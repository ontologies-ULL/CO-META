@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .

@prefix cm: <https://w3id.org/ontologies-ULL/CO-META#> .

# Without these values an execution cannot be run; under the open world
# assumption OWL cannot require them.

cm:ExecutionShape
    a sh:NodeShape ;
    sh:targetClass cm:Execution ;
    sh:property [
        sh:path cm:solvesInstance ;
        sh:minCount 1 ;
        sh:message "An execution must state the instance it solves." ;
    ] ;
    sh:property [
        sh:path cm:usesMetaheuristic ;
        sh:minCount 1 ;
        sh:message "An execution must state the metaheuristic it uses." ;
    ] .

cm:ParameterAssignmentShape
    a sh:NodeShape ;
    sh:targetClass cm:ParameterAssignment ;
    sh:property [
        sh:path cm:assignsParameterValue ;
        sh:minCount 1 ;
        sh:message "An assignment must state the parameter value it assigns." ;
    ] ;
    sh:property [
        sh:path cm:hasValue ;
        sh:minCount 1 ;
        sh:message "An assignment must state the assigned value." ;
    ] ;

    # The bounds of the parameter value domain also apply to the assigned value
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Assigned value {?value} of {$this} is outside the bound {?bound} of its parameter." ;
        sh:select """
            PREFIX cm: <https://w3id.org/ontologies-ULL/CO-META#>
            SELECT $this ?value ?bound
            WHERE {
                $this cm:hasValue ?value ;
                      cm:assignsParameterValue/cm:hasType/cm:hasValueDomain ?domain .
                {
                    ?domain cm:hasLowerBound/cm:hasLiteralValue ?bound .
                    BIND ("lower" AS ?side)
                } UNION {
                    ?domain cm:hasUpperBound/cm:hasLiteralValue ?bound .
                    BIND ("upper" AS ?side)
                } UNION {
                    ?domain cm:hasExclusiveLowerBound/cm:hasLiteralValue ?bound .
                    BIND ("exclusive lower" AS ?side)
                } UNION {
                    ?domain cm:hasExclusiveUpperBound/cm:hasLiteralValue ?bound .
                    BIND ("exclusive upper" AS ?side)
                }
                FILTER ((?side = "lower" && ?value < ?bound) || (?side = "upper" && ?value > ?bound) ||
                        (?side = "exclusive lower" && ?value <= ?bound) || (?side = "exclusive upper" && ?value >= ?bound))
            }
        """ ;
    ] .
