        <hasValueDomain rdf:resource="https://w3id.org/ontologies-ULL/CO-META#NonNegativeIntegers"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#Integers -->


    <owl:NamedIndividual rdf:about="https://w3id.org/ontologies-ULL/CO-META#Integers">
        <rdf:type rdf:resource="https://w3id.org/ontologies-ULL/CO-META#BaseType"/>
        <rdfs:comment xml:lang="es">Conjunto de los números enteros.</rdfs:comment>
        <rdfs:comment xml:lang="en">Set of integer numbers.</rdfs:comment>
        <rdfs:label xml:lang="es">Enteros</rdfs:label>
        <rdfs:label xml:lang="en">Integers</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#Iterations -->


    <owl:NamedIndividual rdf:about="https://w3id.org/ontologies-ULL/CO-META#Iterations">
        <rdf:type rdf:resource="https://w3id.org/ontologies-ULL/CO-META#Parameter"/>
        <hasValueDomain rdf:resource="https://w3id.org/ontologies-ULL/CO-META#NonNegativeIntegers"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#MutationProbability -->


    <owl:NamedIndividual rdf:about="https://w3id.org/ontologies-ULL/CO-META#MutationProbability">
        <rdf:type rdf:resource="https://w3id.org/ontologies-ULL/CO-META#Parameter"/>
        <hasValueDomain rdf:resource="https://w3id.org/ontologies-ULL/CO-META#UnitInterval"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#NonNegativeIntegers -->


    <owl:NamedIndividual rdf:about="https://w3id.org/ontologies-ULL/CO-META#NonNegativeIntegers">
        <rdf:type rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ValueDomain"/>
        <hasBaseType rdf:resource="https://w3id.org/ontologies-ULL/CO-META#Integers"/>
        <hasLowerBound rdf:resource="https://w3id.org/ontologies-ULL/CO-META#Zero"/>
        <rdfs:comment xml:lang="es">Dominio de valores con los enteros mayores o iguales que 0 (p. ej., un número de iteraciones).</rdfs:comment>
        <rdfs:comment xml:lang="en">Value domain of the integers greater than or equal to 0 (e.g. a number of iterations).</rdfs:comment>
        <rdfs:label xml:lang="es">Enteros no negativos</rdfs:label>
        <rdfs:label xml:lang="en">Non-Negative Integers</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#NonNegativeReals -->


    <owl:NamedIndividual rdf:about="https://w3id.org/ontologies-ULL/CO-META#NonNegativeReals">
        <rdf:type rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ValueDomain"/>
        <hasBaseType rdf:resource="https://w3id.org/ontologies-ULL/CO-META#Reals"/>
        <hasLowerBound rdf:resource="https://w3id.org/ontologies-ULL/CO-META#Zero"/>
        <rdfs:comment xml:lang="es">Dominio de valores con los reales mayores o iguales que 0 (p. ej., un peso).</rdfs:comment>
        <rdfs:comment xml:lang="en">Value domain of the real numbers greater than or equal to 0 (e.g. a weight).</rdfs:comment>
        <rdfs:label xml:lang="en">Non-Negative Reals</rdfs:label>
        <rdfs:label xml:lang="es">Reales no negativos</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#One -->


    <owl:NamedIndividual rdf:about="https://w3id.org/ontologies-ULL/CO-META#One">
        <rdf:type rdf:resource="https://w3id.org/ontologies-ULL/CO-META#LiteralValue"/>
        <hasLiteralValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</hasLiteralValue>
        <rdfs:comment xml:lang="es">El número 1, como valor literal para tamaños y cotas.</rdfs:comment>
        <rdfs:comment xml:lang="en">The number 1, as a literal value for sizes and bounds.</rdfs:comment>
        <rdfs:label xml:lang="en">One</rdfs:label>
        <rdfs:label xml:lang="es">Uno</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#PopulationSize -->


    <owl:NamedIndividual rdf:about="https://w3id.org/ontologies-ULL/CO-META#PopulationSize">
        <rdf:type rdf:resource="https://w3id.org/ontologies-ULL/CO-META#Parameter"/>
        <hasValueDomain rdf:resource="https://w3id.org/ontologies-ULL/CO-META#NonNegativeIntegers"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#PositiveIntegers -->


    <owl:NamedIndividual rdf:about="https://w3id.org/ontologies-ULL/CO-META#PositiveIntegers">
        <rdf:type rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ValueDomain"/>
        <hasBaseType rdf:resource="https://w3id.org/ontologies-ULL/CO-META#Integers"/>
        <hasLowerBound rdf:resource="https://w3id.org/ontologies-ULL/CO-META#One"/>
        <rdfs:comment xml:lang="es">Dominio de valores con los enteros mayores o iguales que 1 (p. ej., un número de ciudades).</rdfs:comment>
        <rdfs:comment xml:lang="en">Value domain of the integers greater than or equal to 1 (e.g. a number of cities).</rdfs:comment>
        <rdfs:label xml:lang="es">Enteros positivos</rdfs:label>
        <rdfs:label xml:lang="en">Positive Integers</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#Reals -->


    <owl:NamedIndividual rdf:about="https://w3id.org/ontologies-ULL/CO-META#Reals">
        <rdf:type rdf:resource="https://w3id.org/ontologies-ULL/CO-META#BaseType"/>
        <rdfs:comment xml:lang="es">Conjunto de los números reales.</rdfs:comment>
        <rdfs:comment xml:lang="en">Set of real numbers.</rdfs:comment>
        <rdfs:label xml:lang="es">Reales</rdfs:label>
        <rdfs:label xml:lang="en">Reals</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#Safe -->


    <owl:NamedIndividual rdf:about="https://w3id.org/ontologies-ULL/CO-META#Safe">
        <rdf:type rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ComponentSafety"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#Scalar -->


    <owl:NamedIndividual rdf:about="https://w3id.org/ontologies-ULL/CO-META#Scalar">
        <rdf:type rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ScalarShape"/>
        <rdfs:comment xml:lang="es">La forma de los valores individuales.</rdfs:comment>
        <rdfs:comment xml:lang="en">The shape of single values.</rdfs:comment>
        <rdfs:label xml:lang="es">Escalar</rdfs:label>
        <rdfs:label xml:lang="en">Scalar</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#SolutionFirstDimensionSize -->


    <owl:NamedIndividual rdf:about="https://w3id.org/ontologies-ULL/CO-META#SolutionFirstDimensionSize">
        <rdf:type rdf:resource="https://w3id.org/ontologies-ULL/CO-META#SolutionSizeReference"/>
        <hasDimensionIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">1</hasDimensionIndex>
        <rdfs:comment xml:lang="en">Size of the first dimension of the solution handled by the algorithm: the length of a sequence or the number of rows of a matrix.</rdfs:comment>
        <rdfs:comment xml:lang="es">Tamaño de la primera dimensión de la solución que maneja el algoritmo: la longitud de una secuencia o el número de filas de una matriz.</rdfs:comment>
