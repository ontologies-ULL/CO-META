    <owl:NamedIndividual rdf:about="https://w3id.org/ontologies-ULL/CO-META#Both">
        <rdf:type rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ComponentSafety"/>
    </owl:NamedIndividual>
    


