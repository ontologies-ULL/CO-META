    <owl:NamedIndividual rdf:about="https://w3id.org/ontologies-ULL/CO-META#CrossoverKPoints">
        <rdf:type rdf:resource="https://w3id.org/ontologies-ULL/CO-META#Parameter"/>
        <hasValueDomain rdf:resource="https://w3id.org/ontologies-ULL/CO-META#PositiveIntegers"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#CrossoverProbability -->


    <owl:NamedIndividual rdf:about="https://w3id.org/ontologies-ULL/CO-META#CrossoverProbability">
        <rdf:type rdf:resource="https://w3id.org/ontologies-ULL/CO-META#Parameter"/>
        <hasValueDomain rdf:resource="https://w3id.org/ontologies-ULL/CO-META#UnitInterval"/>
    </owl:NamedIndividual>
    


