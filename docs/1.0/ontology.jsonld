  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#ValueSpecification"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#hasLiteralValue",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Number given explicitly. xsd:double is used for -INF and INF."
  }, {
    "@language" : "es",
    "@value" : "Número indicado de forma explícita. Se usa xsd:double para -INF e INF."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#LiteralValue"
