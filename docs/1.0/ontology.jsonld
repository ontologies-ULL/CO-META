    "@value" : "tiene cota inferior"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#ValueSpecification"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#hasNadirValue",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Peor valor del objetivo entre las soluciones eficientes. Se usa con hasIdealValue para normalizar el objetivo."
  }, {
