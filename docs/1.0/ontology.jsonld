  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Carácter que separa los campos de un fichero CSV (una coma por defecto)."
  }, {
    "@language" : "en",
    "@value" : "Character that separates the fields of a CSV file (a comma by default)."
