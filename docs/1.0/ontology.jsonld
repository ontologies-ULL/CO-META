  "http://purl.org/dc/elements/1.1/description" : [ {
    "@language" : "en",
    "@value" : "Ontology for Combinatorial Optimization Metaheuristics"
  }, {
    "@language" : "es",
    "@value" : "Ontología para Metaheurísticas de Optimización Combinatoria"
