  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Dominio de valores con todas las soluciones candidatas del problema que se resuelve."
  }, {
    "@language" : "en",
    "@value" : "Value domain of all candidate solutions of the problem being solved."
