    "@id" : "https://w3id.org/ontologies-ULL/CO-META#Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Amount of pheromone an ant deposits, divided by the cost of its solution."
  }, {
    "@language" : "es",
    "@value" : "Cantidad de feromona que deposita una hormiga, dividida por el coste de su solución."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Adición de feromona"
  }, {
    "@language" : "en",
    "@value" : "Pheromone Addition"
  } ],
