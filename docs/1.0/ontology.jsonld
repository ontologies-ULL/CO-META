    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#hasDimensionIndex",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Dimension of the solution whose size is referred to: 1 for the length of a sequence or the rows of a matrix, 2 for the columns of a matrix."
  }, {
    "@language" : "es",
    "@value" : "Dimensión de la solución cuyo tamaño se referencia: 1 para la longitud de una secuencia o las filas de una matriz, 2 para las columnas de una matriz."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#SolutionSizeReference"
