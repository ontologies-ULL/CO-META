  "@id" : "https://w3id.org/ontologies-ULL/CO-META#PheromoneEvaporationComponent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Data handler that multiplies every pheromone it writes by (1 - evaporation rate)."
  }, {
    "@language" : "es",
    "@value" : "Manejador de datos que multiplica cada feromona que escribe por (1 - tasa de evaporación)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Componente de evaporación de feromonas"
