    "@language" : "es",
    "@value" : "Componente de selección que selecciona un único individuo en cada invocación, por lo que se aplica repetidamente para seleccionar varios individuos."
  }, {
    "@language" : "en",
    "@value" : "Selection component that selects a single individual per invocation, so it is applied repeatedly to select several individuals."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Componente de selección iterativa"
  }, {
    "@language" : "en",
    "@value" : "Iterative Selection Component"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#SelectionComponent"
