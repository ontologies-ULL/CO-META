  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Fichero JSON (hasSourceLocation) con las mismas formas que un valor en línea."
  }, {
    "@language" : "en",
    "@value" : "JSON file (hasSourceLocation) with the same forms as an inline value."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "JSON"
  }, {
    "@language" : "es",
    "@value" : "JSON"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#KPointCrossoverComponent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Componente de cruce que divide a los progenitores en k puntos de corte e intercambia los segmentos resultantes. Tiene un parámetro para el número de puntos de corte."
  }, {
    "@language" : "en",
    "@value" : "Crossover component that splits the parents at k cut points and exchanges the resulting segments. It has a parameter for the number of cut points."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Componente de cruce de k puntos"
  }, {
    "@language" : "en",
    "@value" : "K-Point Crossover Component"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#CrossoverComponent"
  }, {
    "@id" : "_:genid106"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#LiteralValue",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Especificación de valor indicada explícitamente como un número (p. ej., 0, 1 o INF)."
  }, {
    "@language" : "en",
    "@value" : "Value specification given explicitly as a number (e.g. 0, 1 or INF)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Literal Value"
  }, {
    "@language" : "es",
    "@value" : "Valor literal"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#ValueSpecification"
  }, {
    "@id" : "_:genid108"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#LocalSearchComponent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Componente de modificación que mejora la aptitud de una solución explorando el vecindario que usa."
  }, {
    "@language" : "en",
    "@value" : "Modification component that improves the fitness of a solution by exploring the neighbourhood it uses."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Componente de búsqueda local"
  }, {
    "@language" : "en",
    "@value" : "Local Search Component"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#ModificationComponent"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#LocalSearchMetaheuristic",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Metaheuristic that improves solutions by exploring their neighbourhoods: a perturbative single-solution metaheuristic, or one that uses a local search."
  }, {
    "@language" : "es",
    "@value" : "Metaheurística que mejora soluciones explorando sus vecindarios: una metaheurística perturbativa de solución única, o una que usa una búsqueda local."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Local Search Metaheuristic"
  }, {
    "@language" : "es",
    "@value" : "Metaheurística de búsqueda local"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid109"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#LoopComponent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Component that creates loops to iterate through data structures or to repeat processes until a condition is met. It has two additional properties: hasOutputStart and hasOutputEnd."
  }, {
    "@language" : "es",
    "@value" : "Componente que crea bucles para recorrer estructuras de datos o repetir procesos hasta que se cumple una condición. Tiene dos propiedades adicionales: hasOutputStart y hasOutputEnd."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Componente de bucle"
  }, {
    "@language" : "en",
    "@value" : "Loop Component"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#MetaheuristicComponent"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#MatrixData",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Datos del problema organizados como una matriz de valores de la misma naturaleza (p. ej., las distancias entre cada par de ciudades). Se deduce de la forma, por lo que no es necesario declararla."
  }, {
    "@language" : "en",
    "@value" : "Problem data organized as a matrix of values of the same kind (e.g. the distances between each pair of cities). It is inferred from the shape, so it does not need to be asserted."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Datos matriciales"
  }, {
    "@language" : "en",
    "@value" : "Matrix Data"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#ProblemData"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid119"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#MatrixShape",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Forma de una magnitud cuyos valores, todos de la misma naturaleza, se disponen en filas y columnas (p. ej., una matriz de distancias entre ciudades)."
  }, {
    "@language" : "en",
    "@value" : "Shape of a quantity whose values, all of the same kind, are arranged in rows and columns (e.g. a distance matrix between cities)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Forma matricial"
  }, {
    "@language" : "en",
    "@value" : "Matrix Shape"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://qudt.org/schema/qudt/Matrix"
  }, {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#DataShape"
  }, {
    "@id" : "_:genid123"
  }, {
    "@id" : "_:genid124"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#MatrixVariable",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Decision variable made up of a value for each pair of elements of two collections (e.g. whether each vehicle visits each customer). It is inferred from the shape, so it does not need to be asserted."
  }, {
    "@language" : "es",
    "@value" : "Variable de decisión formada por un valor para cada par de elementos de dos colecciones (p. ej., si cada vehículo visita a cada cliente). Se deduce de la forma, por lo que no es necesario declararla."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Matrix Variable"
  }, {
    "@language" : "es",
    "@value" : "Variable matricial"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#DecisionVariable"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid125"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#MaxTemperature",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Initial temperature. The Metropolis acceptance uses relative degradations, so temperatures are fractions of the current objective value."
  }, {
    "@language" : "es",
    "@value" : "Temperatura inicial. La aceptación de Metropolis usa empeoramientos relativos, por lo que las temperaturas son fracciones del valor actual del objetivo."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Maximum Temperature"
  }, {
    "@language" : "es",
    "@value" : "Temperatura máxima"
  } ],
  "https://w3id.org/ontologies-ULL/CO-META#hasDefaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#decimal",
    "@value" : "0.1"
  } ],
  "https://w3id.org/ontologies-ULL/CO-META#hasValueDomain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#PositiveReals"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#MaximizationObjective",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Objective of an optimization problem whose value must be maximized."
  }, {
    "@language" : "es",
    "@value" : "Objetivo de un problema de optimización cuyo valor debe maximizarse."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Maximization Objective"
  }, {
    "@language" : "es",
    "@value" : "Objetivo de maximización"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#Objective"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#MinimizationObjective"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#MemeticAlgorithm",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Algoritmo evolutivo que además utiliza procesos de búsqueda local."
  }, {
    "@language" : "en",
    "@value" : "Evolutionary algorithm that employs local search processes."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Algoritmo memético"
  }, {
    "@language" : "en",
    "@value" : "Memetic Algorithm"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid129"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#Metaheuristic",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "High-level algorithmic procedure, composed of interconnected metaheuristic components, that finds sufficiently good solutions to optimization problems by searching through vast solution spaces."
  }, {
    "@language" : "es",
    "@value" : "Procedimiento algorítmico de alto nivel, compuesto por componentes metaheurísticos interconectados, que encuentran soluciones suficientemente buenas a problemas de optimización mediante búsquedas en amplios espacios de soluciones."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Metaheuristic"
  }, {
    "@language" : "es",
    "@value" : "Metaheurística"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#MetaheuristicComponent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Bloque constructivo de una metaheurística que realiza una tarea específica y se conecta con otros componentes."
  }, {
    "@language" : "en",
    "@value" : "Building block of a metaheuristic that performs a specific task and is connected to other components."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Componente metaheurístico"
  }, {
    "@language" : "en",
    "@value" : "Metaheuristic Component"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#MetropolisAcceptanceComponent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Acceptance component that accepts a worse candidate with probability exp(-d / T), where d is the relative degradation (f_candidate - f_current) / |f_current| and T the temperature it reads."
  }, {
    "@language" : "es",
    "@value" : "Componente de aceptación que acepta una candidata peor con probabilidad exp(-d / T), donde d es el empeoramiento relativo (f_candidata - f_actual) / |f_actual| y T la temperatura que lee."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Componente de aceptación de Metropolis"
  }, {
    "@language" : "en",
    "@value" : "Metropolis Acceptance Component"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#AcceptanceComponent"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#MinTemperature",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Temperatura que se alcanza al agotarse el presupuesto de iteraciones."
  }, {
    "@language" : "en",
    "@value" : "Temperature reached when the iteration budget is spent."
  } ],
