}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#PopulationSize",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Number of solutions that a component generates, constructs or iterates over."
  }, {
    "@language" : "es",
    "@value" : "Número de soluciones que un componente genera, construye o recorre."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Population Size"
  }, {
    "@language" : "es",
    "@value" : "Tamaño de la población"
  } ],
