  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Maximum number of iterations."
  }, {
    "@language" : "es",
    "@value" : "Número máximo de iteraciones."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
