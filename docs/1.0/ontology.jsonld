}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#ArchiveUpdateComponent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Data handler that replaces the content of the archive it writes with the solutions it receives, and passes them on."
  }, {
    "@language" : "es",
    "@value" : "Manejador de datos que sustituye el contenido del archivo que escribe por las soluciones que recibe, y las deja pasar."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Archive Update Component"
  }, {
    "@language" : "es",
    "@value" : "Componente de actualización del archivo"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#DataHandlerComponent"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#BaseType",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Conjunto en el que se basa un dominio de valores: booleanos, enteros, reales o soluciones candidatas."
  }, {
    "@language" : "en",
    "@value" : "Set on which a value domain is based: booleans, integers, reals or candidate solutions."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Base Type"
  }, {
    "@language" : "es",
    "@value" : "Tipo base"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid43"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#BestCandidateAcceptanceComponent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Acceptance component that accepts the best candidate even if it is worse than the current solution (as in tabu search)."
  }, {
    "@language" : "es",
    "@value" : "Componente de aceptación que acepta al mejor candidato aunque sea peor que la solución actual (como en la búsqueda tabú)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Best Candidate Acceptance Component"
  }, {
    "@language" : "es",
    "@value" : "Componente de aceptación del mejor candidato"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#AcceptanceComponent"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#BestImprovementLocalSearchComponent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Componente de búsqueda local que se desplaza al mejor vecino del vecindario que usa mientras mejore."
  }, {
    "@language" : "en",
    "@value" : "Local search component that moves to the best neighbour of the neighbourhood it uses while it improves."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Best Improvement Local Search Component"
  }, {
    "@language" : "es",
    "@value" : "Componente de búsqueda local de mejor mejora"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#LocalSearchComponent"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#BestSolutionsUpdateComponent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Data handler that keeps in the structure it writes the best solution seen: a single one for a scalar structure, or one per position (e.g. per particle) for a collection."
  }, {
    "@language" : "es",
    "@value" : "Manejador de datos que conserva en la estructura que escribe la mejor solución vista: una única para una estructura escalar, o una por posición (p. ej. por partícula) para una colección."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Best Solutions Update Component"
  }, {
    "@language" : "es",
    "@value" : "Componente de actualización de las mejores soluciones"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#DataHandlerComponent"
  }, {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#UpdateBestComponent"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#BinaryIntegers",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#ValueDomain"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Dominio de valores con los enteros 0 y 1 (p. ej., si un objeto se selecciona)."
  }, {
    "@language" : "en",
    "@value" : "Value domain of the integers 0 and 1 (e.g. whether an item is selected)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Binary Integers"
  }, {
    "@language" : "es",
    "@value" : "Enteros binarios"
  } ],
  "https://w3id.org/ontologies-ULL/CO-META#hasBaseType" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#Integers"
  } ],
  "https://w3id.org/ontologies-ULL/CO-META#hasLowerBound" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#Zero"
  } ],
  "https://w3id.org/ontologies-ULL/CO-META#hasUpperBound" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#One"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#BitFlipMutationComponent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Componente de variación que cambia cada valor binario con probabilidad 1/n, cambiando al menos uno."
  }, {
    "@language" : "en",
    "@value" : "Variation component that flips each binary value with probability 1/n, flipping at least one."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Bit Flip Mutation Component"
  }, {
    "@language" : "es",
    "@value" : "Componente de mutación por cambio de bit"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#VariationComponent"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#BitFlipNeighbourhoodComponent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Neighbourhood of the binary vectors that differ in one position."
  }, {
    "@language" : "es",
    "@value" : "Vecindario de los vectores binarios que difieren en una posición."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Bit Flip Neighbourhood Component"
  }, {
    "@language" : "es",
    "@value" : "Componente de vecindario de cambio de bit"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#NeighbourhoodComponent"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#BlendAlpha",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Ampliación del intervalo de los progenitores en un cruce por mezcla, como fracción de su anchura."
  }, {
    "@language" : "en",
    "@value" : "Extension of the parents' interval in a blend crossover, as a fraction of its width."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Alfa de mezcla"
  }, {
    "@language" : "en",
    "@value" : "Blend Alpha"
  } ],
  "https://w3id.org/ontologies-ULL/CO-META#hasDefaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#decimal",
    "@value" : "0.5"
  } ],
  "https://w3id.org/ontologies-ULL/CO-META#hasValueDomain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#NonNegativeReals"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#BlendCrossoverComponent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Componente de cruce para valores reales que obtiene cada valor del descendiente de forma uniforme en el intervalo de los valores de los progenitores ampliado en alfa veces su anchura (BLX-alfa)."
  }, {
    "@language" : "en",
    "@value" : "Crossover component for real values that draws each offspring value uniformly from the interval of the parents' values extended by alpha times its width (BLX-alpha)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Blend Crossover Component"
  }, {
    "@language" : "es",
    "@value" : "Componente de cruce por mezcla"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#CrossoverComponent"
  }, {
    "@id" : "_:genid48"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#Booleans",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#BaseType"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Conjunto de valores de verdad {falso, verdadero}."
  }, {
    "@language" : "en",
    "@value" : "Set of truth values {false, true}."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Booleanos"
  }, {
    "@language" : "en",
    "@value" : "Booleans"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#Both",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#ComponentSafety"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "El componente puede configurarse para producir solo soluciones factibles o no."
  }, {
    "@language" : "en",
    "@value" : "The component can be configured to produce only feasible solutions or not."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Ambos"
  }, {
    "@language" : "en",
    "@value" : "Both"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#CollectionShape",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Forma de una magnitud formada por varios valores de la misma naturaleza, caracterizada por si importa su orden (isOrdered) y si pueden repetirse (isDistinct)."
  }, {
    "@language" : "en",
    "@value" : "Shape of a quantity made up of a number of values of the same kind, characterized by whether their order matters (isOrdered) and whether they can be repeated (isDistinct)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Collection Shape"
  }, {
    "@language" : "es",
    "@value" : "Forma de colección"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://qudt.org/schema/qudt/Collection"
  }, {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#DataShape"
  }, {
    "@id" : "_:genid50"
  }, {
    "@id" : "_:genid51"
  }, {
    "@id" : "_:genid52"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#Column",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Atributo de las entidades descritas por una tabla. Equivale a un vector de datos con un valor por registro (p. ej., el peso de cada objeto)."
  }, {
    "@language" : "en",
    "@value" : "Attribute of the entities described by a table. It is equivalent to a vector of data with one value per record (e.g. the weight of each item)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Column"
  }, {
    "@language" : "es",
    "@value" : "Columna"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#ProblemData"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#InputParameter"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#ColumnMapping",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Campo del origen que contiene los valores de una columna de una tabla. Sin correspondencias, los campos se emparejan con los identificadores de las columnas."
  }, {
    "@language" : "en",
    "@value" : "Field of the source that holds the values of a column of a table. Without mappings, the fields are matched with the identifiers of the columns."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Column Mapping"
  }, {
    "@language" : "es",
    "@value" : "Correspondencia de columna"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#ComponentSafety",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Enumeración (Safe, Unsafe, Both) que indica si un componente metaheurístico garantiza que las soluciones que produce son factibles, puede producir soluciones no factibles o admite ambos comportamientos."
  }, {
    "@language" : "en",
    "@value" : "Enumeration (Safe, Unsafe, Both) that indicates whether a metaheuristic component guarantees that the solutions it produces are feasible, may produce infeasible solutions, or supports both behaviours."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Component Safety"
  }, {
    "@language" : "es",
    "@value" : "Seguridad del componente"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid53"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#ComponentTrace",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#TraceLevel"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Every execution of a component is recorded, with its inputs and outputs."
  }, {
    "@language" : "es",
    "@value" : "Se registra cada ejecución de un componente, con sus entradas y salidas."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Component trace"
  }, {
    "@language" : "es",
    "@value" : "Traza por componente"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#CompositeShape",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Forma de una magnitud que combina varias formas, una por componente (p. ej., una solución formada por una permutación y una matriz)."
  }, {
    "@language" : "en",
    "@value" : "Shape of a quantity that combines several shapes, one per component (e.g. a solution made up of a permutation and a matrix)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Composite Shape"
  }, {
    "@language" : "es",
    "@value" : "Forma compuesta"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://qudt.org/schema/qudt/Record"
  }, {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#DataShape"
  }, {
    "@id" : "_:genid57"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#Constraint",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Condición que debe cumplir una solución de un problema de optimización para ser factible. Si no es dura, solo se penalizan las soluciones que la violan."
  }, {
    "@language" : "en",
    "@value" : "Condition that a solution of an optimization problem must satisfy in order to be feasible. If it is not hard, the solutions that violate it are only penalized."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Constraint"
  }, {
    "@language" : "es",
    "@value" : "Restricción"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#ProblemElement"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#ConstraintHandling",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Cómo trata una metaheurística las soluciones no factibles."
  }, {
    "@language" : "en",
    "@value" : "How a metaheuristic deals with infeasible solutions."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Constraint Handling"
  }, {
    "@language" : "es",
    "@value" : "Tratamiento de restricciones"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid58"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#ConstructionComponent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Component that constructs a solution or a group of solutions step by step using heuristic methods."
  }, {
    "@language" : "es",
    "@value" : "Componente que construye una solución o un grupo de soluciones paso a paso mediante métodos heurísticos."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Componente de construcción"
  }, {
    "@language" : "en",
    "@value" : "Construction Component"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#MetaheuristicComponent"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#ConstructiveMetaheuristic",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Metaheuristic that builds solutions incrementally."
  }, {
    "@language" : "es",
    "@value" : "Metaheurística que construye soluciones de forma incremental."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Constructive Metaheuristic"
  }, {
    "@language" : "es",
    "@value" : "Metaheurística constructiva"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid63"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#CrossoverComponent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Componente de modificación que produce uno o más individuos descendientes recombinando dos o más individuos progenitores. Tiene un parámetro de probabilidad de cruce."
  }, {
    "@language" : "en",
    "@value" : "Modification component that produces one or more offspring individuals by recombining two or more parent individuals. It has a crossover probability parameter."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Componente de cruce"
  }, {
    "@language" : "en",
    "@value" : "Crossover Component"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#ModificationComponent"
  }, {
    "@id" : "_:genid67"
  }, {
    "@id" : "_:genid69"
  }, {
    "@id" : "_:genid70"
  }, {
    "@id" : "_:genid71"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#CrossoverKPoints",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Number of cut points of a k-point crossover."
  }, {
    "@language" : "es",
    "@value" : "Número de puntos de corte de un cruce de k puntos."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Crossover K Points"
  }, {
    "@language" : "es",
    "@value" : "Puntos del cruce de k puntos"
  } ],
  "https://w3id.org/ontologies-ULL/CO-META#hasDefaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#integer",
    "@value" : "1"
  } ],
  "https://w3id.org/ontologies-ULL/CO-META#hasValueDomain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#PositiveIntegers"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#CrossoverProbability",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Probabilidad de que se recombine una pareja de progenitores; si no, se copian."
  }, {
    "@language" : "en",
    "@value" : "Probability that a pair of parents is recombined; otherwise they are copied."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Crossover Probability"
  }, {
    "@language" : "es",
    "@value" : "Probabilidad de cruce"
  } ],
  "https://w3id.org/ontologies-ULL/CO-META#hasDefaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#decimal",
    "@value" : "0.9"
  } ],
  "https://w3id.org/ontologies-ULL/CO-META#hasValueDomain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#UnitInterval"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#CrowdingDistanceComponent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Componente de preservación de la diversidad que mide, dentro de cada frente, el tamaño del cuboide alrededor de cada individuo en el espacio de objetivos."
  }, {
    "@language" : "en",
    "@value" : "Diversity preservation component that measures, within each front, the size of the cuboid around each individual in objective space."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Componente de distancia de hacinamiento"
  }, {
    "@language" : "en",
    "@value" : "Crowding Distance Component"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#DiversityPreservationComponent"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#CsvFormat",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#DataFormat"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "CSV file (hasSourceLocation): a table, with a header row by default, or a matrix without one."
  }, {
    "@language" : "es",
    "@value" : "Fichero CSV (hasSourceLocation): una tabla, con fila de cabecera por defecto, o una matriz sin ella."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "CSV"
  }, {
    "@language" : "es",
    "@value" : "CSV"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#CycleCrossoverComponent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Componente de cruce para permutaciones que mantiene cada valor en la posición que ocupa en uno de los progenitores, siguiendo los ciclos entre ellos (CX)."
  }, {
    "@language" : "en",
    "@value" : "Crossover component for permutations that keeps each value in the position it has in one of the parents, following the cycles between them (CX)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Componente de cruce por ciclos"
  }, {
    "@language" : "en",
    "@value" : "Cycle Crossover Component"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#CrossoverComponent"
  }, {
    "@id" : "_:genid72"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#DataBinding",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Fuente de los valores de un dato del problema en una instancia: un valor en línea o un fichero."
  }, {
    "@language" : "en",
    "@value" : "Source of the values of one problem datum in an instance: an inline value or a file."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Data Binding"
  }, {
    "@language" : "es",
    "@value" : "Ligadura de datos"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#DataFormat",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Format of the source of a data binding."
  }, {
    "@language" : "es",
    "@value" : "Formato del origen de una ligadura de datos."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Data Format"
  }, {
    "@language" : "es",
    "@value" : "Formato de datos"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid73"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#DataHandlerComponent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Component that updates specific data structures used by the algorithm."
  }, {
    "@language" : "es",
    "@value" : "Componente que actualiza estructuras de datos específicas utilizadas por el algoritmo."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Componente manejador de datos"
  }, {
    "@language" : "en",
    "@value" : "Data Handler Component"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#MetaheuristicComponent"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#DataShape",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Organización de los valores de una magnitud: un único valor, una colección, una matriz, una tabla o una combinación de ellas. Describe un tipo de datos, no valores concretos. Esta clase no debe instanciarse directamente; deben usarse sus subclases."
  }, {
    "@language" : "en",
    "@value" : "Organization of the values of a quantity: a single value, a collection, a matrix, a table or a combination of them. It describes a type of data, not specific values. This class should not be instantiated directly; its subclasses should be used instead."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Data Shape"
  }, {
    "@language" : "es",
    "@value" : "Forma de datos"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#DataStructure",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Data structure that stores information used by the algorithm during its execution."
  }, {
    "@language" : "es",
    "@value" : "Estructura de datos que almacena información utilizada por el algoritmo durante su ejecución."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Data Structure"
  }, {
    "@language" : "es",
    "@value" : "Estructura de datos"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#DeathPenaltyHandling",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#ConstraintHandling"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Infeasible solutions are discarded."
  }, {
    "@language" : "es",
    "@value" : "Las soluciones no factibles se descartan."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Death Penalty"
  }, {
    "@language" : "es",
    "@value" : "Pena de muerte"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#DecisionVariable",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Magnitud cuyo valor elige el método de resolución. Una asignación de valores a todas las variables de decisión del problema constituye una solución candidata."
  }, {
    "@language" : "en",
    "@value" : "Quantity whose value is chosen by the solution method. An assignment of values to all the decision variables of a problem is a candidate solution."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Decision Variable"
  }, {
    "@language" : "es",
    "@value" : "Variable de decisión"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#ProblemQuantity"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#ProblemData"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#DistinctSequenceShape",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Secuencia cuyos valores no pueden repetirse. Cuando su longitud coincide con el número de valores posibles, es una permutación (p. ej., el recorrido por las ciudades en el TSP)."
  }, {
    "@language" : "en",
    "@value" : "Sequence whose values cannot be repeated. When its length equals the number of possible values, it is a permutation (e.g. the tour through the cities in the TSP)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Distinct Sequence Shape"
  }, {
    "@language" : "es",
    "@value" : "Forma de secuencia sin repeticiones"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid77"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#DiversityPreservationComponent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Componente multiobjetivo que ajusta los valores de aptitud para fomentar la diversidad en la población."
  }, {
    "@language" : "en",
    "@value" : "Multiobjective component that adjusts fitness values to encourage diversity in the population."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Componente de preservación de la diversidad"
  }, {
    "@language" : "en",
    "@value" : "Diversity Preservation Component"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#MultiobjectiveComponent"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#ElementChangeNeighbourhoodComponent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Neighbourhood of the integer vectors obtained by changing the value of one position to another value of its domain."
  }, {
    "@language" : "es",
    "@value" : "Vecindario de los vectores enteros obtenidos cambiando el valor de una posición por otro valor de su dominio."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Componente de vecindario de cambio de elemento"
  }, {
    "@language" : "en",
    "@value" : "Element Change Neighbourhood Component"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#NeighbourhoodComponent"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#Elitism",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Number of best individuals that a selection keeps in the new population."
  }, {
    "@language" : "es",
    "@value" : "Número de los mejores individuos que una selección conserva en la nueva población."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Elitism"
  }, {
    "@language" : "es",
    "@value" : "Elitismo"
  } ],
  "https://w3id.org/ontologies-ULL/CO-META#hasDefaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#integer",
    "@value" : "1"
  } ],
  "https://w3id.org/ontologies-ULL/CO-META#hasValueDomain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#NonNegativeIntegers"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#Evaluations",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Maximum number of solution evaluations."
  }, {
    "@language" : "es",
    "@value" : "Número máximo de evaluaciones de soluciones."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Evaluaciones"
  }, {
    "@language" : "en",
    "@value" : "Evaluations"
  } ],
  "https://w3id.org/ontologies-ULL/CO-META#hasValueDomain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#PositiveIntegers"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#EvolutionaryAlgorithm",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Metaheuristic based on evolutionary algorithms, employing selection, crossover and variation processes."
  }, {
    "@language" : "es",
    "@value" : "Metaheurística basada en algoritmos evolutivos, utilizando procesos de selección, cruce y variación."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Algoritmo evolutivo"
  }, {
    "@language" : "en",
    "@value" : "Evolutionary Algorithm"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid83"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#Execution",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Ejecución de una metaheurística sobre una instancia de un problema, con su semilla, número de repeticiones, nivel de traza y asignaciones de parámetros."
  }, {
    "@language" : "en",
    "@value" : "Run of a metaheuristic on a problem instance, with its seed, number of runs, trace level and parameter assignments."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Ejecución"
  }, {
    "@language" : "en",
    "@value" : "Execution"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#FeasibilityFirstHandling",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#ConstraintHandling"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Feasible solutions are better than infeasible ones, and infeasible ones are compared by their violation."
  }, {
    "@language" : "es",
    "@value" : "Las soluciones factibles son mejores que las no factibles, y estas se comparan por su violación."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Factibilidad primero"
  }, {
    "@language" : "en",
    "@value" : "Feasibility First"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#FirstImprovementLocalSearchComponent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Componente de búsqueda local que se desplaza al primer vecino que mejora del vecindario que usa, hasta que ningún vecino mejora."
  }, {
    "@language" : "en",
    "@value" : "Local search component that moves to the first improving neighbour of the neighbourhood it uses, until no neighbour improves."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Componente de búsqueda local de primera mejora"
  }, {
    "@language" : "en",
    "@value" : "First Improvement Local Search Component"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#LocalSearchComponent"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#FitnessAssignmentComponent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Componente multiobjetivo que asigna un valor de aptitud individual a cada miembro de una población."
  }, {
    "@language" : "en",
    "@value" : "Multiobjective component that assigns a single fitness value to each member of a population."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Componente de asignación de aptitud"
  }, {
    "@language" : "en",
    "@value" : "Fitness Assignment Component"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#MultiobjectiveComponent"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#GaussianMutationComponent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Componente de variación que suma ruido normal a valores reales, con una desviación típica igual a la intensidad de mutación por la anchura del dominio."
  }, {
    "@language" : "en",
    "@value" : "Variation component that adds normal noise to real values, with a standard deviation equal to the mutation strength times the width of the domain."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Componente de mutación gaussiana"
  }, {
    "@language" : "en",
    "@value" : "Gaussian Mutation Component"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#VariationComponent"
  }, {
    "@id" : "_:genid93"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#GenerationComponent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Component that generates an initial solution or an initial population."
  }, {
    "@language" : "es",
    "@value" : "Componente que genera una solución inicial o una población inicial."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Componente de generación"
  }, {
    "@language" : "en",
    "@value" : "Generation Component"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#MetaheuristicComponent"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#GeometricCoolingComponent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Data handler that lowers the temperature it writes geometrically, from the maximum temperature at the start to the minimum one when the iteration budget of the enclosing stopping criterion is spent."
  }, {
    "@language" : "es",
    "@value" : "Manejador de datos que reduce de forma geométrica la temperatura que escribe, desde la temperatura máxima al principio hasta la mínima cuando se agota el presupuesto de iteraciones del criterio de parada que lo contiene."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Componente de enfriamiento geométrico"
  }, {
    "@language" : "en",
    "@value" : "Geometric Cooling Component"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#DataHandlerComponent"
  }, {
    "@id" : "_:genid95"
  }, {
    "@id" : "_:genid97"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#GlobalBestInfluence",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Peso de la atracción de una partícula hacia la mejor solución del enjambre (c2)."
  }, {
    "@language" : "en",
    "@value" : "Weight of the attraction of a particle towards the best solution of the swarm (c2)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Global Best Influence"
  }, {
    "@language" : "es",
    "@value" : "Influencia del mejor global"
  } ],
  "https://w3id.org/ontologies-ULL/CO-META#hasDefaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#decimal",
    "@value" : "1.5"
  } ],
  "https://w3id.org/ontologies-ULL/CO-META#hasValueDomain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#NonNegativeReals"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#GreedyRandomizedConstructionComponent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Componente de construcción que añade un elemento cada vez, elegido al azar de una lista restringida de candidatos (RCL) construida con la información heurística del problema. Su parámetro de aleatoriedad de la RCL va de puramente voraz (0) a puramente aleatorio (1)."
  }, {
    "@language" : "en",
    "@value" : "Construction component that adds one element at a time, chosen at random from a restricted candidate list (RCL) built from the heuristic information of the problem. Its RCL randomness parameter goes from purely greedy (0) to purely random (1)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Componente de construcción voraz aleatorizada"
  }, {
    "@language" : "en",
    "@value" : "Greedy Randomized Construction Component"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#ConstructionComponent"
  }, {
    "@id" : "_:genid99"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#GreedyRepairComponent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Componente de reparación que cambia, uno cada vez, el valor cuyo cambio más reduce la violación de las restricciones, hasta que la solución es factible."
  }, {
    "@language" : "en",
    "@value" : "Repair component that changes, one at a time, the value whose change reduces the constraint violation the most, until the solution is feasible."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Componente de reparación voraz"
  }, {
    "@language" : "en",
    "@value" : "Greedy Repair Component"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#RepairComponent"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#HeuristicInfluence",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Exponent of the heuristic information (beta)."
  }, {
    "@language" : "es",
    "@value" : "Exponente de la información heurística (beta)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Heuristic Influence"
  }, {
    "@language" : "es",
    "@value" : "Influencia heurística"
  } ],
  "https://w3id.org/ontologies-ULL/CO-META#hasDefaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#decimal",
    "@value" : "2.0"
  } ],
  "https://w3id.org/ontologies-ULL/CO-META#hasValueDomain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#NonNegativeReals"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#HeuristicInformation",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Deseabilidad de una elección cuando una solución se construye paso a paso (p. ej. la visibilidad de las colonias de hormigas o la función voraz de GRASP), dada por una expresión LaTeX sobre los símbolos del problema y uno o dos índices."
  }, {
    "@language" : "en",
    "@value" : "Desirability of a choice when a solution is built step by step (e.g. the visibility of ant colonies or the greedy function of GRASP), given by a LaTeX expression over the symbols of the problem and one or two indices."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Heuristic Information"
  }, {
    "@language" : "es",
    "@value" : "Información heurística"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#ImprovementAcceptanceComponent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Acceptance component that keeps the best of the current and the candidate solutions; ties favour the candidate."
  }, {
    "@language" : "es",
    "@value" : "Componente de aceptación que conserva la mejor entre la solución actual y la candidata; en caso de empate, la candidata."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Componente de aceptación por mejora"
  }, {
    "@language" : "en",
    "@value" : "Improvement Acceptance Component"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#AcceptanceComponent"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#InertiaFactor",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Fracción de su velocidad anterior que conserva una partícula (w)."
  }, {
    "@language" : "en",
    "@value" : "Fraction of its previous velocity that a particle keeps (w)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Factor de inercia"
  }, {
    "@language" : "en",
    "@value" : "Inertia Factor"
  } ],
  "https://w3id.org/ontologies-ULL/CO-META#hasDefaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#decimal",
    "@value" : "0.7"
  } ],
  "https://w3id.org/ontologies-ULL/CO-META#hasValueDomain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#UnitInterval"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#InlineFormat",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#DataFormat"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Los valores se escriben en la propia ligadura, en JSON (hasInlineValue)."
  }, {
    "@language" : "en",
    "@value" : "The values are written in the binding itself, in JSON (hasInlineValue)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "En línea"
  }, {
    "@language" : "en",
    "@value" : "Inline"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#InputParameter",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Dato escalar que caracteriza una instancia del problema (p. ej., la capacidad de la mochila o el número de ciudades)."
  }, {
    "@language" : "en",
    "@value" : "Scalar datum that characterizes an instance of the problem (e.g. the capacity of the knapsack or the number of cities)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Input Parameter"
  }, {
    "@language" : "es",
    "@value" : "Parámetro de entrada"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#ProblemData"
  }, {
    "@id" : "_:genid101"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#InsertionMutationComponent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Componente de variación que mueve el valor de una posición aleatoria a otra posición aleatoria de una permutación."
  }, {
    "@language" : "en",
    "@value" : "Variation component that moves the value of a random position to another random position of a permutation."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Componente de mutación por inserción"
  }, {
    "@language" : "en",
    "@value" : "Insertion Mutation Component"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#VariationComponent"
  }, {
    "@id" : "_:genid102"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#InsertionNeighbourhoodComponent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Neighbourhood of the permutations obtained by moving a value to another position."
  }, {
    "@language" : "es",
    "@value" : "Vecindario de las permutaciones obtenidas moviendo un valor a otra posición."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Componente de vecindario de inserción"
  }, {
    "@language" : "en",
    "@value" : "Insertion Neighbourhood Component"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
