    "@value" : "Componente de modificación que opera sobre poblaciones completas."
  }, {
    "@language" : "en",
    "@value" : "Modification component that operates on whole populations."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Componente operador de población"
  }, {
