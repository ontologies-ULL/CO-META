  "@id" : "https://w3id.org/ontologies-ULL/CO-META#ParameterAssignment",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Valor dado a un valor de parámetro de la metaheurística para una ejecución, que sustituye al valor de la plantilla."
  }, {
    "@language" : "en",
    "@value" : "Value given to a parameter value of the metaheuristic for one execution, overriding the value of the template."
  } ],
