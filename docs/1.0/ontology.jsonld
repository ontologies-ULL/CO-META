  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#ValueDomain"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Dominio de valores con todos los números reales, sin cotas."
  }, {
    "@language" : "en",
    "@value" : "Value domain of all real numbers, without bounds."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Any Real"
  }, {
    "@language" : "es",
    "@value" : "Cualquier real"
  } ],
  "https://w3id.org/ontologies-ULL/CO-META#hasBaseType" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#Reals"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#AnySolution",
