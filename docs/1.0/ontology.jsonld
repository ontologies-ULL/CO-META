}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#IterationsWithoutImprovement",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Number of consecutive iterations without improving the best solution after which the loop stops."
  }, {
    "@language" : "es",
    "@value" : "Número de iteraciones consecutivas sin mejorar la mejor solución tras las que se detiene el bucle."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Iteraciones sin mejora"
  }, {
