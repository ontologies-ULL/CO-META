  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Data handler that resets the neighbourhood index it writes to 1 when the candidate improves the current solution and increases it otherwise, back to 1 after its upper bound."
  }, {
    "@language" : "es",
    "@value" : "Manejador de datos que reinicia a 1 el índice de vecindario que escribe cuando la candidata mejora la solución actual y lo incrementa en otro caso, volviendo a 1 tras su cota superior."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Componente de cambio de vecindario"
  }, {
    "@language" : "en",
    "@value" : "Neighbourhood Change Component"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
