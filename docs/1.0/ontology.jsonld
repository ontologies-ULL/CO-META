  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Data handler that adds, on the elements used by each solution it receives, the pheromone addition divided by the solution's cost."
  }, {
    "@language" : "es",
    "@value" : "Manejador de datos que añade, en los elementos que usa cada solución que recibe, la adición de feromona dividida por el coste de la solución."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Componente de depósito de feromonas"
  }, {
    "@language" : "en",
    "@value" : "Pheromone Deposit Component"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#DataHandlerComponent"
  }, {
    "@id" : "_:genid152"
  } ]
