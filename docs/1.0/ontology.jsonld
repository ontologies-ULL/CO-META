  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Heuristic information that guides the choice of the values of the decision variable when a solution is built step by step."
  }, {
    "@language" : "es",
    "@value" : "Información heurística que guía la elección de los valores de la variable de decisión cuando una solución se construye paso a paso."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#DecisionVariable"
  } ],
