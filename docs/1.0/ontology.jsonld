  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Componente de bucle que repite un proceso parcial, tomando la población anterior como entrada, hasta completar la nueva población. Tiene un parámetro de tamaño de población."
  }, {
    "@language" : "en",
    "@value" : "Loop component that repeats a partial process, taking the old population as input, until the new population is filled. It has a population size parameter."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Componente modificador de población"
  }, {
    "@language" : "en",
    "@value" : "Population Modifier Component"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#LoopComponent"
  }, {
