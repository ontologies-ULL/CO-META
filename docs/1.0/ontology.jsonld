  "@id" : "https://w3id.org/ontologies-ULL/CO-META#Parameter",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Define la estructura de un parámetro utilizado por un componente, como su tipo y su rango de valores válidos."
  }, {
    "@language" : "en",
    "@value" : "Defines the structure of a parameter used by a component, such as its type and its valid range of values."
