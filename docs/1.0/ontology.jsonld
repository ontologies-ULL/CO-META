  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Dominio de valores con todos los valores de verdad."
  }, {
    "@language" : "en",
    "@value" : "Value domain of all truth values."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Any Boolean"
  }, {
    "@language" : "es",
    "@value" : "Cualquier booleano"
  } ],
  "https://w3id.org/ontologies-ULL/CO-META#hasBaseType" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#Booleans"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#AnyInteger",
