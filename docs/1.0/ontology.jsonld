    "@language" : "en",
    "@value" : "Positive Integers"
  } ],
  "https://w3id.org/ontologies-ULL/CO-META#hasBaseType" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#Integers"
