    "@id" : "https://w3id.org/ontologies-ULL/CO-META#ValueSpecification"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#hasFromIndexSymbol",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Symbol of the index that the expression of a transition heuristic uses for the previous value."
  }, {
    "@language" : "es",
    "@value" : "Símbolo del índice que usa la expresión de una heurística de transición para el valor anterior."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#TransitionHeuristic"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has from index symbol"
  }, {
    "@language" : "es",
    "@value" : "tiene símbolo del índice de origen"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#hasHeaderRow",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Si la primera fila de un fichero CSV contiene los nombres de los campos (true por defecto). Sin ella, el fichero se lee como una matriz."
  }, {
    "@language" : "en",
    "@value" : "Whether the first row of a CSV file holds the names of the fields (true by default). Without it, the file is read as a matrix."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#DataBinding"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has header row"
  }, {
    "@language" : "es",
    "@value" : "tiene fila de cabecera"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#boolean"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#hasHeuristic",
