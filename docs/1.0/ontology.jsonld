  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Number used as a size or as a bound, given explicitly or by reference to a parameter or to the size of the solution. This class should not be instantiated directly; its subclasses should be used instead."
  }, {
    "@language" : "es",
    "@value" : "Número usado como tamaño o como cota, indicado explícitamente o mediante una referencia a un parámetro o al tamaño de la solución. Esta clase no debe instanciarse directamente; deben usarse sus subclases."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Especificación de valor"
  }, {
    "@language" : "en",
    "@value" : "Value Specification"
  } ]
