  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Valor de cada elemento de una estructura de datos numérica al empezar el algoritmo."
  }, {
    "@language" : "en",
    "@value" : "Value of every element of a numeric data structure when the algorithm starts."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#DataStructure"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
