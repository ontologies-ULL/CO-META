  } ],
  "http://purl.org/dc/terms/abstract" : [ {
    "@language" : "es",
    "@value" : "Esta ontología proporciona un marco estructurado para la interoperabilidad de fuentes de datos y aplicaciones en el contexto de las metaheurísticas de optimización combinatoria."
  }, {
    "@language" : "en",
    "@value" : "This ontology provides a structured framework for the interoperability of data sources and applications in the context of combinatorial optimization metaheuristics."
  } ],
