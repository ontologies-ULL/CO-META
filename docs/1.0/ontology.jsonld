  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#TraceLevel"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Se registra el mejor valor en cada iteración del bucle principal."
  }, {
    "@language" : "en",
    "@value" : "The best value is recorded at every iteration of the main loop."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Iteration trace"
  }, {
    "@language" : "es",
    "@value" : "Traza por iteración"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#Iterations",
