  "@id" : "https://w3id.org/ontologies-ULL/CO-META#hasDefaultValue",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Valor que se usa para un valor de parámetro que no indica ni un valor ni una referencia."
  }, {
    "@language" : "en",
    "@value" : "Value used for a parameter value that states neither a value nor a reference."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#Parameter"
