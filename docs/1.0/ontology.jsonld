    "@language" : "en",
    "@value" : "has elapsed time"
  }, {
    "@language" : "es",
    "@value" : "tiene tiempo transcurrido"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#double"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#hasEvaluationCount",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Number of evaluations of solutions in the run."
  }, {
    "@language" : "es",
    "@value" : "Número de evaluaciones de soluciones en la repetición."
