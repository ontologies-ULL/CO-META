  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Forma de las soluciones que puede manejar una metaheurística o un componente. Describe un tipo de solución, por lo que no es necesario indicar sus tamaños."
  }, {
    "@language" : "en",
    "@value" : "Shape of the solutions that a metaheuristic or a component can handle. It describes a kind of solution, so its sizes do not need to be stated."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid25"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "admite forma"
  }, {
    "@language" : "en",
    "@value" : "supports shape"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#DataShape"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#usesComponent",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Component used internally by another one, outside the data flow of the algorithm: e.g. the neighbourhood that a local search explores or from which a perturbation takes its moves."
  }, {
    "@language" : "es",
    "@value" : "Componente usado internamente por otro, fuera del flujo de datos del algoritmo: p. ej. el vecindario que explora una búsqueda local o del que una perturbación toma sus movimientos."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#MetaheuristicComponent"
