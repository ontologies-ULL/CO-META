    "@id" : "_:genid32"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#hasLowerBound",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Menor valor de un dominio de valores, incluido en él. Si no se indica ni esta ni hasExclusiveLowerBound, no se impone cota inferior."
  }, {
    "@language" : "en",
    "@value" : "Smallest value of a value domain, included in it. If neither it nor hasExclusiveLowerBound is stated, no lower bound is imposed."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#ValueDomain"
  } ],
