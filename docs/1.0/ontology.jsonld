    "@language" : "es",
    "@value" : "Especificación de valor dada por el valor de un parámetro, que solo se conoce para una instancia concreta del problema o una configuración concreta del algoritmo (p. ej., el número de ciudades N)."
  }, {
    "@language" : "en",
    "@value" : "Value specification given by the value of a parameter, which is only known for a specific problem instance or algorithm configuration (e.g. the number of cities N)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Parameter Reference"
  }, {
    "@language" : "es",
    "@value" : "Referencia a parámetro"
  } ],
