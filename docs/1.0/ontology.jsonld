  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#nonNegativeInteger"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#hasExclusiveLowerBound",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Valor del que todos los valores de un dominio de valores son mayores, sin alcanzarlo. Un dominio de valores tiene como mucho una cota inferior, inclusiva (hasLowerBound) o exclusiva."
  }, {
    "@language" : "en",
    "@value" : "Value that every value of a value domain is greater than, without reaching it. A value domain has at most one lower bound, inclusive (hasLowerBound) or exclusive."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#ValueDomain"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has exclusive lower bound"
  }, {
    "@language" : "es",
    "@value" : "tiene cota inferior exclusiva"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#ValueSpecification"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#hasExclusiveUpperBound",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Valor del que todos los valores de un dominio de valores son menores, sin alcanzarlo. Un dominio de valores tiene como mucho una cota superior, inclusiva (hasUpperBound) o exclusiva."
  }, {
    "@language" : "en",
    "@value" : "Value that every value of a value domain is less than, without reaching it. A value domain has at most one upper bound, inclusive (hasUpperBound) or exclusive."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#ValueDomain"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has exclusive upper bound"
  }, {
    "@language" : "es",
    "@value" : "tiene cota superior exclusiva"
  } ],
