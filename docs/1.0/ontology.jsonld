    "@type" : "http://www.w3.org/2001/XMLSchema#integer",
    "@value" : "50"
  } ],
  "https://w3id.org/ontologies-ULL/CO-META#hasValueDomain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#NonNegativeIntegers"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#PositiveIntegers",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#ValueDomain"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Dominio de valores con los enteros mayores o iguales que 1 (p. ej., un número de ciudades)."
  }, {
    "@language" : "en",
    "@value" : "Value domain of the integers greater than or equal to 1 (e.g. a number of cities)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Enteros positivos"
