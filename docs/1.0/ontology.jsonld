    "@id" : "https://w3id.org/ontologies-ULL/CO-META#ValueSpecification"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#hasInlineValue",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Los valores escritos en JSON: un número, un array, un array de arrays (matriz), un objeto de arrays o un array de objetos (tabla)."
  }, {
    "@language" : "en",
    "@value" : "The values written in JSON: a number, an array, an array of arrays (matrix), an object of arrays or an array of objects (table)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#DataBinding"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
