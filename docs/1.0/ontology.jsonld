  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#PartiallyMappedCrossoverComponent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Componente de cruce para permutaciones que intercambia un segmento entre los progenitores y repara las posiciones restantes mediante la correspondencia definida por dicho segmento (PMX)."
  }, {
    "@language" : "en",
    "@value" : "Crossover component for permutations that exchanges a segment between parents and repairs the remaining positions using the mapping defined by that segment (PMX)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Componente de cruce parcialmente mapeado"
  }, {
    "@language" : "en",
    "@value" : "Partially Mapped Crossover Component"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#CrossoverComponent"
  }, {
    "@id" : "_:genid143"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#PenaltyHandling",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#ConstraintHandling"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "La violación ponderada de las restricciones se suma al objetivo que se minimiza."
  }, {
    "@language" : "en",
    "@value" : "The weighted violation of the constraints is added to the objective to minimize."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Penalización"
  }, {
    "@language" : "en",
    "@value" : "Penalty"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#PermutationVariable",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Decision variable made up of an ordering of values without repetitions. When its length equals the number of possible values it is a complete permutation (e.g. the tour through the cities in the TSP); otherwise it is a partial permutation. It is inferred from the shape, so it does not need to be asserted."
  }, {
    "@language" : "es",
    "@value" : "Variable de decisión formada por una ordenación de valores sin repeticiones. Cuando su longitud coincide con el número de valores posibles es una permutación completa (p. ej., el recorrido por las ciudades en el TSP); si no, es una permutación parcial. Se deduce de la forma, por lo que no es necesario declararla."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Permutation Variable"
  }, {
    "@language" : "es",
    "@value" : "Variable de permutación"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#DecisionVariable"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid144"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#PersonalBestInfluence",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Peso de la atracción de una partícula hacia la mejor solución que ha encontrado (c1)."
  }, {
    "@language" : "en",
    "@value" : "Weight of the attraction of a particle towards the best solution it has found (c1)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Influencia del mejor personal"
  }, {
    "@language" : "en",
    "@value" : "Personal Best Influence"
  } ],
  "https://w3id.org/ontologies-ULL/CO-META#hasDefaultValue" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#decimal",
    "@value" : "1.5"
  } ],
  "https://w3id.org/ontologies-ULL/CO-META#hasValueDomain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#NonNegativeReals"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#PerturbativeMetaheuristic",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Metaheuristic that starts from complete solutions and iteratively improves them."
  }, {
    "@language" : "es",
    "@value" : "Metaheurística que parte de soluciones completas y las mejora iterativamente."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Metaheurística perturbativa"
  }, {
    "@language" : "en",
    "@value" : "Perturbative Metaheuristic"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid148"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#PheromoneAddition",
