    "@value" : "is feasible"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#boolean"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#isHard",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Si una solución que viola la restricción es no factible (true, por defecto) o solo se penaliza (false)."
  }, {
    "@language" : "en",
    "@value" : "Whether a solution that violates the constraint is infeasible (true, the default) or only penalized (false)."
