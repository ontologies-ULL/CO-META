}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#hasCodeReference",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Clave de una implementación del componente en un programa que ejecuta metaheurísticas (p. ej. \"cometa:swap-mutation\"). Selecciona esa implementación de forma explícita; si no se indica, se usa la clase más específica del componente."
  }, {
    "@language" : "en",
    "@value" : "Key of an implementation of the component in a program that runs metaheuristics (e.g. \"cometa:swap-mutation\"). It selects that implementation explicitly; without it, the most specific class of the component is used."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#MetaheuristicComponent"
