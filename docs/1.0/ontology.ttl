[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :BoolParameter
                :FloatParameter
                :IntegerParameter
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :Column
                :InputParameter
                :Table
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :ComponentSafety
                :DataStructure
                :Metaheuristic
                :MetaheuristicComponent
                :Parameter
                :ParameterValue
                :Problem
                :ProblemElement
                :SolutionEncoding
                :SolutionNode
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :Constraint
                :Objective
                :ProblemQuantity
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :ListVariable
                :MatrixVariable
                :PermutationVariable
                :ScalarVariable
              )
] .


