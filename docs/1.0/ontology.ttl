@prefix : <https://w3id.org/ontologies-ULL/CO-META#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/ontologies-ULL/CO-META#> .

<https://w3id.org/ontologies-ULL/CO-META> rdf:type owl:Ontology ;
                                           owl:versionIRI <https://w3id.org/ontologies-ULL/CO-META/1.0> ;
                                           <http://creativecommons.org/ns#license> <http://creativecommons.org/licenses/by-nc-sa/4.0/> ;
                                           <http://purl.org/dc/elements/1.1/creator> "Eduardo Segredo (https://orcid.org/0000-0002-4085-4356)" ,
                                                                                     "Gara Miranda Valladares (http://orcid.org/0000-0002-2181-0067)" ,
                                                                                     "Iván Castilla Rodríguez (http://orcid.org/0000-0003-3933-2582)" ,
                                                                                     "Miguel Luna García (http://orcid.org/0009-0006-6611-4360)" ;
                                           <http://purl.org/dc/elements/1.1/description> "Ontology for Combinatory Optimization Metaheuristics"@en ,
                                                                                         "Ontología para Metaheurísticas de Optimización Combinatoria"@es ;
                                           <http://purl.org/dc/elements/1.1/source> <https://github.com/ontologies-ULL/CO-META> ;
                                           <http://purl.org/dc/terms/abstract> "Esta ontología proporciona un marco estructurado para la interoperabilidad de fuentes de datos y aplicaciones en el contexto de las metaheurísticas de optimización combinatoria."@es ,
                                                                               "This ontology provides a structured framework for the interoperability of data sources and applications in the context of combinatory optimization metaheuristics."@en ;
                                           rdfs:label "CO-META"@en ,
                                                      "CO-META"@es .

#################################################################
#    Annotation properties
#################################################################

###  http://creativecommons.org/ns#license
<http://creativecommons.org/ns#license> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/creator
<http://purl.org/dc/elements/1.1/creator> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/description
<http://purl.org/dc/elements/1.1/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/source
<http://purl.org/dc/elements/1.1/source> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/abstract
<http://purl.org/dc/terms/abstract> rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/ontologies-ULL/CO-META#hasCodification
:hasCodification rdf:type owl:ObjectProperty ;
                 owl:inverseOf :isCodificationOf ;
                 rdfs:domain [ rdf:type owl:Class ;
                               owl:unionOf ( :Metaheuristic
                                             :Problem
                                           )
                             ] ;
                 rdfs:range :SolutionEncoding .


###  https://w3id.org/ontologies-ULL/CO-META#hasColumn
:hasColumn rdf:type owl:ObjectProperty ;
           rdfs:domain :NamedColumnTable ;
           rdfs:range :Column ;
           rdfs:comment "Relaciona una tabla con cada uno de los atributos que describen sus registros."@es ,
                        "Relates a table to each of the attributes that describe its records."@en ;
           rdfs:label "has column"@en ,
                      "tiene columna"@es .


###  https://w3id.org/ontologies-ULL/CO-META#hasColumnCount
:hasColumnCount rdf:type owl:ObjectProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain [ rdf:type owl:Class ;
                              owl:unionOf ( :MatrixTable
                                            :MatrixVariable
                                          )
                            ] ;
                rdfs:range :InputParameter ;
                rdfs:comment "Input parameter whose value is the second dimension of a matrix of data or of decision variables. Alternative to hasFixedColumnCount."@en ,
                             "Parámetro de entrada cuyo valor es la segunda dimensión de una matriz de datos o de variables de decisión. Alternativa a hasFixedColumnCount."@es ;
                rdfs:label "has column count"@en ,
                           "tiene número de columnas"@es .


###  https://w3id.org/ontologies-ULL/CO-META#hasConstraint
:hasConstraint rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf :hasProblemElement ;
               owl:inverseOf :isConstraintOf ;
               rdfs:domain :Problem ;
               rdfs:range :Constraint .


###  https://w3id.org/ontologies-ULL/CO-META#hasDataStructure
:hasDataStructure rdf:type owl:ObjectProperty ;
                  rdfs:domain :Metaheuristic ;
                  rdfs:range :DataStructure .


###  https://w3id.org/ontologies-ULL/CO-META#hasInput
:hasInput rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf :isConnectedTo ;
          owl:inverseOf :hasOutput .


###  https://w3id.org/ontologies-ULL/CO-META#hasInputEnd
:hasInputEnd rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf :hasInput ;
             owl:inverseOf :hasOutputEnd .


###  https://w3id.org/ontologies-ULL/CO-META#hasInputStart
:hasInputStart rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf :hasInput ;
               owl:inverseOf :hasOutputStart .


###  https://w3id.org/ontologies-ULL/CO-META#hasLength
:hasLength rdf:type owl:ObjectProperty ,
                    owl:FunctionalProperty ;
           rdfs:domain [ rdf:type owl:Class ;
                         owl:unionOf ( :ListVariable
                                       :PermutationVariable
                                     )
                       ] ;
           rdfs:range :InputParameter ;
           rdfs:comment "Input parameter whose value is the number of elements of a sequence of decision variables. Alternative to hasFixedLength."@en ,
                        "Parámetro de entrada cuyo valor es el número de elementos de una secuencia de variables de decisión. Alternativa a hasFixedLength."@es ;
           rdfs:label "has length"@en ,
                      "tiene longitud"@es .


###  https://w3id.org/ontologies-ULL/CO-META#hasNodeType
:hasNodeType rdf:type owl:ObjectProperty ;
             rdfs:domain :SolutionEncoding ;
             rdfs:range :SolutionNode .


###  https://w3id.org/ontologies-ULL/CO-META#hasObjective
:hasObjective rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf :hasProblemElement ;
              owl:inverseOf :isObjectiveOf ;
              rdfs:domain :Problem ;
              rdfs:range :Objective .


###  https://w3id.org/ontologies-ULL/CO-META#hasOutput
:hasOutput rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf :isConnectedTo ;
           rdfs:domain :MetaheuristicComponent ;
           rdfs:range :MetaheuristicComponent .


###  https://w3id.org/ontologies-ULL/CO-META#hasOutputEnd
:hasOutputEnd rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf :hasOutput ;
              rdfs:domain :LoopComponent .


###  https://w3id.org/ontologies-ULL/CO-META#hasOutputStart
:hasOutputStart rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf :hasOutput ;
                rdfs:range :LoopComponent .


###  https://w3id.org/ontologies-ULL/CO-META#hasParameter
:hasParameter rdf:type owl:ObjectProperty ;
              owl:inverseOf :isParameterOf ;
              rdfs:domain :MetaheuristicComponent ;
              rdfs:range :ParameterValue .


###  https://w3id.org/ontologies-ULL/CO-META#hasProblemElement
:hasProblemElement rdf:type owl:ObjectProperty ;
                   rdfs:domain :Problem ;
                   rdfs:range :ProblemElement ;
                   rdfs:comment "Relaciona un problema con cada uno de los constituyentes de su formulación: datos, variables de decisión, objetivos y restricciones."@es ,
                                "Relates a problem to each of the constituents of its formulation: data, decision variables, objectives and constraints."@en ;
                   rdfs:label "has problem element"@en ,
                              "tiene elemento del problema"@es .


###  https://w3id.org/ontologies-ULL/CO-META#hasRowCount
:hasRowCount rdf:type owl:ObjectProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain [ rdf:type owl:Class ;
                           owl:unionOf ( :MatrixVariable
                                         :Table
                                       )
                         ] ;
             rdfs:range :InputParameter ;
             rdfs:comment "Input parameter whose value is the number of entities described by a table, or the first dimension of a matrix of decision variables. Alternative to hasFixedRowCount."@en ,
                          "Parámetro de entrada cuyo valor es el número de entidades que describe una tabla, o la primera dimensión de una matriz de variables de decisión. Alternativa a hasFixedRowCount."@es ;
             rdfs:label "has row count"@en ,
                        "tiene número de filas"@es .


###  https://w3id.org/ontologies-ULL/CO-META#hasSafety
:hasSafety rdf:type owl:ObjectProperty ;
           rdfs:domain :MetaheuristicComponent ;
           rdfs:range :ComponentSafety .


###  https://w3id.org/ontologies-ULL/CO-META#hasStart
:hasStart rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf :isConnectedTo ;
          owl:inverseOf :isStartOf ;
          rdfs:domain :Metaheuristic ;
          rdfs:range :MetaheuristicComponent .


###  https://w3id.org/ontologies-ULL/CO-META#hasType
:hasType rdf:type owl:ObjectProperty ,
                  owl:FunctionalProperty ;
         rdfs:domain :ParameterValue ;
         rdfs:range :Parameter .


###  https://w3id.org/ontologies-ULL/CO-META#hasValueType
:hasValueType rdf:type owl:ObjectProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :DecisionVariable ;
              rdfs:range :ValueType ;
              rdfs:comment "Dominio numérico (enteros o reales) al que pertenecen los valores que puede tomar una variable de decisión."@es ,
                           "Numeric domain (integers or reals) to which the values a decision variable can take belong."@en ;
              rdfs:label "has value type"@en ,
                         "tiene tipo de valor"@es .


###  https://w3id.org/ontologies-ULL/CO-META#isCodificationOf
:isCodificationOf rdf:type owl:ObjectProperty .


###  https://w3id.org/ontologies-ULL/CO-META#isConnectedTo
:isConnectedTo rdf:type owl:ObjectProperty ,
                        owl:TransitiveProperty ;
               owl:propertyChainAxiom ( :hasOutput
                                        :isConnectedTo
                                      ) .


###  https://w3id.org/ontologies-ULL/CO-META#isConstraintOf
:isConstraintOf rdf:type owl:ObjectProperty .


###  https://w3id.org/ontologies-ULL/CO-META#isObjectiveOf
:isObjectiveOf rdf:type owl:ObjectProperty .


###  https://w3id.org/ontologies-ULL/CO-META#isParameterOf
:isParameterOf rdf:type owl:ObjectProperty .


###  https://w3id.org/ontologies-ULL/CO-META#isStartOf
:isStartOf rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf :isConnectedTo .


###  https://w3id.org/ontologies-ULL/CO-META#readsData
:readsData rdf:type owl:ObjectProperty ;
           rdfs:domain :MetaheuristicComponent ;
           rdfs:range :DataStructure .


###  https://w3id.org/ontologies-ULL/CO-META#writesData
:writesData rdf:type owl:ObjectProperty ;
            rdfs:domain :DataHandlerComponent ;
            rdfs:range :DataStructure .


#################################################################
#    Data properties
#################################################################

###  https://w3id.org/ontologies-ULL/CO-META#hasCodeReference
:hasCodeReference rdf:type owl:DatatypeProperty ;
                  rdfs:domain :MetaheuristicComponent ;
                  rdfs:range xsd:string .


###  https://w3id.org/ontologies-ULL/CO-META#hasFixedColumnCount
:hasFixedColumnCount rdf:type owl:DatatypeProperty ,
                              owl:FunctionalProperty ;
                     rdfs:domain [ rdf:type owl:Class ;
                                   owl:unionOf ( :MatrixTable
                                                 :MatrixVariable
                                               )
                                 ] ;
                     rdfs:range xsd:integer ;
                     rdfs:comment "Fixed second dimension of a matrix of data or of decision variables. Alternative to hasColumnCount."@en ,
                                  "Segunda dimensión fija de una matriz de datos o de variables de decisión. Alternativa a hasColumnCount."@es ;
                     rdfs:label "has fixed column count"@en ,
                                "tiene número fijo de columnas"@es .


###  https://w3id.org/ontologies-ULL/CO-META#hasFixedLength
:hasFixedLength rdf:type owl:DatatypeProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain [ rdf:type owl:Class ;
                              owl:unionOf ( :ListVariable
                                            :PermutationVariable
                                          )
                            ] ;
                rdfs:range xsd:integer ;
                rdfs:comment "Fixed number of elements of a sequence of decision variables. Alternative to hasLength."@en ,
                             "Número fijo de elementos de una secuencia de variables de decisión. Alternativa a hasLength."@es ;
                rdfs:label "has fixed length"@en ,
                           "tiene longitud fija"@es .


###  https://w3id.org/ontologies-ULL/CO-META#hasFixedRowCount
:hasFixedRowCount rdf:type owl:DatatypeProperty ,
                           owl:FunctionalProperty ;
                  rdfs:domain [ rdf:type owl:Class ;
                                owl:unionOf ( :MatrixVariable
                                              :Table
                                            )
                              ] ;
                  rdfs:range xsd:integer ;
                  rdfs:comment "Fixed number of entities described by a table, or fixed first dimension of a matrix of decision variables. Alternative to hasRowCount."@en ,
                               "Número fijo de entidades que describe una tabla, o primera dimensión fija de una matriz de variables de decisión. Alternativa a hasRowCount."@es ;
                  rdfs:label "has fixed row count"@en ,
                             "tiene número fijo de filas"@es .


###  https://w3id.org/ontologies-ULL/CO-META#hasIdentifier
:hasIdentifier rdf:type owl:DatatypeProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain :ProblemQuantity ;
               rdfs:range xsd:string ;
               rdfs:comment "Name that identifies a quantity unambiguously within the problem formulation."@en ,
                            "Nombre que identifica de forma unívoca una magnitud dentro de la formulación del problema."@es ;
               rdfs:label "has identifier"@en ,
                          "tiene identificador"@es .


###  https://w3id.org/ontologies-ULL/CO-META#hasInputSize
:hasInputSize rdf:type owl:DatatypeProperty ;
              rdfs:domain :MetaheuristicComponent ;
              rdfs:range xsd:integer .


###  https://w3id.org/ontologies-ULL/CO-META#hasLatexExpression
:hasLatexExpression rdf:type owl:DatatypeProperty ,
                             owl:FunctionalProperty ;
                    rdfs:domain [ rdf:type owl:Class ;
                                  owl:unionOf ( :Constraint
                                                :Objective
                                              )
                                ] ;
                    rdfs:range xsd:string ;
                    rdfs:comment "Expresión LaTeX de un objetivo o de una restricción. En las restricciones incluye el comparador y el cuantificador universal, si lo hay."@es ,
                                 "LaTeX expression of an objective or constraint. For constraints it includes the comparator and the universal quantifier, if any."@en ;
                    rdfs:label "has LaTeX expression"@en ,
                               "tiene expresión LaTeX"@es .


###  https://w3id.org/ontologies-ULL/CO-META#hasLatexSymbol
:hasLatexSymbol rdf:type owl:DatatypeProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain :ProblemQuantity ;
                rdfs:range xsd:string ;
                rdfs:comment "Mathematical notation, written in LaTeX, that represents a quantity in the objective and constraint expressions (e.g. \"x\" or \"v\")."@en ,
                             "Notación matemática, escrita en LaTeX, que representa una magnitud en las expresiones de los objetivos y las restricciones (p. ej. \"x\" o \"v\")."@es ;
                rdfs:label "has LaTeX symbol"@en ,
                           "tiene símbolo LaTeX"@es .


###  https://w3id.org/ontologies-ULL/CO-META#hasLowerBound
:hasLowerBound rdf:type owl:DatatypeProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain :DecisionVariable ;
               rdfs:range xsd:double ;
               rdfs:comment "Menor valor que puede tomar una variable de decisión. Se usa xsd:double para poder expresar -INF (sin cota inferior)."@es ,
                            "Smallest value a decision variable may take. xsd:double is used so that -INF (no lower bound) can be expressed."@en ;
               rdfs:label "has lower bound"@en ,
                          "tiene cota inferior"@es .


###  https://w3id.org/ontologies-ULL/CO-META#hasOutputSize
:hasOutputSize rdf:type owl:DatatypeProperty ;
               rdfs:domain :MetaheuristicComponent ;
               rdfs:range xsd:integer .


###  https://w3id.org/ontologies-ULL/CO-META#hasPosition
:hasPosition rdf:type owl:DatatypeProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain :Column ;
             rdfs:range xsd:integer ;
             rdfs:comment "Posición de un atributo en el orden en que se describen los registros de su tabla."@es ,
                          "Position of an attribute in the order in which the records of its table are described."@en ;
             rdfs:label "has position"@en ,
                        "tiene posición"@es .


###  https://w3id.org/ontologies-ULL/CO-META#hasSize
:hasSize rdf:type owl:DatatypeProperty ,
                  owl:FunctionalProperty ;
         rdfs:domain :SolutionEncoding ;
         rdfs:range xsd:integer .


###  https://w3id.org/ontologies-ULL/CO-META#hasUpperBound
:hasUpperBound rdf:type owl:DatatypeProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain :DecisionVariable ;
               rdfs:range xsd:double ;
               rdfs:comment "Largest value a decision variable may take. xsd:double is used so that INF (no upper bound) can be expressed."@en ,
                            "Mayor valor que puede tomar una variable de decisión. Se usa xsd:double para poder expresar INF (sin cota superior)."@es ;
               rdfs:label "has upper bound"@en ,
                          "tiene cota superior"@es .


###  https://w3id.org/ontologies-ULL/CO-META#hasValue
:hasValue rdf:type owl:DatatypeProperty ,
                   owl:FunctionalProperty ;
          rdfs:domain :ParameterValue .


###  https://w3id.org/ontologies-ULL/CO-META#hasWeight
:hasWeight rdf:type owl:DatatypeProperty ,
                    owl:FunctionalProperty ;
           rdfs:domain :Objective ;
           rdfs:range xsd:double ;
           rdfs:comment "Importancia relativa de un objetivo cuando se agrega con otros objetivos en una única función."@es ,
                        "Relative importance of an objective when it is aggregated with other objectives into a single function."@en ;
           rdfs:label "has weight"@en ,
                      "tiene peso"@es .


###  https://w3id.org/ontologies-ULL/CO-META#isImplicit
:isImplicit rdf:type owl:DatatypeProperty ,
                     owl:FunctionalProperty ;
            rdfs:domain :InputParameter ;
            rdfs:range xsd:boolean ;
            rdfs:comment "Indica que el parámetro de entrada no se declaró explícitamente como dato del problema, sino que surgió al usarse como tamaño de una tabla."@es ,
                         "Indicates that the input parameter was not explicitly declared as problem data, but arose from its use as the size of a table."@en ;
            rdfs:label "es implícito"@es ,
                       "is implicit"@en .


###  https://w3id.org/ontologies-ULL/CO-META#maxValue
:maxValue rdf:type owl:DatatypeProperty ;
          rdfs:domain :Parameter ;
          rdfs:range xsd:decimal .


###  https://w3id.org/ontologies-ULL/CO-META#minValue
:minValue rdf:type owl:DatatypeProperty ;
          rdfs:domain :Parameter ;
          rdfs:range xsd:decimal .


#################################################################
#    Classes
#################################################################

###  https://w3id.org/ontologies-ULL/CO-META#AcceptanceComponent
:AcceptanceComponent rdf:type owl:Class ;
                     rdfs:subClassOf :MetaheuristicComponent ;
                     rdfs:comment "Component that accepts one solution out of two or more candidate solutions according to their fitness. In multiobjective optimization it requires a preceding fitness assignment component."@en ,
                                  "Componente que acepta una solución entre dos o más soluciones candidatas según su aptitud. En optimización multiobjetivo requiere un componente de asignación de aptitud previo."@es ;
                     rdfs:label "Acceptance Component"@en ,
                                "Componente de aceptación"@es .


###  https://w3id.org/ontologies-ULL/CO-META#Bit
:Bit rdf:type owl:Class ;
     rdfs:subClassOf :SolutionNode ;
     rdfs:comment "Nodo de solución que toma un valor binario (0 o 1)."@es ,
                  "Solution node that takes a binary value (0 or 1)."@en ;
     rdfs:label "Bit"@en ,
                "Bit"@es .


###  https://w3id.org/ontologies-ULL/CO-META#BoolParameter
:BoolParameter rdf:type owl:Class ;
               rdfs:subClassOf :Parameter ;
               rdfs:comment "Parameter whose value is a boolean (true or false)."@en ,
                            "Parámetro cuyo valor es un booleano (verdadero o falso)."@es ;
               rdfs:label "Boolean Parameter"@en ,
                          "Parámetro booleano"@es .


###  https://w3id.org/ontologies-ULL/CO-META#Column
:Column rdf:type owl:Class ;
        rdfs:subClassOf :ProblemData ;
        rdfs:comment "Atributo de las entidades descritas por una tabla. Equivale a un vector de datos con un valor por registro (p. ej., el peso de cada objeto)."@es ,
                     "Attribute of the entities described by a table. It is equivalent to a vector of data with one value per record (e.g. the weight of each item)."@en ;
        rdfs:label "Column"@en ,
                   "Columna"@es .


###  https://w3id.org/ontologies-ULL/CO-META#ComponentSafety
:ComponentSafety rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Class ;
                                       owl:oneOf ( :Both
                                                   :Safe
                                                   :Unsafe
                                                 )
                                     ] ;
                 rdfs:comment "Enumeración (Safe, Unsafe, Both) que indica si un componente metaheurístico garantiza que las soluciones que produce son factibles, puede producir soluciones no factibles o admite ambos comportamientos."@es ,
                              "Enumeration (Safe, Unsafe, Both) that indicates whether a metaheuristic component guarantees that the solutions it produces are feasible, may produce infeasible solutions, or supports both behaviours."@en ;
                 rdfs:label "Component Safety"@en ,
                            "Seguridad del componente"@es .


###  https://w3id.org/ontologies-ULL/CO-META#CompositeEncoding
:CompositeEncoding rdf:type owl:Class ;
                   rdfs:subClassOf :SolutionEncoding ;
                   rdfs:comment "Solución codificada como una combinación de varias codificaciones, cada una de las cuales representa una parte distinta de la solución."@es ,
                                "Solution encoded as a combination of several encodings, each of which represents a different part of the solution."@en ;
                   rdfs:label "Codificación compuesta"@es ,
                              "Composite Encoding"@en .


###  https://w3id.org/ontologies-ULL/CO-META#Constraint
:Constraint rdf:type owl:Class ;
            rdfs:subClassOf :ProblemElement ;
            rdfs:comment "Condición que debe cumplir una solución de un problema de optimización para ser factible."@es ,
                         "Condition that a solution of an optimization problem must satisfy in order to be feasible."@en ;
            rdfs:label "Constraint"@en ,
                       "Restricción"@es .


###  https://w3id.org/ontologies-ULL/CO-META#ConstructionComponent
:ConstructionComponent rdf:type owl:Class ;
                       rdfs:subClassOf :MetaheuristicComponent ;
                       rdfs:comment "Component that constructs a solution or a group of solutions step by step using heuristic methods."@en ,
                                    "Componente que construye una solución o un grupo de soluciones paso a paso mediante métodos heurísticos."@es ;
                       rdfs:label "Componente de construcción"@es ,
                                  "Construction Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#ConstructiveMetaheuristic
:ConstructiveMetaheuristic rdf:type owl:Class ;
                           owl:equivalentClass [ owl:intersectionOf ( :Metaheuristic
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty :isConnectedTo ;
                                                                        owl:someValuesFrom :ConstructionComponent
                                                                      ]
                                                                    ) ;
                                                 rdf:type owl:Class
                                               ] ;
                           rdfs:comment "Metaheuristic that builds solutions incrementally."@en ,
                                        "Metaheurística que construye soluciones de forma incremental."@es ;
                           rdfs:label "Constructive Metaheuristic"@en ,
                                      "Metaheurística constructiva"@es .


###  https://w3id.org/ontologies-ULL/CO-META#CrossoverComponent
:CrossoverComponent rdf:type owl:Class ;
                    rdfs:subClassOf :ModificationComponent ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :hasParameter ;
                                      owl:someValuesFrom [ rdf:type owl:Restriction ;
                                                           owl:onProperty :hasType ;
                                                           owl:hasValue :CrossoverProbability
                                                         ]
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :hasInputSize ;
                                      owl:hasValue 2
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :hasOutputSize ;
                                      owl:hasValue 2
                                    ] ;
                    rdfs:comment "Componente de modificación que produce uno o más individuos descendientes recombinando dos o más individuos progenitores. Tiene un parámetro de probabilidad de cruce."@es ,
                                 "Modification component that produces one or more offspring individuals by recombining two or more parent individuals. It has a crossover probability parameter."@en ;
                    rdfs:label "Componente de cruce"@es ,
                               "Crossover Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#Custom
:Custom rdf:type owl:Class ;
        rdfs:subClassOf :SolutionNode ;
        rdfs:comment "Nodo de solución cuyo tipo de valor está definido por el usuario y no corresponde a ninguno de los tipos de nodo predefinidos."@es ,
                     "Solution node whose value type is user-defined and does not correspond to any of the predefined node types."@en ;
        rdfs:label "Custom Node"@en ,
                   "Nodo personalizado"@es .


###  https://w3id.org/ontologies-ULL/CO-META#DataHandlerComponent
:DataHandlerComponent rdf:type owl:Class ;
                      rdfs:subClassOf :MetaheuristicComponent ;
                      rdfs:comment "Component that updates specific data structures used by the algorithm."@en ,
                                   "Componente que actualiza estructuras de datos específicas utilizadas por el algoritmo."@es ;
                      rdfs:label "Componente manejador de datos"@es ,
                                 "Data Handler Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#DataStructure
:DataStructure rdf:type owl:Class ;
               rdfs:comment "Data structure that stores information used by the algorithm during its execution."@en ,
                            "Estructura de datos que almacena información utilizada por el algoritmo durante su ejecución."@es ;
               rdfs:label "Data Structure"@en ,
                          "Estructura de datos"@es .


###  https://w3id.org/ontologies-ULL/CO-META#DecisionVariable
:DecisionVariable rdf:type owl:Class ;
                  rdfs:subClassOf :ProblemQuantity ;
                  owl:disjointWith :ProblemData ;
                  rdfs:comment "Magnitud cuyo valor elige el método de resolución. Una asignación de valores a todas las variables de decisión del problema constituye una solución candidata."@es ,
                               "Quantity whose value is chosen by the solution method. An assignment of values to all the decision variables of a problem is a candidate solution."@en ;
                  rdfs:label "Decision Variable"@en ,
                             "Variable de decisión"@es .


###  https://w3id.org/ontologies-ULL/CO-META#DiversityPreservationComponent
:DiversityPreservationComponent rdf:type owl:Class ;
                                rdfs:subClassOf :MultiobjectiveComponent ;
                                rdfs:comment "Componente multiobjetivo que ajusta los valores de aptitud para fomentar la diversidad en la población."@es ,
                                             "Multiobjective component that adjusts fitness values to encourage diversity in the population."@en ;
                                rdfs:label "Componente de preservación de la diversidad"@es ,
                                           "Diversity Preservation Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#EvolutionaryAlgorithm
:EvolutionaryAlgorithm rdf:type owl:Class ;
                       owl:equivalentClass [ owl:intersectionOf ( :PopulationBasedMetaheuristic
                                                                  [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                                           owl:onProperty :isConnectedTo ;
                                                                                           owl:someValuesFrom :CrossoverComponent
                                                                                         ]
                                                                                         [ rdf:type owl:Restriction ;
                                                                                           owl:onProperty :isConnectedTo ;
                                                                                           owl:someValuesFrom :SelectionComponent
                                                                                         ]
                                                                                         [ rdf:type owl:Restriction ;
                                                                                           owl:onProperty :isConnectedTo ;
                                                                                           owl:someValuesFrom :VariationComponent
                                                                                         ]
                                                                                       ) ;
                                                                    rdf:type owl:Class
                                                                  ]
                                                                ) ;
                                             rdf:type owl:Class
                                           ] ;
                       rdfs:comment "Metaheuristic based on evolutionary algorithms, employing selection, crossover and variation processes."@en ,
                                    "Metaheurística basada en algoritmos evolutivos, utilizando procesos de selección, cruce y variación."@es ;
                       rdfs:label "Algoritmo evolutivo"@es ,
                                  "Evolutionary Algorithm"@en .


###  https://w3id.org/ontologies-ULL/CO-META#FitnessAssignmentComponent
:FitnessAssignmentComponent rdf:type owl:Class ;
                            rdfs:subClassOf :MultiobjectiveComponent ;
                            rdfs:comment "Componente multiobjetivo que asigna un valor de aptitud individual a cada miembro de una población."@es ,
                                         "Multiobjective component that assigns a single fitness value to each member of a population."@en ;
                            rdfs:label "Componente de asignación de aptitud"@es ,
                                       "Fitness Assignment Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#FloatParameter
:FloatParameter rdf:type owl:Class ;
                rdfs:subClassOf :Parameter ;
                rdfs:comment "Parameter whose value is a real (decimal) number."@en ,
                             "Parámetro cuyo valor es un número real (decimal)."@es ;
                rdfs:label "Float Parameter"@en ,
                           "Parámetro real"@es .


###  https://w3id.org/ontologies-ULL/CO-META#GenerationComponent
:GenerationComponent rdf:type owl:Class ;
                     rdfs:subClassOf :MetaheuristicComponent ;
                     rdfs:comment "Component that generates an initial solution or an initial population."@en ,
                                  "Componente que genera una solución inicial o una población inicial."@es ;
                     rdfs:label "Componente de generación"@es ,
                                "Generation Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#InputParameter
:InputParameter rdf:type owl:Class ;
                rdfs:subClassOf :ProblemData ;
                rdfs:comment "Dato escalar que caracteriza una instancia del problema (p. ej., la capacidad de la mochila o el número de ciudades)."@es ,
                             "Scalar datum that characterizes an instance of the problem (e.g. the capacity of the knapsack or the number of cities)."@en ;
                rdfs:label "Input Parameter"@en ,
                           "Parámetro de entrada"@es .


###  https://w3id.org/ontologies-ULL/CO-META#Integer
:Integer rdf:type owl:Class ;
         rdfs:subClassOf :SolutionNode ;
         rdfs:comment "Nodo de solución que toma un valor entero."@es ,
                      "Solution node that takes an integer value."@en ;
         rdfs:label "Integer Node"@en ,
                    "Nodo entero"@es .


###  https://w3id.org/ontologies-ULL/CO-META#IntegerParameter
:IntegerParameter rdf:type owl:Class ;
                  rdfs:subClassOf :Parameter ;
                  rdfs:comment "Parameter whose value is an integer number."@en ,
                               "Parámetro cuyo valor es un número entero."@es ;
                  rdfs:label "Integer Parameter"@en ,
                             "Parámetro entero"@es .


###  https://w3id.org/ontologies-ULL/CO-META#IterativeSelectionComponent
:IterativeSelectionComponent rdf:type owl:Class ;
                             rdfs:subClassOf :SelectionComponent ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty :hasOutputSize ;
                                               owl:hasValue 1
                                             ] ;
                             rdfs:comment "Componente de selección que selecciona un único individuo en cada invocación, por lo que se aplica repetidamente para seleccionar varios individuos."@es ,
                                          "Selection component that selects a single individual per invocation, so it is applied repeatedly to select several individuals."@en ;
                             rdfs:label "Componente de selección iterativa"@es ,
                                        "Iterative Selection Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#KPointCrossoverComponent
:KPointCrossoverComponent rdf:type owl:Class ;
                          rdfs:subClassOf :CrossoverComponent ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty :hasParameter ;
                                            owl:someValuesFrom [ rdf:type owl:Restriction ;
                                                                 owl:onProperty :hasType ;
                                                                 owl:hasValue :CrossoverKPoints
                                                               ]
                                          ] ;
                          rdfs:comment "Componente de cruce que divide a los progenitores en k puntos de corte e intercambia los segmentos resultantes. Tiene un parámetro para el número de puntos de corte."@es ,
                                       "Crossover component that splits the parents at k cut points and exchanges the resulting segments. It has a parameter for the number of cut points."@en ;
                          rdfs:label "Componente de cruce de k puntos"@es ,
                                     "K-Point Crossover Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#ListEncoding
:ListEncoding rdf:type owl:Class ;
              rdfs:subClassOf :SolutionEncoding ;
              rdfs:comment "Solución codificada como una secuencia ordenada de nodos que puede contener valores repetidos."@es ,
                           "Solution encoded as an ordered sequence of nodes that may contain repeated values."@en ;
              rdfs:label "Codificación de lista"@es ,
                         "List Encoding"@en .


###  https://w3id.org/ontologies-ULL/CO-META#ListVariable
:ListVariable rdf:type owl:Class ;
              rdfs:subClassOf :DecisionVariable ,
                              [ rdf:type owl:Class ;
                                owl:unionOf ( [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                       owl:onProperty :hasLength ;
                                                                       owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                     ]
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty :hasFixedLength ;
                                                                       owl:maxCardinality "0"^^xsd:nonNegativeInteger
                                                                     ]
                                                                   ) ;
                                                rdf:type owl:Class
                                              ]
                                              [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                       owl:onProperty :hasLength ;
                                                                       owl:maxCardinality "0"^^xsd:nonNegativeInteger
                                                                     ]
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty :hasFixedLength ;
                                                                       owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                     ]
                                                                   ) ;
                                                rdf:type owl:Class
                                              ]
                                            )
                              ] ;
              rdfs:comment "Decision variable that represents a sequence of values, one per element of a collection, which may be repeated (e.g. whether each item is put in the knapsack)."@en ,
                           "Variable de decisión que representa una secuencia de valores, uno por elemento de una colección, que pueden repetirse (p. ej., si cada objeto se mete en la mochila)."@es ;
              rdfs:label "List Variable"@en ,
                         "Variable de lista"@es .


###  https://w3id.org/ontologies-ULL/CO-META#LocalSearchComponent
:LocalSearchComponent rdf:type owl:Class ;
                      rdfs:subClassOf :ModificationComponent ;
                      rdfs:comment "Componente de modificación que mejora la aptitud de una solución explorando su vecindario."@es ,
                                   "Modification component that improves the fitness of a solution by exploring its neighbourhood."@en ;
                      rdfs:label "Componente de búsqueda local"@es ,
                                 "Local Search Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#LocalSearchMetaheuristic
:LocalSearchMetaheuristic rdf:type owl:Class ;
                          owl:equivalentClass [ owl:intersectionOf ( :Metaheuristic
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty :isConnectedTo ;
                                                                       owl:someValuesFrom :GenerationComponent
                                                                     ]
                                                                   ) ;
                                                rdf:type owl:Class
                                              ] ;
                          rdfs:comment "Metaheuristic that starts from complete solutions and iteratively improves them."@en ,
                                       "Metaheurística que parte de soluciones completas y las mejora iterativamente."@es ;
                          rdfs:label "Local Search Metaheuristic"@en ,
                                     "Metaheurística de búsqueda local"@es .


###  https://w3id.org/ontologies-ULL/CO-META#LoopComponent
:LoopComponent rdf:type owl:Class ;
               rdfs:subClassOf :MetaheuristicComponent ;
               rdfs:comment "Component that creates loops to iterate through data structures or to repeat processes until a condition is met. It has two additional properties: hasOutputStart and hasOutputEnd."@en ,
                            "Componente que crea bucles para recorrer estructuras de datos o repetir procesos hasta que se cumple una condición. Tiene dos propiedades adicionales: hasOutputStart y hasOutputEnd."@es ;
               rdfs:label "Componente de bucle"@es ,
                          "Loop Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#MatrixEncoding
:MatrixEncoding rdf:type owl:Class ;
                rdfs:subClassOf :SolutionEncoding ;
                rdfs:comment "Solución codificada como una disposición bidimensional de nodos organizados en filas y columnas."@es ,
                             "Solution encoded as a two-dimensional arrangement of nodes organized in rows and columns."@en ;
                rdfs:label "Codificación matricial"@es ,
                           "Matrix Encoding"@en .


###  https://w3id.org/ontologies-ULL/CO-META#MatrixTable
:MatrixTable rdf:type owl:Class ;
             rdfs:subClassOf :Table ,
                             [ rdf:type owl:Class ;
                               owl:unionOf ( [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                      owl:onProperty :hasColumnCount ;
                                                                      owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                    ]
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty :hasFixedColumnCount ;
                                                                      owl:maxCardinality "0"^^xsd:nonNegativeInteger
                                                                    ]
                                                                  ) ;
                                               rdf:type owl:Class
                                             ]
                                             [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                      owl:onProperty :hasColumnCount ;
                                                                      owl:maxCardinality "0"^^xsd:nonNegativeInteger
                                                                    ]
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty :hasFixedColumnCount ;
                                                                      owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                    ]
                                                                  ) ;
                                               rdf:type owl:Class
                                             ]
                                           )
                             ] ;
             rdfs:comment "Tabla cuyos registros se describen mediante atributos anónimos de la misma naturaleza, de modo que los datos forman una matriz (p. ej., una matriz de distancias entre ciudades)."@es ,
                          "Table whose records are described by anonymous attributes of the same nature, so that the data form a matrix (e.g. a distance matrix between cities)."@en ;
             rdfs:label "Matrix Table"@en ,
                        "Tabla matricial"@es .


###  https://w3id.org/ontologies-ULL/CO-META#MatrixVariable
:MatrixVariable rdf:type owl:Class ;
                rdfs:subClassOf :DecisionVariable ,
                                [ rdf:type owl:Class ;
                                  owl:unionOf ( [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                         owl:onProperty :hasColumnCount ;
                                                                         owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                       ]
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty :hasFixedColumnCount ;
                                                                         owl:maxCardinality "0"^^xsd:nonNegativeInteger
                                                                       ]
                                                                     ) ;
                                                  rdf:type owl:Class
                                                ]
                                                [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                         owl:onProperty :hasColumnCount ;
                                                                         owl:maxCardinality "0"^^xsd:nonNegativeInteger
                                                                       ]
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty :hasFixedColumnCount ;
                                                                         owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                       ]
                                                                     ) ;
                                                  rdf:type owl:Class
                                                ]
                                              )
                                ] ,
                                [ rdf:type owl:Class ;
                                  owl:unionOf ( [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                         owl:onProperty :hasRowCount ;
                                                                         owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                       ]
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty :hasFixedRowCount ;
                                                                         owl:maxCardinality "0"^^xsd:nonNegativeInteger
                                                                       ]
                                                                     ) ;
                                                  rdf:type owl:Class
                                                ]
                                                [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                         owl:onProperty :hasRowCount ;
                                                                         owl:maxCardinality "0"^^xsd:nonNegativeInteger
                                                                       ]
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty :hasFixedRowCount ;
                                                                         owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                       ]
                                                                     ) ;
                                                  rdf:type owl:Class
                                                ]
                                              )
                                ] ;
                rdfs:comment "Decision variable that represents a value for each pair of elements of two collections (e.g. whether each vehicle visits each customer)."@en ,
                             "Variable de decisión que representa un valor para cada par de elementos de dos colecciones (p. ej., si cada vehículo visita a cada cliente)."@es ;
                rdfs:label "Matrix Variable"@en ,
                           "Variable matricial"@es .


###  https://w3id.org/ontologies-ULL/CO-META#MaximizationObjective
:MaximizationObjective rdf:type owl:Class ;
                       rdfs:subClassOf :Objective ;
                       owl:disjointWith :MinimizationObjective ;
                       rdfs:comment "Objective of an optimization problem whose value must be maximized."@en ,
                                    "Objetivo de un problema de optimización cuyo valor debe maximizarse."@es ;
                       rdfs:label "Maximization Objective"@en ,
                                  "Objetivo de maximización"@es .


###  https://w3id.org/ontologies-ULL/CO-META#MemeticAlgorithm
:MemeticAlgorithm rdf:type owl:Class ;
                  owl:equivalentClass [ owl:intersectionOf ( :EvolutionaryAlgorithm
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty :isConnectedTo ;
                                                               owl:someValuesFrom :LocalSearchComponent
                                                             ]
                                                           ) ;
                                        rdf:type owl:Class
                                      ] ;
                  rdfs:comment "Algoritmo evolutivo que además utiliza procesos de búsqueda local."@es ,
                               "Evolutionary algorithm that employs local search processes."@en ;
                  rdfs:label "Algoritmo memético"@es ,
                             "Memetic Algorithm"@en .


###  https://w3id.org/ontologies-ULL/CO-META#Metaheuristic
:Metaheuristic rdf:type owl:Class ;
               rdfs:comment "High-level algorithmic procedure, composed of interconnected metaheuristic components, that finds sufficiently good solutions to optimization problems by searching through vast solution spaces."@en ,
                            "Procedimiento algorítmico de alto nivel, compuesto por componentes metaheurísticos interconectados, que encuentran soluciones suficientemente buenas a problemas de optimización mediante búsquedas en amplios espacios de soluciones."@es ;
               rdfs:label "Metaheuristic"@en ,
                          "Metaheurística"@es .


###  https://w3id.org/ontologies-ULL/CO-META#MetaheuristicComponent
:MetaheuristicComponent rdf:type owl:Class ;
                        rdfs:comment "Bloque constructivo de una metaheurística que realiza una tarea específica y se conecta con otros componentes."@es ,
                                     "Building block of a metaheuristic that performs a specific task and is connected to other components."@en ;
                        rdfs:label "Componente metaheurístico"@es ,
                                   "Metaheuristic Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#MinimizationObjective
:MinimizationObjective rdf:type owl:Class ;
                       rdfs:subClassOf :Objective ;
                       rdfs:comment "Objective of an optimization problem whose value must be minimized."@en ,
                                    "Objetivo de un problema de optimización cuyo valor debe minimizarse."@es ;
                       rdfs:label "Minimization Objective"@en ,
                                  "Objetivo de minimización"@es .


###  https://w3id.org/ontologies-ULL/CO-META#ModificationComponent
:ModificationComponent rdf:type owl:Class ;
                       rdfs:subClassOf :MetaheuristicComponent ;
                       rdfs:comment "Component that modifies a solution or a population."@en ,
                                    "Componente que modifica una solución o una población."@es ;
                       rdfs:label "Componente de modificación"@es ,
                                  "Modification Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#MultiobjectiveComponent
:MultiobjectiveComponent rdf:type owl:Class ;
                         rdfs:subClassOf :MetaheuristicComponent ;
                         rdfs:comment "Component used in multiobjective optimization. It is required before acceptance components."@en ,
                                      "Componente utilizado en optimización multiobjetivo. Es necesario antes de los componentes de aceptación."@es ;
                         rdfs:label "Componente multiobjetivo"@es ,
                                    "Multiobjective Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#NamedColumnTable
:NamedColumnTable rdf:type owl:Class ;
                  rdfs:subClassOf :Table ;
                  rdfs:comment "Tabla cuyos registros se describen mediante atributos distintos y con nombre (p. ej., las coordenadas X e Y de cada ciudad)."@es ,
                               "Table whose records are described by distinct, named attributes (e.g. the X and Y coordinates of each city)."@en ;
                  rdfs:label "Named Column Table"@en ,
                             "Tabla de columnas con nombre"@es .


###  https://w3id.org/ontologies-ULL/CO-META#NeighbourhoodComponent
:NeighbourhoodComponent rdf:type owl:Class ;
                        rdfs:subClassOf :ModificationComponent ;
                        rdfs:comment "Componente de modificación que genera soluciones vecinas de una solución dada aplicando un operador de movimiento."@es ,
                                     "Modification component that generates neighbouring solutions of a given solution by applying a move operator."@en ;
                        rdfs:label "Componente de vecindario"@es ,
                                   "Neighbourhood Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#Objective
:Objective rdf:type owl:Class ;
           rdfs:subClassOf :ProblemElement ;
           rdfs:comment "Objective of an optimization problem. This class should not be instantiated directly; its subclasses should be used instead."@en ,
                        "Objetivo de un problema de optimización. Esta clase no debe instanciarse directamente; deben usarse sus subclases."@es ;
           rdfs:label "Objective"@en ,
                      "Objetivo"@es .


###  https://w3id.org/ontologies-ULL/CO-META#Parameter
:Parameter rdf:type owl:Class ;
           rdfs:comment "Define la estructura de un parámetro utilizado por un componente, como su tipo y su rango de valores válidos."@es ,
                        "Defines the structure of a parameter used by a component, such as its type and its valid range of values."@en ;
           rdfs:label "Parameter"@en ,
                      "Parámetro"@es .


###  https://w3id.org/ontologies-ULL/CO-META#ParameterValue
:ParameterValue rdf:type owl:Class ;
                rdfs:comment "Valor asignado a un parámetro para un componente concreto."@es ,
                             "Value assigned to a parameter for a specific component."@en ;
                rdfs:label "Parameter Value"@en ,
                           "Valor de parámetro"@es .


###  https://w3id.org/ontologies-ULL/CO-META#PartiallyMappedCrossoverComponent
:PartiallyMappedCrossoverComponent rdf:type owl:Class ;
                                   rdfs:subClassOf :CrossoverComponent ;
                                   rdfs:comment "Componente de cruce para permutaciones que intercambia un segmento entre los progenitores y repara las posiciones restantes mediante la correspondencia definida por dicho segmento (PMX)."@es ,
                                                "Crossover component for permutations that exchanges a segment between parents and repairs the remaining positions using the mapping defined by that segment (PMX)."@en ;
                                   rdfs:label "Componente de cruce parcialmente mapeado"@es ,
                                              "Partially Mapped Crossover Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#PermutationEncoding
:PermutationEncoding rdf:type owl:Class ;
                     rdfs:subClassOf :SolutionEncoding ;
                     rdfs:comment "Solución codificada como una ordenación de elementos distintos, sin repeticiones."@es ,
                                  "Solution encoded as an ordered arrangement of distinct elements, without repetitions."@en ;
                     rdfs:label "Codificación de permutación"@es ,
                                "Permutation Encoding"@en .


###  https://w3id.org/ontologies-ULL/CO-META#PermutationVariable
:PermutationVariable rdf:type owl:Class ;
                     rdfs:subClassOf :DecisionVariable ,
                                     [ rdf:type owl:Class ;
                                       owl:unionOf ( [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                              owl:onProperty :hasLength ;
                                                                              owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                            ]
                                                                            [ rdf:type owl:Restriction ;
                                                                              owl:onProperty :hasFixedLength ;
                                                                              owl:maxCardinality "0"^^xsd:nonNegativeInteger
                                                                            ]
                                                                          ) ;
                                                       rdf:type owl:Class
                                                     ]
                                                     [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                              owl:onProperty :hasLength ;
                                                                              owl:maxCardinality "0"^^xsd:nonNegativeInteger
                                                                            ]
                                                                            [ rdf:type owl:Restriction ;
                                                                              owl:onProperty :hasFixedLength ;
                                                                              owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                            ]
                                                                          ) ;
                                                       rdf:type owl:Class
                                                     ]
                                                   )
                                     ] ;
                     rdfs:comment "Decision variable that represents an ordering of the elements of a collection, in which each element appears exactly once (e.g. the tour through the cities in the TSP)."@en ,
                                  "Variable de decisión que representa un orden de los elementos de una colección, en el que cada elemento aparece exactamente una vez (p. ej., el recorrido por las ciudades en el TSP)."@es ;
                     rdfs:label "Permutation Variable"@en ,
                                "Variable de permutación"@es .


###  https://w3id.org/ontologies-ULL/CO-META#PopulationBasedMetaheuristic
:PopulationBasedMetaheuristic rdf:type owl:Class ;
                              owl:equivalentClass [ owl:intersectionOf ( :Metaheuristic
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty :isConnectedTo ;
                                                                           owl:someValuesFrom [ rdf:type owl:Class ;
                                                                                                owl:unionOf ( :PopulationConstructionComponent
                                                                                                              :PopulationGenerationComponent
                                                                                                            )
                                                                                              ]
                                                                         ]
                                                                       ) ;
                                                    rdf:type owl:Class
                                                  ] ;
                              owl:disjointWith :SingleSolutionMetaheuristic ;
                              rdfs:comment "Metaheuristic that works with a population of solutions."@en ,
                                           "Metaheurística que trabaja con una población de soluciones."@es ;
                              rdfs:label "Metaheurística basada en población"@es ,
                                         "Population Based Metaheuristic"@en .


###  https://w3id.org/ontologies-ULL/CO-META#PopulationConstructionComponent
:PopulationConstructionComponent rdf:type owl:Class ;
                                 owl:equivalentClass [ owl:intersectionOf ( :ConstructionComponent
                                                                            [ rdf:type owl:Restriction ;
                                                                              owl:onProperty :hasParameter ;
                                                                              owl:someValuesFrom [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
