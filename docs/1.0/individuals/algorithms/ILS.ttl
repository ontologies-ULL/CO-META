@prefix CO-META: <https://w3id.org/ontologies-ULL/CO-META#> .
@base <https://w3id.org/ontologies-ULL/CO-META#> .

<https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/ILS> rdf:type owl:Ontology ;
                                                                      owl:imports <https://w3id.org/ontologies-ULL/CO-META> ;
                                                                      rdfs:label "CO-META individuals for Iterated Local Search"@en .

#################################################################
#    Individuals
#################################################################

###  https://w3id.org/ontologies-ULL/CO-META#ILS_acceptance
CO-META:ILS_acceptance rdf:type owl:NamedIndividual ,
                                CO-META:AcceptanceComponent ;
                       CO-META:hasOutput CO-META:ILS_stop .


###  https://w3id.org/ontologies-ULL/CO-META#ILS_generate
CO-META:ILS_generate rdf:type owl:NamedIndividual ,
                              CO-META:GenerationComponent ;
                     CO-META:hasOutputStart CO-META:ILS_stop ;
                     CO-META:hasParameter CO-META:ILS_parameter_populationsize .


###  https://w3id.org/ontologies-ULL/CO-META#ILS_localsearch
CO-META:ILS_localsearch rdf:type owl:NamedIndividual ,
                                 CO-META:LocalSearchComponent ;
                        CO-META:hasOutput CO-META:ILS_acceptance .


###  https://w3id.org/ontologies-ULL/CO-META#ILS_parameter_iterations
CO-META:ILS_parameter_iterations rdf:type owl:NamedIndividual ,
                                          CO-META:ParameterValue ;
                                 CO-META:hasType CO-META:Iterations ;
                                 CO-META:hasValue 1000 .


###  https://w3id.org/ontologies-ULL/CO-META#ILS_parameter_populationsize
CO-META:ILS_parameter_populationsize rdf:type owl:NamedIndividual ,
                                              CO-META:ParameterValue ;
                                     CO-META:hasType CO-META:PopulationSize ;
                                     CO-META:hasValue 1 .


###  https://w3id.org/ontologies-ULL/CO-META#ILS_perturbation
CO-META:ILS_perturbation rdf:type owl:NamedIndividual ,
                                  CO-META:VariationComponent ;
                         CO-META:hasOutput CO-META:ILS_localsearch .


###  https://w3id.org/ontologies-ULL/CO-META#ILS_stop
CO-META:ILS_stop rdf:type owl:NamedIndividual ,
                          CO-META:StoppingCriterionComponent ;
                 CO-META:hasOutput CO-META:ILS_acceptance ,
                                   CO-META:ILS_perturbation ;
                 CO-META:hasParameter CO-META:ILS_parameter_iterations .


###  https://w3id.org/ontologies-ULL/CO-META#IteratedLocalSearch
CO-META:IteratedLocalSearch rdf:type owl:NamedIndividual ,
                                     CO-META:Metaheuristic ;
                            CO-META:hasStart CO-META:ILS_generate .


