<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/ontologies-ULL/CO-META#"
     xml:base="https://w3id.org/ontologies-ULL/CO-META"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:ns="http://creativecommons.org/ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:qudt="http://qudt.org/schema/qudt/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:CO-META="https://w3id.org/ontologies-ULL/CO-META#">
    <owl:Ontology rdf:about="https://w3id.org/ontologies-ULL/CO-META">
        <owl:versionIRI rdf:resource="https://w3id.org/ontologies-ULL/CO-META/1.0"/>
        <owl:imports rdf:resource="https://w3id.org/ontologies-ULL/CO-META/imports/qudt"/>
        <owl:imports rdf:resource="https://w3id.org/ontologies-ULL/CO-META/imports/qudt-units"/>
        <ns:license rdf:resource="http://creativecommons.org/licenses/by-nc-sa/4.0/"/>
        <dc:creator>Eduardo Segredo (https://orcid.org/0000-0002-4085-4356)</dc:creator>
        <dc:creator>Gara Miranda Valladares (http://orcid.org/0000-0002-2181-0067)</dc:creator>
        <dc:creator>Iván Castilla Rodríguez (http://orcid.org/0000-0003-3933-2582)</dc:creator>
        <dc:creator>Miguel Luna García (http://orcid.org/0009-0006-6611-4360)</dc:creator>
        <dc:description xml:lang="en">Ontology for Combinatorial Optimization Metaheuristics</dc:description>
        <dc:description xml:lang="es">Ontología para Metaheurísticas de Optimización Combinatoria</dc:description>
        <dc:source rdf:resource="https://github.com/ontologies-ULL/CO-META"/>
        <terms:abstract xml:lang="es">Esta ontología proporciona un marco estructurado para la interoperabilidad de fuentes de datos y aplicaciones en el contexto de las metaheurísticas de optimización combinatoria.</terms:abstract>
        <terms:abstract xml:lang="en">This ontology provides a structured framework for the interoperability of data sources and applications in the context of combinatorial optimization metaheuristics.</terms:abstract>
        <rdfs:label xml:lang="en">CO-META</rdfs:label>
        <rdfs:label xml:lang="es">CO-META</rdfs:label>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://creativecommons.org/ns#license -->


    <owl:AnnotationProperty rdf:about="http://creativecommons.org/ns#license"/>
    


    <!-- http://purl.org/dc/elements/1.1/creator -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/creator"/>
    


    <!-- http://purl.org/dc/elements/1.1/description -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/description"/>
    


    <!-- http://purl.org/dc/elements/1.1/source -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/source"/>
    


    <!-- http://purl.org/dc/terms/abstract -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/abstract"/>
    


    <!-- http://qudt.org/schema/qudt/unit -->


    <owl:AnnotationProperty rdf:about="http://qudt.org/schema/qudt/unit"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/ontologies-ULL/CO-META#hasBaseType -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/CO-META#hasBaseType">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ValueDomain"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/CO-META#BaseType"/>
        <rdfs:comment xml:lang="es">Conjunto numérico al que pertenecen los valores de un dominio de valores.</rdfs:comment>
        <rdfs:comment xml:lang="en">Number set to which the values of a value domain belong.</rdfs:comment>
        <rdfs:label xml:lang="en">has base type</rdfs:label>
        <rdfs:label xml:lang="es">tiene tipo base</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#hasCandidateInput -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/CO-META#hasCandidateInput">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasInput"/>
        <owl:inverseOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasCandidateOutput"/>
        <rdfs:comment xml:lang="es">Entrada de un componente con las soluciones nuevas que juzgar o añadir (p. ej. descendientes).</rdfs:comment>
        <rdfs:comment xml:lang="en">Input of a component that holds the new solutions to judge or add (e.g. offspring).</rdfs:comment>
        <rdfs:label xml:lang="en">has candidate input</rdfs:label>
        <rdfs:label xml:lang="es">tiene entrada candidata</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#hasCandidateOutput -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/CO-META#hasCandidateOutput">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasOutput"/>
        <rdfs:comment xml:lang="en">Output that feeds the input of the target component that holds the new solutions to judge or add (e.g. offspring).</rdfs:comment>
        <rdfs:comment xml:lang="es">Salida que alimenta la entrada del componente de destino con las soluciones nuevas que juzgar o añadir (p. ej. descendientes).</rdfs:comment>
        <rdfs:label xml:lang="en">has candidate output</rdfs:label>
        <rdfs:label xml:lang="es">tiene salida candidata</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#hasColumn -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/CO-META#hasColumn">
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/CO-META#TableShape"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/CO-META#Column"/>
        <rdfs:comment xml:lang="es">Relaciona una forma de tabla con cada uno de los atributos que describen sus registros.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a table shape to each of the attributes that describe its records.</rdfs:comment>
        <rdfs:label xml:lang="en">has column</rdfs:label>
        <rdfs:label xml:lang="es">tiene columna</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#hasColumnCount -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/CO-META#hasColumnCount">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/CO-META#MatrixShape"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ValueSpecification"/>
        <rdfs:comment xml:lang="en">Number of columns of a matrix.</rdfs:comment>
        <rdfs:comment xml:lang="es">Número de columnas de una matriz.</rdfs:comment>
        <rdfs:label xml:lang="en">has column count</rdfs:label>
        <rdfs:label xml:lang="es">tiene número de columnas</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#hasComponent -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/CO-META#hasComponent">
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/CO-META#CompositeShape"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/CO-META#DataShape"/>
        <rdfs:comment xml:lang="es">Relaciona una forma compuesta con cada una de las formas que combina.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a composite shape to each of the shapes it combines.</rdfs:comment>
        <rdfs:label xml:lang="en">has component</rdfs:label>
        <rdfs:label xml:lang="es">tiene componente</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#hasConstraint -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/CO-META#hasConstraint">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasProblemElement"/>
        <owl:inverseOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#isConstraintOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/CO-META#Problem"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/CO-META#Constraint"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#hasConstraintHandling -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/CO-META#hasConstraintHandling">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/CO-META#Metaheuristic"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ConstraintHandling"/>
        <rdfs:comment xml:lang="es">Cómo trata una metaheurística las soluciones no factibles.</rdfs:comment>
        <rdfs:comment xml:lang="en">How a metaheuristic deals with infeasible solutions.</rdfs:comment>
        <rdfs:label xml:lang="en">has constraint handling</rdfs:label>
        <rdfs:label xml:lang="es">tiene tratamiento de restricciones</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#hasCurrentInput -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/CO-META#hasCurrentInput">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasInput"/>
        <owl:inverseOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasCurrentOutput"/>
        <rdfs:comment xml:lang="es">Entrada de un componente con la solución o población actual, con la que se juzgan las candidatas.</rdfs:comment>
        <rdfs:comment xml:lang="en">Input of a component that holds the current solution or population, against which candidates are judged.</rdfs:comment>
        <rdfs:label xml:lang="en">has current input</rdfs:label>
        <rdfs:label xml:lang="es">tiene entrada actual</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#hasCurrentOutput -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/CO-META#hasCurrentOutput">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasOutput"/>
        <rdfs:comment xml:lang="en">Output that feeds the input of the target component that holds the current solution or population, against which candidates are judged.</rdfs:comment>
        <rdfs:comment xml:lang="es">Salida que alimenta la entrada del componente de destino con la solución o población actual, con la que se juzgan las candidatas.</rdfs:comment>
        <rdfs:label xml:lang="en">has current output</rdfs:label>
        <rdfs:label xml:lang="es">tiene salida actual</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#hasDataStructure -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/CO-META#hasDataStructure">
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/CO-META#Metaheuristic"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/CO-META#DataStructure"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#hasExclusiveLowerBound -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/CO-META#hasExclusiveLowerBound">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ValueDomain"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ValueSpecification"/>
        <rdfs:comment xml:lang="es">Valor del que todos los valores de un dominio de valores son mayores, sin alcanzarlo. Un dominio de valores tiene como mucho una cota inferior, inclusiva (hasLowerBound) o exclusiva.</rdfs:comment>
        <rdfs:comment xml:lang="en">Value that every value of a value domain is greater than, without reaching it. A value domain has at most one lower bound, inclusive (hasLowerBound) or exclusive.</rdfs:comment>
        <rdfs:label xml:lang="en">has exclusive lower bound</rdfs:label>
        <rdfs:label xml:lang="es">tiene cota inferior exclusiva</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#hasExclusiveUpperBound -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/CO-META#hasExclusiveUpperBound">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ValueDomain"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ValueSpecification"/>
        <rdfs:comment xml:lang="es">Valor del que todos los valores de un dominio de valores son menores, sin alcanzarlo. Un dominio de valores tiene como mucho una cota superior, inclusiva (hasUpperBound) o exclusiva.</rdfs:comment>
        <rdfs:comment xml:lang="en">Value that every value of a value domain is less than, without reaching it. A value domain has at most one upper bound, inclusive (hasUpperBound) or exclusive.</rdfs:comment>
        <rdfs:label xml:lang="en">has exclusive upper bound</rdfs:label>
        <rdfs:label xml:lang="es">tiene cota superior exclusiva</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#hasInitialValue -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/CO-META#hasInitialValue">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/CO-META#DataStructure"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ValueSpecification"/>
        <rdfs:comment xml:lang="es">Valor de cada elemento de una estructura de datos numérica al empezar el algoritmo.</rdfs:comment>
        <rdfs:comment xml:lang="en">Value of every element of a numeric data structure when the algorithm starts.</rdfs:comment>
        <rdfs:label xml:lang="en">has initial value</rdfs:label>
        <rdfs:label xml:lang="es">tiene valor inicial</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#hasInput -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/CO-META#hasInput">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#isConnectedTo"/>
        <owl:inverseOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasOutput"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#hasInputEnd -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/CO-META#hasInputEnd">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasInput"/>
        <owl:inverseOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasOutputEnd"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#hasInputStart -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/CO-META#hasInputStart">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasInput"/>
        <owl:inverseOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasOutputStart"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#hasLength -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/CO-META#hasLength">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/CO-META#CollectionShape"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ValueSpecification"/>
        <rdfs:comment xml:lang="en">Number of values of a collection.</rdfs:comment>
        <rdfs:comment xml:lang="es">Número de valores de una colección.</rdfs:comment>
        <rdfs:label xml:lang="en">has length</rdfs:label>
        <rdfs:label xml:lang="es">tiene longitud</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#hasLowerBound -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/CO-META#hasLowerBound">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ValueDomain"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ValueSpecification"/>
        <rdfs:comment xml:lang="es">Menor valor de un dominio de valores, incluido en él. Si no se indica ni esta ni hasExclusiveLowerBound, no se impone cota inferior.</rdfs:comment>
        <rdfs:comment xml:lang="en">Smallest value of a value domain, included in it. If neither it nor hasExclusiveLowerBound is stated, no lower bound is imposed.</rdfs:comment>
        <rdfs:label xml:lang="en">has lower bound</rdfs:label>
        <rdfs:label xml:lang="es">tiene cota inferior</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#hasObjective -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/CO-META#hasObjective">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasProblemElement"/>
        <owl:inverseOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#isObjectiveOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/CO-META#Problem"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/CO-META#Objective"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#hasOutput -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/CO-META#hasOutput">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#isConnectedTo"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/CO-META#MetaheuristicComponent"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/CO-META#MetaheuristicComponent"/>
        <rdfs:comment xml:lang="en">Output of a component that feeds the input of another: the data flow from one component to the next.</rdfs:comment>
        <rdfs:comment xml:lang="es">Salida de un componente que alimenta la entrada de otro: el flujo de datos de un componente al siguiente.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#hasOutputEnd -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/CO-META#hasOutputEnd">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasOutput"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/CO-META#LoopComponent"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#hasOutputStart -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/CO-META#hasOutputStart">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasOutput"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/CO-META#LoopComponent"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#hasParameter -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/CO-META#hasParameter">
        <owl:inverseOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#isParameterOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/CO-META#MetaheuristicComponent"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ParameterValue"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#hasProblemElement -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/CO-META#hasProblemElement">
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/CO-META#Problem"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ProblemElement"/>
        <rdfs:comment xml:lang="es">Relaciona un problema con cada uno de los constituyentes de su formulación: datos, variables de decisión, objetivos y restricciones.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a problem to each of the constituents of its formulation: data, decision variables, objectives and constraints.</rdfs:comment>
        <rdfs:label xml:lang="en">has problem element</rdfs:label>
        <rdfs:label xml:lang="es">tiene elemento del problema</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#hasResult -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/CO-META#hasResult">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/CO-META#Metaheuristic"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/CO-META#DataStructure"/>
        <rdfs:comment xml:lang="en">Data structure whose solutions are the result of the metaheuristic. Without it, the result is the best solution found or, with several objectives, the non-dominated solutions found.</rdfs:comment>
        <rdfs:comment xml:lang="es">Estructura de datos cuyas soluciones son el resultado de la metaheurística. Si no se indica, el resultado es la mejor solución encontrada o, con varios objetivos, las soluciones no dominadas encontradas.</rdfs:comment>
        <rdfs:label xml:lang="en">has result</rdfs:label>
        <rdfs:label xml:lang="es">tiene resultado</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#hasRowCount -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/CO-META#hasRowCount">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/CO-META#MatrixShape"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/CO-META#TableShape"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ValueSpecification"/>
        <rdfs:comment xml:lang="en">Number of rows of a matrix, or of records of a table.</rdfs:comment>
        <rdfs:comment xml:lang="es">Número de filas de una matriz, o de registros de una tabla.</rdfs:comment>
        <rdfs:label xml:lang="en">has row count</rdfs:label>
        <rdfs:label xml:lang="es">tiene número de filas</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#hasSafety -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/CO-META#hasSafety">
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/CO-META#MetaheuristicComponent"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ComponentSafety"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#hasShape -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/CO-META#hasShape">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/CO-META#DataStructure"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/CO-META#DecisionVariable"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/CO-META#ProblemData"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/CO-META#DataShape"/>
        <rdfs:comment xml:lang="es">Forma en que se organizan los valores de una magnitud o de una estructura de datos.</rdfs:comment>
        <rdfs:comment xml:lang="en">Shape in which the values of a quantity or of a data structure are organized.</rdfs:comment>
        <rdfs:label xml:lang="en">has shape</rdfs:label>
        <rdfs:label xml:lang="es">tiene forma</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#hasStart -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/CO-META#hasStart">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#isConnectedTo"/>
        <owl:inverseOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#isStartOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/CO-META#Metaheuristic"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/CO-META#MetaheuristicComponent"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#hasType -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/CO-META#hasType">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ParameterValue"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/CO-META#Parameter"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#hasUpperBound -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/CO-META#hasUpperBound">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ValueDomain"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ValueSpecification"/>
        <rdfs:comment xml:lang="en">Largest value of a value domain, included in it. If neither it nor hasExclusiveUpperBound is stated, no upper bound is imposed.</rdfs:comment>
        <rdfs:comment xml:lang="es">Mayor valor de un dominio de valores, incluido en él. Si no se indica ni esta ni hasExclusiveUpperBound, no se impone cota superior.</rdfs:comment>
        <rdfs:label xml:lang="en">has upper bound</rdfs:label>
        <rdfs:label xml:lang="es">tiene cota superior</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#hasValueDomain -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/CO-META#hasValueDomain">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/CO-META#Column"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/CO-META#DataStructure"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/CO-META#DecisionVariable"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/CO-META#InputParameter"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/CO-META#Parameter"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ValueDomain"/>
        <rdfs:comment xml:lang="es">Conjunto de valores que puede tomar una magnitud del problema, una estructura de datos o un parámetro del algoritmo.</rdfs:comment>
        <rdfs:comment xml:lang="en">Set of values that a quantity of the problem, a data structure or a parameter of the algorithm can take.</rdfs:comment>
        <rdfs:label xml:lang="en">has value domain</rdfs:label>
        <rdfs:label xml:lang="es">tiene dominio de valores</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#hasValueReference -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/CO-META#hasValueReference">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ParameterValue"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ParameterReference"/>
        <rdfs:comment xml:lang="es">El valor de parámetro toma el valor de otro (p. ej. un truncamiento conserva tantos individuos como el tamaño de población).</rdfs:comment>
        <rdfs:comment xml:lang="en">The parameter value takes the value of another one (e.g. a truncation keeps as many individuals as the population size).</rdfs:comment>
        <rdfs:label xml:lang="en">has value reference</rdfs:label>
        <rdfs:label xml:lang="es">tiene referencia de valor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#isConnectedTo -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/CO-META#isConnectedTo">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/CO-META#hasOutput"/>
            <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/CO-META#isConnectedTo"/>
        </owl:propertyChainAxiom>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#isConstraintOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/CO-META#isConstraintOf"/>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#isObjectiveOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/CO-META#isObjectiveOf"/>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#isParameterOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/CO-META#isParameterOf"/>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#isStartOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/CO-META#isStartOf">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#isConnectedTo"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#readsData -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/CO-META#readsData">
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/CO-META#MetaheuristicComponent"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/CO-META#DataStructure"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#refersTo -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/CO-META#refersTo">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ParameterReference"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/CO-META#InputParameter"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/CO-META#ParameterValue"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Parameter whose value determines a value specification: an input parameter of the problem or the value of a parameter of the algorithm.</rdfs:comment>
        <rdfs:comment xml:lang="es">Parámetro cuyo valor determina una especificación de valor: un parámetro de entrada del problema o el valor de un parámetro del algoritmo.</rdfs:comment>
        <rdfs:label xml:lang="en">refers to</rdfs:label>
        <rdfs:label xml:lang="es">se refiere a</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#supportsShape -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/CO-META#supportsShape">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/CO-META#Metaheuristic"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/CO-META#MetaheuristicComponent"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/CO-META#DataShape"/>
        <rdfs:comment xml:lang="es">Forma de las soluciones que puede manejar una metaheurística o un componente. Describe un tipo de solución, por lo que no es necesario indicar sus tamaños.</rdfs:comment>
        <rdfs:comment xml:lang="en">Shape of the solutions that a metaheuristic or a component can handle. It describes a kind of solution, so its sizes do not need to be stated.</rdfs:comment>
        <rdfs:label xml:lang="es">admite forma</rdfs:label>
        <rdfs:label xml:lang="en">supports shape</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#usesComponent -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/CO-META#usesComponent">
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/CO-META#MetaheuristicComponent"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/CO-META#MetaheuristicComponent"/>
        <rdfs:comment xml:lang="en">Component used internally by another one, outside the data flow of the algorithm: e.g. the neighbourhood that a local search explores or from which a perturbation takes its moves.</rdfs:comment>
        <rdfs:comment xml:lang="es">Componente usado internamente por otro, fuera del flujo de datos del algoritmo: p. ej. el vecindario que explora una búsqueda local o del que una perturbación toma sus movimientos.</rdfs:comment>
        <rdfs:label xml:lang="es">usa componente</rdfs:label>
        <rdfs:label xml:lang="en">uses component</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#writesData -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/CO-META#writesData">
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/CO-META#DataHandlerComponent"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/CO-META#DataStructure"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/ontologies-ULL/CO-META#hasCodeReference -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontologies-ULL/CO-META#hasCodeReference">
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/CO-META#MetaheuristicComponent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Clave de una implementación del componente en un programa que ejecuta metaheurísticas (p. ej. &quot;cometa:swap-mutation&quot;). Selecciona esa implementación de forma explícita; si no se indica, se usa la clase más específica del componente.</rdfs:comment>
        <rdfs:comment xml:lang="en">Key of an implementation of the component in a program that runs metaheuristics (e.g. &quot;cometa:swap-mutation&quot;). It selects that implementation explicitly; without it, the most specific class of the component is used.</rdfs:comment>
        <rdfs:label xml:lang="en">has code reference</rdfs:label>
        <rdfs:label xml:lang="es">tiene referencia de código</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#hasDefaultValue -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontologies-ULL/CO-META#hasDefaultValue">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/CO-META#Parameter"/>
        <rdfs:comment xml:lang="es">Valor que se usa para un valor de parámetro que no indica ni un valor ni una referencia.</rdfs:comment>
        <rdfs:comment xml:lang="en">Value used for a parameter value that states neither a value nor a reference.</rdfs:comment>
        <rdfs:label xml:lang="en">has default value</rdfs:label>
        <rdfs:label xml:lang="es">tiene valor por defecto</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#hasDimensionIndex -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontologies-ULL/CO-META#hasDimensionIndex">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/CO-META#SolutionSizeReference"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
        <rdfs:comment xml:lang="en">Dimension of the solution whose size is referred to: 1 for the length of a sequence or the rows of a matrix, 2 for the columns of a matrix.</rdfs:comment>
        <rdfs:comment xml:lang="es">Dimensión de la solución cuyo tamaño se referencia: 1 para la longitud de una secuencia o las filas de una matriz, 2 para las columnas de una matriz.</rdfs:comment>
        <rdfs:label xml:lang="en">has dimension index</rdfs:label>
        <rdfs:label xml:lang="es">tiene índice de dimensión</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#hasIdentifier -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontologies-ULL/CO-META#hasIdentifier">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ProblemQuantity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Name that identifies a quantity unambiguously within the problem formulation.</rdfs:comment>
        <rdfs:comment xml:lang="es">Nombre que identifica de forma unívoca una magnitud dentro de la formulación del problema.</rdfs:comment>
        <rdfs:label xml:lang="en">has identifier</rdfs:label>
        <rdfs:label xml:lang="es">tiene identificador</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#hasInputSize -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontologies-ULL/CO-META#hasInputSize">
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/CO-META#MetaheuristicComponent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#hasLatexExpression -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontologies-ULL/CO-META#hasLatexExpression">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/CO-META#Constraint"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/CO-META#Objective"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Expresión LaTeX de un objetivo o de una restricción. En las restricciones incluye el comparador (=, \neq, &lt;, \leq, &gt;, \geq; se admiten cadenas como 0 \leq x_i \leq 1) y el cuantificador universal, si lo hay, antes o después de la condición (\forall i \in S). Los índices empiezan en 1. Un subíndice es un índice (x_i, d_{ij}, X_{x_i}): los términos yuxtapuestos en un subíndice son índices distintos, por lo que un producto en un índice se escribe con \cdot. Una columna de una tabla se indexa por registro (v_i), una matriz por fila y columna (d_{ij}), y los valores de las variables de decisión pueden usarse como índices. Conjuntos: \{a, \ldots, b\}, \{a, b, c\} y \{ i \in S : P(i) \}, con |S| su tamaño. Agregados: \sum, \prod, \min y \max, sobre _{i=a}^{b}, _{i \in S} o _{i \in S : P(i)}. Funciones: \sqrt, \frac, |x|, \lfloor x \rfloor, \lceil x \rceil, \exp, \ln, \log (logaritmo natural), \min(a, b), \max(a, b) y \bmod.</rdfs:comment>
        <rdfs:comment xml:lang="en">LaTeX expression of an objective or constraint. For constraints it includes the comparator (=, \neq, &lt;, \leq, &gt;, \geq; chains such as 0 \leq x_i \leq 1 are allowed) and the universal quantifier, if any, before or after the condition (\forall i \in S). Indices start at 1. A subscript is an index (x_i, d_{ij}, X_{x_i}): juxtaposed terms in a subscript are separate indices, so a product in an index is written with \cdot. A column of a table is indexed by record (v_i), a matrix by row and column (d_{ij}), and values of decision variables can be used as indices. Sets: \{a, \ldots, b\}, \{a, b, c\} and \{ i \in S : P(i) \}, with |S| their size. Aggregates: \sum, \prod, \min and \max, over _{i=a}^{b}, _{i \in S} or _{i \in S : P(i)}. Functions: \sqrt, \frac, |x|, \lfloor x \rfloor, \lceil x \rceil, \exp, \ln, \log (natural logarithm), \min(a, b), \max(a, b) and \bmod.</rdfs:comment>
        <rdfs:label xml:lang="en">has LaTeX expression</rdfs:label>
        <rdfs:label xml:lang="es">tiene expresión LaTeX</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#hasLatexSymbol -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontologies-ULL/CO-META#hasLatexSymbol">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ProblemQuantity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Mathematical notation, written in LaTeX, that represents a quantity in the objective and constraint expressions (e.g. &quot;x&quot; or &quot;v&quot;).</rdfs:comment>
        <rdfs:comment xml:lang="es">Notación matemática, escrita en LaTeX, que representa una magnitud en las expresiones de los objetivos y las restricciones (p. ej. &quot;x&quot; o &quot;v&quot;).</rdfs:comment>
        <rdfs:label xml:lang="en">has LaTeX symbol</rdfs:label>
        <rdfs:label xml:lang="es">tiene símbolo LaTeX</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#hasLiteralValue -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontologies-ULL/CO-META#hasLiteralValue">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/CO-META#LiteralValue"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#double"/>
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#integer"/>
                </owl:unionOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Number given explicitly. xsd:double is used for -INF and INF.</rdfs:comment>
        <rdfs:comment xml:lang="es">Número indicado de forma explícita. Se usa xsd:double para -INF e INF.</rdfs:comment>
        <rdfs:label xml:lang="en">has literal value</rdfs:label>
        <rdfs:label xml:lang="es">tiene valor literal</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#hasOutputSize -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontologies-ULL/CO-META#hasOutputSize">
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/CO-META#MetaheuristicComponent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#hasPosition -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontologies-ULL/CO-META#hasPosition">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/CO-META#Column"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="es">Posición de un atributo en el orden en que se describen los registros de su tabla.</rdfs:comment>
        <rdfs:comment xml:lang="en">Position of an attribute in the order in which the records of its table are described.</rdfs:comment>
        <rdfs:label xml:lang="en">has position</rdfs:label>
        <rdfs:label xml:lang="es">tiene posición</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#hasValue -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontologies-ULL/CO-META#hasValue">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ParameterValue"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#hasWeight -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontologies-ULL/CO-META#hasWeight">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/CO-META#Objective"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment xml:lang="es">Importancia relativa de un objetivo cuando se agrega con otros objetivos en una única función.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relative importance of an objective when it is aggregated with other objectives into a single function.</rdfs:comment>
        <rdfs:label xml:lang="en">has weight</rdfs:label>
        <rdfs:label xml:lang="es">tiene peso</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#isDistinct -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontologies-ULL/CO-META#isDistinct">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/CO-META#CollectionShape"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Indica si los valores de una colección deben ser distintos entre sí.</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates whether the values of a collection must be pairwise different.</rdfs:comment>
        <rdfs:label xml:lang="es">es sin repeticiones</rdfs:label>
        <rdfs:label xml:lang="en">is distinct</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#isImplicit -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontologies-ULL/CO-META#isImplicit">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/CO-META#InputParameter"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Indica que el parámetro de entrada no se declaró explícitamente como dato del problema, sino que surgió al usarse como tamaño de una tabla.</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates that the input parameter was not explicitly declared as problem data, but arose from its use as the size of a table.</rdfs:comment>
        <rdfs:label xml:lang="es">es implícito</rdfs:label>
        <rdfs:label xml:lang="en">is implicit</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#isOrdered -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontologies-ULL/CO-META#isOrdered">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/CO-META#CollectionShape"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Indica si importa la posición de cada valor en una colección.</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates whether the position of each value in a collection matters.</rdfs:comment>
        <rdfs:label xml:lang="es">es ordenada</rdfs:label>
        <rdfs:label xml:lang="en">is ordered</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://qudt.org/schema/qudt/Collection -->


    <owl:Class rdf:about="http://qudt.org/schema/qudt/Collection"/>
    


    <!-- http://qudt.org/schema/qudt/Matrix -->


    <owl:Class rdf:about="http://qudt.org/schema/qudt/Matrix"/>
    


    <!-- http://qudt.org/schema/qudt/MultiSet -->


    <owl:Class rdf:about="http://qudt.org/schema/qudt/MultiSet"/>
    


    <!-- http://qudt.org/schema/qudt/Record -->


    <owl:Class rdf:about="http://qudt.org/schema/qudt/Record"/>
    


    <!-- http://qudt.org/schema/qudt/Sequence -->


    <owl:Class rdf:about="http://qudt.org/schema/qudt/Sequence"/>
    


    <!-- http://qudt.org/schema/qudt/Set -->


    <owl:Class rdf:about="http://qudt.org/schema/qudt/Set"/>
    


    <!-- http://qudt.org/schema/qudt/Table -->


    <owl:Class rdf:about="http://qudt.org/schema/qudt/Table"/>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#AcceptanceComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#AcceptanceComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#MetaheuristicComponent"/>
        <rdfs:comment xml:lang="en">Component that accepts one solution out of two or more candidate solutions according to their fitness. In multiobjective optimization it requires a preceding fitness assignment component.</rdfs:comment>
        <rdfs:comment xml:lang="es">Componente que acepta una solución entre dos o más soluciones candidatas según su aptitud. En optimización multiobjetivo requiere un componente de asignación de aptitud previo.</rdfs:comment>
        <rdfs:label xml:lang="en">Acceptance Component</rdfs:label>
        <rdfs:label xml:lang="es">Componente de aceptación</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#AntConstructionComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#AntConstructionComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ConstructionComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasParameter"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasType"/>
                        <owl:hasValue rdf:resource="https://w3id.org/ontologies-ULL/CO-META#HeuristicInfluence"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasParameter"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasType"/>
                        <owl:hasValue rdf:resource="https://w3id.org/ontologies-ULL/CO-META#PheromoneInfluence"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Componente de construcción que crea cada solución eligiendo el siguiente elemento con probabilidad proporcional a feromona^alfa · heurística^beta, donde las feromonas son la matriz que lee el componente, y alfa y beta sus parámetros de influencia de la feromona y de la heurística.</rdfs:comment>
        <rdfs:comment xml:lang="en">Construction component that builds each solution by choosing the next element with probability proportional to pheromone^alpha · heuristic^beta, where the pheromones are the matrix the component reads, and alpha and beta its pheromone and heuristic influence parameters.</rdfs:comment>
        <rdfs:label xml:lang="en">Ant Construction Component</rdfs:label>
        <rdfs:label xml:lang="es">Componente de construcción por hormigas</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#ArchiveUpdateComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#ArchiveUpdateComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#DataHandlerComponent"/>
        <rdfs:comment xml:lang="en">Data handler that replaces the content of the archive it writes with the solutions it receives, and passes them on.</rdfs:comment>
        <rdfs:comment xml:lang="es">Manejador de datos que sustituye el contenido del archivo que escribe por las soluciones que recibe, y las deja pasar.</rdfs:comment>
        <rdfs:label xml:lang="en">Archive Update Component</rdfs:label>
        <rdfs:label xml:lang="es">Componente de actualización del archivo</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#BaseType -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#BaseType">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/CO-META#Booleans"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/CO-META#Integers"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/CO-META#Reals"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/CO-META#Solutions"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="es">Conjunto en el que se basa un dominio de valores: booleanos, enteros, reales o soluciones candidatas.</rdfs:comment>
        <rdfs:comment xml:lang="en">Set on which a value domain is based: booleans, integers, reals or candidate solutions.</rdfs:comment>
        <rdfs:label xml:lang="en">Base Type</rdfs:label>
        <rdfs:label xml:lang="es">Tipo base</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#BestCandidateAcceptanceComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#BestCandidateAcceptanceComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#AcceptanceComponent"/>
        <rdfs:comment xml:lang="en">Acceptance component that accepts the best candidate even if it is worse than the current solution (as in tabu search).</rdfs:comment>
        <rdfs:comment xml:lang="es">Componente de aceptación que acepta al mejor candidato aunque sea peor que la solución actual (como en la búsqueda tabú).</rdfs:comment>
        <rdfs:label xml:lang="en">Best Candidate Acceptance Component</rdfs:label>
        <rdfs:label xml:lang="es">Componente de aceptación del mejor candidato</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#BestImprovementLocalSearchComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#BestImprovementLocalSearchComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#LocalSearchComponent"/>
        <rdfs:comment xml:lang="es">Componente de búsqueda local que se desplaza al mejor vecino del vecindario que usa mientras mejore.</rdfs:comment>
        <rdfs:comment xml:lang="en">Local search component that moves to the best neighbour of the neighbourhood it uses while it improves.</rdfs:comment>
        <rdfs:label xml:lang="en">Best Improvement Local Search Component</rdfs:label>
        <rdfs:label xml:lang="es">Componente de búsqueda local de mejor mejora</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#BestSolutionsUpdateComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#BestSolutionsUpdateComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#DataHandlerComponent"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#UpdateBestComponent"/>
        <rdfs:comment xml:lang="en">Data handler that keeps in the structure it writes the best solution seen: a single one for a scalar structure, or one per position (e.g. per particle) for a collection.</rdfs:comment>
        <rdfs:comment xml:lang="es">Manejador de datos que conserva en la estructura que escribe la mejor solución vista: una única para una estructura escalar, o una por posición (p. ej. por partícula) para una colección.</rdfs:comment>
        <rdfs:label xml:lang="en">Best Solutions Update Component</rdfs:label>
        <rdfs:label xml:lang="es">Componente de actualización de las mejores soluciones</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#BitFlipMutationComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#BitFlipMutationComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#VariationComponent"/>
        <rdfs:comment xml:lang="es">Componente de variación que cambia cada valor binario con probabilidad 1/n, cambiando al menos uno.</rdfs:comment>
        <rdfs:comment xml:lang="en">Variation component that flips each binary value with probability 1/n, flipping at least one.</rdfs:comment>
        <rdfs:label xml:lang="en">Bit Flip Mutation Component</rdfs:label>
        <rdfs:label xml:lang="es">Componente de mutación por cambio de bit</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#BitFlipNeighbourhoodComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#BitFlipNeighbourhoodComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#NeighbourhoodComponent"/>
        <rdfs:comment xml:lang="en">Neighbourhood of the binary vectors that differ in one position.</rdfs:comment>
        <rdfs:comment xml:lang="es">Vecindario de los vectores binarios que difieren en una posición.</rdfs:comment>
        <rdfs:label xml:lang="en">Bit Flip Neighbourhood Component</rdfs:label>
        <rdfs:label xml:lang="es">Componente de vecindario de cambio de bit</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#BlendCrossoverComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#BlendCrossoverComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#CrossoverComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasParameter"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasType"/>
                        <owl:hasValue rdf:resource="https://w3id.org/ontologies-ULL/CO-META#BlendAlpha"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Componente de cruce para valores reales que obtiene cada valor del descendiente de forma uniforme en el intervalo de los valores de los progenitores ampliado en alfa veces su anchura (BLX-alfa).</rdfs:comment>
        <rdfs:comment xml:lang="en">Crossover component for real values that draws each offspring value uniformly from the interval of the parents&apos; values extended by alpha times its width (BLX-alpha).</rdfs:comment>
        <rdfs:label xml:lang="en">Blend Crossover Component</rdfs:label>
        <rdfs:label xml:lang="es">Componente de cruce por mezcla</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#CollectionShape -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#CollectionShape">
        <rdfs:subClassOf rdf:resource="http://qudt.org/schema/qudt/Collection"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#DataShape"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasLength"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#isDistinct"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#isOrdered"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Forma de una magnitud formada por varios valores de la misma naturaleza, caracterizada por si importa su orden (isOrdered) y si pueden repetirse (isDistinct).</rdfs:comment>
        <rdfs:comment xml:lang="en">Shape of a quantity made up of a number of values of the same kind, characterized by whether their order matters (isOrdered) and whether they can be repeated (isDistinct).</rdfs:comment>
        <rdfs:label xml:lang="en">Collection Shape</rdfs:label>
        <rdfs:label xml:lang="es">Forma de colección</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#Column -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#Column">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ProblemData"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/CO-META#InputParameter"/>
        <rdfs:comment xml:lang="es">Atributo de las entidades descritas por una tabla. Equivale a un vector de datos con un valor por registro (p. ej., el peso de cada objeto).</rdfs:comment>
        <rdfs:comment xml:lang="en">Attribute of the entities described by a table. It is equivalent to a vector of data with one value per record (e.g. the weight of each item).</rdfs:comment>
        <rdfs:label xml:lang="en">Column</rdfs:label>
        <rdfs:label xml:lang="es">Columna</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#ComponentSafety -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#ComponentSafety">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/CO-META#Both"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/CO-META#Safe"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/CO-META#Unsafe"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="es">Enumeración (Safe, Unsafe, Both) que indica si un componente metaheurístico garantiza que las soluciones que produce son factibles, puede producir soluciones no factibles o admite ambos comportamientos.</rdfs:comment>
        <rdfs:comment xml:lang="en">Enumeration (Safe, Unsafe, Both) that indicates whether a metaheuristic component guarantees that the solutions it produces are feasible, may produce infeasible solutions, or supports both behaviours.</rdfs:comment>
        <rdfs:label xml:lang="en">Component Safety</rdfs:label>
        <rdfs:label xml:lang="es">Seguridad del componente</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#CompositeShape -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#CompositeShape">
        <rdfs:subClassOf rdf:resource="http://qudt.org/schema/qudt/Record"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#DataShape"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasComponent"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/CO-META#DataShape"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Forma de una magnitud que combina varias formas, una por componente (p. ej., una solución formada por una permutación y una matriz).</rdfs:comment>
        <rdfs:comment xml:lang="en">Shape of a quantity that combines several shapes, one per component (e.g. a solution made up of a permutation and a matrix).</rdfs:comment>
        <rdfs:label xml:lang="en">Composite Shape</rdfs:label>
        <rdfs:label xml:lang="es">Forma compuesta</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#Constraint -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#Constraint">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ProblemElement"/>
        <rdfs:comment xml:lang="es">Condición que debe cumplir una solución de un problema de optimización para ser factible.</rdfs:comment>
        <rdfs:comment xml:lang="en">Condition that a solution of an optimization problem must satisfy in order to be feasible.</rdfs:comment>
        <rdfs:label xml:lang="en">Constraint</rdfs:label>
        <rdfs:label xml:lang="es">Restricción</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#ConstraintHandling -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#ConstraintHandling">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/CO-META#DeathPenaltyHandling"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/CO-META#FeasibilityFirstHandling"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/CO-META#PenaltyHandling"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/CO-META#RepairHandling"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="es">Cómo trata una metaheurística las soluciones no factibles.</rdfs:comment>
        <rdfs:comment xml:lang="en">How a metaheuristic deals with infeasible solutions.</rdfs:comment>
        <rdfs:label xml:lang="en">Constraint Handling</rdfs:label>
        <rdfs:label xml:lang="es">Tratamiento de restricciones</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#ConstructionComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#ConstructionComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#MetaheuristicComponent"/>
        <rdfs:comment xml:lang="en">Component that constructs a solution or a group of solutions step by step using heuristic methods.</rdfs:comment>
        <rdfs:comment xml:lang="es">Componente que construye una solución o un grupo de soluciones paso a paso mediante métodos heurísticos.</rdfs:comment>
        <rdfs:label xml:lang="es">Componente de construcción</rdfs:label>
        <rdfs:label xml:lang="en">Construction Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#ConstructiveMetaheuristic -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#ConstructiveMetaheuristic">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/CO-META#Metaheuristic"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#isConnectedTo"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ConstructionComponent"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">Metaheuristic that builds solutions incrementally.</rdfs:comment>
        <rdfs:comment xml:lang="es">Metaheurística que construye soluciones de forma incremental.</rdfs:comment>
        <rdfs:label xml:lang="en">Constructive Metaheuristic</rdfs:label>
        <rdfs:label xml:lang="es">Metaheurística constructiva</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#CrossoverComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#CrossoverComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ModificationComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasParameter"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasType"/>
                        <owl:hasValue rdf:resource="https://w3id.org/ontologies-ULL/CO-META#CrossoverProbability"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasSafety"/>
                <owl:hasValue rdf:resource="https://w3id.org/ontologies-ULL/CO-META#Unsafe"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasInputSize"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasOutputSize"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Componente de modificación que produce uno o más individuos descendientes recombinando dos o más individuos progenitores. Tiene un parámetro de probabilidad de cruce.</rdfs:comment>
        <rdfs:comment xml:lang="en">Modification component that produces one or more offspring individuals by recombining two or more parent individuals. It has a crossover probability parameter.</rdfs:comment>
        <rdfs:label xml:lang="es">Componente de cruce</rdfs:label>
        <rdfs:label xml:lang="en">Crossover Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#CrowdingDistanceComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#CrowdingDistanceComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#DiversityPreservationComponent"/>
        <rdfs:comment xml:lang="es">Componente de preservación de la diversidad que mide, dentro de cada frente, el tamaño del cuboide alrededor de cada individuo en el espacio de objetivos.</rdfs:comment>
        <rdfs:comment xml:lang="en">Diversity preservation component that measures, within each front, the size of the cuboid around each individual in objective space.</rdfs:comment>
        <rdfs:label xml:lang="es">Componente de distancia de hacinamiento</rdfs:label>
        <rdfs:label xml:lang="en">Crowding Distance Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#CycleCrossoverComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#CycleCrossoverComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#CrossoverComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#supportsShape"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/CO-META#DistinctSequenceShape"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Componente de cruce para permutaciones que mantiene cada valor en la posición que ocupa en uno de los progenitores, siguiendo los ciclos entre ellos (CX).</rdfs:comment>
        <rdfs:comment xml:lang="en">Crossover component for permutations that keeps each value in the position it has in one of the parents, following the cycles between them (CX).</rdfs:comment>
        <rdfs:label xml:lang="es">Componente de cruce por ciclos</rdfs:label>
        <rdfs:label xml:lang="en">Cycle Crossover Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#DataHandlerComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#DataHandlerComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#MetaheuristicComponent"/>
        <rdfs:comment xml:lang="en">Component that updates specific data structures used by the algorithm.</rdfs:comment>
        <rdfs:comment xml:lang="es">Componente que actualiza estructuras de datos específicas utilizadas por el algoritmo.</rdfs:comment>
        <rdfs:label xml:lang="es">Componente manejador de datos</rdfs:label>
        <rdfs:label xml:lang="en">Data Handler Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#DataShape -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#DataShape">
        <rdfs:comment xml:lang="es">Organización de los valores de una magnitud: un único valor, una colección, una matriz, una tabla o una combinación de ellas. Describe un tipo de datos, no valores concretos. Esta clase no debe instanciarse directamente; deben usarse sus subclases.</rdfs:comment>
        <rdfs:comment xml:lang="en">Organization of the values of a quantity: a single value, a collection, a matrix, a table or a combination of them. It describes a type of data, not specific values. This class should not be instantiated directly; its subclasses should be used instead.</rdfs:comment>
        <rdfs:label xml:lang="en">Data Shape</rdfs:label>
        <rdfs:label xml:lang="es">Forma de datos</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#DataStructure -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#DataStructure">
        <rdfs:comment xml:lang="en">Data structure that stores information used by the algorithm during its execution.</rdfs:comment>
        <rdfs:comment xml:lang="es">Estructura de datos que almacena información utilizada por el algoritmo durante su ejecución.</rdfs:comment>
        <rdfs:label xml:lang="en">Data Structure</rdfs:label>
        <rdfs:label xml:lang="es">Estructura de datos</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#DecisionVariable -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#DecisionVariable">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ProblemQuantity"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ProblemData"/>
        <rdfs:comment xml:lang="es">Magnitud cuyo valor elige el método de resolución. Una asignación de valores a todas las variables de decisión del problema constituye una solución candidata.</rdfs:comment>
        <rdfs:comment xml:lang="en">Quantity whose value is chosen by the solution method. An assignment of values to all the decision variables of a problem is a candidate solution.</rdfs:comment>
        <rdfs:label xml:lang="en">Decision Variable</rdfs:label>
        <rdfs:label xml:lang="es">Variable de decisión</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#DistinctSequenceShape -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#DistinctSequenceShape">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/CO-META#CollectionShape"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#isDistinct"/>
                        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:hasValue>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#isOrdered"/>
                        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:hasValue>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="es">Secuencia cuyos valores no pueden repetirse. Cuando su longitud coincide con el número de valores posibles, es una permutación (p. ej., el recorrido por las ciudades en el TSP).</rdfs:comment>
        <rdfs:comment xml:lang="en">Sequence whose values cannot be repeated. When its length equals the number of possible values, it is a permutation (e.g. the tour through the cities in the TSP).</rdfs:comment>
        <rdfs:label xml:lang="en">Distinct Sequence Shape</rdfs:label>
        <rdfs:label xml:lang="es">Forma de secuencia sin repeticiones</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#DiversityPreservationComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#DiversityPreservationComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#MultiobjectiveComponent"/>
        <rdfs:comment xml:lang="es">Componente multiobjetivo que ajusta los valores de aptitud para fomentar la diversidad en la población.</rdfs:comment>
        <rdfs:comment xml:lang="en">Multiobjective component that adjusts fitness values to encourage diversity in the population.</rdfs:comment>
        <rdfs:label xml:lang="es">Componente de preservación de la diversidad</rdfs:label>
        <rdfs:label xml:lang="en">Diversity Preservation Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#ElementChangeNeighbourhoodComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#ElementChangeNeighbourhoodComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#NeighbourhoodComponent"/>
        <rdfs:comment xml:lang="en">Neighbourhood of the integer vectors obtained by changing the value of one position to another value of its domain.</rdfs:comment>
        <rdfs:comment xml:lang="es">Vecindario de los vectores enteros obtenidos cambiando el valor de una posición por otro valor de su dominio.</rdfs:comment>
        <rdfs:label xml:lang="es">Componente de vecindario de cambio de elemento</rdfs:label>
        <rdfs:label xml:lang="en">Element Change Neighbourhood Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#EvolutionaryAlgorithm -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#EvolutionaryAlgorithm">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/CO-META#PopulationBasedMetaheuristic"/>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#isConnectedTo"/>
                                <owl:someValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/CO-META#CrossoverComponent"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#isConnectedTo"/>
                                <owl:someValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/CO-META#SelectionComponent"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#isConnectedTo"/>
                                <owl:someValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/CO-META#VariationComponent"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">Metaheuristic based on evolutionary algorithms, employing selection, crossover and variation processes.</rdfs:comment>
        <rdfs:comment xml:lang="es">Metaheurística basada en algoritmos evolutivos, utilizando procesos de selección, cruce y variación.</rdfs:comment>
        <rdfs:label xml:lang="es">Algoritmo evolutivo</rdfs:label>
        <rdfs:label xml:lang="en">Evolutionary Algorithm</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#FirstImprovementLocalSearchComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#FirstImprovementLocalSearchComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#LocalSearchComponent"/>
        <rdfs:comment xml:lang="es">Componente de búsqueda local que se desplaza al primer vecino que mejora del vecindario que usa, hasta que ningún vecino mejora.</rdfs:comment>
        <rdfs:comment xml:lang="en">Local search component that moves to the first improving neighbour of the neighbourhood it uses, until no neighbour improves.</rdfs:comment>
        <rdfs:label xml:lang="es">Componente de búsqueda local de primera mejora</rdfs:label>
        <rdfs:label xml:lang="en">First Improvement Local Search Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#FitnessAssignmentComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#FitnessAssignmentComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#MultiobjectiveComponent"/>
        <rdfs:comment xml:lang="es">Componente multiobjetivo que asigna un valor de aptitud individual a cada miembro de una población.</rdfs:comment>
        <rdfs:comment xml:lang="en">Multiobjective component that assigns a single fitness value to each member of a population.</rdfs:comment>
        <rdfs:label xml:lang="es">Componente de asignación de aptitud</rdfs:label>
        <rdfs:label xml:lang="en">Fitness Assignment Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#GaussianMutationComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#GaussianMutationComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#VariationComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasParameter"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasType"/>
                        <owl:hasValue rdf:resource="https://w3id.org/ontologies-ULL/CO-META#MutationStrength"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Componente de variación que suma ruido normal a valores reales, con una desviación típica igual a la intensidad de mutación por la anchura del dominio.</rdfs:comment>
        <rdfs:comment xml:lang="en">Variation component that adds normal noise to real values, with a standard deviation equal to the mutation strength times the width of the domain.</rdfs:comment>
        <rdfs:label xml:lang="es">Componente de mutación gaussiana</rdfs:label>
        <rdfs:label xml:lang="en">Gaussian Mutation Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#GenerationComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#GenerationComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#MetaheuristicComponent"/>
        <rdfs:comment xml:lang="en">Component that generates an initial solution or an initial population.</rdfs:comment>
        <rdfs:comment xml:lang="es">Componente que genera una solución inicial o una población inicial.</rdfs:comment>
        <rdfs:label xml:lang="es">Componente de generación</rdfs:label>
        <rdfs:label xml:lang="en">Generation Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#GeometricCoolingComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#GeometricCoolingComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#DataHandlerComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasParameter"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasType"/>
                        <owl:hasValue rdf:resource="https://w3id.org/ontologies-ULL/CO-META#MaxTemperature"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasParameter"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasType"/>
                        <owl:hasValue rdf:resource="https://w3id.org/ontologies-ULL/CO-META#MinTemperature"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Data handler that lowers the temperature it writes geometrically, from the maximum temperature at the start to the minimum one when the iteration budget of the enclosing stopping criterion is spent.</rdfs:comment>
        <rdfs:comment xml:lang="es">Manejador de datos que reduce de forma geométrica la temperatura que escribe, desde la temperatura máxima al principio hasta la mínima cuando se agota el presupuesto de iteraciones del criterio de parada que lo contiene.</rdfs:comment>
        <rdfs:label xml:lang="es">Componente de enfriamiento geométrico</rdfs:label>
        <rdfs:label xml:lang="en">Geometric Cooling Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#GreedyRandomizedConstructionComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#GreedyRandomizedConstructionComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ConstructionComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasParameter"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasType"/>
                        <owl:hasValue rdf:resource="https://w3id.org/ontologies-ULL/CO-META#RCLRandomness"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Componente de construcción que añade un elemento cada vez, elegido al azar de una lista restringida de candidatos (RCL) construida con la información heurística del problema. Su parámetro de aleatoriedad de la RCL va de puramente voraz (0) a puramente aleatorio (1).</rdfs:comment>
        <rdfs:comment xml:lang="en">Construction component that adds one element at a time, chosen at random from a restricted candidate list (RCL) built from the heuristic information of the problem. Its RCL randomness parameter goes from purely greedy (0) to purely random (1).</rdfs:comment>
        <rdfs:label xml:lang="es">Componente de construcción voraz aleatorizada</rdfs:label>
        <rdfs:label xml:lang="en">Greedy Randomized Construction Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#GreedyRepairComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#GreedyRepairComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#RepairComponent"/>
        <rdfs:comment xml:lang="es">Componente de reparación que cambia, uno cada vez, el valor cuyo cambio más reduce la violación de las restricciones, hasta que la solución es factible.</rdfs:comment>
        <rdfs:comment xml:lang="en">Repair component that changes, one at a time, the value whose change reduces the constraint violation the most, until the solution is feasible.</rdfs:comment>
        <rdfs:label xml:lang="es">Componente de reparación voraz</rdfs:label>
        <rdfs:label xml:lang="en">Greedy Repair Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#ImprovementAcceptanceComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#ImprovementAcceptanceComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#AcceptanceComponent"/>
        <rdfs:comment xml:lang="en">Acceptance component that keeps the best of the current and the candidate solutions; ties favour the candidate.</rdfs:comment>
        <rdfs:comment xml:lang="es">Componente de aceptación que conserva la mejor entre la solución actual y la candidata; en caso de empate, la candidata.</rdfs:comment>
        <rdfs:label xml:lang="es">Componente de aceptación por mejora</rdfs:label>
        <rdfs:label xml:lang="en">Improvement Acceptance Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#InputParameter -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#InputParameter">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ProblemData"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasShape"/>
                <owl:hasValue rdf:resource="https://w3id.org/ontologies-ULL/CO-META#Scalar"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Dato escalar que caracteriza una instancia del problema (p. ej., la capacidad de la mochila o el número de ciudades).</rdfs:comment>
        <rdfs:comment xml:lang="en">Scalar datum that characterizes an instance of the problem (e.g. the capacity of the knapsack or the number of cities).</rdfs:comment>
        <rdfs:label xml:lang="en">Input Parameter</rdfs:label>
        <rdfs:label xml:lang="es">Parámetro de entrada</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#InsertionMutationComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#InsertionMutationComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#VariationComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#supportsShape"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/CO-META#DistinctSequenceShape"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Componente de variación que mueve el valor de una posición aleatoria a otra posición aleatoria de una permutación.</rdfs:comment>
        <rdfs:comment xml:lang="en">Variation component that moves the value of a random position to another random position of a permutation.</rdfs:comment>
        <rdfs:label xml:lang="es">Componente de mutación por inserción</rdfs:label>
        <rdfs:label xml:lang="en">Insertion Mutation Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#InsertionNeighbourhoodComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#InsertionNeighbourhoodComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#NeighbourhoodComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#supportsShape"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/CO-META#DistinctSequenceShape"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Neighbourhood of the permutations obtained by moving a value to another position.</rdfs:comment>
        <rdfs:comment xml:lang="es">Vecindario de las permutaciones obtenidas moviendo un valor a otra posición.</rdfs:comment>
        <rdfs:label xml:lang="es">Componente de vecindario de inserción</rdfs:label>
        <rdfs:label xml:lang="en">Insertion Neighbourhood Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#InversionMutationComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#InversionMutationComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#VariationComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#supportsShape"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/CO-META#DistinctSequenceShape"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Componente de variación que invierte el orden de un segmento aleatorio de una permutación.</rdfs:comment>
        <rdfs:comment xml:lang="en">Variation component that reverses the order of a random segment of a permutation.</rdfs:comment>
        <rdfs:label xml:lang="es">Componente de mutación por inversión</rdfs:label>
        <rdfs:label xml:lang="en">Inversion Mutation Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#IterativeSelectionComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#IterativeSelectionComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#SelectionComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasOutputSize"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Componente de selección que selecciona un único individuo en cada invocación, por lo que se aplica repetidamente para seleccionar varios individuos.</rdfs:comment>
        <rdfs:comment xml:lang="en">Selection component that selects a single individual per invocation, so it is applied repeatedly to select several individuals.</rdfs:comment>
        <rdfs:label xml:lang="es">Componente de selección iterativa</rdfs:label>
        <rdfs:label xml:lang="en">Iterative Selection Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#KPointCrossoverComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#KPointCrossoverComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#CrossoverComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasParameter"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasType"/>
                        <owl:hasValue rdf:resource="https://w3id.org/ontologies-ULL/CO-META#CrossoverKPoints"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Componente de cruce que divide a los progenitores en k puntos de corte e intercambia los segmentos resultantes. Tiene un parámetro para el número de puntos de corte.</rdfs:comment>
        <rdfs:comment xml:lang="en">Crossover component that splits the parents at k cut points and exchanges the resulting segments. It has a parameter for the number of cut points.</rdfs:comment>
        <rdfs:label xml:lang="es">Componente de cruce de k puntos</rdfs:label>
        <rdfs:label xml:lang="en">K-Point Crossover Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#LiteralValue -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#LiteralValue">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ValueSpecification"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasLiteralValue"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Especificación de valor indicada explícitamente como un número (p. ej., 0, 1 o INF).</rdfs:comment>
        <rdfs:comment xml:lang="en">Value specification given explicitly as a number (e.g. 0, 1 or INF).</rdfs:comment>
        <rdfs:label xml:lang="en">Literal Value</rdfs:label>
        <rdfs:label xml:lang="es">Valor literal</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#LocalSearchComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#LocalSearchComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ModificationComponent"/>
        <rdfs:comment xml:lang="es">Componente de modificación que mejora la aptitud de una solución explorando el vecindario que usa.</rdfs:comment>
        <rdfs:comment xml:lang="en">Modification component that improves the fitness of a solution by exploring the neighbourhood it uses.</rdfs:comment>
        <rdfs:label xml:lang="es">Componente de búsqueda local</rdfs:label>
        <rdfs:label xml:lang="en">Local Search Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#LocalSearchMetaheuristic -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#LocalSearchMetaheuristic">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/CO-META#Metaheuristic"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#isConnectedTo"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/CO-META#GenerationComponent"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">Metaheuristic that starts from complete solutions and iteratively improves them.</rdfs:comment>
        <rdfs:comment xml:lang="es">Metaheurística que parte de soluciones completas y las mejora iterativamente.</rdfs:comment>
        <rdfs:label xml:lang="en">Local Search Metaheuristic</rdfs:label>
        <rdfs:label xml:lang="es">Metaheurística de búsqueda local</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#LoopComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#LoopComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#MetaheuristicComponent"/>
        <rdfs:comment xml:lang="en">Component that creates loops to iterate through data structures or to repeat processes until a condition is met. It has two additional properties: hasOutputStart and hasOutputEnd.</rdfs:comment>
        <rdfs:comment xml:lang="es">Componente que crea bucles para recorrer estructuras de datos o repetir procesos hasta que se cumple una condición. Tiene dos propiedades adicionales: hasOutputStart y hasOutputEnd.</rdfs:comment>
        <rdfs:label xml:lang="es">Componente de bucle</rdfs:label>
        <rdfs:label xml:lang="en">Loop Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#MatrixData -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#MatrixData">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/CO-META#ProblemData"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasShape"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/CO-META#MatrixShape"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ProblemData"/>
        <rdfs:comment xml:lang="es">Datos del problema organizados como una matriz de valores de la misma naturaleza (p. ej., las distancias entre cada par de ciudades). Se deduce de la forma, por lo que no es necesario declararla.</rdfs:comment>
        <rdfs:comment xml:lang="en">Problem data organized as a matrix of values of the same kind (e.g. the distances between each pair of cities). It is inferred from the shape, so it does not need to be asserted.</rdfs:comment>
        <rdfs:label xml:lang="es">Datos matriciales</rdfs:label>
        <rdfs:label xml:lang="en">Matrix Data</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#MatrixShape -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#MatrixShape">
        <rdfs:subClassOf rdf:resource="http://qudt.org/schema/qudt/Matrix"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#DataShape"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasColumnCount"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasRowCount"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Forma de una magnitud cuyos valores, todos de la misma naturaleza, se disponen en filas y columnas (p. ej., una matriz de distancias entre ciudades).</rdfs:comment>
        <rdfs:comment xml:lang="en">Shape of a quantity whose values, all of the same kind, are arranged in rows and columns (e.g. a distance matrix between cities).</rdfs:comment>
        <rdfs:label xml:lang="es">Forma matricial</rdfs:label>
        <rdfs:label xml:lang="en">Matrix Shape</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#MatrixVariable -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#MatrixVariable">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/CO-META#DecisionVariable"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasShape"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/CO-META#MatrixShape"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#DecisionVariable"/>
        <rdfs:comment xml:lang="en">Decision variable made up of a value for each pair of elements of two collections (e.g. whether each vehicle visits each customer). It is inferred from the shape, so it does not need to be asserted.</rdfs:comment>
        <rdfs:comment xml:lang="es">Variable de decisión formada por un valor para cada par de elementos de dos colecciones (p. ej., si cada vehículo visita a cada cliente). Se deduce de la forma, por lo que no es necesario declararla.</rdfs:comment>
        <rdfs:label xml:lang="en">Matrix Variable</rdfs:label>
        <rdfs:label xml:lang="es">Variable matricial</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#MaximizationObjective -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#MaximizationObjective">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#Objective"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/CO-META#MinimizationObjective"/>
        <rdfs:comment xml:lang="en">Objective of an optimization problem whose value must be maximized.</rdfs:comment>
        <rdfs:comment xml:lang="es">Objetivo de un problema de optimización cuyo valor debe maximizarse.</rdfs:comment>
        <rdfs:label xml:lang="en">Maximization Objective</rdfs:label>
        <rdfs:label xml:lang="es">Objetivo de maximización</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#MemeticAlgorithm -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#MemeticAlgorithm">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/CO-META#EvolutionaryAlgorithm"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#isConnectedTo"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/CO-META#LocalSearchComponent"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="es">Algoritmo evolutivo que además utiliza procesos de búsqueda local.</rdfs:comment>
        <rdfs:comment xml:lang="en">Evolutionary algorithm that employs local search processes.</rdfs:comment>
        <rdfs:label xml:lang="es">Algoritmo memético</rdfs:label>
        <rdfs:label xml:lang="en">Memetic Algorithm</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#Metaheuristic -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#Metaheuristic">
        <rdfs:comment xml:lang="en">High-level algorithmic procedure, composed of interconnected metaheuristic components, that finds sufficiently good solutions to optimization problems by searching through vast solution spaces.</rdfs:comment>
        <rdfs:comment xml:lang="es">Procedimiento algorítmico de alto nivel, compuesto por componentes metaheurísticos interconectados, que encuentran soluciones suficientemente buenas a problemas de optimización mediante búsquedas en amplios espacios de soluciones.</rdfs:comment>
        <rdfs:label xml:lang="en">Metaheuristic</rdfs:label>
        <rdfs:label xml:lang="es">Metaheurística</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#MetaheuristicComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#MetaheuristicComponent">
        <rdfs:comment xml:lang="es">Bloque constructivo de una metaheurística que realiza una tarea específica y se conecta con otros componentes.</rdfs:comment>
        <rdfs:comment xml:lang="en">Building block of a metaheuristic that performs a specific task and is connected to other components.</rdfs:comment>
        <rdfs:label xml:lang="es">Componente metaheurístico</rdfs:label>
        <rdfs:label xml:lang="en">Metaheuristic Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#MetropolisAcceptanceComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#MetropolisAcceptanceComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#AcceptanceComponent"/>
        <rdfs:comment xml:lang="en">Acceptance component that accepts a worse candidate with probability exp(-d / T), where d is the relative degradation (f_candidate - f_current) / |f_current| and T the temperature it reads.</rdfs:comment>
        <rdfs:comment xml:lang="es">Componente de aceptación que acepta una candidata peor con probabilidad exp(-d / T), donde d es el empeoramiento relativo (f_candidata - f_actual) / |f_actual| y T la temperatura que lee.</rdfs:comment>
        <rdfs:label xml:lang="es">Componente de aceptación de Metropolis</rdfs:label>
        <rdfs:label xml:lang="en">Metropolis Acceptance Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#MinimizationObjective -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#MinimizationObjective">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#Objective"/>
        <rdfs:comment xml:lang="en">Objective of an optimization problem whose value must be minimized.</rdfs:comment>
        <rdfs:comment xml:lang="es">Objetivo de un problema de optimización cuyo valor debe minimizarse.</rdfs:comment>
        <rdfs:label xml:lang="en">Minimization Objective</rdfs:label>
        <rdfs:label xml:lang="es">Objetivo de minimización</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#ModificationComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#ModificationComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#MetaheuristicComponent"/>
        <rdfs:comment xml:lang="en">Component that modifies a solution or a population.</rdfs:comment>
        <rdfs:comment xml:lang="es">Componente que modifica una solución o una población.</rdfs:comment>
        <rdfs:label xml:lang="es">Componente de modificación</rdfs:label>
        <rdfs:label xml:lang="en">Modification Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#MultiSetShape -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#MultiSetShape">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/CO-META#CollectionShape"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#isDistinct"/>
                        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</owl:hasValue>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#isOrdered"/>
                        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</owl:hasValue>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://qudt.org/schema/qudt/MultiSet"/>
        <rdfs:comment xml:lang="es">Colección cuyos valores no están ordenados y pueden repetirse (p. ej., el número de unidades de cada producto en un pedido).</rdfs:comment>
        <rdfs:comment xml:lang="en">Collection whose values are not ordered and can be repeated (e.g. the number of units of each product in an order).</rdfs:comment>
        <rdfs:label xml:lang="es">Forma de multiconjunto</rdfs:label>
        <rdfs:label xml:lang="en">Multiset Shape</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#MultiobjectiveComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#MultiobjectiveComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#MetaheuristicComponent"/>
        <rdfs:comment xml:lang="en">Component used in multiobjective optimization. It is required before acceptance components.</rdfs:comment>
        <rdfs:comment xml:lang="es">Componente utilizado en optimización multiobjetivo. Es necesario antes de los componentes de aceptación.</rdfs:comment>
        <rdfs:label xml:lang="es">Componente multiobjetivo</rdfs:label>
        <rdfs:label xml:lang="en">Multiobjective Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#NearestNeighbourDensityComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#NearestNeighbourDensityComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#DiversityPreservationComponent"/>
        <rdfs:comment xml:lang="es">Componente de preservación de la diversidad que estima la densidad alrededor de cada individuo a partir de la distancia a su k-ésimo vecino más cercano en el espacio de objetivos (SPEA2).</rdfs:comment>
        <rdfs:comment xml:lang="en">Diversity preservation component that estimates the density around each individual from the distance to its k-th nearest neighbour in objective space (SPEA2).</rdfs:comment>
        <rdfs:label xml:lang="es">Componente de densidad del vecino más cercano</rdfs:label>
        <rdfs:label xml:lang="en">Nearest Neighbour Density Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#NeighbourhoodChangeComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#NeighbourhoodChangeComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#DataHandlerComponent"/>
        <rdfs:comment xml:lang="en">Data handler that resets the neighbourhood index it writes to 1 when the candidate improves the current solution and increases it otherwise, back to 1 after its upper bound.</rdfs:comment>
        <rdfs:comment xml:lang="es">Manejador de datos que reinicia a 1 el índice de vecindario que escribe cuando la candidata mejora la solución actual y lo incrementa en otro caso, volviendo a 1 tras su cota superior.</rdfs:comment>
        <rdfs:label xml:lang="es">Componente de cambio de vecindario</rdfs:label>
        <rdfs:label xml:lang="en">Neighbourhood Change Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#NeighbourhoodComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#NeighbourhoodComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ModificationComponent"/>
        <rdfs:comment xml:lang="es">Componente de modificación que genera soluciones vecinas de una solución dada aplicando un operador de movimiento.</rdfs:comment>
        <rdfs:comment xml:lang="en">Modification component that generates neighbouring solutions of a given solution by applying a move operator.</rdfs:comment>
        <rdfs:label xml:lang="es">Componente de vecindario</rdfs:label>
        <rdfs:label xml:lang="en">Neighbourhood Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#NonDominatedSortingComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#NonDominatedSortingComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#FitnessAssignmentComponent"/>
        <rdfs:comment xml:lang="es">Componente de asignación de aptitud que clasifica cada individuo según el frente no dominado al que pertenece.</rdfs:comment>
        <rdfs:comment xml:lang="en">Fitness assignment component that ranks each individual by the non-dominated front it belongs to.</rdfs:comment>
        <rdfs:label xml:lang="es">Componente de ordenación no dominada</rdfs:label>
        <rdfs:label xml:lang="en">Non-Dominated Sorting Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#Objective -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#Objective">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ProblemElement"/>
        <rdfs:comment xml:lang="en">Objective of an optimization problem. This class should not be instantiated directly; its subclasses should be used instead.</rdfs:comment>
        <rdfs:comment xml:lang="es">Objetivo de un problema de optimización. Esta clase no debe instanciarse directamente; deben usarse sus subclases.</rdfs:comment>
        <rdfs:label xml:lang="en">Objective</rdfs:label>
        <rdfs:label xml:lang="es">Objetivo</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#OrderCrossoverComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#OrderCrossoverComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#CrossoverComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#supportsShape"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/CO-META#DistinctSequenceShape"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Componente de cruce para permutaciones que copia un segmento de un progenitor y rellena las posiciones restantes con los valores del otro progenitor en su orden (OX).</rdfs:comment>
        <rdfs:comment xml:lang="en">Crossover component for permutations that copies a segment from one parent and fills the remaining positions with the values of the other parent in their order (OX).</rdfs:comment>
        <rdfs:label xml:lang="es">Componente de cruce de orden</rdfs:label>
        <rdfs:label xml:lang="en">Order Crossover Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#Parameter -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#Parameter">
        <rdfs:comment xml:lang="es">Define la estructura de un parámetro utilizado por un componente, como su tipo y su rango de valores válidos.</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines the structure of a parameter used by a component, such as its type and its valid range of values.</rdfs:comment>
        <rdfs:label xml:lang="en">Parameter</rdfs:label>
        <rdfs:label xml:lang="es">Parámetro</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#ParameterReference -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#ParameterReference">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ValueSpecification"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#refersTo"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Especificación de valor dada por el valor de un parámetro, que solo se conoce para una instancia concreta del problema o una configuración concreta del algoritmo (p. ej., el número de ciudades N).</rdfs:comment>
        <rdfs:comment xml:lang="en">Value specification given by the value of a parameter, which is only known for a specific problem instance or algorithm configuration (e.g. the number of cities N).</rdfs:comment>
        <rdfs:label xml:lang="en">Parameter Reference</rdfs:label>
        <rdfs:label xml:lang="es">Referencia a parámetro</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#ParameterValue -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#ParameterValue">
        <rdfs:comment xml:lang="es">Valor asignado a un parámetro para un componente concreto.</rdfs:comment>
        <rdfs:comment xml:lang="en">Value assigned to a parameter for a specific component.</rdfs:comment>
        <rdfs:label xml:lang="en">Parameter Value</rdfs:label>
        <rdfs:label xml:lang="es">Valor de parámetro</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#PartiallyMappedCrossoverComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#PartiallyMappedCrossoverComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#CrossoverComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#supportsShape"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/CO-META#DistinctSequenceShape"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Componente de cruce para permutaciones que intercambia un segmento entre los progenitores y repara las posiciones restantes mediante la correspondencia definida por dicho segmento (PMX).</rdfs:comment>
        <rdfs:comment xml:lang="en">Crossover component for permutations that exchanges a segment between parents and repairs the remaining positions using the mapping defined by that segment (PMX).</rdfs:comment>
        <rdfs:label xml:lang="es">Componente de cruce parcialmente mapeado</rdfs:label>
        <rdfs:label xml:lang="en">Partially Mapped Crossover Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#PermutationVariable -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#PermutationVariable">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/CO-META#DecisionVariable"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasShape"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/CO-META#DistinctSequenceShape"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#DecisionVariable"/>
        <rdfs:comment xml:lang="en">Decision variable made up of an ordering of values without repetitions. When its length equals the number of possible values it is a complete permutation (e.g. the tour through the cities in the TSP); otherwise it is a partial permutation. It is inferred from the shape, so it does not need to be asserted.</rdfs:comment>
        <rdfs:comment xml:lang="es">Variable de decisión formada por una ordenación de valores sin repeticiones. Cuando su longitud coincide con el número de valores posibles es una permutación completa (p. ej., el recorrido por las ciudades en el TSP); si no, es una permutación parcial. Se deduce de la forma, por lo que no es necesario declararla.</rdfs:comment>
        <rdfs:label xml:lang="en">Permutation Variable</rdfs:label>
        <rdfs:label xml:lang="es">Variable de permutación</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#PheromoneDepositComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#PheromoneDepositComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#DataHandlerComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasParameter"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasType"/>
                        <owl:hasValue rdf:resource="https://w3id.org/ontologies-ULL/CO-META#PheromoneAddition"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Data handler that adds, on the elements used by each solution it receives, the pheromone addition divided by the solution&apos;s cost.</rdfs:comment>
        <rdfs:comment xml:lang="es">Manejador de datos que añade, en los elementos que usa cada solución que recibe, la adición de feromona dividida por el coste de la solución.</rdfs:comment>
        <rdfs:label xml:lang="es">Componente de depósito de feromonas</rdfs:label>
        <rdfs:label xml:lang="en">Pheromone Deposit Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#PheromoneEvaporationComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#PheromoneEvaporationComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#DataHandlerComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasParameter"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasType"/>
                        <owl:hasValue rdf:resource="https://w3id.org/ontologies-ULL/CO-META#PheromoneEvaporation"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Data handler that multiplies every pheromone it writes by (1 - evaporation rate).</rdfs:comment>
        <rdfs:comment xml:lang="es">Manejador de datos que multiplica cada feromona que escribe por (1 - tasa de evaporación).</rdfs:comment>
        <rdfs:label xml:lang="es">Componente de evaporación de feromonas</rdfs:label>
        <rdfs:label xml:lang="en">Pheromone Evaporation Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#PopulationBasedMetaheuristic -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#PopulationBasedMetaheuristic">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/CO-META#Metaheuristic"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#isConnectedTo"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/CO-META#PopulationConstructionComponent"/>
                                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/CO-META#PopulationGenerationComponent"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/CO-META#SingleSolutionMetaheuristic"/>
        <rdfs:comment xml:lang="en">Metaheuristic that works with a population of solutions.</rdfs:comment>
        <rdfs:comment xml:lang="es">Metaheurística que trabaja con una población de soluciones.</rdfs:comment>
        <rdfs:label xml:lang="es">Metaheurística basada en población</rdfs:label>
        <rdfs:label xml:lang="en">Population Based Metaheuristic</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#PopulationConstructionComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#PopulationConstructionComponent">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/CO-META#ConstructionComponent"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasParameter"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasType"/>
                                        <owl:hasValue rdf:resource="https://w3id.org/ontologies-ULL/CO-META#PopulationSize"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasValue"/>
                                        <owl:someValuesFrom>
                                            <rdfs:Datatype>
                                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                                                <owl:withRestrictions rdf:parseType="Collection">
                                                    <rdf:Description>
                                                        <xsd:minExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</xsd:minExclusive>
                                                    </rdf:Description>
                                                </owl:withRestrictions>
                                            </rdfs:Datatype>
                                        </owl:someValuesFrom>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ConstructionComponent"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/CO-META#SingleSolutionConstructionComponent"/>
        <rdfs:comment xml:lang="es">Componente de construcción que construye una población de más de una solución.</rdfs:comment>
        <rdfs:comment xml:lang="en">Construction component that builds a population of more than one solution.</rdfs:comment>
        <rdfs:label xml:lang="es">Componente de construcción de población</rdfs:label>
        <rdfs:label xml:lang="en">Population Construction Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#PopulationGenerationComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#PopulationGenerationComponent">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/CO-META#GenerationComponent"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasParameter"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasType"/>
                                        <owl:hasValue rdf:resource="https://w3id.org/ontologies-ULL/CO-META#PopulationSize"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasValue"/>
                                        <owl:someValuesFrom>
                                            <rdfs:Datatype>
                                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                                                <owl:withRestrictions rdf:parseType="Collection">
                                                    <rdf:Description>
                                                        <xsd:minExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</xsd:minExclusive>
                                                    </rdf:Description>
                                                </owl:withRestrictions>
                                            </rdfs:Datatype>
                                        </owl:someValuesFrom>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#GenerationComponent"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/CO-META#SingleSolutionGenerationComponent"/>
        <rdfs:comment xml:lang="es">Componente de generación que genera una población inicial de más de una solución.</rdfs:comment>
        <rdfs:comment xml:lang="en">Generation component that generates an initial population of more than one solution.</rdfs:comment>
        <rdfs:label xml:lang="es">Componente de generación de población</rdfs:label>
        <rdfs:label xml:lang="en">Population Generation Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#PopulationModifierComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#PopulationModifierComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#LoopComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasParameter"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasType"/>
                        <owl:hasValue rdf:resource="https://w3id.org/ontologies-ULL/CO-META#PopulationSize"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/CO-META#StoppingCriterionComponent"/>
        <rdfs:comment xml:lang="es">Componente de bucle que repite un proceso parcial, tomando la población anterior como entrada, hasta completar la nueva población. Tiene un parámetro de tamaño de población.</rdfs:comment>
        <rdfs:comment xml:lang="en">Loop component that repeats a partial process, taking the old population as input, until the new population is filled. It has a population size parameter.</rdfs:comment>
        <rdfs:label xml:lang="es">Componente modificador de población</rdfs:label>
        <rdfs:label xml:lang="en">Population Modifier Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#PopulationOperatorComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#PopulationOperatorComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ModificationComponent"/>
        <rdfs:comment xml:lang="es">Componente de modificación que opera sobre poblaciones completas.</rdfs:comment>
        <rdfs:comment xml:lang="en">Modification component that operates on whole populations.</rdfs:comment>
        <rdfs:label xml:lang="es">Componente operador de población</rdfs:label>
        <rdfs:label xml:lang="en">Population Operator Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#Problem -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#Problem">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasObjective"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/CO-META#Objective"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Optimization problem, formulated by its data, its decision variables, at least one objective and, optionally, constraints. A solution is an assignment of values to its decision variables.</rdfs:comment>
        <rdfs:comment xml:lang="es">Problema de optimización, formulado mediante sus datos, sus variables de decisión, al menos un objetivo y, opcionalmente, restricciones. Una solución es una asignación de valores a sus variables de decisión.</rdfs:comment>
        <rdfs:label xml:lang="en">Problem</rdfs:label>
        <rdfs:label xml:lang="es">Problema</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#ProblemData -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#ProblemData">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ProblemQuantity"/>
        <rdfs:comment xml:lang="es">Magnitud del problema cuyo valor se conoce antes de resolverlo y que caracteriza una instancia concreta del problema.</rdfs:comment>
        <rdfs:comment xml:lang="en">Problem quantity whose value is known before solving the problem and that characterizes a specific instance of it.</rdfs:comment>
        <rdfs:label xml:lang="es">Datos del problema</rdfs:label>
        <rdfs:label xml:lang="en">Problem Data</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#ProblemElement -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#ProblemElement">
        <rdfs:comment xml:lang="en">Constituent of the mathematical formulation of an optimization problem: its data, its decision variables, its objectives or its constraints.</rdfs:comment>
        <rdfs:comment xml:lang="es">Constituyente de la formulación matemática de un problema de optimización: sus datos, sus variables de decisión, sus objetivos o sus restricciones.</rdfs:comment>
        <rdfs:label xml:lang="es">Elemento del problema</rdfs:label>
        <rdfs:label xml:lang="en">Problem Element</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#ProblemQuantity -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#ProblemQuantity">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ProblemElement"/>
        <rdfs:comment xml:lang="es">Magnitud, o colección indexada de magnitudes, que interviene en la formulación del problema y se representa mediante un símbolo en sus expresiones. Su valor se conoce de antemano (datos) o se busca al resolver el problema (variable de decisión). No se refiere a una magnitud física.</rdfs:comment>
        <rdfs:comment xml:lang="en">Quantity, or indexed collection of quantities, that takes part in the formulation of the problem and is represented by a symbol in its expressions. Its value is either known in advance (data) or sought when solving the problem (decision variable). It does not refer to a physical quantity.</rdfs:comment>
        <rdfs:label xml:lang="es">Magnitud del problema</rdfs:label>
        <rdfs:label xml:lang="en">Problem Quantity</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#RandomDecisionCrossoverComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#RandomDecisionCrossoverComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#CrossoverComponent"/>
        <rdfs:comment xml:lang="es">Componente de cruce que decide aleatoriamente, para cada posición, de qué progenitor hereda el valor el descendiente.</rdfs:comment>
        <rdfs:comment xml:lang="en">Crossover component that decides randomly, for each position, from which parent the offspring inherits the value.</rdfs:comment>
        <rdfs:label xml:lang="es">Componente de cruce por decisión aleatoria</rdfs:label>
        <rdfs:label xml:lang="en">Random Decision Crossover Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#RandomGenerationComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#RandomGenerationComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#GenerationComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasSafety"/>
                <owl:hasValue rdf:resource="https://w3id.org/ontologies-ULL/CO-META#Unsafe"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Componente de generación que obtiene cada solución de forma uniformemente aleatoria a partir de la representación de las variables de decisión.</rdfs:comment>
        <rdfs:comment xml:lang="en">Generation component that draws each solution uniformly at random from the representation of the decision variables.</rdfs:comment>
        <rdfs:label xml:lang="es">Componente de generación aleatoria</rdfs:label>
        <rdfs:label xml:lang="en">Random Generation Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#RandomResetMutationComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#RandomResetMutationComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#VariationComponent"/>
        <rdfs:comment xml:lang="es">Componente de variación que sustituye el valor de una posición aleatoria por un valor aleatorio de su dominio.</rdfs:comment>
        <rdfs:comment xml:lang="en">Variation component that replaces the value of a random position with a random value of its domain.</rdfs:comment>
        <rdfs:label xml:lang="es">Componente de mutación por reinicio aleatorio</rdfs:label>
        <rdfs:label xml:lang="en">Random Reset Mutation Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#RandomSelectionComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#RandomSelectionComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#SelectionComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasParameter"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasType"/>
                        <owl:hasValue rdf:resource="https://w3id.org/ontologies-ULL/CO-META#Elitism"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasOutputSize"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Componente de selección que selecciona aleatoriamente una pareja de individuos. Tiene un parámetro de elitismo.</rdfs:comment>
        <rdfs:comment xml:lang="en">Selection component that selects a pair of individuals at random. It has an elitism parameter.</rdfs:comment>
        <rdfs:label xml:lang="es">Componente de selección aleatoria</rdfs:label>
        <rdfs:label xml:lang="en">Random Selection Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#RepairComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#RepairComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ModificationComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasSafety"/>
                <owl:hasValue rdf:resource="https://w3id.org/ontologies-ULL/CO-META#Safe"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Componente de modificación que convierte soluciones no factibles en factibles.</rdfs:comment>
        <rdfs:comment xml:lang="en">Modification component that turns infeasible solutions into feasible ones.</rdfs:comment>
        <rdfs:label xml:lang="es">Componente de reparación</rdfs:label>
        <rdfs:label xml:lang="en">Repair Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#RouletteWheelSelectionComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#RouletteWheelSelectionComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#SelectionComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasParameter"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasType"/>
                        <owl:hasValue rdf:resource="https://w3id.org/ontologies-ULL/CO-META#Elitism"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasOutputSize"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Componente de selección que selecciona cada individuo con probabilidad proporcional a su posición según la aptitud. Tiene un parámetro de elitismo.</rdfs:comment>
        <rdfs:comment xml:lang="en">Selection component that selects each individual with probability proportional to its fitness rank. It has an elitism parameter.</rdfs:comment>
        <rdfs:label xml:lang="es">Componente de selección por ruleta</rdfs:label>
        <rdfs:label xml:lang="en">Roulette Wheel Selection Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#ScalarShape -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#ScalarShape">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/CO-META#Scalar"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#DataShape"/>
        <rdfs:comment xml:lang="es">Forma de una magnitud formada por un único valor. Su única instancia es Scalar.</rdfs:comment>
        <rdfs:comment xml:lang="en">Shape of a quantity made up of a single value. Its only instance is Scalar.</rdfs:comment>
        <rdfs:label xml:lang="es">Forma escalar</rdfs:label>
        <rdfs:label xml:lang="en">Scalar Shape</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#ScalarVariable -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#ScalarVariable">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/CO-META#DecisionVariable"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasShape"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ScalarShape"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#DecisionVariable"/>
        <rdfs:comment xml:lang="en">Decision variable that takes a single value (e.g. the number of vehicles to use). It is inferred from the shape, so it does not need to be asserted.</rdfs:comment>
        <rdfs:comment xml:lang="es">Variable de decisión que toma un único valor (p. ej., el número de vehículos que se van a utilizar). Se deduce de la forma, por lo que no es necesario declararla.</rdfs:comment>
        <rdfs:label xml:lang="en">Scalar Variable</rdfs:label>
        <rdfs:label xml:lang="es">Variable escalar</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#SelectionComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#SelectionComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ModificationComponent"/>
        <rdfs:comment xml:lang="es">Componente de modificación que selecciona los individuos que formarán parte de la siguiente generación.</rdfs:comment>
        <rdfs:comment xml:lang="en">Modification component that selects the individuals that will take part in the next generation.</rdfs:comment>
        <rdfs:label xml:lang="es">Componente de selección</rdfs:label>
        <rdfs:label xml:lang="en">Selection Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#SequenceShape -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#SequenceShape">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/CO-META#CollectionShape"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#isOrdered"/>
                        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:hasValue>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://qudt.org/schema/qudt/Sequence"/>
        <rdfs:comment xml:lang="es">Colección cuyos valores están ordenados, de modo que cada uno ocupa una posición (p. ej., si cada objeto se mete en la mochila).</rdfs:comment>
        <rdfs:comment xml:lang="en">Collection whose values are ordered, so that each one occupies a position (e.g. whether each item is put in the knapsack).</rdfs:comment>
        <rdfs:label xml:lang="es">Forma de secuencia</rdfs:label>
        <rdfs:label xml:lang="en">Sequence Shape</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#SequenceVariable -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#SequenceVariable">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/CO-META#DecisionVariable"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasShape"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/CO-META#SequenceShape"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#DecisionVariable"/>
        <rdfs:comment xml:lang="en">Decision variable made up of an ordered sequence of values, one per position, which may be repeated unless it is a permutation (e.g. whether each item is put in the knapsack). It is inferred from the shape, so it does not need to be asserted.</rdfs:comment>
        <rdfs:comment xml:lang="es">Variable de decisión formada por una secuencia ordenada de valores, uno por posición, que pueden repetirse salvo que sea una permutación (p. ej., si cada objeto se mete en la mochila). Se deduce de la forma, por lo que no es necesario declararla.</rdfs:comment>
        <rdfs:label xml:lang="en">Sequence Variable</rdfs:label>
        <rdfs:label xml:lang="es">Variable de secuencia</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#SequentialIterativeSelectionComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#SequentialIterativeSelectionComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#IterativeSelectionComponent"/>
        <rdfs:comment xml:lang="es">Componente de selección iterativa que selecciona los individuos de la población uno a uno, en orden (p. ej. cada hormiga o cada partícula).</rdfs:comment>
        <rdfs:comment xml:lang="en">Iterative selection component that selects the individuals of the population one by one, in order (e.g. each ant or each particle).</rdfs:comment>
        <rdfs:label xml:lang="es">Componente de selección iterativa secuencial</rdfs:label>
        <rdfs:label xml:lang="en">Sequential Iterative Selection Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#SetShape -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#SetShape">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/CO-META#CollectionShape"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#isDistinct"/>
                        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:hasValue>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#isOrdered"/>
                        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</owl:hasValue>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://qudt.org/schema/qudt/Set"/>
        <rdfs:comment xml:lang="es">Colección cuyos valores no están ordenados ni se repiten (p. ej., una selección de k ubicaciones de entre N).</rdfs:comment>
        <rdfs:comment xml:lang="en">Collection whose values are neither ordered nor repeated (e.g. a selection of k locations out of N).</rdfs:comment>
        <rdfs:label xml:lang="es">Forma de conjunto</rdfs:label>
        <rdfs:label xml:lang="en">Set Shape</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#SetVariable -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#SetVariable">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/CO-META#DecisionVariable"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasShape"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/CO-META#SetShape"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#DecisionVariable"/>
        <rdfs:comment xml:lang="en">Decision variable made up of an unordered selection of values without repetitions (e.g. the k locations where facilities are opened). It is inferred from the shape, so it does not need to be asserted.</rdfs:comment>
        <rdfs:comment xml:lang="es">Variable de decisión formada por una selección no ordenada de valores sin repeticiones (p. ej., las k ubicaciones en las que se abren instalaciones). Se deduce de la forma, por lo que no es necesario declararla.</rdfs:comment>
        <rdfs:label xml:lang="en">Set Variable</rdfs:label>
        <rdfs:label xml:lang="es">Variable de conjunto</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#ShakingComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#ShakingComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#VariationComponent"/>
        <rdfs:comment xml:lang="es">Componente de variación que aplica k movimientos aleatorios del vecindario que usa, donde k es el valor de la estructura de datos que lee (el vecindario actual de una búsqueda de vecindario variable).</rdfs:comment>
        <rdfs:comment xml:lang="en">Variation component that applies k random moves of the neighbourhood it uses, where k is the value of the data structure it reads (the current neighbourhood of a variable neighbourhood search).</rdfs:comment>
        <rdfs:label xml:lang="es">Componente de agitación</rdfs:label>
        <rdfs:label xml:lang="en">Shaking Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#SimplePairSelectionComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#SimplePairSelectionComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#SelectionComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasParameter"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasType"/>
                        <owl:hasValue rdf:resource="https://w3id.org/ontologies-ULL/CO-META#Elitism"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasOutputSize"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Componente de selección que selecciona individuos por parejas en orden. Tiene un parámetro de elitismo.</rdfs:comment>
        <rdfs:comment xml:lang="en">Selection component that selects pairs of individuals in order. It has an elitism parameter.</rdfs:comment>
        <rdfs:label xml:lang="es">Componente de selección simple por parejas</rdfs:label>
        <rdfs:label xml:lang="en">Simple Pair Selection Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#SingleSolutionConstructionComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#SingleSolutionConstructionComponent">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/CO-META#ConstructionComponent"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasParameter"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasType"/>
                                        <owl:hasValue rdf:resource="https://w3id.org/ontologies-ULL/CO-META#PopulationSize"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasValue"/>
                                        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ConstructionComponent"/>
        <rdfs:comment xml:lang="es">Componente de construcción que construye una única solución (tamaño de población igual a 1).</rdfs:comment>
        <rdfs:comment xml:lang="en">Construction component that builds a single solution (population size equal to 1).</rdfs:comment>
        <rdfs:label xml:lang="es">Componente de construcción de solución única</rdfs:label>
        <rdfs:label xml:lang="en">Single Solution Construction Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#SingleSolutionGenerationComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#SingleSolutionGenerationComponent">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/CO-META#GenerationComponent"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasParameter"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasType"/>
                                        <owl:hasValue rdf:resource="https://w3id.org/ontologies-ULL/CO-META#PopulationSize"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasValue"/>
                                        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#GenerationComponent"/>
        <rdfs:comment xml:lang="es">Componente de generación que genera una única solución inicial (tamaño de población igual a 1).</rdfs:comment>
        <rdfs:comment xml:lang="en">Generation component that generates a single initial solution (population size equal to 1).</rdfs:comment>
        <rdfs:label xml:lang="es">Componente de generación de solución única</rdfs:label>
        <rdfs:label xml:lang="en">Single Solution Generation Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#SingleSolutionMetaheuristic -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#SingleSolutionMetaheuristic">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/CO-META#Metaheuristic"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#isConnectedTo"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/CO-META#SingleSolutionConstructionComponent"/>
                                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/CO-META#SingleSolutionGenerationComponent"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">Metaheuristic that works with a single solution at a time.</rdfs:comment>
        <rdfs:comment xml:lang="es">Metaheurística que trabaja con una única solución a la vez.</rdfs:comment>
        <rdfs:label xml:lang="es">Metaheurística basada en solución única</rdfs:label>
        <rdfs:label xml:lang="en">Single Solution Based Metaheuristic</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#SolutionSizeReference -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#SolutionSizeReference">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ValueSpecification"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasDimensionIndex"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Especificación de valor dada por el tamaño de una dimensión de la solución que maneja el algoritmo. Permite dimensionar las estructuras de datos del algoritmo sin depender de un problema concreto (p. ej., una matriz de feromonas de n × n).</rdfs:comment>
        <rdfs:comment xml:lang="en">Value specification given by the size of one dimension of the solution handled by the algorithm. It allows algorithm data structures to be sized independently of any specific problem (e.g. an n × n pheromone matrix).</rdfs:comment>
        <rdfs:label xml:lang="es">Referencia al tamaño de la solución</rdfs:label>
        <rdfs:label xml:lang="en">Solution Size Reference</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#StoppingCriterionComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#StoppingCriterionComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#LoopComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasParameter"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasType"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:oneOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/CO-META#Evaluations"/>
                                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/CO-META#Iterations"/>
                                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/CO-META#IterationsWithoutImprovement"/>
                                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/CO-META#TargetValue"/>
                                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/CO-META#Time"/>
                                </owl:oneOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Componente de bucle que crea el bucle principal del algoritmo y determina cuándo detenerlo. Se detiene en cuanto alcanza cualquiera de sus límites: iteraciones, tiempo, evaluaciones, iteraciones sin mejora o valor objetivo.</rdfs:comment>
        <rdfs:comment xml:lang="en">Loop component that creates the main loop of the algorithm and determines when to stop it. It stops as soon as it reaches any of its limits: iterations, time, evaluations, iterations without improvement or target value.</rdfs:comment>
        <rdfs:label xml:lang="es">Componente de criterio de parada</rdfs:label>
        <rdfs:label xml:lang="en">Stopping Criterion Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#StrengthFitnessComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#StrengthFitnessComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#FitnessAssignmentComponent"/>
        <rdfs:comment xml:lang="es">Componente de asignación de aptitud que da a cada individuo la suma de las fuerzas (número de individuos dominados) de los que lo dominan (aptitud bruta de SPEA2).</rdfs:comment>
        <rdfs:comment xml:lang="en">Fitness assignment component that gives each individual the sum of the strengths (number of dominated individuals) of those that dominate it (SPEA2 raw fitness).</rdfs:comment>
        <rdfs:label xml:lang="es">Componente de aptitud por fuerza</rdfs:label>
        <rdfs:label xml:lang="en">Strength Fitness Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#SubtractionComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#SubtractionComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#PopulationOperatorComponent"/>
        <rdfs:comment xml:lang="es">Operador de población que elimina de su entrada las soluciones almacenadas en las estructuras de datos que lee (p. ej. una lista tabú).</rdfs:comment>
        <rdfs:comment xml:lang="en">Population operator that removes from its input the solutions stored in the data structures it reads (e.g. a tabu list).</rdfs:comment>
        <rdfs:label xml:lang="es">Componente de sustracción</rdfs:label>
        <rdfs:label xml:lang="en">Subtraction Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#SwapMutationComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#SwapMutationComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#VariationComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#supportsShape"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/CO-META#DistinctSequenceShape"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Componente de variación que intercambia los valores de dos posiciones aleatorias de una permutación.</rdfs:comment>
        <rdfs:comment xml:lang="en">Variation component that exchanges the values of two random positions of a permutation.</rdfs:comment>
        <rdfs:label xml:lang="es">Componente de mutación por intercambio</rdfs:label>
        <rdfs:label xml:lang="en">Swap Mutation Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#SwapNeighbourhoodComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#SwapNeighbourhoodComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#NeighbourhoodComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#supportsShape"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/CO-META#DistinctSequenceShape"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Neighbourhood of the permutations obtained by exchanging the values of two positions.</rdfs:comment>
        <rdfs:comment xml:lang="es">Vecindario de las permutaciones obtenidas intercambiando los valores de dos posiciones.</rdfs:comment>
        <rdfs:label xml:lang="es">Componente de vecindario de intercambio</rdfs:label>
        <rdfs:label xml:lang="en">Swap Neighbourhood Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#TableData -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#TableData">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/CO-META#ProblemData"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasShape"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/CO-META#TableShape"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ProblemData"/>
        <rdfs:comment xml:lang="es">Datos del problema organizados como una tabla de registros, cada uno de los cuales describe una entidad del problema mediante sus atributos (p. ej., las coordenadas de cada ciudad). Se deduce de la forma, por lo que no es necesario declararla.</rdfs:comment>
        <rdfs:comment xml:lang="en">Problem data organized as a table of records, each of which describes an entity of the problem by means of its attributes (e.g. the coordinates of each city). It is inferred from the shape, so it does not need to be asserted.</rdfs:comment>
        <rdfs:label xml:lang="es">Datos en tabla</rdfs:label>
        <rdfs:label xml:lang="en">Table Data</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#TableShape -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#TableShape">
        <rdfs:subClassOf rdf:resource="http://qudt.org/schema/qudt/Table"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#DataShape"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasColumn"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/CO-META#Column"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasRowCount"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Forma de una magnitud formada por registros homogéneos (filas), cada uno de los cuales describe una entidad del problema mediante atributos con nombre (columnas) (p. ej., las coordenadas de cada ciudad).</rdfs:comment>
        <rdfs:comment xml:lang="en">Shape of a quantity made up of homogeneous records (rows), each of which describes an entity of the problem by means of named attributes (columns) (e.g. the coordinates of each city).</rdfs:comment>
        <rdfs:label xml:lang="es">Forma de tabla</rdfs:label>
        <rdfs:label xml:lang="en">Table Shape</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#TabuListUpdateComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#TabuListUpdateComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#DataHandlerComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasParameter"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasType"/>
                        <owl:hasValue rdf:resource="https://w3id.org/ontologies-ULL/CO-META#StorageSize"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Data handler that stores the solutions it receives in the list it writes, discarding the oldest beyond the storage size, and passes them on.</rdfs:comment>
        <rdfs:comment xml:lang="es">Manejador de datos que almacena las soluciones que recibe en la lista que escribe, descartando las más antiguas por encima del tamaño de almacenamiento, y las deja pasar.</rdfs:comment>
        <rdfs:label xml:lang="es">Componente de actualización de la lista tabú</rdfs:label>
        <rdfs:label xml:lang="en">Tabu List Update Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#TournamentSelectionComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#TournamentSelectionComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#SelectionComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasParameter"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasType"/>
                        <owl:hasValue rdf:resource="https://w3id.org/ontologies-ULL/CO-META#Elitism"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasParameter"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasType"/>
                        <owl:hasValue rdf:resource="https://w3id.org/ontologies-ULL/CO-META#TournamentSize"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasOutputSize"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Componente de selección que selecciona cada individuo como el mejor de un grupo elegido aleatoriamente (torneo). Tiene parámetros de elitismo y de tamaño de torneo.</rdfs:comment>
        <rdfs:comment xml:lang="en">Selection component that selects each individual as the best one of a randomly chosen group (tournament). It has elitism and tournament size parameters.</rdfs:comment>
        <rdfs:label xml:lang="es">Componente de selección por torneo</rdfs:label>
        <rdfs:label xml:lang="en">Tournament Selection Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#TruncationComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#TruncationComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#PopulationOperatorComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasParameter"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasType"/>
                        <owl:hasValue rdf:resource="https://w3id.org/ontologies-ULL/CO-META#PopulationSize"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Operador de población que conserva los mejores individuos hasta el tamaño de población, según la aptitud asignada por los componentes previos (rango y diversidad) o, si no la hay, según los objetivos.</rdfs:comment>
        <rdfs:comment xml:lang="en">Population operator that keeps the best individuals up to the population size, according to the fitness assigned by the previous components (rank and diversity) or, without it, to the objectives.</rdfs:comment>
        <rdfs:label xml:lang="es">Componente de truncamiento</rdfs:label>
        <rdfs:label xml:lang="en">Truncation Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#TwoOptNeighbourhoodComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#TwoOptNeighbourhoodComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#NeighbourhoodComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#supportsShape"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/CO-META#DistinctSequenceShape"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Neighbourhood of the permutations obtained by reversing a segment (2-opt move).</rdfs:comment>
        <rdfs:comment xml:lang="es">Vecindario de las permutaciones obtenidas invirtiendo un segmento (movimiento 2-opt).</rdfs:comment>
        <rdfs:label xml:lang="en">2-opt Neighbourhood Component</rdfs:label>
        <rdfs:label xml:lang="es">Componente de vecindario 2-opt</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#UnionComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#UnionComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#PopulationOperatorComponent"/>
        <rdfs:comment xml:lang="es">Operador de población que une, sin repeticiones, las poblaciones que recibe y las soluciones de las estructuras de datos que lee.</rdfs:comment>
        <rdfs:comment xml:lang="en">Population operator that joins, without repetitions, the populations it receives and the solutions of the data structures it reads.</rdfs:comment>
        <rdfs:label xml:lang="es">Componente de unión</rdfs:label>
        <rdfs:label xml:lang="en">Union Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#UpdateBestComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#UpdateBestComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#MetaheuristicComponent"/>
        <rdfs:comment xml:lang="en">Component that updates the best solution or solutions found so far by the algorithm.</rdfs:comment>
        <rdfs:comment xml:lang="es">Componente que actualiza la mejor solución o soluciones encontradas hasta el momento por el algoritmo.</rdfs:comment>
        <rdfs:label xml:lang="es">Componente de actualización del mejor</rdfs:label>
        <rdfs:label xml:lang="en">Update Best Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#ValueDomain -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#ValueDomain">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:complementOf>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasExclusiveLowerBound"/>
                                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasLowerBound"/>
                                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:complementOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:complementOf>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasExclusiveUpperBound"/>
                                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasUpperBound"/>
                                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:complementOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasBaseType"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Conjunto de valores que puede tomar una magnitud o un parámetro, definido por un conjunto numérico base y cotas inferior y superior opcionales, inclusivas o exclusivas (p. ej., los enteros entre 0 y 1).</rdfs:comment>
        <rdfs:comment xml:lang="en">Set of values that a quantity or parameter can take, defined by a base number set and optional lower and upper bounds, inclusive or exclusive (e.g. the integers between 0 and 1).</rdfs:comment>
        <rdfs:label xml:lang="es">Dominio de valores</rdfs:label>
        <rdfs:label xml:lang="en">Value Domain</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#ValueSpecification -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#ValueSpecification">
        <rdfs:comment xml:lang="en">Number used as a size or as a bound, given explicitly or by reference to a parameter or to the size of the solution. This class should not be instantiated directly; its subclasses should be used instead.</rdfs:comment>
        <rdfs:comment xml:lang="es">Número usado como tamaño o como cota, indicado explícitamente o mediante una referencia a un parámetro o al tamaño de la solución. Esta clase no debe instanciarse directamente; deben usarse sus subclases.</rdfs:comment>
        <rdfs:label xml:lang="es">Especificación de valor</rdfs:label>
        <rdfs:label xml:lang="en">Value Specification</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#VariationComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#VariationComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ModificationComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasSafety"/>
                <owl:hasValue rdf:resource="https://w3id.org/ontologies-ULL/CO-META#Unsafe"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Componente de modificación que introduce pequeños cambios aleatorios en una solución (mutación).</rdfs:comment>
        <rdfs:comment xml:lang="en">Modification component that introduces small random changes to a solution (mutation).</rdfs:comment>
        <rdfs:label xml:lang="es">Componente de variación</rdfs:label>
        <rdfs:label xml:lang="en">Variation Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#VelocityApplicationComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#VelocityApplicationComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ModificationComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasSafety"/>
                <owl:hasValue rdf:resource="https://w3id.org/ontologies-ULL/CO-META#Unsafe"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Componente de modificación que desplaza cada partícula que recibe según su velocidad: sumada a los valores reales, o mediante una sigmoide como probabilidad de un 1 en valores binarios.</rdfs:comment>
        <rdfs:comment xml:lang="en">Modification component that moves each particle it receives by its velocity: added to real values, or through a sigmoid as the probability of a 1 for binary values.</rdfs:comment>
        <rdfs:label xml:lang="es">Componente de aplicación de la velocidad</rdfs:label>
        <rdfs:label xml:lang="en">Velocity Application Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#VelocityUpdateComponent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/CO-META#VelocityUpdateComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/CO-META#DataHandlerComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasParameter"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasType"/>
                        <owl:hasValue rdf:resource="https://w3id.org/ontologies-ULL/CO-META#GlobalBestInfluence"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasParameter"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasType"/>
                        <owl:hasValue rdf:resource="https://w3id.org/ontologies-ULL/CO-META#InertiaFactor"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasParameter"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/CO-META#hasType"/>
                        <owl:hasValue rdf:resource="https://w3id.org/ontologies-ULL/CO-META#PersonalBestInfluence"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Data handler that updates the velocity of each particle it receives from its inertia and the attraction towards its personal best and the global best.</rdfs:comment>
        <rdfs:comment xml:lang="es">Manejador de datos que actualiza la velocidad de cada partícula que recibe a partir de su inercia y la atracción hacia su mejor posición personal y la mejor global.</rdfs:comment>
        <rdfs:label xml:lang="es">Componente de actualización de la velocidad</rdfs:label>
        <rdfs:label xml:lang="en">Velocity Update Component</rdfs:label>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/ontologies-ULL/CO-META#AnyBoolean -->


    <owl:NamedIndividual rdf:about="https://w3id.org/ontologies-ULL/CO-META#AnyBoolean">
        <rdf:type rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ValueDomain"/>
        <hasBaseType rdf:resource="https://w3id.org/ontologies-ULL/CO-META#Booleans"/>
        <rdfs:comment xml:lang="es">Dominio de valores con todos los valores de verdad.</rdfs:comment>
        <rdfs:comment xml:lang="en">Value domain of all truth values.</rdfs:comment>
        <rdfs:label xml:lang="en">Any Boolean</rdfs:label>
        <rdfs:label xml:lang="es">Cualquier booleano</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#AnyInteger -->


    <owl:NamedIndividual rdf:about="https://w3id.org/ontologies-ULL/CO-META#AnyInteger">
        <rdf:type rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ValueDomain"/>
        <hasBaseType rdf:resource="https://w3id.org/ontologies-ULL/CO-META#Integers"/>
        <rdfs:comment xml:lang="es">Dominio de valores con todos los números enteros, sin cotas.</rdfs:comment>
        <rdfs:comment xml:lang="en">Value domain of all integer numbers, without bounds.</rdfs:comment>
        <rdfs:label xml:lang="en">Any Integer</rdfs:label>
        <rdfs:label xml:lang="es">Cualquier entero</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#AnyReal -->


    <owl:NamedIndividual rdf:about="https://w3id.org/ontologies-ULL/CO-META#AnyReal">
        <rdf:type rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ValueDomain"/>
        <hasBaseType rdf:resource="https://w3id.org/ontologies-ULL/CO-META#Reals"/>
        <rdfs:comment xml:lang="es">Dominio de valores con todos los números reales, sin cotas.</rdfs:comment>
        <rdfs:comment xml:lang="en">Value domain of all real numbers, without bounds.</rdfs:comment>
        <rdfs:label xml:lang="en">Any Real</rdfs:label>
        <rdfs:label xml:lang="es">Cualquier real</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#AnySolution -->


    <owl:NamedIndividual rdf:about="https://w3id.org/ontologies-ULL/CO-META#AnySolution">
        <rdf:type rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ValueDomain"/>
        <hasBaseType rdf:resource="https://w3id.org/ontologies-ULL/CO-META#Solutions"/>
        <rdfs:comment xml:lang="es">Dominio de valores con todas las soluciones candidatas del problema que se resuelve.</rdfs:comment>
        <rdfs:comment xml:lang="en">Value domain of all candidate solutions of the problem being solved.</rdfs:comment>
        <rdfs:label xml:lang="en">Any Solution</rdfs:label>
        <rdfs:label xml:lang="es">Cualquier solución</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/ontologies-ULL/CO-META#BinaryIntegers -->


    <owl:NamedIndividual rdf:about="https://w3id.org/ontologies-ULL/CO-META#BinaryIntegers">
        <rdf:type rdf:resource="https://w3id.org/ontologies-ULL/CO-META#ValueDomain"/>
        <hasBaseType rdf:resource="https://w3id.org/ontologies-ULL/CO-META#Integers"/>
        <hasLowerBound rdf:resource="https://w3id.org/ontologies-ULL/CO-META#Zero"/>
        <hasUpperBound rdf:resource="https://w3id.org/ontologies-ULL/CO-META#One"/>
        <rdfs:comment xml:lang="es">Dominio de valores con los enteros 0 y 1 (p. ej., si un objeto se selecciona).</rdfs:comment>
        <rdfs:comment xml:lang="en">Value domain of the integers 0 and 1 (e.g. whether an item is selected).</rdfs:comment>
        <rdfs:label xml:lang="en">Binary Integers</rdfs:label>
        <rdfs:label xml:lang="es">Enteros binarios</rdfs:label>
    </owl:NamedIndividual>
    


