#################################################################
#    Classes
#################################################################

###  http://qudt.org/schema/qudt/Array
qudt:Array rdf:type owl:Class ;
           rdfs:subClassOf qudt:StructuredDatatype ;
           rdfs:label "Array" .


###  http://qudt.org/schema/qudt/Collection
qudt:Collection rdf:type owl:Class ;
                rdfs:subClassOf qudt:StructuredDatatype ;
                rdfs:label "Collection Type" .


###  http://qudt.org/schema/qudt/CompositeDatatype
qudt:CompositeDatatype rdf:type owl:Class ;
                       rdfs:subClassOf qudt:StructuredDatatype ;
                       rdfs:label "Composite Data Type" .


###  http://qudt.org/schema/qudt/Matrix
qudt:Matrix rdf:type owl:Class ;
            rdfs:subClassOf qudt:Array ;
            rdfs:label "Matrix" .


###  http://qudt.org/schema/qudt/MultiSet
qudt:MultiSet rdf:type owl:Class ;
              rdfs:subClassOf qudt:Collection ;
              rdfs:label "Bag" .


###  http://qudt.org/schema/qudt/Record
qudt:Record rdf:type owl:Class ;
            rdfs:subClassOf qudt:CompositeDatatype ;
            rdfs:label "Record Type" .


###  http://qudt.org/schema/qudt/Sequence
qudt:Sequence rdf:type owl:Class ;
              rdfs:subClassOf qudt:Collection ;
              rdfs:label "Sequence" .


###  http://qudt.org/schema/qudt/Set
qudt:Set rdf:type owl:Class ;
         rdfs:subClassOf qudt:Collection ;
         rdfs:label "Set Type" .


###  http://qudt.org/schema/qudt/StructuredDatatype
qudt:StructuredDatatype rdf:type owl:Class ;
                        rdfs:label "Structured Data Type" .


###  http://qudt.org/schema/qudt/Table
qudt:Table rdf:type owl:Class ;
           rdfs:subClassOf qudt:StructuredDatatype ;
           rdfs:label "Table Type" .


