#################################################################
#    Individuals
#################################################################

###  https://w3id.org/ontologies-ULL/CO-META#SA_SimulatedAnnealing
CO-META:SA_SimulatedAnnealing rdf:type owl:NamedIndividual ,
                                       CO-META:Metaheuristic ;
                              CO-META:hasDataStructure CO-META:SA_temperature ;
                              CO-META:hasStart CO-META:SA_generate .


###  https://w3id.org/ontologies-ULL/CO-META#SA_acceptance
CO-META:SA_acceptance rdf:type owl:NamedIndividual ,
                               CO-META:MetropolisAcceptanceComponent ;
                      CO-META:hasOutput CO-META:SA_cooling_schedule ;
                      CO-META:readsData CO-META:SA_temperature .


###  https://w3id.org/ontologies-ULL/CO-META#SA_cooling_schedule
CO-META:SA_cooling_schedule rdf:type owl:NamedIndividual ,
                                     CO-META:GeometricCoolingComponent ;
                            CO-META:hasOutput CO-META:SA_stop ;
                            CO-META:hasParameter CO-META:SA_parameter_max_temperature ,
                                                 CO-META:SA_parameter_min_temperature ;
                            CO-META:writesData CO-META:SA_temperature .


###  https://w3id.org/ontologies-ULL/CO-META#SA_generate
CO-META:SA_generate rdf:type owl:NamedIndividual ,
                             CO-META:RandomGenerationComponent ;
                    CO-META:hasOutputStart CO-META:SA_stop ;
                    CO-META:hasParameter CO-META:SA_parameter_populationsize .


###  https://w3id.org/ontologies-ULL/CO-META#SA_parameter_iterations
CO-META:SA_parameter_iterations rdf:type owl:NamedIndividual ,
                                         CO-META:ParameterValue ;
                                CO-META:hasType CO-META:Iterations .


###  https://w3id.org/ontologies-ULL/CO-META#SA_parameter_max_temperature
CO-META:SA_parameter_max_temperature rdf:type owl:NamedIndividual ,
                                              CO-META:ParameterValue ;
                                     CO-META:hasType CO-META:MaxTemperature .


###  https://w3id.org/ontologies-ULL/CO-META#SA_parameter_max_temperature_reference
CO-META:SA_parameter_max_temperature_reference rdf:type owl:NamedIndividual ,
                                                        CO-META:ParameterReference ;
                                               CO-META:refersTo CO-META:SA_parameter_max_temperature .


###  https://w3id.org/ontologies-ULL/CO-META#SA_parameter_min_temperature
CO-META:SA_parameter_min_temperature rdf:type owl:NamedIndividual ,
                                              CO-META:ParameterValue ;
                                     CO-META:hasType CO-META:MinTemperature .


###  https://w3id.org/ontologies-ULL/CO-META#SA_parameter_min_temperature_reference
CO-META:SA_parameter_min_temperature_reference rdf:type owl:NamedIndividual ,
                                                        CO-META:ParameterReference ;
                                               CO-META:refersTo CO-META:SA_parameter_min_temperature .


###  https://w3id.org/ontologies-ULL/CO-META#SA_parameter_populationsize
CO-META:SA_parameter_populationsize rdf:type owl:NamedIndividual ,
                                             CO-META:ParameterValue ;
                                    CO-META:hasType CO-META:PopulationSize ;
                                    CO-META:hasValue 1 .


###  https://w3id.org/ontologies-ULL/CO-META#SA_perturbation
CO-META:SA_perturbation rdf:type owl:NamedIndividual ,
                                 CO-META:VariationComponent ;
                        CO-META:hasCandidateOutput CO-META:SA_acceptance .


###  https://w3id.org/ontologies-ULL/CO-META#SA_stop
CO-META:SA_stop rdf:type owl:NamedIndividual ,
                         CO-META:StoppingCriterionComponent ;
                CO-META:hasCurrentOutput CO-META:SA_acceptance ;
                CO-META:hasOutput CO-META:SA_perturbation ;
                CO-META:hasParameter CO-META:SA_parameter_iterations .


###  https://w3id.org/ontologies-ULL/CO-META#SA_temperature
CO-META:SA_temperature rdf:type owl:NamedIndividual ,
                                CO-META:DataStructure ;
                       CO-META:hasShape CO-META:Scalar ;
                       CO-META:hasValueDomain CO-META:SA_temperature_domain .


###  https://w3id.org/ontologies-ULL/CO-META#SA_temperature_domain
CO-META:SA_temperature_domain rdf:type owl:NamedIndividual ,
                                       CO-META:ValueDomain ;
                              CO-META:hasBaseType CO-META:Reals ;
                              CO-META:hasLowerBound CO-META:SA_parameter_min_temperature_reference ;
                              CO-META:hasUpperBound CO-META:SA_parameter_max_temperature_reference .


