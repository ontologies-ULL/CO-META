#################################################################
#    Individuals
#################################################################

###  https://w3id.org/ontologies-ULL/CO-META#TS_TabuSearch
CO-META:TS_TabuSearch rdf:type owl:NamedIndividual ,
                               CO-META:Metaheuristic ;
                      CO-META:hasDataStructure CO-META:TS_tabu_list ;
                      CO-META:hasStart CO-META:TS_generate .


###  https://w3id.org/ontologies-ULL/CO-META#TS_generate
CO-META:TS_generate rdf:type owl:NamedIndividual ,
                             CO-META:SingleSolutionGenerationComponent ;
                    CO-META:hasOutputStart CO-META:TS_stop .


###  https://w3id.org/ontologies-ULL/CO-META#TS_neighbourhood
CO-META:TS_neighbourhood rdf:type owl:NamedIndividual ,
                                  CO-META:NeighbourhoodComponent ;
                         CO-META:hasOutput CO-META:TS_substraction .


###  https://w3id.org/ontologies-ULL/CO-META#TS_parameter_iterations
CO-META:TS_parameter_iterations rdf:type owl:NamedIndividual ,
                                         CO-META:ParameterValue ;
                                CO-META:hasType CO-META:Iterations .


###  https://w3id.org/ontologies-ULL/CO-META#TS_select_best
CO-META:TS_select_best rdf:type owl:NamedIndividual ,
                                CO-META:AcceptanceComponent ;
                       CO-META:hasOutput CO-META:TS_stop .


###  https://w3id.org/ontologies-ULL/CO-META#TS_stop
CO-META:TS_stop rdf:type owl:NamedIndividual ,
                         CO-META:StoppingCriterionComponent ;
                CO-META:hasOutput CO-META:TS_store_visited ;
                CO-META:hasParameter CO-META:TS_parameter_iterations .


###  https://w3id.org/ontologies-ULL/CO-META#TS_store_visited
CO-META:TS_store_visited rdf:type owl:NamedIndividual ,
                                  CO-META:DataHandlerComponent ;
                         CO-META:hasOutput CO-META:TS_neighbourhood ;
                         CO-META:writesData CO-META:TS_tabu_list .


###  https://w3id.org/ontologies-ULL/CO-META#TS_substraction
CO-META:TS_substraction rdf:type owl:NamedIndividual ,
                                 CO-META:PopulationOperatorComponent ;
                        CO-META:hasOutput CO-META:TS_select_best ;
                        CO-META:readsData CO-META:TS_tabu_list .


###  https://w3id.org/ontologies-ULL/CO-META#TS_tabu_list
CO-META:TS_tabu_list rdf:type owl:NamedIndividual ,
                              CO-META:DataStructure .


