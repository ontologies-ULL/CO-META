@prefix CO-META: <https://w3id.org/ontologies-ULL/CO-META#> .
@base <https://w3id.org/ontologies-ULL/CO-META#> .

<https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/GRASP> rdf:type owl:Ontology ;
                                                                        owl:imports <https://w3id.org/ontologies-ULL/CO-META> ;
                                                                        rdfs:label "CO-META individuals for GRASP"@en .

#################################################################
#    Individuals
#################################################################

###  https://w3id.org/ontologies-ULL/CO-META#GRASP
CO-META:GRASP rdf:type owl:NamedIndividual ,
                       CO-META:Metaheuristic ;
              CO-META:hasStart CO-META:GRASP_stop .


###  https://w3id.org/ontologies-ULL/CO-META#GRASP_acceptance
CO-META:GRASP_acceptance rdf:type owl:NamedIndividual ,
                                  CO-META:AcceptanceComponent ;
                         CO-META:hasOutput CO-META:GRASP_stop .


###  https://w3id.org/ontologies-ULL/CO-META#GRASP_construction_rcl
CO-META:GRASP_construction_rcl rdf:type owl:NamedIndividual ,
                                        CO-META:SingleSolutionConstructionComponent ;
                               CO-META:hasOutput CO-META:GRASP_localsearch ;
                               CO-META:hasParameter CO-META:GRASP_parameter_rclrandomness .


###  https://w3id.org/ontologies-ULL/CO-META#GRASP_localsearch
CO-META:GRASP_localsearch rdf:type owl:NamedIndividual ,
                                   CO-META:LocalSearchComponent ;
                          CO-META:hasOutput CO-META:GRASP_acceptance .


###  https://w3id.org/ontologies-ULL/CO-META#GRASP_parameter_iterations
CO-META:GRASP_parameter_iterations rdf:type owl:NamedIndividual ,
                                            CO-META:ParameterValue ;
                                   CO-META:hasType CO-META:Iterations .


###  https://w3id.org/ontologies-ULL/CO-META#GRASP_parameter_rclrandomness
CO-META:GRASP_parameter_rclrandomness rdf:type owl:NamedIndividual ,
                                               CO-META:ParameterValue ;
                                      CO-META:hasType CO-META:RCLRandomness .


###  https://w3id.org/ontologies-ULL/CO-META#GRASP_stop
CO-META:GRASP_stop rdf:type owl:NamedIndividual ,
                            CO-META:StoppingCriterionComponent ;
                   CO-META:hasOutput CO-META:GRASP_acceptance ,
                                     CO-META:GRASP_construction_rcl ;
                   CO-META:hasParameter CO-META:GRASP_parameter_iterations .


###  https://w3id.org/ontologies-ULL/CO-META#RCLRandomness
CO-META:RCLRandomness rdf:type owl:NamedIndividual ,
                               CO-META:FloatParameter ;
                      CO-META:maxValue 1 ;
                      CO-META:minValue 0 .


