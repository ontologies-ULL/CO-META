@prefix : <https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/GRASP#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix CO-META: <https://w3id.org/ontologies-ULL/CO-META#> .
@base <https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/GRASP> .

<https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/GRASP> rdf:type owl:Ontology ;
                                                                        owl:imports <https://w3id.org/ontologies-ULL/CO-META> ;
                                                                        rdfs:label "CO-META individuals for GRASP"@en .

#################################################################
#    Individuals
#################################################################

###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/GRASP#GRASP
:GRASP rdf:type owl:NamedIndividual ,
                CO-META:Metaheuristic ;
       CO-META:hasConstraintHandling CO-META:FeasibilityFirstHandling ;
       CO-META:hasStart :stop ;
       rdfs:label "Greedy Randomized Adaptive Search Procedure"@en ,
                  "Procedimiento de búsqueda voraz aleatorizado y adaptativo"@es .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/GRASP#acceptance
:acceptance rdf:type owl:NamedIndividual ,
                     CO-META:ImprovementAcceptanceComponent ;
            CO-META:hasOutput :stop .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/GRASP#construction_rcl
:construction_rcl rdf:type owl:NamedIndividual ,
                           CO-META:GreedyRandomizedConstructionComponent ;
                  CO-META:hasOutput :localsearch ;
                  CO-META:hasParameter :parameter_populationsize ,
                                       :parameter_rclrandomness .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/GRASP#localsearch
:localsearch rdf:type owl:NamedIndividual ,
                      CO-META:FirstImprovementLocalSearchComponent ;
             CO-META:hasCandidateOutput :acceptance ;
             CO-META:usesComponent :neighbourhood .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/GRASP#neighbourhood
:neighbourhood rdf:type owl:NamedIndividual ,
                        CO-META:NeighbourhoodComponent .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/GRASP#parameter_iterations
:parameter_iterations rdf:type owl:NamedIndividual ,
                               CO-META:ParameterValue ;
                      CO-META:hasType CO-META:Iterations ;
                      CO-META:hasValue 100 .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/GRASP#parameter_populationsize
:parameter_populationsize rdf:type owl:NamedIndividual ,
                                   CO-META:ParameterValue ;
                          CO-META:hasType CO-META:PopulationSize ;
                          CO-META:hasValue 1 .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/GRASP#parameter_rclrandomness
:parameter_rclrandomness rdf:type owl:NamedIndividual ,
                                  CO-META:ParameterValue ;
                         CO-META:hasType CO-META:RCLRandomness .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/GRASP#stop
:stop rdf:type owl:NamedIndividual ,
               CO-META:StoppingCriterionComponent ;
      CO-META:hasCurrentOutput :acceptance ;
      CO-META:hasOutput :construction_rcl ;
      CO-META:hasParameter :parameter_iterations .


