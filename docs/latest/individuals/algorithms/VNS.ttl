#################################################################
#    Individuals
#################################################################

###  https://w3id.org/ontologies-ULL/CO-META#VNS_VariableNeighbourhoodSearch
CO-META:VNS_VariableNeighbourhoodSearch rdf:type owl:NamedIndividual ,
                                                 CO-META:Metaheuristic ;
                                        CO-META:hasDataStructure CO-META:VNS_neighbourhood ;
                                        CO-META:hasStart CO-META:VNS_generate .


###  https://w3id.org/ontologies-ULL/CO-META#VNS_acceptance
CO-META:VNS_acceptance rdf:type owl:NamedIndividual ,
                                CO-META:AcceptanceComponent ;
                       CO-META:hasOutput CO-META:VNS_change_neighbourhood .


###  https://w3id.org/ontologies-ULL/CO-META#VNS_change_neighbourhood
CO-META:VNS_change_neighbourhood rdf:type owl:NamedIndividual ,
                                          CO-META:DataHandlerComponent ;
                                 CO-META:hasOutput CO-META:VNS_stop ;
                                 CO-META:writesData CO-META:VNS_neighbourhood .


###  https://w3id.org/ontologies-ULL/CO-META#VNS_generate
CO-META:VNS_generate rdf:type owl:NamedIndividual ,
                              CO-META:SingleSolutionGenerationComponent ;
                     CO-META:hasOutputStart CO-META:VNS_stop .


###  https://w3id.org/ontologies-ULL/CO-META#VNS_localsearch
CO-META:VNS_localsearch rdf:type owl:NamedIndividual ,
                                 CO-META:LocalSearchComponent ;
                        CO-META:hasOutput CO-META:VNS_acceptance .


###  https://w3id.org/ontologies-ULL/CO-META#VNS_neighbourhood
CO-META:VNS_neighbourhood rdf:type owl:NamedIndividual ,
                                   CO-META:DataStructure .


###  https://w3id.org/ontologies-ULL/CO-META#VNS_parameter_iterations
CO-META:VNS_parameter_iterations rdf:type owl:NamedIndividual ,
                                          CO-META:ParameterValue ;
                                 CO-META:hasType CO-META:Iterations .


###  https://w3id.org/ontologies-ULL/CO-META#VNS_perturbation
CO-META:VNS_perturbation rdf:type owl:NamedIndividual ,
                                  CO-META:VariationComponent ;
                         CO-META:hasOutput CO-META:VNS_localsearch ;
                         CO-META:readsData CO-META:VNS_neighbourhood .


###  https://w3id.org/ontologies-ULL/CO-META#VNS_stop
CO-META:VNS_stop rdf:type owl:NamedIndividual ,
                          CO-META:StoppingCriterionComponent ;
                 CO-META:hasOutput CO-META:VNS_acceptance ,
                                   CO-META:VNS_change_neighbourhood ,
                                   CO-META:VNS_perturbation ;
                 CO-META:hasParameter CO-META:VNS_parameter_iterations .


