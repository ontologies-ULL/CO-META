@prefix : <https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/ILS#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix CO-META: <https://w3id.org/ontologies-ULL/CO-META#> .
@base <https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/ILS> .

<https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/ILS> rdf:type owl:Ontology ;
                                                                      owl:imports <https://w3id.org/ontologies-ULL/CO-META> ;
                                                                      rdfs:label "CO-META individuals for Iterated Local Search"@en .

#################################################################
#    Individuals
#################################################################

###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/ILS#IteratedLocalSearch
:IteratedLocalSearch rdf:type owl:NamedIndividual ,
                              CO-META:Metaheuristic ;
                     CO-META:hasConstraintHandling CO-META:FeasibilityFirstHandling ;
                     CO-META:hasStart :generate ;
                     rdfs:label "Búsqueda local iterada"@es ,
                                "Iterated Local Search"@en .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/ILS#acceptance
:acceptance rdf:type owl:NamedIndividual ,
                     CO-META:ImprovementAcceptanceComponent ;
            CO-META:hasOutput :stop .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/ILS#generate
:generate rdf:type owl:NamedIndividual ,
                   CO-META:RandomGenerationComponent ;
          CO-META:hasOutputStart :stop ;
          CO-META:hasParameter :parameter_populationsize .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/ILS#localsearch
:localsearch rdf:type owl:NamedIndividual ,
                      CO-META:FirstImprovementLocalSearchComponent ;
             CO-META:hasCandidateOutput :acceptance ;
             CO-META:usesComponent :localsearch_neighbourhood .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/ILS#localsearch_neighbourhood
:localsearch_neighbourhood rdf:type owl:NamedIndividual ,
                                    CO-META:NeighbourhoodComponent .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/ILS#parameter_iterations
:parameter_iterations rdf:type owl:NamedIndividual ,
                               CO-META:ParameterValue ;
                      CO-META:hasType CO-META:Iterations ;
                      CO-META:hasValue 1000 .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/ILS#parameter_populationsize
:parameter_populationsize rdf:type owl:NamedIndividual ,
                                   CO-META:ParameterValue ;
                          CO-META:hasType CO-META:PopulationSize ;
                          CO-META:hasValue 1 .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/ILS#perturbation
:perturbation rdf:type owl:NamedIndividual ,
                       CO-META:VariationComponent ;
              CO-META:hasOutput :localsearch ;
              CO-META:usesComponent :perturbation_neighbourhood .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/ILS#perturbation_neighbourhood
:perturbation_neighbourhood rdf:type owl:NamedIndividual ,
                                     CO-META:NeighbourhoodComponent .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/ILS#stop
:stop rdf:type owl:NamedIndividual ,
               CO-META:StoppingCriterionComponent ;
      CO-META:hasCurrentOutput :acceptance ;
      CO-META:hasOutput :perturbation ;
      CO-META:hasParameter :parameter_iterations .


