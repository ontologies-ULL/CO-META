                                    CO-META:hasType CO-META:InertiaFactor .


###  https://w3id.org/ontologies-ULL/CO-META#PSO_parameter_iterations
CO-META:PSO_parameter_iterations rdf:type owl:NamedIndividual ,
                                          CO-META:ParameterValue ;
                                 CO-META:hasType CO-META:Iterations .


###  https://w3id.org/ontologies-ULL/CO-META#PSO_parameter_personalbestinfluence
CO-META:PSO_parameter_personalbestinfluence rdf:type owl:NamedIndividual ,
                                                     CO-META:ParameterValue ;
                                            CO-META:hasType CO-META:PersonalBestInfluence .


###  https://w3id.org/ontologies-ULL/CO-META#PSO_parameter_populationsize
CO-META:PSO_parameter_populationsize rdf:type owl:NamedIndividual ,
                                              CO-META:ParameterValue ;
                                     CO-META:hasType CO-META:PopulationSize .


###  https://w3id.org/ontologies-ULL/CO-META#PSO_parameter_populationsize_reference
CO-META:PSO_parameter_populationsize_reference rdf:type owl:NamedIndividual ,
                                                        CO-META:ParameterReference ;
                                               CO-META:refersTo CO-META:PSO_parameter_populationsize .


###  https://w3id.org/ontologies-ULL/CO-META#PSO_stop
CO-META:PSO_stop rdf:type owl:NamedIndividual ,
                          CO-META:StoppingCriterionComponent ;
                 CO-META:hasOutput CO-META:PSO_iterate_population ;
                 CO-META:hasParameter CO-META:PSO_parameter_iterations .


###  https://w3id.org/ontologies-ULL/CO-META#PSO_store_global_best
CO-META:PSO_store_global_best rdf:type owl:NamedIndividual ,
                                       CO-META:BestSolutionsUpdateComponent ;
                              CO-META:hasOutputStart CO-META:PSO_stop ;
                              CO-META:writesData CO-META:PSO_archive_global_best .


###  https://w3id.org/ontologies-ULL/CO-META#PSO_store_local_best
CO-META:PSO_store_local_best rdf:type owl:NamedIndividual ,
                                      CO-META:BestSolutionsUpdateComponent ;
                             CO-META:hasOutput CO-META:PSO_store_global_best ;
                             CO-META:writesData CO-META:PSO_archive_local_best ,
                                                CO-META:PSO_velocities .


###  https://w3id.org/ontologies-ULL/CO-META#PSO_update_global_best
CO-META:PSO_update_global_best rdf:type owl:NamedIndividual ,
                                        CO-META:BestSolutionsUpdateComponent ;
                               CO-META:hasOutput CO-META:PSO_iterate_population ;
                               CO-META:writesData CO-META:PSO_archive_global_best .


###  https://w3id.org/ontologies-ULL/CO-META#PSO_update_local_best
CO-META:PSO_update_local_best rdf:type owl:NamedIndividual ,
                                       CO-META:BestSolutionsUpdateComponent ;
                              CO-META:hasOutput CO-META:PSO_update_global_best ;
                              CO-META:writesData CO-META:PSO_archive_local_best .


###  https://w3id.org/ontologies-ULL/CO-META#PSO_update_velocity
CO-META:PSO_update_velocity rdf:type owl:NamedIndividual ,
                                     CO-META:VelocityUpdateComponent ;
                            CO-META:hasOutput CO-META:PSO_apply_velocity ;
                            CO-META:hasParameter CO-META:PSO_parameter_globalbestinfluence ,
                                                 CO-META:PSO_parameter_inertiafactor ,
                                                 CO-META:PSO_parameter_personalbestinfluence ;
                            CO-META:readsData CO-META:PSO_archive_global_best ,
                                              CO-META:PSO_archive_local_best ;
                            CO-META:writesData CO-META:PSO_velocities .


###  https://w3id.org/ontologies-ULL/CO-META#PSO_velocities
CO-META:PSO_velocities rdf:type owl:NamedIndividual ,
                                CO-META:DataStructure ;
                       CO-META:hasInitialValue CO-META:Zero ;
                       CO-META:hasShape CO-META:PSO_velocities_shape ;
                       CO-META:hasValueDomain CO-META:AnyReal .


###  https://w3id.org/ontologies-ULL/CO-META#PSO_velocities_shape
CO-META:PSO_velocities_shape rdf:type owl:NamedIndividual ,
                                      CO-META:MatrixShape ;
                             CO-META:hasColumnCount CO-META:SolutionFirstDimensionSize ;
                             CO-META:hasRowCount CO-META:PSO_parameter_populationsize_reference .


