                                      CO-META:hasDataStructure CO-META:PSO_archive_global_best ,
                                                               CO-META:PSO_archive_local_best ,
                                                               CO-META:PSO_velocities ;
                                      CO-META:hasStart CO-META:PSO_generate_population .


###  https://w3id.org/ontologies-ULL/CO-META#PSO_apply_velocity
CO-META:PSO_apply_velocity rdf:type owl:NamedIndividual ,
                                    CO-META:VelocityApplicationComponent ;
                           CO-META:hasOutput CO-META:PSO_update_local_best ;
                           CO-META:readsData CO-META:PSO_velocities .


###  https://w3id.org/ontologies-ULL/CO-META#PSO_archive_global_best
CO-META:PSO_archive_global_best rdf:type owl:NamedIndividual ,
                                         CO-META:DataStructure ;
                                CO-META:hasShape CO-META:Scalar ;
                                CO-META:hasValueDomain CO-META:AnySolution .


###  https://w3id.org/ontologies-ULL/CO-META#PSO_archive_local_best
CO-META:PSO_archive_local_best rdf:type owl:NamedIndividual ,
                                        CO-META:DataStructure ;
                               CO-META:hasShape CO-META:PSO_archive_local_best_shape ;
                               CO-META:hasValueDomain CO-META:AnySolution .


###  https://w3id.org/ontologies-ULL/CO-META#PSO_archive_local_best_shape
CO-META:PSO_archive_local_best_shape rdf:type owl:NamedIndividual ,
                                              CO-META:CollectionShape ;
                                     CO-META:hasLength CO-META:PSO_parameter_populationsize_reference ;
                                     CO-META:isDistinct "false"^^xsd:boolean ;
                                     CO-META:isOrdered "true"^^xsd:boolean .


###  https://w3id.org/ontologies-ULL/CO-META#PSO_generate_population
CO-META:PSO_generate_population rdf:type owl:NamedIndividual ,
                                         CO-META:PopulationGenerationComponent ,
                                         CO-META:RandomGenerationComponent ;
                                CO-META:hasOutput CO-META:PSO_store_local_best ;
                                CO-META:hasParameter CO-META:PSO_parameter_populationsize .


###  https://w3id.org/ontologies-ULL/CO-META#PSO_iterate_population
CO-META:PSO_iterate_population rdf:type owl:NamedIndividual ,
                                        CO-META:PopulationModifierComponent ;
                               CO-META:hasOutput CO-META:PSO_iterative_selector ;
                               CO-META:hasOutputEnd CO-META:PSO_stop ;
                               CO-META:hasParameter CO-META:PSO_parameter_populationsize .


###  https://w3id.org/ontologies-ULL/CO-META#PSO_iterative_selector
CO-META:PSO_iterative_selector rdf:type owl:NamedIndividual ,
                                        CO-META:SequentialIterativeSelectionComponent ;
                               CO-META:hasOutput CO-META:PSO_update_velocity .


###  https://w3id.org/ontologies-ULL/CO-META#PSO_parameter_globalbestinfluence
CO-META:PSO_parameter_globalbestinfluence rdf:type owl:NamedIndividual ,
                                                   CO-META:ParameterValue ;
                                          CO-META:hasType CO-META:GlobalBestInfluence .


###  https://w3id.org/ontologies-ULL/CO-META#PSO_parameter_inertiafactor
CO-META:PSO_parameter_inertiafactor rdf:type owl:NamedIndividual ,
