<https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/EA> rdf:type owl:Ontology ;
                                                                     owl:imports <https://w3id.org/ontologies-ULL/CO-META> ;
                                                                     rdfs:label "CO-META individuals for Evolutionary Algorithm"@en .

#################################################################
#    Individuals
#################################################################

###  https://w3id.org/ontologies-ULL/CO-META#EA_EvolutionaryAlgorithm
CO-META:EA_EvolutionaryAlgorithm rdf:type owl:NamedIndividual ,
                                          CO-META:Metaheuristic ;
                                 rdfs:label "Evolutionary Algorithm"@en .


###  https://w3id.org/ontologies-ULL/CO-META#EA_binary_tournament_selection
CO-META:EA_binary_tournament_selection rdf:type owl:NamedIndividual ,
                                                CO-META:TournamentSelectionComponent ;
                                       CO-META:hasInput CO-META:EA_next_generation .


###  https://w3id.org/ontologies-ULL/CO-META#EA_generate_population
CO-META:EA_generate_population rdf:type owl:NamedIndividual ,
                                        CO-META:PopulationGenerationComponent ;
                               CO-META:hasParameter CO-META:EA_parameter_populationsize ;
                               CO-META:isStartOf CO-META:EA_EvolutionaryAlgorithm .


###  https://w3id.org/ontologies-ULL/CO-META#EA_mutation
CO-META:EA_mutation rdf:type owl:NamedIndividual ,
                             CO-META:VariationComponent ;
                    CO-META:hasInput CO-META:EA_order_crossover ;
                    CO-META:hasParameter CO-META:EA_parameter_mutationprobability .


###  https://w3id.org/ontologies-ULL/CO-META#EA_next_generation
CO-META:EA_next_generation rdf:type owl:NamedIndividual ,
                                    CO-META:PopulationModifierComponent ;
                           CO-META:hasInput CO-META:EA_mutation ;
                           CO-META:hasInputStart CO-META:EA_stop .


###  https://w3id.org/ontologies-ULL/CO-META#EA_order_crossover
CO-META:EA_order_crossover rdf:type owl:NamedIndividual ,
                                    CO-META:CrossoverComponent ;
                           CO-META:hasInput CO-META:EA_binary_tournament_selection ;
                           CO-META:hasParameter CO-META:EA_parameter_crossoverprobability .


###  https://w3id.org/ontologies-ULL/CO-META#EA_parameter_crossoverprobability
CO-META:EA_parameter_crossoverprobability rdf:type owl:NamedIndividual ,
                                                   CO-META:ParameterValue ;
                                          CO-META:hasType CO-META:CrossoverProbability .


###  https://w3id.org/ontologies-ULL/CO-META#EA_parameter_iterations
CO-META:EA_parameter_iterations rdf:type owl:NamedIndividual ,
                                         CO-META:ParameterValue ;
                                CO-META:hasType CO-META:Iterations .


###  https://w3id.org/ontologies-ULL/CO-META#EA_parameter_mutationprobability
CO-META:EA_parameter_mutationprobability rdf:type owl:NamedIndividual ,
                                                  CO-META:ParameterValue ;
                                         CO-META:hasType CO-META:MutationProbability .


###  https://w3id.org/ontologies-ULL/CO-META#EA_parameter_populationsize
CO-META:EA_parameter_populationsize rdf:type owl:NamedIndividual ,
                                             CO-META:ParameterValue ;
                                    CO-META:hasType CO-META:PopulationSize .


###  https://w3id.org/ontologies-ULL/CO-META#EA_stop
CO-META:EA_stop rdf:type owl:NamedIndividual ,
                         CO-META:StoppingCriterionComponent ;
                CO-META:hasInputEnd CO-META:EA_next_generation ;
                CO-META:hasInputStart CO-META:EA_generate_population ;
                CO-META:hasParameter CO-META:EA_parameter_iterations .


