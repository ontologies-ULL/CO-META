#    Individuals
#################################################################

###  https://w3id.org/ontologies-ULL/CO-META#Both
:Both rdf:type owl:NamedIndividual ,
               :ComponentSafety .


###  https://w3id.org/ontologies-ULL/CO-META#CrossoverKPoints
:CrossoverKPoints rdf:type owl:NamedIndividual ,
                           :IntegerParameter ;
                  :minValue 1 .


###  https://w3id.org/ontologies-ULL/CO-META#CrossoverProbability
:CrossoverProbability rdf:type owl:NamedIndividual ,
                               :FloatParameter ;
                      :maxValue 1 ;
                      :minValue 0 .


###  https://w3id.org/ontologies-ULL/CO-META#Elitism
:Elitism rdf:type owl:NamedIndividual ,
                  :IntegerParameter ;
         :minValue 0 .


###  https://w3id.org/ontologies-ULL/CO-META#Iterations
:Iterations rdf:type owl:NamedIndividual ,
                     :IntegerParameter ;
            :minValue 0 .


###  https://w3id.org/ontologies-ULL/CO-META#MutationProbability
:MutationProbability rdf:type owl:NamedIndividual ,
                              :FloatParameter ;
                     :maxValue 1 ;
                     :minValue 0 .


###  https://w3id.org/ontologies-ULL/CO-META#PopulationSize
:PopulationSize rdf:type owl:NamedIndividual ,
                         :IntegerParameter ;
                :minValue 0 .


###  https://w3id.org/ontologies-ULL/CO-META#Safe
:Safe rdf:type owl:NamedIndividual ,
               :ComponentSafety .


###  https://w3id.org/ontologies-ULL/CO-META#StorageSize
:StorageSize rdf:type owl:NamedIndividual ,
                      :IntegerParameter ;
             :minValue 0 .


###  https://w3id.org/ontologies-ULL/CO-META#Time
:Time rdf:type owl:NamedIndividual ,
               :IntegerParameter ;
      :minValue 0 .


###  https://w3id.org/ontologies-ULL/CO-META#TournamentSize
:TournamentSize rdf:type owl:NamedIndividual ,
                         :IntegerParameter ;
                :minValue 1 .


###  https://w3id.org/ontologies-ULL/CO-META#Unsafe
:Unsafe rdf:type owl:NamedIndividual ,
                 :ComponentSafety .


#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :BoolParameter
                :FloatParameter
                :IntegerParameter
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :ComponentSafety
                :Constraint
                :DataStructure
                :Metaheuristic
                :MetaheuristicComponent
                :Objective
                :Parameter
                :ParameterValue
                :Problem
                :SolutionEncoding
                :SolutionNode
              )
] .


