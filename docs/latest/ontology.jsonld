  "http://creativecommons.org/ns#license" : [ {
    "@id" : "http://creativecommons.org/licenses/by-nc-sa/4.0/"
  } ],
  "http://purl.org/dc/elements/1.1/creator" : [ {
    "@value" : "Eduardo Segredo (https://orcid.org/0000-0002-4085-4356)"
  }, {
    "@value" : "Gara Miranda Valladares (http://orcid.org/0000-0002-2181-0067)"
  }, {
    "@value" : "Iván Castilla Rodríguez (http://orcid.org/0000-0003-3933-2582)"
  }, {
    "@value" : "Miguel Luna García (http://orcid.org/0009-0006-6611-4360)"
  } ],
  "http://purl.org/dc/elements/1.1/description" : [ {
    "@language" : "en",
    "@value" : "Ontology for Combinatory Optimization Metaheuristics"
  }, {
    "@language" : "es",
    "@value" : "Ontología para Metaheurísticas de Optimización Combinatoria"
  } ],
  "http://purl.org/dc/elements/1.1/source" : [ {
    "@id" : "https://github.com/ontologies-ULL/CO-META"
  } ],
  "http://purl.org/dc/terms/abstract" : [ {
    "@language" : "es",
    "@value" : "Esta ontología proporciona un marco estructurado para la interoperabilidad de fuentes de datos y aplicaciones en el contexto de las metaheurísticas de optimización combinatoria."
  }, {
    "@language" : "en",
    "@value" : "This ontology provides a structured framework for the interoperability of data sources and applications in the context of combinatory optimization metaheuristics."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "CO-META"
  }, {
    "@language" : "es",
    "@value" : "CO-META"
  } ],
  "http://www.w3.org/2002/07/owl#versionIRI" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META/1.0"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#AcceptanceComponent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Component that accepts one solution out of two or more candidate solutions according to their fitness. In multiobjective optimization it requires a preceding fitness assignment component."
  }, {
    "@language" : "es",
    "@value" : "Componente que acepta una solución entre dos o más soluciones candidatas según su aptitud. En optimización multiobjetivo requiere un componente de asignación de aptitud previo."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Acceptance Component"
  }, {
    "@language" : "es",
    "@value" : "Componente de aceptación"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#MetaheuristicComponent"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#Bit",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Nodo de solución que toma un valor binario (0 o 1)."
  }, {
    "@language" : "en",
    "@value" : "Solution node that takes a binary value (0 or 1)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Bit"
  }, {
    "@language" : "es",
    "@value" : "Bit"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#SolutionNode"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#BoolParameter",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Parameter whose value is a boolean (true or false)."
  }, {
    "@language" : "es",
    "@value" : "Parámetro cuyo valor es un booleano (verdadero o falso)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Boolean Parameter"
  }, {
    "@language" : "es",
    "@value" : "Parámetro booleano"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#Parameter"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#Both",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#ComponentSafety"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#ComponentSafety",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Enumeración (Safe, Unsafe, Both) que indica si un componente metaheurístico garantiza que las soluciones que produce son factibles, puede producir soluciones no factibles o admite ambos comportamientos."
  }, {
    "@language" : "en",
    "@value" : "Enumeration (Safe, Unsafe, Both) that indicates whether a metaheuristic component guarantees that the solutions it produces are feasible, may produce infeasible solutions, or supports both behaviours."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Component Safety"
  }, {
    "@language" : "es",
    "@value" : "Seguridad del componente"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid6"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#CompositeEncoding",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Solución codificada como una combinación de varias codificaciones, cada una de las cuales representa una parte distinta de la solución."
  }, {
    "@language" : "en",
    "@value" : "Solution encoded as a combination of several encodings, each of which represents a different part of the solution."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Codificación compuesta"
  }, {
    "@language" : "en",
    "@value" : "Composite Encoding"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#SolutionEncoding"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#Constraint",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Condición que debe cumplir una solución de un problema de optimización para ser factible."
  }, {
    "@language" : "en",
    "@value" : "Condition that a solution of an optimization problem must satisfy in order to be feasible."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Constraint"
  }, {
    "@language" : "es",
    "@value" : "Restricción"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#ConstructionComponent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Component that constructs a solution or a group of solutions step by step using heuristic methods."
  }, {
    "@language" : "es",
    "@value" : "Componente que construye una solución o un grupo de soluciones paso a paso mediante métodos heurísticos."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Componente de construcción"
  }, {
    "@language" : "en",
    "@value" : "Construction Component"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#MetaheuristicComponent"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#ConstructiveMetaheuristic",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Metaheuristic that builds solutions incrementally."
  }, {
    "@language" : "es",
    "@value" : "Metaheurística que construye soluciones de forma incremental."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Constructive Metaheuristic"
  }, {
    "@language" : "es",
    "@value" : "Metaheurística constructiva"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid10"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#CrossoverComponent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Componente de modificación que produce uno o más individuos descendientes recombinando dos o más individuos progenitores. Tiene un parámetro de probabilidad de cruce."
  }, {
    "@language" : "en",
    "@value" : "Modification component that produces one or more offspring individuals by recombining two or more parent individuals. It has a crossover probability parameter."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Componente de cruce"
  }, {
    "@language" : "en",
    "@value" : "Crossover Component"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/CO-META#ModificationComponent"
  }, {
    "@id" : "_:genid14"
  }, {
    "@id" : "_:genid16"
  }, {
    "@id" : "_:genid17"
  } ]
}, {
