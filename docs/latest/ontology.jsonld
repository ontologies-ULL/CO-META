    "@language" : "es",
    "@value" : "Nodo de solución cuyo tipo de valor está definido por el usuario y no corresponde a ninguno de los tipos de nodo predefinidos."
  }, {
    "@language" : "en",
    "@value" : "Solution node whose value type is user-defined and does not correspond to any of the predefined node types."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Custom Node"
  }, {
    "@language" : "es",
