  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/CO-META#DataHandlerComponent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Component that updates specific data structures used by the algorithm."
  }, {
    "@language" : "es",
    "@value" : "Componente que actualiza estructuras de datos específicas utilizadas por el algoritmo."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Componente manejador de datos"
  }, {
    "@language" : "en",
    "@value" : "Data Handler Component"
  } ],
