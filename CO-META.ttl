@prefix : <https://w3id.org/ontologies-ULL/CO-META#> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix CO-META: <https://w3id.org/ontologies-ULL/CO-META#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@base <https://w3id.org/ontologies-ULL/CO-META#> .

<https://w3id.org/ontologies-ULL/CO-META> rdf:type owl:Ontology ;
                                           owl:versionIRI <https://w3id.org/ontologies-ULL/CO-META/1.0> ;
                                           cc:license <http://creativecommons.org/licenses/by-nc-sa/4.0/> ;
                                           dc:creator "Eduardo Segredo (https://orcid.org/0000-0002-4085-4356)" ,
                                                      "Gara Miranda Valladares (http://orcid.org/0000-0002-2181-0067)" ,
                                                      "Iván Castilla Rodríguez (http://orcid.org/0000-0003-3933-2582)" ,
                                                      "Miguel Luna García (http://orcid.org/0009-0006-6611-4360)" ;
                                           dc:description "Ontology for Combinatory Optimization Metaheuristics"@en ,
                                                          "Ontología para Metaheurísticas de Optimización Combinatoria"@es ;
                                           dc:source <https://github.com/ontologies-ULL/CO-META> ;
                                           dcterms:abstract "Esta ontología proporciona un marco estructurado para la interoperabilidad de fuentes de datos y aplicaciones en el contexto de las metaheurísticas de optimización combinatoria."@es ,
                                                            "This ontology provides a structured framework for the interoperability of data sources and applications in the context of combinatory optimization metaheuristics."@en ;
                                           rdfs:label "CO-META"@en ,
                                                      "CO-META"@es .

#################################################################
#    Annotation properties
#################################################################

###  http://creativecommons.org/ns#license
cc:license rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/creator
dc:creator rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/description
dc:description rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/source
dc:source rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/abstract
dcterms:abstract rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/ontologies-ULL/CO-META#hasCodification
CO-META:hasCodification rdf:type owl:ObjectProperty ;
                        owl:inverseOf CO-META:isCodificationOf ;
                        rdfs:domain [ rdf:type owl:Class ;
                                      owl:unionOf ( CO-META:Metaheuristic
                                                    CO-META:Problem
                                                  )
                                    ] ;
                        rdfs:range CO-META:SolutionEncoding .


###  https://w3id.org/ontologies-ULL/CO-META#hasConstraint
CO-META:hasConstraint rdf:type owl:ObjectProperty ;
                      owl:inverseOf CO-META:isConstraintOf ;
                      rdfs:domain CO-META:Problem ;
                      rdfs:range CO-META:Constraint .


###  https://w3id.org/ontologies-ULL/CO-META#hasDataStructure
CO-META:hasDataStructure rdf:type owl:ObjectProperty ;
                         rdfs:domain CO-META:Metaheuristic ;
                         rdfs:range CO-META:DataStructure .


###  https://w3id.org/ontologies-ULL/CO-META#hasInput
CO-META:hasInput rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf CO-META:isConnectedTo ;
                 owl:inverseOf CO-META:hasOutput .


###  https://w3id.org/ontologies-ULL/CO-META#hasInputEnd
CO-META:hasInputEnd rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf CO-META:hasInput ;
                    owl:inverseOf CO-META:hasOutputEnd .


###  https://w3id.org/ontologies-ULL/CO-META#hasInputStart
CO-META:hasInputStart rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf CO-META:hasInput ;
                      owl:inverseOf CO-META:hasOutputStart .


###  https://w3id.org/ontologies-ULL/CO-META#hasNodeType
CO-META:hasNodeType rdf:type owl:ObjectProperty ;
                    rdfs:domain CO-META:SolutionEncoding ;
                    rdfs:range CO-META:SolutionNode .


###  https://w3id.org/ontologies-ULL/CO-META#hasObjective
CO-META:hasObjective rdf:type owl:ObjectProperty ;
                     owl:inverseOf CO-META:isObjectiveOf ;
                     rdfs:domain CO-META:Problem ;
                     rdfs:range CO-META:Objective .


###  https://w3id.org/ontologies-ULL/CO-META#hasOutput
CO-META:hasOutput rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf CO-META:isConnectedTo ;
                  rdfs:domain CO-META:MetaheuristicComponent ;
                  rdfs:range CO-META:MetaheuristicComponent .


###  https://w3id.org/ontologies-ULL/CO-META#hasOutputEnd
CO-META:hasOutputEnd rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf CO-META:hasOutput ;
                     rdfs:domain CO-META:LoopComponent .


###  https://w3id.org/ontologies-ULL/CO-META#hasOutputStart
CO-META:hasOutputStart rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf CO-META:hasOutput ;
                       rdfs:range CO-META:LoopComponent .


###  https://w3id.org/ontologies-ULL/CO-META#hasParameter
CO-META:hasParameter rdf:type owl:ObjectProperty ;
                     owl:inverseOf CO-META:isParameterOf ;
                     rdfs:domain CO-META:MetaheuristicComponent ;
                     rdfs:range CO-META:ParameterValue .


###  https://w3id.org/ontologies-ULL/CO-META#hasSafety
CO-META:hasSafety rdf:type owl:ObjectProperty ;
                  rdfs:domain CO-META:MetaheuristicComponent ;
                  rdfs:range CO-META:ComponentSafety .


###  https://w3id.org/ontologies-ULL/CO-META#hasStart
CO-META:hasStart rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf CO-META:isConnectedTo ;
                 owl:inverseOf CO-META:isStartOf ;
                 rdfs:domain CO-META:Metaheuristic ;
                 rdfs:range CO-META:MetaheuristicComponent .


###  https://w3id.org/ontologies-ULL/CO-META#hasType
CO-META:hasType rdf:type owl:ObjectProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain CO-META:ParameterValue ;
                rdfs:range CO-META:Parameter .


###  https://w3id.org/ontologies-ULL/CO-META#isCodificationOf
CO-META:isCodificationOf rdf:type owl:ObjectProperty .


###  https://w3id.org/ontologies-ULL/CO-META#isConnectedTo
CO-META:isConnectedTo rdf:type owl:ObjectProperty ,
                               owl:TransitiveProperty ;
                      owl:propertyChainAxiom ( CO-META:hasOutput
                                               CO-META:isConnectedTo
                                             ) .


###  https://w3id.org/ontologies-ULL/CO-META#isConstraintOf
CO-META:isConstraintOf rdf:type owl:ObjectProperty .


###  https://w3id.org/ontologies-ULL/CO-META#isObjectiveOf
CO-META:isObjectiveOf rdf:type owl:ObjectProperty .


###  https://w3id.org/ontologies-ULL/CO-META#isParameterOf
CO-META:isParameterOf rdf:type owl:ObjectProperty .


###  https://w3id.org/ontologies-ULL/CO-META#isStartOf
CO-META:isStartOf rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf CO-META:isConnectedTo .


###  https://w3id.org/ontologies-ULL/CO-META#readsData
CO-META:readsData rdf:type owl:ObjectProperty ;
                  rdfs:domain CO-META:MetaheuristicComponent ;
                  rdfs:range CO-META:DataStructure .


###  https://w3id.org/ontologies-ULL/CO-META#writesData
CO-META:writesData rdf:type owl:ObjectProperty ;
                   rdfs:domain CO-META:DataHandlerComponent ;
                   rdfs:range CO-META:DataStructure .


#################################################################
#    Data properties
#################################################################

###  https://w3id.org/ontologies-ULL/CO-META#hasCodeReference
CO-META:hasCodeReference rdf:type owl:DatatypeProperty ;
                         rdfs:domain CO-META:MetaheuristicComponent ;
                         rdfs:range xsd:string .


###  https://w3id.org/ontologies-ULL/CO-META#hasInputSize
CO-META:hasInputSize rdf:type owl:DatatypeProperty ;
                     rdfs:domain CO-META:MetaheuristicComponent ;
                     rdfs:range xsd:integer .


###  https://w3id.org/ontologies-ULL/CO-META#hasOutputSize
CO-META:hasOutputSize rdf:type owl:DatatypeProperty ;
                      rdfs:domain CO-META:MetaheuristicComponent ;
                      rdfs:range xsd:integer .


###  https://w3id.org/ontologies-ULL/CO-META#hasSize
CO-META:hasSize rdf:type owl:DatatypeProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain CO-META:SolutionEncoding ;
                rdfs:range xsd:integer .


###  https://w3id.org/ontologies-ULL/CO-META#hasValue
CO-META:hasValue rdf:type owl:DatatypeProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain CO-META:ParameterValue .


###  https://w3id.org/ontologies-ULL/CO-META#maxValue
CO-META:maxValue rdf:type owl:DatatypeProperty ;
                 rdfs:domain CO-META:Parameter ;
                 rdfs:range xsd:decimal .


###  https://w3id.org/ontologies-ULL/CO-META#minValue
CO-META:minValue rdf:type owl:DatatypeProperty ;
                 rdfs:domain CO-META:Parameter ;
                 rdfs:range xsd:decimal .


#################################################################
#    Classes
#################################################################

###  https://w3id.org/ontologies-ULL/CO-META#AcceptanceComponent
CO-META:AcceptanceComponent rdf:type owl:Class ;
                            rdfs:subClassOf CO-META:MetaheuristicComponent ;
                            rdfs:comment "Component that accepts one solution out of two or more candidate solutions according to their fitness. In multiobjective optimization it requires a preceding fitness assignment component."@en ,
                                         "Componente que acepta una solución entre dos o más soluciones candidatas según su aptitud. En optimización multiobjetivo requiere un componente de asignación de aptitud previo."@es ;
                            rdfs:label "Acceptance Component"@en ,
                                       "Componente de aceptación"@es .


###  https://w3id.org/ontologies-ULL/CO-META#Bit
CO-META:Bit rdf:type owl:Class ;
            rdfs:subClassOf CO-META:SolutionNode ;
            rdfs:comment "Nodo de solución que toma un valor binario (0 o 1)."@es ,
                         "Solution node that takes a binary value (0 or 1)."@en ;
            rdfs:label "Bit"@en ,
                       "Bit"@es .


###  https://w3id.org/ontologies-ULL/CO-META#BoolParameter
CO-META:BoolParameter rdf:type owl:Class ;
                      rdfs:subClassOf CO-META:Parameter ;
                      rdfs:comment "Parameter whose value is a boolean (true or false)."@en ,
                                   "Parámetro cuyo valor es un booleano (verdadero o falso)."@es ;
                      rdfs:label "Boolean Parameter"@en ,
                                 "Parámetro booleano"@es .


###  https://w3id.org/ontologies-ULL/CO-META#ComponentSafety
CO-META:ComponentSafety rdf:type owl:Class ;
                        owl:equivalentClass [ rdf:type owl:Class ;
                                              owl:oneOf ( CO-META:Both
                                                          CO-META:Safe
                                                          CO-META:Unsafe
                                                        )
                                            ] ;
                        rdfs:comment "Enumeración (Safe, Unsafe, Both) que indica si un componente metaheurístico garantiza que las soluciones que produce son factibles, puede producir soluciones no factibles o admite ambos comportamientos."@es ,
                                     "Enumeration (Safe, Unsafe, Both) that indicates whether a metaheuristic component guarantees that the solutions it produces are feasible, may produce infeasible solutions, or supports both behaviours."@en ;
                        rdfs:label "Component Safety"@en ,
                                   "Seguridad del componente"@es .


###  https://w3id.org/ontologies-ULL/CO-META#CompositeEncoding
CO-META:CompositeEncoding rdf:type owl:Class ;
                          rdfs:subClassOf CO-META:SolutionEncoding ;
                          rdfs:comment "Solución codificada como una combinación de varias codificaciones, cada una de las cuales representa una parte distinta de la solución."@es ,
                                       "Solution encoded as a combination of several encodings, each of which represents a different part of the solution."@en ;
                          rdfs:label "Codificación compuesta"@es ,
                                     "Composite Encoding"@en .


###  https://w3id.org/ontologies-ULL/CO-META#Constraint
CO-META:Constraint rdf:type owl:Class ;
                   rdfs:comment "Condición que debe cumplir una solución de un problema de optimización para ser factible."@es ,
                                "Condition that a solution of an optimization problem must satisfy in order to be feasible."@en ;
                   rdfs:label "Constraint"@en ,
                              "Restricción"@es .


###  https://w3id.org/ontologies-ULL/CO-META#ConstructionComponent
CO-META:ConstructionComponent rdf:type owl:Class ;
                              rdfs:subClassOf CO-META:MetaheuristicComponent ;
                              rdfs:comment "Component that constructs a solution or a group of solutions step by step using heuristic methods."@en ,
                                           "Componente que construye una solución o un grupo de soluciones paso a paso mediante métodos heurísticos."@es ;
                              rdfs:label "Componente de construcción"@es ,
                                         "Construction Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#ConstructiveMetaheuristic
CO-META:ConstructiveMetaheuristic rdf:type owl:Class ;
                                  owl:equivalentClass [ owl:intersectionOf ( CO-META:Metaheuristic
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty CO-META:isConnectedTo ;
                                                                               owl:someValuesFrom CO-META:ConstructionComponent
                                                                             ]
                                                                           ) ;
                                                        rdf:type owl:Class
                                                      ] ;
                                  rdfs:comment "Metaheuristic that builds solutions incrementally."@en ,
                                               "Metaheurística que construye soluciones de forma incremental."@es ;
                                  rdfs:label "Constructive Metaheuristic"@en ,
                                             "Metaheurística constructiva"@es .


###  https://w3id.org/ontologies-ULL/CO-META#CrossoverComponent
CO-META:CrossoverComponent rdf:type owl:Class ;
                           rdfs:subClassOf CO-META:ModificationComponent ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty CO-META:hasParameter ;
                                             owl:someValuesFrom [ rdf:type owl:Restriction ;
                                                                  owl:onProperty CO-META:hasType ;
                                                                  owl:hasValue CO-META:CrossoverProbability
                                                                ]
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty CO-META:hasInputSize ;
                                             owl:hasValue 2
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty CO-META:hasOutputSize ;
                                             owl:hasValue 2
                                           ] ;
                           rdfs:comment "Componente de modificación que produce uno o más individuos descendientes recombinando dos o más individuos progenitores. Tiene un parámetro de probabilidad de cruce."@es ,
                                        "Modification component that produces one or more offspring individuals by recombining two or more parent individuals. It has a crossover probability parameter."@en ;
                           rdfs:label "Componente de cruce"@es ,
                                      "Crossover Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#Custom
CO-META:Custom rdf:type owl:Class ;
               rdfs:subClassOf CO-META:SolutionNode ;
               rdfs:comment "Nodo de solución cuyo tipo de valor está definido por el usuario y no corresponde a ninguno de los tipos de nodo predefinidos."@es ,
                            "Solution node whose value type is user-defined and does not correspond to any of the predefined node types."@en ;
               rdfs:label "Custom Node"@en ,
                          "Nodo personalizado"@es .


###  https://w3id.org/ontologies-ULL/CO-META#DataHandlerComponent
CO-META:DataHandlerComponent rdf:type owl:Class ;
                             rdfs:subClassOf CO-META:MetaheuristicComponent ;
                             rdfs:comment "Component that updates specific data structures used by the algorithm."@en ,
                                          "Componente que actualiza estructuras de datos específicas utilizadas por el algoritmo."@es ;
                             rdfs:label "Componente manejador de datos"@es ,
                                        "Data Handler Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#DataStructure
CO-META:DataStructure rdf:type owl:Class ;
                      rdfs:comment "Data structure that stores information used by the algorithm during its execution."@en ,
                                   "Estructura de datos que almacena información utilizada por el algoritmo durante su ejecución."@es ;
                      rdfs:label "Data Structure"@en ,
                                 "Estructura de datos"@es .


###  https://w3id.org/ontologies-ULL/CO-META#DiversityPreservationComponent
CO-META:DiversityPreservationComponent rdf:type owl:Class ;
                                       rdfs:subClassOf CO-META:MultiobjectiveComponent ;
                                       rdfs:comment "Componente multiobjetivo que ajusta los valores de aptitud para fomentar la diversidad en la población."@es ,
                                                    "Multiobjective component that adjusts fitness values to encourage diversity in the population."@en ;
                                       rdfs:label "Componente de preservación de la diversidad"@es ,
                                                  "Diversity Preservation Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#EvolutionaryAlgorithm
CO-META:EvolutionaryAlgorithm rdf:type owl:Class ;
                              owl:equivalentClass [ owl:intersectionOf ( CO-META:PopulationBasedMetaheuristic
                                                                         [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                                                  owl:onProperty CO-META:isConnectedTo ;
                                                                                                  owl:someValuesFrom CO-META:CrossoverComponent
                                                                                                ]
                                                                                                [ rdf:type owl:Restriction ;
                                                                                                  owl:onProperty CO-META:isConnectedTo ;
                                                                                                  owl:someValuesFrom CO-META:SelectionComponent
                                                                                                ]
                                                                                                [ rdf:type owl:Restriction ;
                                                                                                  owl:onProperty CO-META:isConnectedTo ;
                                                                                                  owl:someValuesFrom CO-META:VariationComponent
                                                                                                ]
                                                                                              ) ;
                                                                           rdf:type owl:Class
                                                                         ]
                                                                       ) ;
                                                    rdf:type owl:Class
                                                  ] ;
                              rdfs:comment "Metaheuristic based on evolutionary algorithms, employing selection, crossover and variation processes."@en ,
                                           "Metaheurística basada en algoritmos evolutivos, utilizando procesos de selección, cruce y variación."@es ;
                              rdfs:label "Algoritmo evolutivo"@es ,
                                         "Evolutionary Algorithm"@en .


###  https://w3id.org/ontologies-ULL/CO-META#FitnessAssignmentComponent
CO-META:FitnessAssignmentComponent rdf:type owl:Class ;
                                   rdfs:subClassOf CO-META:MultiobjectiveComponent ;
                                   rdfs:comment "Componente multiobjetivo que asigna un valor de aptitud individual a cada miembro de una población."@es ,
                                                "Multiobjective component that assigns a single fitness value to each member of a population."@en ;
                                   rdfs:label "Componente de asignación de aptitud"@es ,
                                              "Fitness Assignment Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#FloatParameter
CO-META:FloatParameter rdf:type owl:Class ;
                       rdfs:subClassOf CO-META:Parameter ;
                       rdfs:comment "Parameter whose value is a real (decimal) number."@en ,
                                    "Parámetro cuyo valor es un número real (decimal)."@es ;
                       rdfs:label "Float Parameter"@en ,
                                  "Parámetro real"@es .


###  https://w3id.org/ontologies-ULL/CO-META#GenerationComponent
CO-META:GenerationComponent rdf:type owl:Class ;
                            rdfs:subClassOf CO-META:MetaheuristicComponent ;
                            rdfs:comment "Component that generates an initial solution or an initial population."@en ,
                                         "Componente que genera una solución inicial o una población inicial."@es ;
                            rdfs:label "Componente de generación"@es ,
                                       "Generation Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#Integer
CO-META:Integer rdf:type owl:Class ;
                rdfs:subClassOf CO-META:SolutionNode ;
                rdfs:comment "Nodo de solución que toma un valor entero."@es ,
                             "Solution node that takes an integer value."@en ;
                rdfs:label "Integer Node"@en ,
                           "Nodo entero"@es .


###  https://w3id.org/ontologies-ULL/CO-META#IntegerParameter
CO-META:IntegerParameter rdf:type owl:Class ;
                         rdfs:subClassOf CO-META:Parameter ;
                         rdfs:comment "Parameter whose value is an integer number."@en ,
                                      "Parámetro cuyo valor es un número entero."@es ;
                         rdfs:label "Integer Parameter"@en ,
                                    "Parámetro entero"@es .


###  https://w3id.org/ontologies-ULL/CO-META#IterativeSelectionComponent
CO-META:IterativeSelectionComponent rdf:type owl:Class ;
                                    rdfs:subClassOf CO-META:SelectionComponent ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty CO-META:hasOutputSize ;
                                                      owl:hasValue 1
                                                    ] ;
                                    rdfs:comment "Componente de selección que selecciona un único individuo en cada invocación, por lo que se aplica repetidamente para seleccionar varios individuos."@es ,
                                                 "Selection component that selects a single individual per invocation, so it is applied repeatedly to select several individuals."@en ;
                                    rdfs:label "Componente de selección iterativa"@es ,
                                               "Iterative Selection Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#KPointCrossoverComponent
CO-META:KPointCrossoverComponent rdf:type owl:Class ;
                                 rdfs:subClassOf CO-META:CrossoverComponent ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty CO-META:hasParameter ;
                                                   owl:someValuesFrom [ rdf:type owl:Restriction ;
                                                                        owl:onProperty CO-META:hasType ;
                                                                        owl:hasValue CO-META:CrossoverKPoints
                                                                      ]
                                                 ] ;
                                 rdfs:comment "Componente de cruce que divide a los progenitores en k puntos de corte e intercambia los segmentos resultantes. Tiene un parámetro para el número de puntos de corte."@es ,
                                              "Crossover component that splits the parents at k cut points and exchanges the resulting segments. It has a parameter for the number of cut points."@en ;
                                 rdfs:label "Componente de cruce de k puntos"@es ,
                                            "K-Point Crossover Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#ListEncoding
CO-META:ListEncoding rdf:type owl:Class ;
                     rdfs:subClassOf CO-META:SolutionEncoding ;
                     rdfs:comment "Solución codificada como una secuencia ordenada de nodos que puede contener valores repetidos."@es ,
                                  "Solution encoded as an ordered sequence of nodes that may contain repeated values."@en ;
                     rdfs:label "Codificación de lista"@es ,
                                "List Encoding"@en .


###  https://w3id.org/ontologies-ULL/CO-META#LocalSearchComponent
CO-META:LocalSearchComponent rdf:type owl:Class ;
                             rdfs:subClassOf CO-META:ModificationComponent ;
                             rdfs:comment "Componente de modificación que mejora la aptitud de una solución explorando su vecindario."@es ,
                                          "Modification component that improves the fitness of a solution by exploring its neighbourhood."@en ;
                             rdfs:label "Componente de búsqueda local"@es ,
                                        "Local Search Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#LocalSearchMetaheuristic
CO-META:LocalSearchMetaheuristic rdf:type owl:Class ;
                                 owl:equivalentClass [ owl:intersectionOf ( CO-META:Metaheuristic
                                                                            [ rdf:type owl:Restriction ;
                                                                              owl:onProperty CO-META:isConnectedTo ;
                                                                              owl:someValuesFrom CO-META:GenerationComponent
                                                                            ]
                                                                          ) ;
                                                       rdf:type owl:Class
                                                     ] ;
                                 rdfs:comment "Metaheuristic that starts from complete solutions and iteratively improves them."@en ,
                                              "Metaheurística que parte de soluciones completas y las mejora iterativamente."@es ;
                                 rdfs:label "Local Search Metaheuristic"@en ,
                                            "Metaheurística de búsqueda local"@es .


###  https://w3id.org/ontologies-ULL/CO-META#LoopComponent
CO-META:LoopComponent rdf:type owl:Class ;
                      rdfs:subClassOf CO-META:MetaheuristicComponent ;
                      rdfs:comment "Component that creates loops to iterate through data structures or to repeat processes until a condition is met. It has two additional properties: hasOutputStart and hasOutputEnd."@en ,
                                   "Componente que crea bucles para recorrer estructuras de datos o repetir procesos hasta que se cumple una condición. Tiene dos propiedades adicionales: hasOutputStart y hasOutputEnd."@es ;
                      rdfs:label "Componente de bucle"@es ,
                                 "Loop Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#MatrixEncoding
CO-META:MatrixEncoding rdf:type owl:Class ;
                       rdfs:subClassOf CO-META:SolutionEncoding ;
                       rdfs:comment "Solución codificada como una disposición bidimensional de nodos organizados en filas y columnas."@es ,
                                    "Solution encoded as a two-dimensional arrangement of nodes organized in rows and columns."@en ;
                       rdfs:label "Codificación matricial"@es ,
                                  "Matrix Encoding"@en .


###  https://w3id.org/ontologies-ULL/CO-META#MaximizationObjective
CO-META:MaximizationObjective rdf:type owl:Class ;
                              rdfs:subClassOf CO-META:Objective ;
                              owl:disjointWith CO-META:MinimizationObjective ;
                              rdfs:comment "Objective of an optimization problem whose value must be maximized."@en ,
                                           "Objetivo de un problema de optimización cuyo valor debe maximizarse."@es ;
                              rdfs:label "Maximization Objective"@en ,
                                         "Objetivo de maximización"@es .


###  https://w3id.org/ontologies-ULL/CO-META#MemeticAlgorithm
CO-META:MemeticAlgorithm rdf:type owl:Class ;
                         owl:equivalentClass [ owl:intersectionOf ( CO-META:EvolutionaryAlgorithm
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty CO-META:isConnectedTo ;
                                                                      owl:someValuesFrom CO-META:LocalSearchComponent
                                                                    ]
                                                                  ) ;
                                               rdf:type owl:Class
                                             ] ;
                         rdfs:comment "Algoritmo evolutivo que además utiliza procesos de búsqueda local."@es ,
                                      "Evolutionary algorithm that employs local search processes."@en ;
                         rdfs:label "Algoritmo memético"@es ,
                                    "Memetic Algorithm"@en .


###  https://w3id.org/ontologies-ULL/CO-META#Metaheuristic
CO-META:Metaheuristic rdf:type owl:Class ;
                      rdfs:comment "High-level algorithmic procedure, composed of interconnected metaheuristic components, that finds sufficiently good solutions to optimization problems by searching through vast solution spaces."@en ,
                                   "Procedimiento algorítmico de alto nivel, compuesto por componentes metaheurísticos interconectados, que encuentran soluciones suficientemente buenas a problemas de optimización mediante búsquedas en amplios espacios de soluciones."@es ;
                      rdfs:label "Metaheuristic"@en ,
                                 "Metaheurística"@es .


###  https://w3id.org/ontologies-ULL/CO-META#MetaheuristicComponent
CO-META:MetaheuristicComponent rdf:type owl:Class ;
                               rdfs:comment "Bloque constructivo de una metaheurística que realiza una tarea específica y se conecta con otros componentes."@es ,
                                            "Building block of a metaheuristic that performs a specific task and is connected to other components."@en ;
                               rdfs:label "Componente metaheurístico"@es ,
                                          "Metaheuristic Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#MinimizationObjective
CO-META:MinimizationObjective rdf:type owl:Class ;
                              rdfs:subClassOf CO-META:Objective ;
                              rdfs:comment "Objective of an optimization problem whose value must be minimized."@en ,
                                           "Objetivo de un problema de optimización cuyo valor debe minimizarse."@es ;
                              rdfs:label "Minimization Objective"@en ,
                                         "Objetivo de minimización"@es .


###  https://w3id.org/ontologies-ULL/CO-META#ModificationComponent
CO-META:ModificationComponent rdf:type owl:Class ;
                              rdfs:subClassOf CO-META:MetaheuristicComponent ;
                              rdfs:comment "Component that modifies a solution or a population."@en ,
                                           "Componente que modifica una solución o una población."@es ;
                              rdfs:label "Componente de modificación"@es ,
                                         "Modification Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#MultiobjectiveComponent
CO-META:MultiobjectiveComponent rdf:type owl:Class ;
                                rdfs:subClassOf CO-META:MetaheuristicComponent ;
                                rdfs:comment "Component used in multiobjective optimization. It is required before acceptance components."@en ,
                                             "Componente utilizado en optimización multiobjetivo. Es necesario antes de los componentes de aceptación."@es ;
                                rdfs:label "Componente multiobjetivo"@es ,
                                           "Multiobjective Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#NeighbourhoodComponent
CO-META:NeighbourhoodComponent rdf:type owl:Class ;
                               rdfs:subClassOf CO-META:ModificationComponent ;
                               rdfs:comment "Componente de modificación que genera soluciones vecinas de una solución dada aplicando un operador de movimiento."@es ,
                                            "Modification component that generates neighbouring solutions of a given solution by applying a move operator."@en ;
                               rdfs:label "Componente de vecindario"@es ,
                                          "Neighbourhood Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#Objective
CO-META:Objective rdf:type owl:Class ;
                  rdfs:comment "Objective of an optimization problem. This class should not be instantiated directly; its subclasses should be used instead."@en ,
                               "Objetivo de un problema de optimización. Esta clase no debe instanciarse directamente; deben usarse sus subclases."@es ;
                  rdfs:label "Objective"@en ,
                             "Objetivo"@es .


###  https://w3id.org/ontologies-ULL/CO-META#Parameter
CO-META:Parameter rdf:type owl:Class ;
                  rdfs:comment "Define la estructura de un parámetro utilizado por un componente, como su tipo y su rango de valores válidos."@es ,
                               "Defines the structure of a parameter used by a component, such as its type and its valid range of values."@en ;
                  rdfs:label "Parameter"@en ,
                             "Parámetro"@es .


###  https://w3id.org/ontologies-ULL/CO-META#ParameterValue
CO-META:ParameterValue rdf:type owl:Class ;
                       rdfs:comment "Valor asignado a un parámetro para un componente concreto."@es ,
                                    "Value assigned to a parameter for a specific component."@en ;
                       rdfs:label "Parameter Value"@en ,
                                  "Valor de parámetro"@es .


###  https://w3id.org/ontologies-ULL/CO-META#PartiallyMappedCrossoverComponent
CO-META:PartiallyMappedCrossoverComponent rdf:type owl:Class ;
                                          rdfs:subClassOf CO-META:CrossoverComponent ;
                                          rdfs:comment "Componente de cruce para permutaciones que intercambia un segmento entre los progenitores y repara las posiciones restantes mediante la correspondencia definida por dicho segmento (PMX)."@es ,
                                                       "Crossover component for permutations that exchanges a segment between parents and repairs the remaining positions using the mapping defined by that segment (PMX)."@en ;
                                          rdfs:label "Componente de cruce parcialmente mapeado"@es ,
                                                     "Partially Mapped Crossover Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#PermutationEncoding
CO-META:PermutationEncoding rdf:type owl:Class ;
                            rdfs:subClassOf CO-META:SolutionEncoding ;
                            rdfs:comment "Solución codificada como una ordenación de elementos distintos, sin repeticiones."@es ,
                                         "Solution encoded as an ordered arrangement of distinct elements, without repetitions."@en ;
                            rdfs:label "Codificación de permutación"@es ,
                                       "Permutation Encoding"@en .


###  https://w3id.org/ontologies-ULL/CO-META#PopulationBasedMetaheuristic
CO-META:PopulationBasedMetaheuristic rdf:type owl:Class ;
                                     owl:equivalentClass [ owl:intersectionOf ( CO-META:Metaheuristic
                                                                                [ rdf:type owl:Restriction ;
                                                                                  owl:onProperty CO-META:isConnectedTo ;
                                                                                  owl:someValuesFrom [ rdf:type owl:Class ;
                                                                                                       owl:unionOf ( CO-META:PopulationConstructionComponent
                                                                                                                     CO-META:PopulationGenerationComponent
                                                                                                                   )
                                                                                                     ]
                                                                                ]
                                                                              ) ;
                                                           rdf:type owl:Class
                                                         ] ;
                                     owl:disjointWith CO-META:SingleSolutionMetaheuristic ;
                                     rdfs:comment "Metaheuristic that works with a population of solutions."@en ,
                                                  "Metaheurística que trabaja con una población de soluciones."@es ;
                                     rdfs:label "Metaheurística basada en población"@es ,
                                                "Population Based Metaheuristic"@en .


###  https://w3id.org/ontologies-ULL/CO-META#PopulationConstructionComponent
CO-META:PopulationConstructionComponent rdf:type owl:Class ;
                                        owl:equivalentClass [ owl:intersectionOf ( CO-META:ConstructionComponent
                                                                                   [ rdf:type owl:Restriction ;
                                                                                     owl:onProperty CO-META:hasParameter ;
                                                                                     owl:someValuesFrom [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                                                                                 owl:onProperty CO-META:hasType ;
                                                                                                                                 owl:hasValue CO-META:PopulationSize
                                                                                                                               ]
                                                                                                                               [ rdf:type owl:Restriction ;
                                                                                                                                 owl:onProperty CO-META:hasValue ;
                                                                                                                                 owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                                                                                      owl:onDatatype xsd:integer ;
                                                                                                                                                      owl:withRestrictions ( [ xsd:minExclusive 1
                                                                                                                                                                             ]
                                                                                                                                                                           )
                                                                                                                                                    ]
                                                                                                                               ]
                                                                                                                             ) ;
                                                                                                          rdf:type owl:Class
                                                                                                        ]
                                                                                   ]
                                                                                 ) ;
                                                              rdf:type owl:Class
                                                            ] ;
                                        rdfs:subClassOf CO-META:ConstructionComponent ;
                                        owl:disjointWith CO-META:SingleSolutionConstructionComponent ;
                                        rdfs:comment "Componente de construcción que construye una población de más de una solución."@es ,
                                                     "Construction component that builds a population of more than one solution."@en ;
                                        rdfs:label "Componente de construcción de población"@es ,
                                                   "Population Construction Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#PopulationGenerationComponent
CO-META:PopulationGenerationComponent rdf:type owl:Class ;
                                      owl:equivalentClass [ owl:intersectionOf ( CO-META:GenerationComponent
                                                                                 [ rdf:type owl:Restriction ;
                                                                                   owl:onProperty CO-META:hasParameter ;
                                                                                   owl:someValuesFrom [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                                                                               owl:onProperty CO-META:hasType ;
                                                                                                                               owl:hasValue CO-META:PopulationSize
                                                                                                                             ]
                                                                                                                             [ rdf:type owl:Restriction ;
                                                                                                                               owl:onProperty CO-META:hasValue ;
                                                                                                                               owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                                                                                    owl:onDatatype xsd:integer ;
                                                                                                                                                    owl:withRestrictions ( [ xsd:minExclusive 1
                                                                                                                                                                           ]
                                                                                                                                                                         )
                                                                                                                                                  ]
                                                                                                                             ]
                                                                                                                           ) ;
                                                                                                        rdf:type owl:Class
                                                                                                      ]
                                                                                 ]
                                                                               ) ;
                                                            rdf:type owl:Class
                                                          ] ;
                                      rdfs:subClassOf CO-META:GenerationComponent ;
                                      owl:disjointWith CO-META:SingleSolutionGenerationComponent ;
                                      rdfs:comment "Componente de generación que genera una población inicial de más de una solución."@es ,
                                                   "Generation component that generates an initial population of more than one solution."@en ;
                                      rdfs:label "Componente de generación de población"@es ,
                                                 "Population Generation Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#PopulationModifierComponent
CO-META:PopulationModifierComponent rdf:type owl:Class ;
                                    rdfs:subClassOf CO-META:LoopComponent ;
                                    owl:disjointWith CO-META:StoppingCriterionComponent ;
                                    rdfs:comment "Componente de bucle que repite un proceso parcial, tomando la población anterior como entrada, hasta completar la nueva población."@es ,
                                                 "Loop component that repeats a partial process, taking the old population as input, until the new population is filled."@en ;
                                    rdfs:label "Componente modificador de población"@es ,
                                               "Population Modifier Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#PopulationOperatorComponent
CO-META:PopulationOperatorComponent rdf:type owl:Class ;
                                    rdfs:subClassOf CO-META:ModificationComponent ;
                                    rdfs:comment "Componente de modificación que opera sobre poblaciones completas."@es ,
                                                 "Modification component that operates on whole populations."@en ;
                                    rdfs:label "Componente operador de población"@es ,
                                               "Population Operator Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#Problem
CO-META:Problem rdf:type owl:Class ;
                rdfs:subClassOf [ rdf:type owl:Restriction ;
                                  owl:onProperty CO-META:hasObjective ;
                                  owl:someValuesFrom CO-META:Objective
                                ] ;
                rdfs:comment "Optimization problem, defined by at least one objective and optionally by constraints and a solution codification."@en ,
                             "Problema de optimización, definido por al menos un objetivo y, opcionalmente, por restricciones y una codificación de solución."@es ;
                rdfs:label "Problem"@en ,
                           "Problema"@es .


###  https://w3id.org/ontologies-ULL/CO-META#RandomDecisionCrossoverComponent
CO-META:RandomDecisionCrossoverComponent rdf:type owl:Class ;
                                         rdfs:subClassOf CO-META:CrossoverComponent ;
                                         rdfs:comment "Componente de cruce que decide aleatoriamente, para cada posición, de qué progenitor hereda el valor el descendiente."@es ,
                                                      "Crossover component that decides randomly, for each position, from which parent the offspring inherits the value."@en ;
                                         rdfs:label "Componente de cruce por decisión aleatoria"@es ,
                                                    "Random Decision Crossover Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#RandomSelectionComponent
CO-META:RandomSelectionComponent rdf:type owl:Class ;
                                 rdfs:subClassOf CO-META:SelectionComponent ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty CO-META:hasOutputSize ;
                                                   owl:hasValue 2
                                                 ] ;
                                 rdfs:comment "Componente de selección que selecciona aleatoriamente una pareja de individuos."@es ,
                                              "Selection component that selects a pair of individuals at random."@en ;
                                 rdfs:label "Componente de selección aleatoria"@es ,
                                            "Random Selection Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#ScalarEncoding
CO-META:ScalarEncoding rdf:type owl:Class ;
                       rdfs:subClassOf CO-META:SolutionEncoding ;
                       rdfs:comment "Solución codificada como un único nodo que contiene un solo valor."@es ,
                                    "Solution encoded as a single node that holds one value."@en ;
                       rdfs:label "Codificación escalar"@es ,
                                  "Scalar Encoding"@en .


###  https://w3id.org/ontologies-ULL/CO-META#SelectionComponent
CO-META:SelectionComponent rdf:type owl:Class ;
                           rdfs:subClassOf CO-META:ModificationComponent ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty CO-META:hasParameter ;
                                             owl:someValuesFrom [ rdf:type owl:Restriction ;
                                                                  owl:onProperty CO-META:hasType ;
                                                                  owl:hasValue CO-META:Elitism
                                                                ]
                                           ] ;
                           rdfs:comment "Componente de modificación que selecciona los individuos que formarán parte de la siguiente generación. Tiene un parámetro de elitismo."@es ,
                                        "Modification component that selects the individuals that will take part in the next generation. It has an elitism parameter."@en ;
                           rdfs:label "Componente de selección"@es ,
                                      "Selection Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#SimplePairSelectionComponent
CO-META:SimplePairSelectionComponent rdf:type owl:Class ;
                                     rdfs:subClassOf CO-META:SelectionComponent ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty CO-META:hasOutputSize ;
                                                       owl:hasValue 2
                                                     ] ;
                                     rdfs:comment "Componente de selección que selecciona individuos por parejas en orden."@es ,
                                                  "Selection component that selects pairs of individuals in order."@en ;
                                     rdfs:label "Componente de selección simple por parejas"@es ,
                                                "Simple Pair Selection Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#SingleSolutionConstructionComponent
CO-META:SingleSolutionConstructionComponent rdf:type owl:Class ;
                                            owl:equivalentClass [ owl:intersectionOf ( CO-META:ConstructionComponent
                                                                                       [ rdf:type owl:Restriction ;
                                                                                         owl:onProperty CO-META:hasParameter ;
                                                                                         owl:someValuesFrom [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                                                                                     owl:onProperty CO-META:hasType ;
                                                                                                                                     owl:hasValue CO-META:PopulationSize
                                                                                                                                   ]
                                                                                                                                   [ rdf:type owl:Restriction ;
                                                                                                                                     owl:onProperty CO-META:hasValue ;
                                                                                                                                     owl:hasValue 1
                                                                                                                                   ]
                                                                                                                                 ) ;
                                                                                                              rdf:type owl:Class
                                                                                                            ]
                                                                                       ]
                                                                                     ) ;
                                                                  rdf:type owl:Class
                                                                ] ;
                                            rdfs:subClassOf CO-META:ConstructionComponent ;
                                            rdfs:comment "Componente de construcción que construye una única solución (tamaño de población igual a 1)."@es ,
                                                         "Construction component that builds a single solution (population size equal to 1)."@en ;
                                            rdfs:label "Componente de construcción de solución única"@es ,
                                                       "Single Solution Construction Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#SingleSolutionGenerationComponent
CO-META:SingleSolutionGenerationComponent rdf:type owl:Class ;
                                          owl:equivalentClass [ owl:intersectionOf ( CO-META:GenerationComponent
                                                                                     [ rdf:type owl:Restriction ;
                                                                                       owl:onProperty CO-META:hasParameter ;
                                                                                       owl:someValuesFrom [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                                                                                   owl:onProperty CO-META:hasType ;
                                                                                                                                   owl:hasValue CO-META:PopulationSize
                                                                                                                                 ]
                                                                                                                                 [ rdf:type owl:Restriction ;
                                                                                                                                   owl:onProperty CO-META:hasValue ;
                                                                                                                                   owl:hasValue 1
                                                                                                                                 ]
                                                                                                                               ) ;
                                                                                                            rdf:type owl:Class
                                                                                                          ]
                                                                                     ]
                                                                                   ) ;
                                                                rdf:type owl:Class
                                                              ] ;
                                          rdfs:subClassOf CO-META:GenerationComponent ;
                                          rdfs:comment "Componente de generación que genera una única solución inicial (tamaño de población igual a 1)."@es ,
                                                       "Generation component that generates a single initial solution (population size equal to 1)."@en ;
                                          rdfs:label "Componente de generación de solución única"@es ,
                                                     "Single Solution Generation Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#SingleSolutionMetaheuristic
CO-META:SingleSolutionMetaheuristic rdf:type owl:Class ;
                                    owl:equivalentClass [ owl:intersectionOf ( CO-META:Metaheuristic
                                                                               [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty CO-META:isConnectedTo ;
                                                                                 owl:someValuesFrom [ rdf:type owl:Class ;
                                                                                                      owl:unionOf ( CO-META:SingleSolutionConstructionComponent
                                                                                                                    CO-META:SingleSolutionGenerationComponent
                                                                                                                  )
                                                                                                    ]
                                                                               ]
                                                                             ) ;
                                                          rdf:type owl:Class
                                                        ] ;
                                    rdfs:comment "Metaheuristic that works with a single solution at a time."@en ,
                                                 "Metaheurística que trabaja con una única solución a la vez."@es ;
                                    rdfs:label "Metaheurística basada en solución única"@es ,
                                               "Single Solution Based Metaheuristic"@en .


###  https://w3id.org/ontologies-ULL/CO-META#SolutionEncoding
CO-META:SolutionEncoding rdf:type owl:Class ;
                         rdfs:subClassOf [ rdf:type owl:Restriction ;
                                           owl:onProperty CO-META:hasSize ;
                                           owl:someValuesFrom xsd:integer
                                         ] ;
                         rdfs:comment "Codificación de solución utilizada en un problema de optimización, compuesta por nodos de solución y con un tamaño determinado."@es ,
                                      "Solution encoding used in an optimization problem, composed of solution nodes and with a given size."@en ;
                         rdfs:label "Codificación de una solución"@es ,
                                    "Solution Encoding"@en .


###  https://w3id.org/ontologies-ULL/CO-META#SolutionNode
CO-META:SolutionNode rdf:type owl:Class ;
                     rdfs:comment "Parte más pequeña de una solución, que contiene un único valor."@es ,
                                  "Smallest part of a solution, which holds a single value."@en ;
                     rdfs:label "Nodo de solución"@es ,
                                "Solution Node"@en .


###  https://w3id.org/ontologies-ULL/CO-META#StoppingCriterionComponent
CO-META:StoppingCriterionComponent rdf:type owl:Class ;
                                   rdfs:subClassOf CO-META:LoopComponent ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty CO-META:hasParameter ;
                                                     owl:someValuesFrom [ rdf:type owl:Restriction ;
                                                                          owl:onProperty CO-META:hasType ;
                                                                          owl:hasValue CO-META:Iterations
                                                                        ]
                                                   ] ;
                                   rdfs:comment "Componente de bucle que crea el bucle principal del algoritmo y determina cuándo detenerlo. Tiene un parámetro de número de iteraciones."@es ,
                                                "Loop component that creates the main loop of the algorithm and determines when to stop it. It has an iterations parameter."@en ;
                                   rdfs:label "Componente de criterio de parada"@es ,
                                              "Stopping Criterion Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#TournamentSelectionComponent
CO-META:TournamentSelectionComponent rdf:type owl:Class ;
                                     rdfs:subClassOf CO-META:SelectionComponent ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty CO-META:hasParameter ;
                                                       owl:someValuesFrom [ rdf:type owl:Restriction ;
                                                                            owl:onProperty CO-META:hasType ;
                                                                            owl:hasValue CO-META:TournamentSize
                                                                          ]
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty CO-META:hasOutputSize ;
                                                       owl:hasValue 2
                                                     ] ;
                                     rdfs:comment "Componente de selección que selecciona cada individuo como el mejor de un grupo elegido aleatoriamente (torneo). Tiene un parámetro de tamaño de torneo."@es ,
                                                  "Selection component that selects each individual as the best one of a randomly chosen group (tournament). It has a tournament size parameter."@en ;
                                     rdfs:label "Componente de selección por torneo"@es ,
                                                "Tournament Selection Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#UpdateBestComponent
CO-META:UpdateBestComponent rdf:type owl:Class ;
                            rdfs:subClassOf CO-META:MetaheuristicComponent ;
                            rdfs:comment "Component that updates the best solution or solutions found so far by the algorithm."@en ,
                                         "Componente que actualiza la mejor solución o soluciones encontradas hasta el momento por el algoritmo."@es ;
                            rdfs:label "Componente de actualización del mejor"@es ,
                                       "Update Best Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#VariationComponent
CO-META:VariationComponent rdf:type owl:Class ;
                           rdfs:subClassOf CO-META:ModificationComponent ;
                           rdfs:comment "Componente de modificación que introduce pequeños cambios aleatorios en una solución (mutación)."@es ,
                                        "Modification component that introduces small random changes to a solution (mutation)."@en ;
                           rdfs:label "Componente de variación"@es ,
                                      "Variation Component"@en .


#################################################################
#    Individuals
#################################################################

###  https://w3id.org/ontologies-ULL/CO-META#Both
CO-META:Both rdf:type owl:NamedIndividual ,
                      CO-META:ComponentSafety .


###  https://w3id.org/ontologies-ULL/CO-META#CrossoverKPoints
CO-META:CrossoverKPoints rdf:type owl:NamedIndividual ,
                                  CO-META:IntegerParameter ;
                         CO-META:minValue 1 .


###  https://w3id.org/ontologies-ULL/CO-META#CrossoverProbability
CO-META:CrossoverProbability rdf:type owl:NamedIndividual ,
                                      CO-META:FloatParameter ;
                             CO-META:maxValue 1 ;
                             CO-META:minValue 0 .


###  https://w3id.org/ontologies-ULL/CO-META#Elitism
CO-META:Elitism rdf:type owl:NamedIndividual ,
                         CO-META:IntegerParameter ;
                CO-META:minValue 0 .


###  https://w3id.org/ontologies-ULL/CO-META#Iterations
CO-META:Iterations rdf:type owl:NamedIndividual ,
                            CO-META:IntegerParameter ;
                   CO-META:minValue 0 .


###  https://w3id.org/ontologies-ULL/CO-META#MutationProbability
CO-META:MutationProbability rdf:type owl:NamedIndividual ,
                                     CO-META:FloatParameter ;
                            CO-META:maxValue 1 ;
                            CO-META:minValue 0 .


###  https://w3id.org/ontologies-ULL/CO-META#PopulationSize
CO-META:PopulationSize rdf:type owl:NamedIndividual ,
                                CO-META:IntegerParameter ;
                       CO-META:minValue 0 .


###  https://w3id.org/ontologies-ULL/CO-META#Safe
CO-META:Safe rdf:type owl:NamedIndividual ,
                      CO-META:ComponentSafety .


###  https://w3id.org/ontologies-ULL/CO-META#StorageSize
CO-META:StorageSize rdf:type owl:NamedIndividual ,
                             CO-META:IntegerParameter ;
                    CO-META:minValue 0 .


