                         CO-META:hasLowerBound CO-META:One ;
                         rdfs:comment "Value domain of the integers greater than or equal to 1 (e.g. a number of cities)."@en ,
                                      "Dominio de valores con los enteros mayores o iguales que 1 (p. ej., un número de ciudades)."@es ;
