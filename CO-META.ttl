#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( CO-META:BaseType
                CO-META:ComponentSafety
                CO-META:DataShape
                CO-META:DataStructure
                CO-META:Metaheuristic
                CO-META:MetaheuristicComponent
                CO-META:Parameter
                CO-META:ParameterValue
                CO-META:Problem
                CO-META:ProblemElement
                CO-META:ValueDomain
                CO-META:ValueSpecification
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( CO-META:Constraint
                CO-META:Objective
                CO-META:ProblemQuantity
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( CO-META:CollectionShape
                CO-META:CompositeShape
                CO-META:MatrixShape
                CO-META:ScalarShape
                CO-META:TableShape
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( CO-META:LiteralValue
                CO-META:ParameterReference
                CO-META:SolutionSizeReference
              )
] .


[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( CO-META:Booleans
                        CO-META:Integers
                        CO-META:Reals
                        CO-META:Solutions
                      )
] .


