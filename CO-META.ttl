                            CO-META:hasLowerBound CO-META:Zero ;
                            rdfs:comment "Value domain of the integers greater than or equal to 0 (e.g. a number of iterations)."@en ,
                                         "Dominio de valores con los enteros mayores o iguales que 0 (p. ej., un número de iteraciones)."@es ;
                            rdfs:label "Non-Negative Integers"@en ,
                                       "Enteros no negativos"@es .


###  https://w3id.org/ontologies-ULL/CO-META#NonNegativeReals
CO-META:NonNegativeReals rdf:type owl:NamedIndividual ,
                                  CO-META:ValueDomain ;
                         CO-META:hasBaseType CO-META:Reals ;
                         CO-META:hasLowerBound CO-META:Zero ;
                         rdfs:comment "Value domain of the real numbers greater than or equal to 0 (e.g. a weight)."@en ,
                                      "Dominio de valores con los reales mayores o iguales que 0 (p. ej., un peso)."@es ;
                         rdfs:label "Non-Negative Reals"@en ,
                                    "Reales no negativos"@es .


###  https://w3id.org/ontologies-ULL/CO-META#One
CO-META:One rdf:type owl:NamedIndividual ,
                     CO-META:LiteralValue ;
            CO-META:hasLiteralValue 1 ;
            rdfs:comment "The number 1, as a literal value for sizes and bounds."@en ,
                         "El número 1, como valor literal para tamaños y cotas."@es ;
            rdfs:label "One"@en ,
