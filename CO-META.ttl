                     CO-META:hasBaseType CO-META:Reals ;
                     CO-META:hasLowerBound CO-META:Zero ;
                     CO-META:hasUpperBound CO-META:One ;
                     rdfs:comment "Value domain of the real numbers between 0 and 1 (e.g. a probability)."@en ,
                                  "Dominio de valores con los reales entre 0 y 1 (p. ej., una probabilidad)."@es ;
                     rdfs:label "Unit Interval"@en ,
                                "Intervalo unidad"@es .


