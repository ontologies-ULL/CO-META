###  https://w3id.org/ontologies-ULL/CO-META#AnyBoolean
CO-META:AnyBoolean rdf:type owl:NamedIndividual ,
                            CO-META:ValueDomain ;
                   CO-META:hasBaseType CO-META:Booleans ;
                   rdfs:comment "Value domain of all truth values."@en ,
                                "Dominio de valores con todos los valores de verdad."@es ;
                   rdfs:label "Any Boolean"@en ,
                              "Cualquier booleano"@es .


###  https://w3id.org/ontologies-ULL/CO-META#AnyInteger
CO-META:AnyInteger rdf:type owl:NamedIndividual ,
                            CO-META:ValueDomain ;
                   CO-META:hasBaseType CO-META:Integers ;
                   rdfs:comment "Value domain of all integer numbers, without bounds."@en ,
                                "Dominio de valores con todos los números enteros, sin cotas."@es ;
                   rdfs:label "Any Integer"@en ,
                              "Cualquier entero"@es .


###  https://w3id.org/ontologies-ULL/CO-META#AnyReal
CO-META:AnyReal rdf:type owl:NamedIndividual ,
                         CO-META:ValueDomain ;
                CO-META:hasBaseType CO-META:Reals ;
                rdfs:comment "Value domain of all real numbers, without bounds."@en ,
                             "Dominio de valores con todos los números reales, sin cotas."@es ;
                rdfs:label "Any Real"@en ,
                           "Cualquier real"@es .


###  https://w3id.org/ontologies-ULL/CO-META#AnySolution
CO-META:AnySolution rdf:type owl:NamedIndividual ,
                             CO-META:ValueDomain ;
                    CO-META:hasBaseType CO-META:Solutions ;
                    rdfs:comment "Value domain of all candidate solutions of the problem being solved."@en ,
                                 "Dominio de valores con todas las soluciones candidatas del problema que se resuelve."@es ;
                    rdfs:label "Any Solution"@en ,
                               "Cualquier solución"@es .


###  https://w3id.org/ontologies-ULL/CO-META#BinaryIntegers
CO-META:BinaryIntegers rdf:type owl:NamedIndividual ,
                                CO-META:ValueDomain ;
                       CO-META:hasBaseType CO-META:Integers ;
                       CO-META:hasLowerBound CO-META:Zero ;
                       CO-META:hasUpperBound CO-META:One ;
                       rdfs:comment "Value domain of the integers 0 and 1 (e.g. whether an item is selected)."@en ,
                                    "Dominio de valores con los enteros 0 y 1 (p. ej., si un objeto se selecciona)."@es ;
                       rdfs:label "Binary Integers"@en ,
                                  "Enteros binarios"@es .


###  https://w3id.org/ontologies-ULL/CO-META#Booleans
CO-META:Booleans rdf:type owl:NamedIndividual ,
                          CO-META:BaseType ;
                 rdfs:comment "Set of truth values {false, true}."@en ,
                              "Conjunto de valores de verdad {falso, verdadero}."@es ;
                 rdfs:label "Booleans"@en ,
                            "Booleanos"@es .


###  https://w3id.org/ontologies-ULL/CO-META#Both
CO-META:Both rdf:type owl:NamedIndividual ,
                      CO-META:ComponentSafety .


