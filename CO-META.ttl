###  https://w3id.org/ontologies-ULL/CO-META#SolutionFirstDimensionSize
CO-META:SolutionFirstDimensionSize rdf:type owl:NamedIndividual ,
                                            CO-META:SolutionSizeReference ;
                                   CO-META:hasDimensionIndex "1"^^xsd:positiveInteger ;
                                   rdfs:comment "Size of the first dimension of the solution handled by the algorithm: the length of a sequence or the number of rows of a matrix."@en ,
                                                "Tamaño de la primera dimensión de la solución que maneja el algoritmo: la longitud de una secuencia o el número de filas de una matriz."@es ;
                                   rdfs:label "Solution First Dimension Size"@en ,
                                              "Tamaño de la primera dimensión de la solución"@es .


###  https://w3id.org/ontologies-ULL/CO-META#SolutionSecondDimensionSize
CO-META:SolutionSecondDimensionSize rdf:type owl:NamedIndividual ,
                                             CO-META:SolutionSizeReference ;
                                    CO-META:hasDimensionIndex "2"^^xsd:positiveInteger ;
                                    rdfs:comment "Size of the second dimension of the solution handled by the algorithm: the number of columns of a matrix."@en ,
                                                 "Tamaño de la segunda dimensión de la solución que maneja el algoritmo: el número de columnas de una matriz."@es ;
                                    rdfs:label "Solution Second Dimension Size"@en ,
                                               "Tamaño de la segunda dimensión de la solución"@es .


###  https://w3id.org/ontologies-ULL/CO-META#Solutions
CO-META:Solutions rdf:type owl:NamedIndividual ,
                           CO-META:BaseType ;
                  rdfs:comment "Set of candidate solutions of the problem being solved. It is the base type of data structures that store solutions (e.g. archives or tabu lists)."@en ,
                               "Conjunto de soluciones candidatas del problema que se resuelve. Es el tipo base de las estructuras de datos que almacenan soluciones (p. ej., archivos o listas tabú)."@es ;
                  rdfs:label "Solutions"@en ,
                             "Soluciones"@es .


