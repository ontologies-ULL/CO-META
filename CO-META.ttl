@prefix : <https://w3id.org/ontologies-ULL/CO-META#> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix CO-META: <https://w3id.org/ontologies-ULL/CO-META#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@base <https://w3id.org/ontologies-ULL/CO-META#> .

<https://w3id.org/ontologies-ULL/CO-META> rdf:type owl:Ontology ;
                                           owl:versionIRI <https://w3id.org/ontologies-ULL/CO-META/1.0> ;
                                           owl:imports <https://w3id.org/ontologies-ULL/CO-META/imports/qudt> ;
                                           cc:license <http://creativecommons.org/licenses/by-nc-sa/4.0/> ;
                                           dc:creator "Eduardo Segredo (https://orcid.org/0000-0002-4085-4356)" ,
                                                      "Gara Miranda Valladares (http://orcid.org/0000-0002-2181-0067)" ,
                                                      "Iván Castilla Rodríguez (http://orcid.org/0000-0003-3933-2582)" ,
                                                      "Miguel Luna García (http://orcid.org/0009-0006-6611-4360)" ;
                                           dc:description "Ontology for Combinatory Optimization Metaheuristics"@en ,
                                                          "Ontología para Metaheurísticas de Optimización Combinatoria"@es ;
                                           dc:source <https://github.com/ontologies-ULL/CO-META> ;
                                           dcterms:abstract "Esta ontología proporciona un marco estructurado para la interoperabilidad de fuentes de datos y aplicaciones en el contexto de las metaheurísticas de optimización combinatoria."@es ,
                                                            "This ontology provides a structured framework for the interoperability of data sources and applications in the context of combinatory optimization metaheuristics."@en ;
                                           rdfs:label "CO-META"@en ,
                                                      "CO-META"@es .

#################################################################
#    Annotation properties
#################################################################

###  http://creativecommons.org/ns#license
cc:license rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/creator
dc:creator rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/description
dc:description rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/source
dc:source rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/abstract
dcterms:abstract rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/ontologies-ULL/CO-META#hasBaseType
CO-META:hasBaseType rdf:type owl:ObjectProperty ,
                             owl:FunctionalProperty ;
                    rdfs:domain CO-META:ValueDomain ;
                    rdfs:range CO-META:BaseType ;
                    rdfs:comment "Number set to which the values of a value domain belong."@en ,
                                 "Conjunto numérico al que pertenecen los valores de un dominio de valores."@es ;
                    rdfs:label "has base type"@en ,
                               "tiene tipo base"@es .


###  https://w3id.org/ontologies-ULL/CO-META#hasColumn
CO-META:hasColumn rdf:type owl:ObjectProperty ;
                  rdfs:domain CO-META:TableShape ;
                  rdfs:range CO-META:Column ;
                  rdfs:comment "Relates a table shape to each of the attributes that describe its records."@en ,
                               "Relaciona una forma de tabla con cada uno de los atributos que describen sus registros."@es ;
                  rdfs:label "has column"@en ,
                             "tiene columna"@es .


###  https://w3id.org/ontologies-ULL/CO-META#hasColumnCount
CO-META:hasColumnCount rdf:type owl:ObjectProperty ,
                                owl:FunctionalProperty ;
                       rdfs:domain CO-META:MatrixShape ;
                       rdfs:range CO-META:ValueSpecification ;
                       rdfs:comment "Number of columns of a matrix."@en ,
                                    "Número de columnas de una matriz."@es ;
                       rdfs:label "has column count"@en ,
                                  "tiene número de columnas"@es .


###  https://w3id.org/ontologies-ULL/CO-META#hasComponent
CO-META:hasComponent rdf:type owl:ObjectProperty ;
                     rdfs:domain CO-META:CompositeShape ;
                     rdfs:range CO-META:DataShape ;
                     rdfs:comment "Relates a composite shape to each of the shapes it combines."@en ,
                                  "Relaciona una forma compuesta con cada una de las formas que combina."@es ;
                     rdfs:label "has component"@en ,
                                "tiene componente"@es .


###  https://w3id.org/ontologies-ULL/CO-META#hasConstraint
CO-META:hasConstraint rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf CO-META:hasProblemElement ;
                      owl:inverseOf CO-META:isConstraintOf ;
                      rdfs:domain CO-META:Problem ;
                      rdfs:range CO-META:Constraint .


###  https://w3id.org/ontologies-ULL/CO-META#hasDataStructure
CO-META:hasDataStructure rdf:type owl:ObjectProperty ;
                         rdfs:domain CO-META:Metaheuristic ;
                         rdfs:range CO-META:DataStructure .


###  https://w3id.org/ontologies-ULL/CO-META#hasInput
CO-META:hasInput rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf CO-META:isConnectedTo ;
                 owl:inverseOf CO-META:hasOutput .


###  https://w3id.org/ontologies-ULL/CO-META#hasInputEnd
CO-META:hasInputEnd rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf CO-META:hasInput ;
                    owl:inverseOf CO-META:hasOutputEnd .


###  https://w3id.org/ontologies-ULL/CO-META#hasInputStart
CO-META:hasInputStart rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf CO-META:hasInput ;
                      owl:inverseOf CO-META:hasOutputStart .


###  https://w3id.org/ontologies-ULL/CO-META#hasLength
CO-META:hasLength rdf:type owl:ObjectProperty ,
                           owl:FunctionalProperty ;
                  rdfs:domain CO-META:CollectionShape ;
                  rdfs:range CO-META:ValueSpecification ;
                  rdfs:comment "Number of values of a collection."@en ,
                               "Número de valores de una colección."@es ;
                  rdfs:label "has length"@en ,
                             "tiene longitud"@es .


###  https://w3id.org/ontologies-ULL/CO-META#hasLowerBound
CO-META:hasLowerBound rdf:type owl:ObjectProperty ,
                               owl:FunctionalProperty ;
                      rdfs:domain CO-META:ValueDomain ;
                      rdfs:range CO-META:ValueSpecification ;
                      rdfs:comment "Smallest value of a value domain. If it is not stated, no lower bound is imposed."@en ,
                                   "Menor valor de un dominio de valores. Si no se indica, no se impone cota inferior."@es ;
                      rdfs:label "has lower bound"@en ,
                                 "tiene cota inferior"@es .


###  https://w3id.org/ontologies-ULL/CO-META#hasObjective
CO-META:hasObjective rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf CO-META:hasProblemElement ;
                     owl:inverseOf CO-META:isObjectiveOf ;
                     rdfs:domain CO-META:Problem ;
                     rdfs:range CO-META:Objective .


###  https://w3id.org/ontologies-ULL/CO-META#hasOutput
CO-META:hasOutput rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf CO-META:isConnectedTo ;
                  rdfs:domain CO-META:MetaheuristicComponent ;
                  rdfs:range CO-META:MetaheuristicComponent .


###  https://w3id.org/ontologies-ULL/CO-META#hasOutputEnd
CO-META:hasOutputEnd rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf CO-META:hasOutput ;
                     rdfs:domain CO-META:LoopComponent .


###  https://w3id.org/ontologies-ULL/CO-META#hasOutputStart
CO-META:hasOutputStart rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf CO-META:hasOutput ;
                       rdfs:range CO-META:LoopComponent .


###  https://w3id.org/ontologies-ULL/CO-META#hasParameter
CO-META:hasParameter rdf:type owl:ObjectProperty ;
                     owl:inverseOf CO-META:isParameterOf ;
                     rdfs:domain CO-META:MetaheuristicComponent ;
                     rdfs:range CO-META:ParameterValue .


###  https://w3id.org/ontologies-ULL/CO-META#hasProblemElement
CO-META:hasProblemElement rdf:type owl:ObjectProperty ;
                          rdfs:domain CO-META:Problem ;
                          rdfs:range CO-META:ProblemElement ;
                          rdfs:comment "Relaciona un problema con cada uno de los constituyentes de su formulación: datos, variables de decisión, objetivos y restricciones."@es ,
                                       "Relates a problem to each of the constituents of its formulation: data, decision variables, objectives and constraints."@en ;
                          rdfs:label "has problem element"@en ,
                                     "tiene elemento del problema"@es .


###  https://w3id.org/ontologies-ULL/CO-META#hasRowCount
CO-META:hasRowCount rdf:type owl:ObjectProperty ,
                             owl:FunctionalProperty ;
                    rdfs:domain [ rdf:type owl:Class ;
                                  owl:unionOf ( CO-META:MatrixShape
                                                CO-META:TableShape
                                              )
                                ] ;
                    rdfs:range CO-META:ValueSpecification ;
                    rdfs:comment "Number of rows of a matrix, or of records of a table."@en ,
                                 "Número de filas de una matriz, o de registros de una tabla."@es ;
                    rdfs:label "has row count"@en ,
                               "tiene número de filas"@es .


###  https://w3id.org/ontologies-ULL/CO-META#hasSafety
CO-META:hasSafety rdf:type owl:ObjectProperty ;
                  rdfs:domain CO-META:MetaheuristicComponent ;
                  rdfs:range CO-META:ComponentSafety .


###  https://w3id.org/ontologies-ULL/CO-META#hasShape
CO-META:hasShape rdf:type owl:ObjectProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain [ rdf:type owl:Class ;
                               owl:unionOf ( CO-META:DataStructure
                                             CO-META:DecisionVariable
                                             CO-META:ProblemData
                                           )
                             ] ;
                 rdfs:range CO-META:DataShape ;
                 rdfs:comment "Shape in which the values of a quantity or of a data structure are organized."@en ,
                              "Forma en que se organizan los valores de una magnitud o de una estructura de datos."@es ;
                 rdfs:label "has shape"@en ,
                            "tiene forma"@es .


###  https://w3id.org/ontologies-ULL/CO-META#hasStart
CO-META:hasStart rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf CO-META:isConnectedTo ;
                 owl:inverseOf CO-META:isStartOf ;
                 rdfs:domain CO-META:Metaheuristic ;
                 rdfs:range CO-META:MetaheuristicComponent .


###  https://w3id.org/ontologies-ULL/CO-META#hasType
CO-META:hasType rdf:type owl:ObjectProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain CO-META:ParameterValue ;
                rdfs:range CO-META:Parameter .


###  https://w3id.org/ontologies-ULL/CO-META#hasUpperBound
CO-META:hasUpperBound rdf:type owl:ObjectProperty ,
                               owl:FunctionalProperty ;
                      rdfs:domain CO-META:ValueDomain ;
                      rdfs:range CO-META:ValueSpecification ;
                      rdfs:comment "Largest value of a value domain. If it is not stated, no upper bound is imposed."@en ,
                                   "Mayor valor de un dominio de valores. Si no se indica, no se impone cota superior."@es ;
                      rdfs:label "has upper bound"@en ,
                                 "tiene cota superior"@es .


###  https://w3id.org/ontologies-ULL/CO-META#hasValueDomain
CO-META:hasValueDomain rdf:type owl:ObjectProperty ,
                                owl:FunctionalProperty ;
                       rdfs:domain [ rdf:type owl:Class ;
                                     owl:unionOf ( CO-META:Column
                                                   CO-META:DataStructure
                                                   CO-META:DecisionVariable
                                                   CO-META:InputParameter
                                                   CO-META:Parameter
                                                 )
                                   ] ;
                       rdfs:range CO-META:ValueDomain ;
                       rdfs:comment "Set of values that a quantity of the problem, a data structure or a parameter of the algorithm can take."@en ,
                                    "Conjunto de valores que puede tomar una magnitud del problema, una estructura de datos o un parámetro del algoritmo."@es ;
                       rdfs:label "has value domain"@en ,
                                  "tiene dominio de valores"@es .


###  https://w3id.org/ontologies-ULL/CO-META#isConnectedTo
CO-META:isConnectedTo rdf:type owl:ObjectProperty ,
                               owl:TransitiveProperty ;
                      owl:propertyChainAxiom ( CO-META:hasOutput
                                               CO-META:isConnectedTo
                                             ) .


###  https://w3id.org/ontologies-ULL/CO-META#isConstraintOf
CO-META:isConstraintOf rdf:type owl:ObjectProperty .


###  https://w3id.org/ontologies-ULL/CO-META#isObjectiveOf
CO-META:isObjectiveOf rdf:type owl:ObjectProperty .


###  https://w3id.org/ontologies-ULL/CO-META#isParameterOf
CO-META:isParameterOf rdf:type owl:ObjectProperty .


###  https://w3id.org/ontologies-ULL/CO-META#isStartOf
CO-META:isStartOf rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf CO-META:isConnectedTo .


###  https://w3id.org/ontologies-ULL/CO-META#readsData
CO-META:readsData rdf:type owl:ObjectProperty ;
                  rdfs:domain CO-META:MetaheuristicComponent ;
                  rdfs:range CO-META:DataStructure .


###  https://w3id.org/ontologies-ULL/CO-META#refersTo
CO-META:refersTo rdf:type owl:ObjectProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain CO-META:ParameterReference ;
                 rdfs:range [ rdf:type owl:Class ;
                              owl:unionOf ( CO-META:InputParameter
                                            CO-META:ParameterValue
                                          )
                            ] ;
                 rdfs:comment "Parameter whose value determines a value specification: an input parameter of the problem or the value of a parameter of the algorithm."@en ,
                              "Parámetro cuyo valor determina una especificación de valor: un parámetro de entrada del problema o el valor de un parámetro del algoritmo."@es ;
                 rdfs:label "refers to"@en ,
                            "se refiere a"@es .


###  https://w3id.org/ontologies-ULL/CO-META#supportsShape
CO-META:supportsShape rdf:type owl:ObjectProperty ;
                      rdfs:domain [ rdf:type owl:Class ;
                                    owl:unionOf ( CO-META:Metaheuristic
                                                  CO-META:MetaheuristicComponent
                                                )
                                  ] ;
                      rdfs:range CO-META:DataShape ;
                      rdfs:comment "Shape of the solutions that a metaheuristic or a component can handle. It describes a kind of solution, so its sizes do not need to be stated."@en ,
                                   "Forma de las soluciones que puede manejar una metaheurística o un componente. Describe un tipo de solución, por lo que no es necesario indicar sus tamaños."@es ;
                      rdfs:label "supports shape"@en ,
                                 "admite forma"@es .


###  https://w3id.org/ontologies-ULL/CO-META#writesData
CO-META:writesData rdf:type owl:ObjectProperty ;
                   rdfs:domain CO-META:DataHandlerComponent ;
                   rdfs:range CO-META:DataStructure .


#################################################################
#    Data properties
#################################################################

###  https://w3id.org/ontologies-ULL/CO-META#hasCodeReference
CO-META:hasCodeReference rdf:type owl:DatatypeProperty ;
                         rdfs:domain CO-META:MetaheuristicComponent ;
                         rdfs:range xsd:string .


###  https://w3id.org/ontologies-ULL/CO-META#hasDimensionIndex
CO-META:hasDimensionIndex rdf:type owl:DatatypeProperty ,
                                   owl:FunctionalProperty ;
                          rdfs:domain CO-META:SolutionSizeReference ;
                          rdfs:range xsd:positiveInteger ;
                          rdfs:comment "Dimension of the solution whose size is referred to: 1 for the length of a sequence or the rows of a matrix, 2 for the columns of a matrix."@en ,
                                       "Dimensión de la solución cuyo tamaño se referencia: 1 para la longitud de una secuencia o las filas de una matriz, 2 para las columnas de una matriz."@es ;
                          rdfs:label "has dimension index"@en ,
                                     "tiene índice de dimensión"@es .


###  https://w3id.org/ontologies-ULL/CO-META#hasIdentifier
CO-META:hasIdentifier rdf:type owl:DatatypeProperty ,
                               owl:FunctionalProperty ;
                      rdfs:domain CO-META:ProblemQuantity ;
                      rdfs:range xsd:string ;
                      rdfs:comment "Name that identifies a quantity unambiguously within the problem formulation."@en ,
                                   "Nombre que identifica de forma unívoca una magnitud dentro de la formulación del problema."@es ;
                      rdfs:label "has identifier"@en ,
                                 "tiene identificador"@es .


###  https://w3id.org/ontologies-ULL/CO-META#hasInputSize
CO-META:hasInputSize rdf:type owl:DatatypeProperty ;
                     rdfs:domain CO-META:MetaheuristicComponent ;
                     rdfs:range xsd:integer .


###  https://w3id.org/ontologies-ULL/CO-META#hasLatexExpression
CO-META:hasLatexExpression rdf:type owl:DatatypeProperty ,
                                    owl:FunctionalProperty ;
                           rdfs:domain [ rdf:type owl:Class ;
                                         owl:unionOf ( CO-META:Constraint
                                                       CO-META:Objective
                                                     )
                                       ] ;
                           rdfs:range xsd:string ;
                           rdfs:comment "LaTeX expression of an objective or constraint. For constraints it includes the comparator (=, \\neq, <, \\leq, >, \\geq; chains such as 0 \\leq x_i \\leq 1 are allowed) and the universal quantifier, if any, before or after the condition (\\forall i \\in S). Indices start at 1. A subscript is an index (x_i, d_{ij}, X_{x_i}): juxtaposed terms in a subscript are separate indices, so a product in an index is written with \\cdot. A column of a table is indexed by record (v_i), a matrix by row and column (d_{ij}), and values of decision variables can be used as indices. Sets: \\{a, \\ldots, b\\}, \\{a, b, c\\} and \\{ i \\in S : P(i) \\}, with |S| their size. Aggregates: \\sum, \\prod, \\min and \\max, over _{i=a}^{b}, _{i \\in S} or _{i \\in S : P(i)}. Functions: \\sqrt, \\frac, |x|, \\lfloor x \\rfloor, \\lceil x \\rceil, \\exp, \\ln, \\log (natural logarithm), \\min(a, b), \\max(a, b) and \\bmod."@en ,
                                        "Expresión LaTeX de un objetivo o de una restricción. En las restricciones incluye el comparador (=, \\neq, <, \\leq, >, \\geq; se admiten cadenas como 0 \\leq x_i \\leq 1) y el cuantificador universal, si lo hay, antes o después de la condición (\\forall i \\in S). Los índices empiezan en 1. Un subíndice es un índice (x_i, d_{ij}, X_{x_i}): los términos yuxtapuestos en un subíndice son índices distintos, por lo que un producto en un índice se escribe con \\cdot. Una columna de una tabla se indexa por registro (v_i), una matriz por fila y columna (d_{ij}), y los valores de las variables de decisión pueden usarse como índices. Conjuntos: \\{a, \\ldots, b\\}, \\{a, b, c\\} y \\{ i \\in S : P(i) \\}, con |S| su tamaño. Agregados: \\sum, \\prod, \\min y \\max, sobre _{i=a}^{b}, _{i \\in S} o _{i \\in S : P(i)}. Funciones: \\sqrt, \\frac, |x|, \\lfloor x \\rfloor, \\lceil x \\rceil, \\exp, \\ln, \\log (logaritmo natural), \\min(a, b), \\max(a, b) y \\bmod."@es ;
                           rdfs:label "has LaTeX expression"@en ,
                                      "tiene expresión LaTeX"@es .


###  https://w3id.org/ontologies-ULL/CO-META#hasLatexSymbol
CO-META:hasLatexSymbol rdf:type owl:DatatypeProperty ,
                                owl:FunctionalProperty ;
                       rdfs:domain CO-META:ProblemQuantity ;
                       rdfs:range xsd:string ;
                       rdfs:comment "Mathematical notation, written in LaTeX, that represents a quantity in the objective and constraint expressions (e.g. \"x\" or \"v\")."@en ,
                                    "Notación matemática, escrita en LaTeX, que representa una magnitud en las expresiones de los objetivos y las restricciones (p. ej. \"x\" o \"v\")."@es ;
                       rdfs:label "has LaTeX symbol"@en ,
                                  "tiene símbolo LaTeX"@es .


###  https://w3id.org/ontologies-ULL/CO-META#hasLiteralValue
CO-META:hasLiteralValue rdf:type owl:DatatypeProperty ,
                                 owl:FunctionalProperty ;
                        rdfs:domain CO-META:LiteralValue ;
                        rdfs:range [ rdf:type rdfs:Datatype ;
                                     owl:unionOf ( xsd:double
                                                   xsd:integer
                                                 )
                                   ] ;
                        rdfs:comment "Number given explicitly. xsd:double is used for -INF and INF."@en ,
                                     "Número indicado de forma explícita. Se usa xsd:double para -INF e INF."@es ;
                        rdfs:label "has literal value"@en ,
                                   "tiene valor literal"@es .


###  https://w3id.org/ontologies-ULL/CO-META#hasOutputSize
CO-META:hasOutputSize rdf:type owl:DatatypeProperty ;
                      rdfs:domain CO-META:MetaheuristicComponent ;
                      rdfs:range xsd:integer .


###  https://w3id.org/ontologies-ULL/CO-META#hasPosition
CO-META:hasPosition rdf:type owl:DatatypeProperty ,
                             owl:FunctionalProperty ;
                    rdfs:domain CO-META:Column ;
                    rdfs:range xsd:integer ;
                    rdfs:comment "Position of an attribute in the order in which the records of its table are described."@en ,
                                 "Posición de un atributo en el orden en que se describen los registros de su tabla."@es ;
                    rdfs:label "has position"@en ,
                               "tiene posición"@es .


###  https://w3id.org/ontologies-ULL/CO-META#hasValue
CO-META:hasValue rdf:type owl:DatatypeProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain CO-META:ParameterValue .


###  https://w3id.org/ontologies-ULL/CO-META#hasWeight
CO-META:hasWeight rdf:type owl:DatatypeProperty ,
                           owl:FunctionalProperty ;
                  rdfs:domain CO-META:Objective ;
                  rdfs:range xsd:double ;
                  rdfs:comment "Importancia relativa de un objetivo cuando se agrega con otros objetivos en una única función."@es ,
                               "Relative importance of an objective when it is aggregated with other objectives into a single function."@en ;
                  rdfs:label "has weight"@en ,
                             "tiene peso"@es .


###  https://w3id.org/ontologies-ULL/CO-META#isDistinct
CO-META:isDistinct rdf:type owl:DatatypeProperty ,
                            owl:FunctionalProperty ;
                   rdfs:domain CO-META:CollectionShape ;
                   rdfs:range xsd:boolean ;
                   rdfs:comment "Indicates whether the values of a collection must be pairwise different."@en ,
                                "Indica si los valores de una colección deben ser distintos entre sí."@es ;
                   rdfs:label "is distinct"@en ,
                              "es sin repeticiones"@es .


###  https://w3id.org/ontologies-ULL/CO-META#isImplicit
CO-META:isImplicit rdf:type owl:DatatypeProperty ,
                            owl:FunctionalProperty ;
                   rdfs:domain CO-META:InputParameter ;
                   rdfs:range xsd:boolean ;
                   rdfs:comment "Indica que el parámetro de entrada no se declaró explícitamente como dato del problema, sino que surgió al usarse como tamaño de una tabla."@es ,
                                "Indicates that the input parameter was not explicitly declared as problem data, but arose from its use as the size of a table."@en ;
                   rdfs:label "es implícito"@es ,
                              "is implicit"@en .


###  https://w3id.org/ontologies-ULL/CO-META#isOrdered
CO-META:isOrdered rdf:type owl:DatatypeProperty ,
                           owl:FunctionalProperty ;
                  rdfs:domain CO-META:CollectionShape ;
                  rdfs:range xsd:boolean ;
                  rdfs:comment "Indicates whether the position of each value in a collection matters."@en ,
                               "Indica si importa la posición de cada valor en una colección."@es ;
                  rdfs:label "is ordered"@en ,
                             "es ordenada"@es .


#################################################################
#    Classes
#################################################################

###  https://w3id.org/ontologies-ULL/CO-META#AcceptanceComponent
CO-META:AcceptanceComponent rdf:type owl:Class ;
                            rdfs:subClassOf CO-META:MetaheuristicComponent ;
                            rdfs:comment "Component that accepts one solution out of two or more candidate solutions according to their fitness. In multiobjective optimization it requires a preceding fitness assignment component."@en ,
                                         "Componente que acepta una solución entre dos o más soluciones candidatas según su aptitud. En optimización multiobjetivo requiere un componente de asignación de aptitud previo."@es ;
                            rdfs:label "Acceptance Component"@en ,
                                       "Componente de aceptación"@es .


###  https://w3id.org/ontologies-ULL/CO-META#AntConstructionComponent
CO-META:AntConstructionComponent rdf:type owl:Class ;
                                 rdfs:subClassOf CO-META:ConstructionComponent ;
                                 rdfs:comment "Componente de construcción que crea cada solución eligiendo el siguiente elemento con probabilidad proporcional a feromona^alfa · heurística^beta, donde las feromonas son la matriz que lee el componente, y alfa y beta sus parámetros de influencia de la feromona y de la heurística."@es ,
                                              "Construction component that builds each solution by choosing the next element with probability proportional to pheromone^alpha · heuristic^beta, where the pheromones are the matrix the component reads, and alpha and beta its pheromone and heuristic influence parameters."@en ;
                                 rdfs:label "Componente de construcción por hormigas"@es ,
                                            "Ant Construction Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#ArchiveUpdateComponent
CO-META:ArchiveUpdateComponent rdf:type owl:Class ;
                               rdfs:subClassOf CO-META:DataHandlerComponent ;
                               rdfs:comment "Manejador de datos que sustituye el contenido del archivo que escribe por las soluciones que recibe, y las deja pasar."@es ,
                                            "Data handler that replaces the content of the archive it writes with the solutions it receives, and passes them on."@en ;
                               rdfs:label "Componente de actualización del archivo"@es ,
                                          "Archive Update Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#BaseType
CO-META:BaseType rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Class ;
                                       owl:oneOf ( CO-META:Booleans
                                                   CO-META:Integers
                                                   CO-META:Reals
                                                   CO-META:Solutions
                                                 )
                                     ] ;
                 rdfs:comment "Set on which a value domain is based: booleans, integers, reals or candidate solutions."@en ,
                              "Conjunto en el que se basa un dominio de valores: booleanos, enteros, reales o soluciones candidatas."@es ;
                 rdfs:label "Base Type"@en ,
                            "Tipo base"@es .


###  https://w3id.org/ontologies-ULL/CO-META#BestCandidateAcceptanceComponent
CO-META:BestCandidateAcceptanceComponent rdf:type owl:Class ;
                                         rdfs:subClassOf CO-META:AcceptanceComponent ;
                                         rdfs:comment "Componente de aceptación que acepta al mejor candidato aunque sea peor que la solución actual (como en la búsqueda tabú)."@es ,
                                                      "Acceptance component that accepts the best candidate even if it is worse than the current solution (as in tabu search)."@en ;
                                         rdfs:label "Componente de aceptación del mejor candidato"@es ,
                                                    "Best Candidate Acceptance Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#BestImprovementLocalSearchComponent
CO-META:BestImprovementLocalSearchComponent rdf:type owl:Class ;
                                            rdfs:subClassOf CO-META:LocalSearchComponent ;
                                            rdfs:comment "Componente de búsqueda local que se desplaza al mejor vecino del vecindario que usa mientras mejore."@es ,
                                                         "Local search component that moves to the best neighbour of the neighbourhood it uses while it improves."@en ;
                                            rdfs:label "Componente de búsqueda local de mejor mejora"@es ,
                                                       "Best Improvement Local Search Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#BestSolutionsUpdateComponent
CO-META:BestSolutionsUpdateComponent rdf:type owl:Class ;
                                     rdfs:subClassOf CO-META:DataHandlerComponent ,
                                                     CO-META:UpdateBestComponent ;
                                     rdfs:comment "Manejador de datos que conserva en la estructura que escribe la mejor solución vista: una única para una estructura escalar, o una por posición (p. ej. por partícula) para una colección."@es ,
                                                  "Data handler that keeps in the structure it writes the best solution seen: a single one for a scalar structure, or one per position (e.g. per particle) for a collection."@en ;
                                     rdfs:label "Componente de actualización de las mejores soluciones"@es ,
                                                "Best Solutions Update Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#BitFlipMutationComponent
CO-META:BitFlipMutationComponent rdf:type owl:Class ;
                                 rdfs:subClassOf CO-META:VariationComponent ;
                                 rdfs:comment "Componente de variación que cambia cada valor binario con probabilidad 1/n, cambiando al menos uno."@es ,
                                              "Variation component that flips each binary value with probability 1/n, flipping at least one."@en ;
                                 rdfs:label "Componente de mutación por cambio de bit"@es ,
                                            "Bit Flip Mutation Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#BitFlipNeighbourhoodComponent
CO-META:BitFlipNeighbourhoodComponent rdf:type owl:Class ;
                                      rdfs:subClassOf CO-META:NeighbourhoodComponent ;
                                      rdfs:comment "Vecindario de los vectores binarios que difieren en una posición."@es ,
                                                   "Neighbourhood of the binary vectors that differ in one position."@en ;
                                      rdfs:label "Componente de vecindario de cambio de bit"@es ,
                                                 "Bit Flip Neighbourhood Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#CollectionShape
CO-META:CollectionShape rdf:type owl:Class ;
                        rdfs:subClassOf CO-META:DataShape ,
                                        qudt:Collection ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty CO-META:hasLength ;
                                          owl:cardinality "1"^^xsd:nonNegativeInteger
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty CO-META:isDistinct ;
                                          owl:cardinality "1"^^xsd:nonNegativeInteger
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty CO-META:isOrdered ;
                                          owl:cardinality "1"^^xsd:nonNegativeInteger
                                        ] ;
                        rdfs:comment "Shape of a quantity made up of a number of values of the same kind, characterized by whether their order matters (isOrdered) and whether they can be repeated (isDistinct)."@en ,
                                     "Forma de una magnitud formada por varios valores de la misma naturaleza, caracterizada por si importa su orden (isOrdered) y si pueden repetirse (isDistinct)."@es ;
                        rdfs:label "Collection Shape"@en ,
                                   "Forma de colección"@es .


###  https://w3id.org/ontologies-ULL/CO-META#Column
CO-META:Column rdf:type owl:Class ;
               rdfs:subClassOf CO-META:ProblemData ;
               owl:disjointWith CO-META:InputParameter ;
               rdfs:comment "Atributo de las entidades descritas por una tabla. Equivale a un vector de datos con un valor por registro (p. ej., el peso de cada objeto)."@es ,
                            "Attribute of the entities described by a table. It is equivalent to a vector of data with one value per record (e.g. the weight of each item)."@en ;
               rdfs:label "Column"@en ,
                          "Columna"@es .


###  https://w3id.org/ontologies-ULL/CO-META#ComponentSafety
CO-META:ComponentSafety rdf:type owl:Class ;
                        owl:equivalentClass [ rdf:type owl:Class ;
                                              owl:oneOf ( CO-META:Both
                                                          CO-META:Safe
                                                          CO-META:Unsafe
                                                        )
                                            ] ;
                        rdfs:comment "Enumeración (Safe, Unsafe, Both) que indica si un componente metaheurístico garantiza que las soluciones que produce son factibles, puede producir soluciones no factibles o admite ambos comportamientos."@es ,
                                     "Enumeration (Safe, Unsafe, Both) that indicates whether a metaheuristic component guarantees that the solutions it produces are feasible, may produce infeasible solutions, or supports both behaviours."@en ;
                        rdfs:label "Component Safety"@en ,
                                   "Seguridad del componente"@es .


###  https://w3id.org/ontologies-ULL/CO-META#CompositeShape
CO-META:CompositeShape rdf:type owl:Class ;
                       rdfs:subClassOf CO-META:DataShape ,
                                       qudt:Record ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty CO-META:hasComponent ;
                                         owl:someValuesFrom CO-META:DataShape
                                       ] ;
                       rdfs:comment "Shape of a quantity that combines several shapes, one per component (e.g. a solution made up of a permutation and a matrix)."@en ,
                                    "Forma de una magnitud que combina varias formas, una por componente (p. ej., una solución formada por una permutación y una matriz)."@es ;
                       rdfs:label "Composite Shape"@en ,
                                  "Forma compuesta"@es .


###  https://w3id.org/ontologies-ULL/CO-META#Constraint
CO-META:Constraint rdf:type owl:Class ;
                   rdfs:subClassOf CO-META:ProblemElement ;
                   rdfs:comment "Condición que debe cumplir una solución de un problema de optimización para ser factible."@es ,
                                "Condition that a solution of an optimization problem must satisfy in order to be feasible."@en ;
                   rdfs:label "Constraint"@en ,
                              "Restricción"@es .


###  https://w3id.org/ontologies-ULL/CO-META#ConstructionComponent
CO-META:ConstructionComponent rdf:type owl:Class ;
                              rdfs:subClassOf CO-META:MetaheuristicComponent ;
                              rdfs:comment "Component that constructs a solution or a group of solutions step by step using heuristic methods."@en ,
                                           "Componente que construye una solución o un grupo de soluciones paso a paso mediante métodos heurísticos."@es ;
                              rdfs:label "Componente de construcción"@es ,
                                         "Construction Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#ConstructiveMetaheuristic
CO-META:ConstructiveMetaheuristic rdf:type owl:Class ;
                                  owl:equivalentClass [ owl:intersectionOf ( CO-META:Metaheuristic
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty CO-META:isConnectedTo ;
                                                                               owl:someValuesFrom CO-META:ConstructionComponent
                                                                             ]
                                                                           ) ;
                                                        rdf:type owl:Class
                                                      ] ;
                                  rdfs:comment "Metaheuristic that builds solutions incrementally."@en ,
                                               "Metaheurística que construye soluciones de forma incremental."@es ;
                                  rdfs:label "Constructive Metaheuristic"@en ,
                                             "Metaheurística constructiva"@es .


###  https://w3id.org/ontologies-ULL/CO-META#CrossoverComponent
CO-META:CrossoverComponent rdf:type owl:Class ;
                           rdfs:subClassOf CO-META:ModificationComponent ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty CO-META:hasParameter ;
                                             owl:someValuesFrom [ rdf:type owl:Restriction ;
                                                                  owl:onProperty CO-META:hasType ;
                                                                  owl:hasValue CO-META:CrossoverProbability
                                                                ]
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty CO-META:hasInputSize ;
                                             owl:hasValue 2
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty CO-META:hasOutputSize ;
                                             owl:hasValue 2
                                           ] ;
                           rdfs:comment "Componente de modificación que produce uno o más individuos descendientes recombinando dos o más individuos progenitores. Tiene un parámetro de probabilidad de cruce."@es ,
                                        "Modification component that produces one or more offspring individuals by recombining two or more parent individuals. It has a crossover probability parameter."@en ;
                           rdfs:label "Componente de cruce"@es ,
                                      "Crossover Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#CrowdingDistanceComponent
CO-META:CrowdingDistanceComponent rdf:type owl:Class ;
                                  rdfs:subClassOf CO-META:DiversityPreservationComponent ;
                                  rdfs:comment "Componente de preservación de la diversidad que mide, dentro de cada frente, el tamaño del cuboide alrededor de cada individuo en el espacio de objetivos."@es ,
                                               "Diversity preservation component that measures, within each front, the size of the cuboid around each individual in objective space."@en ;
                                  rdfs:label "Componente de distancia de hacinamiento"@es ,
                                             "Crowding Distance Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#CycleCrossoverComponent
CO-META:CycleCrossoverComponent rdf:type owl:Class ;
                                rdfs:subClassOf CO-META:CrossoverComponent ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty CO-META:supportsShape ;
                                                  owl:allValuesFrom CO-META:DistinctSequenceShape
                                                ] ;
                                rdfs:comment "Componente de cruce para permutaciones que mantiene cada valor en la posición que ocupa en uno de los progenitores, siguiendo los ciclos entre ellos (CX)."@es ,
                                             "Crossover component for permutations that keeps each value in the position it has in one of the parents, following the cycles between them (CX)."@en ;
                                rdfs:label "Componente de cruce por ciclos"@es ,
                                           "Cycle Crossover Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#DataHandlerComponent
CO-META:DataHandlerComponent rdf:type owl:Class ;
                             rdfs:subClassOf CO-META:MetaheuristicComponent ;
                             rdfs:comment "Component that updates specific data structures used by the algorithm."@en ,
                                          "Componente que actualiza estructuras de datos específicas utilizadas por el algoritmo."@es ;
                             rdfs:label "Componente manejador de datos"@es ,
                                        "Data Handler Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#DataShape
CO-META:DataShape rdf:type owl:Class ;
                  rdfs:comment "Organization of the values of a quantity: a single value, a collection, a matrix, a table or a combination of them. It describes a type of data, not specific values. This class should not be instantiated directly; its subclasses should be used instead."@en ,
                               "Organización de los valores de una magnitud: un único valor, una colección, una matriz, una tabla o una combinación de ellas. Describe un tipo de datos, no valores concretos. Esta clase no debe instanciarse directamente; deben usarse sus subclases."@es ;
                  rdfs:label "Data Shape"@en ,
                             "Forma de datos"@es .


###  https://w3id.org/ontologies-ULL/CO-META#DataStructure
CO-META:DataStructure rdf:type owl:Class ;
                      rdfs:comment "Data structure that stores information used by the algorithm during its execution."@en ,
                                   "Estructura de datos que almacena información utilizada por el algoritmo durante su ejecución."@es ;
                      rdfs:label "Data Structure"@en ,
                                 "Estructura de datos"@es .


###  https://w3id.org/ontologies-ULL/CO-META#DecisionVariable
CO-META:DecisionVariable rdf:type owl:Class ;
                         rdfs:subClassOf CO-META:ProblemQuantity ;
                         owl:disjointWith CO-META:ProblemData ;
                         rdfs:comment "Magnitud cuyo valor elige el método de resolución. Una asignación de valores a todas las variables de decisión del problema constituye una solución candidata."@es ,
                                      "Quantity whose value is chosen by the solution method. An assignment of values to all the decision variables of a problem is a candidate solution."@en ;
                         rdfs:label "Decision Variable"@en ,
                                    "Variable de decisión"@es .


###  https://w3id.org/ontologies-ULL/CO-META#DistinctSequenceShape
CO-META:DistinctSequenceShape rdf:type owl:Class ;
                              owl:equivalentClass [ owl:intersectionOf ( CO-META:CollectionShape
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty CO-META:isDistinct ;
                                                                           owl:hasValue "true"^^xsd:boolean
                                                                         ]
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty CO-META:isOrdered ;
                                                                           owl:hasValue "true"^^xsd:boolean
                                                                         ]
                                                                       ) ;
                                                    rdf:type owl:Class
                                                  ] ;
                              rdfs:comment "Sequence whose values cannot be repeated. When its length equals the number of possible values, it is a permutation (e.g. the tour through the cities in the TSP)."@en ,
                                           "Secuencia cuyos valores no pueden repetirse. Cuando su longitud coincide con el número de valores posibles, es una permutación (p. ej., el recorrido por las ciudades en el TSP)."@es ;
                              rdfs:label "Distinct Sequence Shape"@en ,
                                         "Forma de secuencia sin repeticiones"@es .


###  https://w3id.org/ontologies-ULL/CO-META#DiversityPreservationComponent
CO-META:DiversityPreservationComponent rdf:type owl:Class ;
                                       rdfs:subClassOf CO-META:MultiobjectiveComponent ;
                                       rdfs:comment "Componente multiobjetivo que ajusta los valores de aptitud para fomentar la diversidad en la población."@es ,
                                                    "Multiobjective component that adjusts fitness values to encourage diversity in the population."@en ;
                                       rdfs:label "Componente de preservación de la diversidad"@es ,
                                                  "Diversity Preservation Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#ElementChangeNeighbourhoodComponent
CO-META:ElementChangeNeighbourhoodComponent rdf:type owl:Class ;
                                            rdfs:subClassOf CO-META:NeighbourhoodComponent ;
                                            rdfs:comment "Vecindario de los vectores enteros obtenidos cambiando el valor de una posición por otro valor de su dominio."@es ,
                                                         "Neighbourhood of the integer vectors obtained by changing the value of one position to another value of its domain."@en ;
                                            rdfs:label "Componente de vecindario de cambio de elemento"@es ,
                                                       "Element Change Neighbourhood Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#EvolutionaryAlgorithm
CO-META:EvolutionaryAlgorithm rdf:type owl:Class ;
                              owl:equivalentClass [ owl:intersectionOf ( CO-META:PopulationBasedMetaheuristic
                                                                         [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                                                  owl:onProperty CO-META:isConnectedTo ;
                                                                                                  owl:someValuesFrom CO-META:CrossoverComponent
                                                                                                ]
                                                                                                [ rdf:type owl:Restriction ;
                                                                                                  owl:onProperty CO-META:isConnectedTo ;
                                                                                                  owl:someValuesFrom CO-META:SelectionComponent
                                                                                                ]
                                                                                                [ rdf:type owl:Restriction ;
                                                                                                  owl:onProperty CO-META:isConnectedTo ;
                                                                                                  owl:someValuesFrom CO-META:VariationComponent
                                                                                                ]
                                                                                              ) ;
                                                                           rdf:type owl:Class
                                                                         ]
                                                                       ) ;
                                                    rdf:type owl:Class
                                                  ] ;
                              rdfs:comment "Metaheuristic based on evolutionary algorithms, employing selection, crossover and variation processes."@en ,
                                           "Metaheurística basada en algoritmos evolutivos, utilizando procesos de selección, cruce y variación."@es ;
                              rdfs:label "Algoritmo evolutivo"@es ,
                                         "Evolutionary Algorithm"@en .


###  https://w3id.org/ontologies-ULL/CO-META#FirstImprovementLocalSearchComponent
CO-META:FirstImprovementLocalSearchComponent rdf:type owl:Class ;
                                             rdfs:subClassOf CO-META:LocalSearchComponent ;
                                             rdfs:comment "Componente de búsqueda local que se desplaza al primer vecino que mejora del vecindario que usa, hasta que ningún vecino mejora."@es ,
                                                          "Local search component that moves to the first improving neighbour of the neighbourhood it uses, until no neighbour improves."@en ;
                                             rdfs:label "Componente de búsqueda local de primera mejora"@es ,
                                                        "First Improvement Local Search Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#FitnessAssignmentComponent
CO-META:FitnessAssignmentComponent rdf:type owl:Class ;
                                   rdfs:subClassOf CO-META:MultiobjectiveComponent ;
                                   rdfs:comment "Componente multiobjetivo que asigna un valor de aptitud individual a cada miembro de una población."@es ,
                                                "Multiobjective component that assigns a single fitness value to each member of a population."@en ;
                                   rdfs:label "Componente de asignación de aptitud"@es ,
                                              "Fitness Assignment Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#GenerationComponent
CO-META:GenerationComponent rdf:type owl:Class ;
                            rdfs:subClassOf CO-META:MetaheuristicComponent ;
                            rdfs:comment "Component that generates an initial solution or an initial population."@en ,
                                         "Componente que genera una solución inicial o una población inicial."@es ;
                            rdfs:label "Componente de generación"@es ,
                                       "Generation Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#GeometricCoolingComponent
CO-META:GeometricCoolingComponent rdf:type owl:Class ;
                                  rdfs:subClassOf CO-META:DataHandlerComponent ;
                                  rdfs:comment "Manejador de datos que reduce de forma geométrica la temperatura que escribe, desde la temperatura máxima al principio hasta la mínima cuando se agota el presupuesto de iteraciones del criterio de parada que lo contiene."@es ,
                                               "Data handler that lowers the temperature it writes geometrically, from the maximum temperature at the start to the minimum one when the iteration budget of the enclosing stopping criterion is spent."@en ;
                                  rdfs:label "Componente de enfriamiento geométrico"@es ,
                                             "Geometric Cooling Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#GreedyRandomizedConstructionComponent
CO-META:GreedyRandomizedConstructionComponent rdf:type owl:Class ;
                                              rdfs:subClassOf CO-META:ConstructionComponent ;
                                              rdfs:comment "Componente de construcción que añade un elemento cada vez, elegido al azar de una lista restringida de candidatos (RCL) construida con la información heurística del problema. Su parámetro de aleatoriedad de la RCL va de puramente voraz (0) a puramente aleatorio (1)."@es ,
                                                           "Construction component that adds one element at a time, chosen at random from a restricted candidate list (RCL) built from the heuristic information of the problem. Its RCL randomness parameter goes from purely greedy (0) to purely random (1)."@en ;
                                              rdfs:label "Componente de construcción voraz aleatorizada"@es ,
                                                         "Greedy Randomized Construction Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#ImprovementAcceptanceComponent
CO-META:ImprovementAcceptanceComponent rdf:type owl:Class ;
                                       rdfs:subClassOf CO-META:AcceptanceComponent ;
                                       rdfs:comment "Componente de aceptación que conserva la mejor entre la solución actual y la candidata; en caso de empate, la candidata."@es ,
                                                    "Acceptance component that keeps the best of the current and the candidate solutions; ties favour the candidate."@en ;
                                       rdfs:label "Componente de aceptación por mejora"@es ,
                                                  "Improvement Acceptance Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#InputParameter
CO-META:InputParameter rdf:type owl:Class ;
                       rdfs:subClassOf CO-META:ProblemData ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty CO-META:hasShape ;
                                         owl:hasValue CO-META:Scalar
                                       ] ;
                       rdfs:comment "Dato escalar que caracteriza una instancia del problema (p. ej., la capacidad de la mochila o el número de ciudades)."@es ,
                                    "Scalar datum that characterizes an instance of the problem (e.g. the capacity of the knapsack or the number of cities)."@en ;
                       rdfs:label "Input Parameter"@en ,
                                  "Parámetro de entrada"@es .


###  https://w3id.org/ontologies-ULL/CO-META#InsertionMutationComponent
CO-META:InsertionMutationComponent rdf:type owl:Class ;
                                   rdfs:subClassOf CO-META:VariationComponent ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty CO-META:supportsShape ;
                                                     owl:allValuesFrom CO-META:DistinctSequenceShape
                                                   ] ;
                                   rdfs:comment "Componente de variación que mueve el valor de una posición aleatoria a otra posición aleatoria de una permutación."@es ,
                                                "Variation component that moves the value of a random position to another random position of a permutation."@en ;
                                   rdfs:label "Componente de mutación por inserción"@es ,
                                              "Insertion Mutation Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#InsertionNeighbourhoodComponent
CO-META:InsertionNeighbourhoodComponent rdf:type owl:Class ;
                                        rdfs:subClassOf CO-META:NeighbourhoodComponent ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty CO-META:supportsShape ;
                                                          owl:allValuesFrom CO-META:DistinctSequenceShape
                                                        ] ;
                                        rdfs:comment "Vecindario de las permutaciones obtenidas moviendo un valor a otra posición."@es ,
                                                     "Neighbourhood of the permutations obtained by moving a value to another position."@en ;
                                        rdfs:label "Componente de vecindario de inserción"@es ,
                                                   "Insertion Neighbourhood Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#InversionMutationComponent
CO-META:InversionMutationComponent rdf:type owl:Class ;
                                   rdfs:subClassOf CO-META:VariationComponent ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty CO-META:supportsShape ;
                                                     owl:allValuesFrom CO-META:DistinctSequenceShape
                                                   ] ;
                                   rdfs:comment "Componente de variación que invierte el orden de un segmento aleatorio de una permutación."@es ,
                                                "Variation component that reverses the order of a random segment of a permutation."@en ;
                                   rdfs:label "Componente de mutación por inversión"@es ,
                                              "Inversion Mutation Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#IterativeSelectionComponent
CO-META:IterativeSelectionComponent rdf:type owl:Class ;
                                    rdfs:subClassOf CO-META:SelectionComponent ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty CO-META:hasOutputSize ;
                                                      owl:hasValue 1
                                                    ] ;
                                    rdfs:comment "Componente de selección que selecciona un único individuo en cada invocación, por lo que se aplica repetidamente para seleccionar varios individuos."@es ,
                                                 "Selection component that selects a single individual per invocation, so it is applied repeatedly to select several individuals."@en ;
                                    rdfs:label "Componente de selección iterativa"@es ,
                                               "Iterative Selection Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#KPointCrossoverComponent
CO-META:KPointCrossoverComponent rdf:type owl:Class ;
                                 rdfs:subClassOf CO-META:CrossoverComponent ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty CO-META:hasParameter ;
                                                   owl:someValuesFrom [ rdf:type owl:Restriction ;
                                                                        owl:onProperty CO-META:hasType ;
                                                                        owl:hasValue CO-META:CrossoverKPoints
                                                                      ]
                                                 ] ;
                                 rdfs:comment "Componente de cruce que divide a los progenitores en k puntos de corte e intercambia los segmentos resultantes. Tiene un parámetro para el número de puntos de corte."@es ,
                                              "Crossover component that splits the parents at k cut points and exchanges the resulting segments. It has a parameter for the number of cut points."@en ;
                                 rdfs:label "Componente de cruce de k puntos"@es ,
                                            "K-Point Crossover Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#LiteralValue
CO-META:LiteralValue rdf:type owl:Class ;
                     rdfs:subClassOf CO-META:ValueSpecification ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty CO-META:hasLiteralValue ;
                                       owl:cardinality "1"^^xsd:nonNegativeInteger
                                     ] ;
                     rdfs:comment "Value specification given explicitly as a number (e.g. 0, 1 or INF)."@en ,
                                  "Especificación de valor indicada explícitamente como un número (p. ej., 0, 1 o INF)."@es ;
                     rdfs:label "Literal Value"@en ,
                                "Valor literal"@es .


###  https://w3id.org/ontologies-ULL/CO-META#LocalSearchComponent
CO-META:LocalSearchComponent rdf:type owl:Class ;
                             rdfs:subClassOf CO-META:ModificationComponent ;
                             rdfs:comment "Componente de modificación que mejora la aptitud de una solución explorando su vecindario."@es ,
                                          "Modification component that improves the fitness of a solution by exploring its neighbourhood."@en ;
                             rdfs:label "Componente de búsqueda local"@es ,
                                        "Local Search Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#LocalSearchMetaheuristic
CO-META:LocalSearchMetaheuristic rdf:type owl:Class ;
                                 owl:equivalentClass [ owl:intersectionOf ( CO-META:Metaheuristic
                                                                            [ rdf:type owl:Restriction ;
                                                                              owl:onProperty CO-META:isConnectedTo ;
                                                                              owl:someValuesFrom CO-META:GenerationComponent
                                                                            ]
                                                                          ) ;
                                                       rdf:type owl:Class
                                                     ] ;
                                 rdfs:comment "Metaheuristic that starts from complete solutions and iteratively improves them."@en ,
                                              "Metaheurística que parte de soluciones completas y las mejora iterativamente."@es ;
                                 rdfs:label "Local Search Metaheuristic"@en ,
                                            "Metaheurística de búsqueda local"@es .


###  https://w3id.org/ontologies-ULL/CO-META#LoopComponent
CO-META:LoopComponent rdf:type owl:Class ;
                      rdfs:subClassOf CO-META:MetaheuristicComponent ;
                      rdfs:comment "Component that creates loops to iterate through data structures or to repeat processes until a condition is met. It has two additional properties: hasOutputStart and hasOutputEnd."@en ,
                                   "Componente que crea bucles para recorrer estructuras de datos o repetir procesos hasta que se cumple una condición. Tiene dos propiedades adicionales: hasOutputStart y hasOutputEnd."@es ;
                      rdfs:label "Componente de bucle"@es ,
                                 "Loop Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#MatrixData
CO-META:MatrixData rdf:type owl:Class ;
                   owl:equivalentClass [ owl:intersectionOf ( CO-META:ProblemData
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty CO-META:hasShape ;
                                                                owl:someValuesFrom CO-META:MatrixShape
                                                              ]
                                                            ) ;
                                         rdf:type owl:Class
                                       ] ;
                   rdfs:subClassOf CO-META:ProblemData ;
                   rdfs:comment "Problem data organized as a matrix of values of the same kind (e.g. the distances between each pair of cities). It is inferred from the shape, so it does not need to be asserted."@en ,
                                "Datos del problema organizados como una matriz de valores de la misma naturaleza (p. ej., las distancias entre cada par de ciudades). Se deduce de la forma, por lo que no es necesario declararla."@es ;
                   rdfs:label "Matrix Data"@en ,
                              "Datos matriciales"@es .


###  https://w3id.org/ontologies-ULL/CO-META#MatrixShape
CO-META:MatrixShape rdf:type owl:Class ;
                    rdfs:subClassOf CO-META:DataShape ,
                                    qudt:Matrix ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty CO-META:hasColumnCount ;
                                      owl:cardinality "1"^^xsd:nonNegativeInteger
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty CO-META:hasRowCount ;
                                      owl:cardinality "1"^^xsd:nonNegativeInteger
                                    ] ;
                    rdfs:comment "Shape of a quantity whose values, all of the same kind, are arranged in rows and columns (e.g. a distance matrix between cities)."@en ,
                                 "Forma de una magnitud cuyos valores, todos de la misma naturaleza, se disponen en filas y columnas (p. ej., una matriz de distancias entre ciudades)."@es ;
                    rdfs:label "Matrix Shape"@en ,
                               "Forma matricial"@es .


###  https://w3id.org/ontologies-ULL/CO-META#MatrixVariable
CO-META:MatrixVariable rdf:type owl:Class ;
                       owl:equivalentClass [ owl:intersectionOf ( CO-META:DecisionVariable
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty CO-META:hasShape ;
                                                                    owl:someValuesFrom CO-META:MatrixShape
                                                                  ]
                                                                ) ;
                                             rdf:type owl:Class
                                           ] ;
                       rdfs:subClassOf CO-META:DecisionVariable ;
                       rdfs:comment "Decision variable made up of a value for each pair of elements of two collections (e.g. whether each vehicle visits each customer). It is inferred from the shape, so it does not need to be asserted."@en ,
                                    "Variable de decisión formada por un valor para cada par de elementos de dos colecciones (p. ej., si cada vehículo visita a cada cliente). Se deduce de la forma, por lo que no es necesario declararla."@es ;
                       rdfs:label "Matrix Variable"@en ,
                                  "Variable matricial"@es .


###  https://w3id.org/ontologies-ULL/CO-META#MaximizationObjective
CO-META:MaximizationObjective rdf:type owl:Class ;
                              rdfs:subClassOf CO-META:Objective ;
                              owl:disjointWith CO-META:MinimizationObjective ;
                              rdfs:comment "Objective of an optimization problem whose value must be maximized."@en ,
                                           "Objetivo de un problema de optimización cuyo valor debe maximizarse."@es ;
                              rdfs:label "Maximization Objective"@en ,
                                         "Objetivo de maximización"@es .


###  https://w3id.org/ontologies-ULL/CO-META#MemeticAlgorithm
CO-META:MemeticAlgorithm rdf:type owl:Class ;
                         owl:equivalentClass [ owl:intersectionOf ( CO-META:EvolutionaryAlgorithm
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty CO-META:isConnectedTo ;
                                                                      owl:someValuesFrom CO-META:LocalSearchComponent
                                                                    ]
                                                                  ) ;
                                               rdf:type owl:Class
                                             ] ;
                         rdfs:comment "Algoritmo evolutivo que además utiliza procesos de búsqueda local."@es ,
                                      "Evolutionary algorithm that employs local search processes."@en ;
                         rdfs:label "Algoritmo memético"@es ,
                                    "Memetic Algorithm"@en .


###  https://w3id.org/ontologies-ULL/CO-META#Metaheuristic
CO-META:Metaheuristic rdf:type owl:Class ;
                      rdfs:comment "High-level algorithmic procedure, composed of interconnected metaheuristic components, that finds sufficiently good solutions to optimization problems by searching through vast solution spaces."@en ,
                                   "Procedimiento algorítmico de alto nivel, compuesto por componentes metaheurísticos interconectados, que encuentran soluciones suficientemente buenas a problemas de optimización mediante búsquedas en amplios espacios de soluciones."@es ;
                      rdfs:label "Metaheuristic"@en ,
                                 "Metaheurística"@es .


###  https://w3id.org/ontologies-ULL/CO-META#MetaheuristicComponent
CO-META:MetaheuristicComponent rdf:type owl:Class ;
                               rdfs:comment "Bloque constructivo de una metaheurística que realiza una tarea específica y se conecta con otros componentes."@es ,
                                            "Building block of a metaheuristic that performs a specific task and is connected to other components."@en ;
                               rdfs:label "Componente metaheurístico"@es ,
                                          "Metaheuristic Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#MetropolisAcceptanceComponent
CO-META:MetropolisAcceptanceComponent rdf:type owl:Class ;
                                      rdfs:subClassOf CO-META:AcceptanceComponent ;
                                      rdfs:comment "Componente de aceptación que acepta una candidata peor con probabilidad exp(-d / T), donde d es el empeoramiento relativo (f_candidata - f_actual) / |f_actual| y T la temperatura que lee."@es ,
                                                   "Acceptance component that accepts a worse candidate with probability exp(-d / T), where d is the relative degradation (f_candidate - f_current) / |f_current| and T the temperature it reads."@en ;
                                      rdfs:label "Componente de aceptación de Metropolis"@es ,
                                                 "Metropolis Acceptance Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#MinimizationObjective
CO-META:MinimizationObjective rdf:type owl:Class ;
                              rdfs:subClassOf CO-META:Objective ;
                              rdfs:comment "Objective of an optimization problem whose value must be minimized."@en ,
                                           "Objetivo de un problema de optimización cuyo valor debe minimizarse."@es ;
                              rdfs:label "Minimization Objective"@en ,
                                         "Objetivo de minimización"@es .


###  https://w3id.org/ontologies-ULL/CO-META#ModificationComponent
CO-META:ModificationComponent rdf:type owl:Class ;
                              rdfs:subClassOf CO-META:MetaheuristicComponent ;
                              rdfs:comment "Component that modifies a solution or a population."@en ,
                                           "Componente que modifica una solución o una población."@es ;
                              rdfs:label "Componente de modificación"@es ,
                                         "Modification Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#MultiSetShape
CO-META:MultiSetShape rdf:type owl:Class ;
                      owl:equivalentClass [ owl:intersectionOf ( CO-META:CollectionShape
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty CO-META:isDistinct ;
                                                                   owl:hasValue "false"^^xsd:boolean
                                                                 ]
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty CO-META:isOrdered ;
                                                                   owl:hasValue "false"^^xsd:boolean
                                                                 ]
                                                               ) ;
                                            rdf:type owl:Class
                                          ] ;
                      rdfs:subClassOf qudt:MultiSet ;
                      rdfs:comment "Collection whose values are not ordered and can be repeated (e.g. the number of units of each product in an order)."@en ,
                                   "Colección cuyos valores no están ordenados y pueden repetirse (p. ej., el número de unidades de cada producto en un pedido)."@es ;
                      rdfs:label "Multiset Shape"@en ,
                                 "Forma de multiconjunto"@es .


###  https://w3id.org/ontologies-ULL/CO-META#MultiobjectiveComponent
CO-META:MultiobjectiveComponent rdf:type owl:Class ;
                                rdfs:subClassOf CO-META:MetaheuristicComponent ;
                                rdfs:comment "Component used in multiobjective optimization. It is required before acceptance components."@en ,
                                             "Componente utilizado en optimización multiobjetivo. Es necesario antes de los componentes de aceptación."@es ;
                                rdfs:label "Componente multiobjetivo"@es ,
                                           "Multiobjective Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#NearestNeighbourDensityComponent
CO-META:NearestNeighbourDensityComponent rdf:type owl:Class ;
                                         rdfs:subClassOf CO-META:DiversityPreservationComponent ;
                                         rdfs:comment "Componente de preservación de la diversidad que estima la densidad alrededor de cada individuo a partir de la distancia a su k-ésimo vecino más cercano en el espacio de objetivos (SPEA2)."@es ,
                                                      "Diversity preservation component that estimates the density around each individual from the distance to its k-th nearest neighbour in objective space (SPEA2)."@en ;
                                         rdfs:label "Componente de densidad del vecino más cercano"@es ,
                                                    "Nearest Neighbour Density Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#NeighbourhoodChangeComponent
CO-META:NeighbourhoodChangeComponent rdf:type owl:Class ;
                                     rdfs:subClassOf CO-META:DataHandlerComponent ;
                                     rdfs:comment "Manejador de datos que reinicia a 1 el índice de vecindario que escribe cuando la candidata mejora la solución actual y lo incrementa en otro caso, volviendo a 1 tras su cota superior."@es ,
                                                  "Data handler that resets the neighbourhood index it writes to 1 when the candidate improves the current solution and increases it otherwise, back to 1 after its upper bound."@en ;
                                     rdfs:label "Componente de cambio de vecindario"@es ,
                                                "Neighbourhood Change Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#NeighbourhoodComponent
CO-META:NeighbourhoodComponent rdf:type owl:Class ;
                               rdfs:subClassOf CO-META:ModificationComponent ;
                               rdfs:comment "Componente de modificación que genera soluciones vecinas de una solución dada aplicando un operador de movimiento."@es ,
                                            "Modification component that generates neighbouring solutions of a given solution by applying a move operator."@en ;
                               rdfs:label "Componente de vecindario"@es ,
                                          "Neighbourhood Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#NonDominatedSortingComponent
CO-META:NonDominatedSortingComponent rdf:type owl:Class ;
                                     rdfs:subClassOf CO-META:FitnessAssignmentComponent ;
                                     rdfs:comment "Componente de asignación de aptitud que clasifica cada individuo según el frente no dominado al que pertenece."@es ,
                                                  "Fitness assignment component that ranks each individual by the non-dominated front it belongs to."@en ;
                                     rdfs:label "Componente de ordenación no dominada"@es ,
                                                "Non-Dominated Sorting Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#Objective
CO-META:Objective rdf:type owl:Class ;
                  rdfs:subClassOf CO-META:ProblemElement ;
                  rdfs:comment "Objective of an optimization problem. This class should not be instantiated directly; its subclasses should be used instead."@en ,
                               "Objetivo de un problema de optimización. Esta clase no debe instanciarse directamente; deben usarse sus subclases."@es ;
                  rdfs:label "Objective"@en ,
                             "Objetivo"@es .


###  https://w3id.org/ontologies-ULL/CO-META#OrderCrossoverComponent
CO-META:OrderCrossoverComponent rdf:type owl:Class ;
                                rdfs:subClassOf CO-META:CrossoverComponent ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty CO-META:supportsShape ;
                                                  owl:allValuesFrom CO-META:DistinctSequenceShape
                                                ] ;
                                rdfs:comment "Componente de cruce para permutaciones que copia un segmento de un progenitor y rellena las posiciones restantes con los valores del otro progenitor en su orden (OX)."@es ,
                                             "Crossover component for permutations that copies a segment from one parent and fills the remaining positions with the values of the other parent in their order (OX)."@en ;
                                rdfs:label "Componente de cruce de orden"@es ,
                                           "Order Crossover Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#Parameter
CO-META:Parameter rdf:type owl:Class ;
                  rdfs:comment "Define la estructura de un parámetro utilizado por un componente, como su tipo y su rango de valores válidos."@es ,
                               "Defines the structure of a parameter used by a component, such as its type and its valid range of values."@en ;
                  rdfs:label "Parameter"@en ,
                             "Parámetro"@es .


###  https://w3id.org/ontologies-ULL/CO-META#ParameterReference
CO-META:ParameterReference rdf:type owl:Class ;
                           rdfs:subClassOf CO-META:ValueSpecification ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty CO-META:refersTo ;
                                             owl:cardinality "1"^^xsd:nonNegativeInteger
                                           ] ;
                           rdfs:comment "Value specification given by the value of a parameter, which is only known for a specific problem instance or algorithm configuration (e.g. the number of cities N)."@en ,
                                        "Especificación de valor dada por el valor de un parámetro, que solo se conoce para una instancia concreta del problema o una configuración concreta del algoritmo (p. ej., el número de ciudades N)."@es ;
                           rdfs:label "Parameter Reference"@en ,
                                      "Referencia a parámetro"@es .


###  https://w3id.org/ontologies-ULL/CO-META#ParameterValue
CO-META:ParameterValue rdf:type owl:Class ;
                       rdfs:comment "Valor asignado a un parámetro para un componente concreto."@es ,
                                    "Value assigned to a parameter for a specific component."@en ;
                       rdfs:label "Parameter Value"@en ,
                                  "Valor de parámetro"@es .


###  https://w3id.org/ontologies-ULL/CO-META#PartiallyMappedCrossoverComponent
CO-META:PartiallyMappedCrossoverComponent rdf:type owl:Class ;
                                          rdfs:subClassOf CO-META:CrossoverComponent ,
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty CO-META:supportsShape ;
                                                            owl:allValuesFrom CO-META:DistinctSequenceShape
                                                          ] ;
                                          rdfs:comment "Componente de cruce para permutaciones que intercambia un segmento entre los progenitores y repara las posiciones restantes mediante la correspondencia definida por dicho segmento (PMX)."@es ,
                                                       "Crossover component for permutations that exchanges a segment between parents and repairs the remaining positions using the mapping defined by that segment (PMX)."@en ;
                                          rdfs:label "Componente de cruce parcialmente mapeado"@es ,
                                                     "Partially Mapped Crossover Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#PermutationVariable
CO-META:PermutationVariable rdf:type owl:Class ;
                            owl:equivalentClass [ owl:intersectionOf ( CO-META:DecisionVariable
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty CO-META:hasShape ;
                                                                         owl:someValuesFrom CO-META:DistinctSequenceShape
                                                                       ]
                                                                     ) ;
                                                  rdf:type owl:Class
                                                ] ;
                            rdfs:subClassOf CO-META:DecisionVariable ;
                            rdfs:comment "Decision variable made up of an ordering of values without repetitions. When its length equals the number of possible values it is a complete permutation (e.g. the tour through the cities in the TSP); otherwise it is a partial permutation. It is inferred from the shape, so it does not need to be asserted."@en ,
                                         "Variable de decisión formada por una ordenación de valores sin repeticiones. Cuando su longitud coincide con el número de valores posibles es una permutación completa (p. ej., el recorrido por las ciudades en el TSP); si no, es una permutación parcial. Se deduce de la forma, por lo que no es necesario declararla."@es ;
                            rdfs:label "Permutation Variable"@en ,
                                       "Variable de permutación"@es .


###  https://w3id.org/ontologies-ULL/CO-META#PheromoneDepositComponent
CO-META:PheromoneDepositComponent rdf:type owl:Class ;
                                  rdfs:subClassOf CO-META:DataHandlerComponent ;
                                  rdfs:comment "Manejador de datos que añade, en los elementos que usa cada solución que recibe, la adición de feromona dividida por el coste de la solución."@es ,
                                               "Data handler that adds, on the elements used by each solution it receives, the pheromone addition divided by the solution's cost."@en ;
                                  rdfs:label "Componente de depósito de feromonas"@es ,
                                             "Pheromone Deposit Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#PheromoneEvaporationComponent
CO-META:PheromoneEvaporationComponent rdf:type owl:Class ;
                                      rdfs:subClassOf CO-META:DataHandlerComponent ;
                                      rdfs:comment "Manejador de datos que multiplica cada feromona que escribe por (1 - tasa de evaporación)."@es ,
                                                   "Data handler that multiplies every pheromone it writes by (1 - evaporation rate)."@en ;
                                      rdfs:label "Componente de evaporación de feromonas"@es ,
                                                 "Pheromone Evaporation Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#PopulationBasedMetaheuristic
CO-META:PopulationBasedMetaheuristic rdf:type owl:Class ;
                                     owl:equivalentClass [ owl:intersectionOf ( CO-META:Metaheuristic
                                                                                [ rdf:type owl:Restriction ;
                                                                                  owl:onProperty CO-META:isConnectedTo ;
                                                                                  owl:someValuesFrom [ rdf:type owl:Class ;
                                                                                                       owl:unionOf ( CO-META:PopulationConstructionComponent
                                                                                                                     CO-META:PopulationGenerationComponent
                                                                                                                   )
                                                                                                     ]
                                                                                ]
                                                                              ) ;
                                                           rdf:type owl:Class
                                                         ] ;
                                     owl:disjointWith CO-META:SingleSolutionMetaheuristic ;
                                     rdfs:comment "Metaheuristic that works with a population of solutions."@en ,
                                                  "Metaheurística que trabaja con una población de soluciones."@es ;
                                     rdfs:label "Metaheurística basada en población"@es ,
                                                "Population Based Metaheuristic"@en .


###  https://w3id.org/ontologies-ULL/CO-META#PopulationConstructionComponent
CO-META:PopulationConstructionComponent rdf:type owl:Class ;
                                        owl:equivalentClass [ owl:intersectionOf ( CO-META:ConstructionComponent
                                                                                   [ rdf:type owl:Restriction ;
                                                                                     owl:onProperty CO-META:hasParameter ;
                                                                                     owl:someValuesFrom [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                                                                                 owl:onProperty CO-META:hasType ;
                                                                                                                                 owl:hasValue CO-META:PopulationSize
                                                                                                                               ]
                                                                                                                               [ rdf:type owl:Restriction ;
                                                                                                                                 owl:onProperty CO-META:hasValue ;
                                                                                                                                 owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                                                                                      owl:onDatatype xsd:integer ;
                                                                                                                                                      owl:withRestrictions ( [ xsd:minExclusive 1
                                                                                                                                                                             ]
                                                                                                                                                                           )
                                                                                                                                                    ]
                                                                                                                               ]
                                                                                                                             ) ;
                                                                                                          rdf:type owl:Class
                                                                                                        ]
                                                                                   ]
                                                                                 ) ;
                                                              rdf:type owl:Class
                                                            ] ;
                                        rdfs:subClassOf CO-META:ConstructionComponent ;
                                        owl:disjointWith CO-META:SingleSolutionConstructionComponent ;
                                        rdfs:comment "Componente de construcción que construye una población de más de una solución."@es ,
                                                     "Construction component that builds a population of more than one solution."@en ;
                                        rdfs:label "Componente de construcción de población"@es ,
                                                   "Population Construction Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#PopulationGenerationComponent
CO-META:PopulationGenerationComponent rdf:type owl:Class ;
                                      owl:equivalentClass [ owl:intersectionOf ( CO-META:GenerationComponent
                                                                                 [ rdf:type owl:Restriction ;
                                                                                   owl:onProperty CO-META:hasParameter ;
                                                                                   owl:someValuesFrom [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                                                                               owl:onProperty CO-META:hasType ;
                                                                                                                               owl:hasValue CO-META:PopulationSize
                                                                                                                             ]
                                                                                                                             [ rdf:type owl:Restriction ;
                                                                                                                               owl:onProperty CO-META:hasValue ;
                                                                                                                               owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                                                                                    owl:onDatatype xsd:integer ;
                                                                                                                                                    owl:withRestrictions ( [ xsd:minExclusive 1
                                                                                                                                                                           ]
                                                                                                                                                                         )
                                                                                                                                                  ]
                                                                                                                             ]
                                                                                                                           ) ;
                                                                                                        rdf:type owl:Class
                                                                                                      ]
                                                                                 ]
                                                                               ) ;
                                                            rdf:type owl:Class
                                                          ] ;
                                      rdfs:subClassOf CO-META:GenerationComponent ;
                                      owl:disjointWith CO-META:SingleSolutionGenerationComponent ;
                                      rdfs:comment "Componente de generación que genera una población inicial de más de una solución."@es ,
                                                   "Generation component that generates an initial population of more than one solution."@en ;
                                      rdfs:label "Componente de generación de población"@es ,
                                                 "Population Generation Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#PopulationModifierComponent
CO-META:PopulationModifierComponent rdf:type owl:Class ;
                                    rdfs:subClassOf CO-META:LoopComponent ;
                                    owl:disjointWith CO-META:StoppingCriterionComponent ;
                                    rdfs:comment "Componente de bucle que repite un proceso parcial, tomando la población anterior como entrada, hasta completar la nueva población."@es ,
                                                 "Loop component that repeats a partial process, taking the old population as input, until the new population is filled."@en ;
                                    rdfs:label "Componente modificador de población"@es ,
                                               "Population Modifier Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#PopulationOperatorComponent
CO-META:PopulationOperatorComponent rdf:type owl:Class ;
                                    rdfs:subClassOf CO-META:ModificationComponent ;
                                    rdfs:comment "Componente de modificación que opera sobre poblaciones completas."@es ,
                                                 "Modification component that operates on whole populations."@en ;
                                    rdfs:label "Componente operador de población"@es ,
                                               "Population Operator Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#Problem
CO-META:Problem rdf:type owl:Class ;
                rdfs:subClassOf [ rdf:type owl:Restriction ;
                                  owl:onProperty CO-META:hasObjective ;
                                  owl:someValuesFrom CO-META:Objective
                                ] ;
                rdfs:comment "Optimization problem, formulated by its data, its decision variables, at least one objective and, optionally, constraints. A solution is an assignment of values to its decision variables."@en ,
                             "Problema de optimización, formulado mediante sus datos, sus variables de decisión, al menos un objetivo y, opcionalmente, restricciones. Una solución es una asignación de valores a sus variables de decisión."@es ;
                rdfs:label "Problem"@en ,
                           "Problema"@es .


###  https://w3id.org/ontologies-ULL/CO-META#ProblemData
CO-META:ProblemData rdf:type owl:Class ;
                    rdfs:subClassOf CO-META:ProblemQuantity ;
                    rdfs:comment "Magnitud del problema cuyo valor se conoce antes de resolverlo y que caracteriza una instancia concreta del problema."@es ,
                                 "Problem quantity whose value is known before solving the problem and that characterizes a specific instance of it."@en ;
                    rdfs:label "Datos del problema"@es ,
                               "Problem Data"@en .


###  https://w3id.org/ontologies-ULL/CO-META#ProblemElement
CO-META:ProblemElement rdf:type owl:Class ;
                       rdfs:comment "Constituent of the mathematical formulation of an optimization problem: its data, its decision variables, its objectives or its constraints."@en ,
                                    "Constituyente de la formulación matemática de un problema de optimización: sus datos, sus variables de decisión, sus objetivos o sus restricciones."@es ;
                       rdfs:label "Elemento del problema"@es ,
                                  "Problem Element"@en .


###  https://w3id.org/ontologies-ULL/CO-META#ProblemQuantity
CO-META:ProblemQuantity rdf:type owl:Class ;
                        rdfs:subClassOf CO-META:ProblemElement ;
                        rdfs:comment "Magnitud, o colección indexada de magnitudes, que interviene en la formulación del problema y se representa mediante un símbolo en sus expresiones. Su valor se conoce de antemano (datos) o se busca al resolver el problema (variable de decisión). No se refiere a una magnitud física."@es ,
                                     "Quantity, or indexed collection of quantities, that takes part in the formulation of the problem and is represented by a symbol in its expressions. Its value is either known in advance (data) or sought when solving the problem (decision variable). It does not refer to a physical quantity."@en ;
                        rdfs:label "Magnitud del problema"@es ,
                                   "Problem Quantity"@en .


###  https://w3id.org/ontologies-ULL/CO-META#RandomDecisionCrossoverComponent
CO-META:RandomDecisionCrossoverComponent rdf:type owl:Class ;
                                         rdfs:subClassOf CO-META:CrossoverComponent ;
                                         rdfs:comment "Componente de cruce que decide aleatoriamente, para cada posición, de qué progenitor hereda el valor el descendiente."@es ,
                                                      "Crossover component that decides randomly, for each position, from which parent the offspring inherits the value."@en ;
                                         rdfs:label "Componente de cruce por decisión aleatoria"@es ,
                                                    "Random Decision Crossover Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#RandomGenerationComponent
CO-META:RandomGenerationComponent rdf:type owl:Class ;
                                  rdfs:subClassOf CO-META:GenerationComponent ;
                                  rdfs:comment "Componente de generación que obtiene cada solución de forma uniformemente aleatoria a partir de la representación de las variables de decisión."@es ,
                                               "Generation component that draws each solution uniformly at random from the representation of the decision variables."@en ;
                                  rdfs:label "Componente de generación aleatoria"@es ,
                                             "Random Generation Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#RandomResetMutationComponent
CO-META:RandomResetMutationComponent rdf:type owl:Class ;
                                     rdfs:subClassOf CO-META:VariationComponent ;
                                     rdfs:comment "Componente de variación que sustituye el valor de una posición aleatoria por un valor aleatorio de su dominio."@es ,
                                                  "Variation component that replaces the value of a random position with a random value of its domain."@en ;
                                     rdfs:label "Componente de mutación por reinicio aleatorio"@es ,
                                                "Random Reset Mutation Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#RandomSelectionComponent
CO-META:RandomSelectionComponent rdf:type owl:Class ;
                                 rdfs:subClassOf CO-META:SelectionComponent ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty CO-META:hasOutputSize ;
                                                   owl:hasValue 2
                                                 ] ;
                                 rdfs:comment "Componente de selección que selecciona aleatoriamente una pareja de individuos."@es ,
                                              "Selection component that selects a pair of individuals at random."@en ;
                                 rdfs:label "Componente de selección aleatoria"@es ,
                                            "Random Selection Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#RouletteWheelSelectionComponent
CO-META:RouletteWheelSelectionComponent rdf:type owl:Class ;
                                        rdfs:subClassOf CO-META:SelectionComponent ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty CO-META:hasOutputSize ;
                                                          owl:hasValue 2
                                                        ] ;
                                        rdfs:comment "Componente de selección que selecciona cada individuo con probabilidad proporcional a su posición según la aptitud."@es ,
                                                     "Selection component that selects each individual with probability proportional to its fitness rank."@en ;
                                        rdfs:label "Componente de selección por ruleta"@es ,
                                                   "Roulette Wheel Selection Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#ScalarShape
CO-META:ScalarShape rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Class ;
                                          owl:oneOf ( CO-META:Scalar
                                                    )
                                        ] ;
                    rdfs:subClassOf CO-META:DataShape ;
                    rdfs:comment "Shape of a quantity made up of a single value. Its only instance is Scalar."@en ,
                                 "Forma de una magnitud formada por un único valor. Su única instancia es Scalar."@es ;
                    rdfs:label "Scalar Shape"@en ,
                               "Forma escalar"@es .


###  https://w3id.org/ontologies-ULL/CO-META#ScalarVariable
CO-META:ScalarVariable rdf:type owl:Class ;
                       owl:equivalentClass [ owl:intersectionOf ( CO-META:DecisionVariable
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty CO-META:hasShape ;
                                                                    owl:someValuesFrom CO-META:ScalarShape
                                                                  ]
                                                                ) ;
                                             rdf:type owl:Class
                                           ] ;
                       rdfs:subClassOf CO-META:DecisionVariable ;
                       rdfs:comment "Decision variable that takes a single value (e.g. the number of vehicles to use). It is inferred from the shape, so it does not need to be asserted."@en ,
                                    "Variable de decisión que toma un único valor (p. ej., el número de vehículos que se van a utilizar). Se deduce de la forma, por lo que no es necesario declararla."@es ;
                       rdfs:label "Scalar Variable"@en ,
                                  "Variable escalar"@es .


###  https://w3id.org/ontologies-ULL/CO-META#SelectionComponent
CO-META:SelectionComponent rdf:type owl:Class ;
                           rdfs:subClassOf CO-META:ModificationComponent ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty CO-META:hasParameter ;
                                             owl:someValuesFrom [ rdf:type owl:Restriction ;
                                                                  owl:onProperty CO-META:hasType ;
                                                                  owl:hasValue CO-META:Elitism
                                                                ]
                                           ] ;
                           rdfs:comment "Componente de modificación que selecciona los individuos que formarán parte de la siguiente generación. Tiene un parámetro de elitismo."@es ,
                                        "Modification component that selects the individuals that will take part in the next generation. It has an elitism parameter."@en ;
                           rdfs:label "Componente de selección"@es ,
                                      "Selection Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#SequenceShape
CO-META:SequenceShape rdf:type owl:Class ;
                      owl:equivalentClass [ owl:intersectionOf ( CO-META:CollectionShape
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty CO-META:isOrdered ;
                                                                   owl:hasValue "true"^^xsd:boolean
                                                                 ]
                                                               ) ;
                                            rdf:type owl:Class
                                          ] ;
                      rdfs:subClassOf qudt:Sequence ;
                      rdfs:comment "Collection whose values are ordered, so that each one occupies a position (e.g. whether each item is put in the knapsack)."@en ,
                                   "Colección cuyos valores están ordenados, de modo que cada uno ocupa una posición (p. ej., si cada objeto se mete en la mochila)."@es ;
                      rdfs:label "Sequence Shape"@en ,
                                 "Forma de secuencia"@es .


###  https://w3id.org/ontologies-ULL/CO-META#SequenceVariable
CO-META:SequenceVariable rdf:type owl:Class ;
                         owl:equivalentClass [ owl:intersectionOf ( CO-META:DecisionVariable
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty CO-META:hasShape ;
                                                                      owl:someValuesFrom CO-META:SequenceShape
                                                                    ]
                                                                  ) ;
                                               rdf:type owl:Class
                                             ] ;
                         rdfs:subClassOf CO-META:DecisionVariable ;
                         rdfs:comment "Decision variable made up of an ordered sequence of values, one per position, which may be repeated unless it is a permutation (e.g. whether each item is put in the knapsack). It is inferred from the shape, so it does not need to be asserted."@en ,
                                      "Variable de decisión formada por una secuencia ordenada de valores, uno por posición, que pueden repetirse salvo que sea una permutación (p. ej., si cada objeto se mete en la mochila). Se deduce de la forma, por lo que no es necesario declararla."@es ;
                         rdfs:label "Sequence Variable"@en ,
                                    "Variable de secuencia"@es .


###  https://w3id.org/ontologies-ULL/CO-META#SequentialIterativeSelectionComponent
CO-META:SequentialIterativeSelectionComponent rdf:type owl:Class ;
                                              rdfs:subClassOf CO-META:IterativeSelectionComponent ;
                                              rdfs:comment "Componente de selección iterativa que selecciona los individuos de la población uno a uno, en orden (p. ej. cada hormiga o cada partícula)."@es ,
                                                           "Iterative selection component that selects the individuals of the population one by one, in order (e.g. each ant or each particle)."@en ;
                                              rdfs:label "Componente de selección iterativa secuencial"@es ,
                                                         "Sequential Iterative Selection Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#SetShape
CO-META:SetShape rdf:type owl:Class ;
                 owl:equivalentClass [ owl:intersectionOf ( CO-META:CollectionShape
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty CO-META:isDistinct ;
                                                              owl:hasValue "true"^^xsd:boolean
                                                            ]
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty CO-META:isOrdered ;
                                                              owl:hasValue "false"^^xsd:boolean
                                                            ]
                                                          ) ;
                                       rdf:type owl:Class
                                     ] ;
                 rdfs:subClassOf qudt:Set ;
                 rdfs:comment "Collection whose values are neither ordered nor repeated (e.g. a selection of k locations out of N)."@en ,
                              "Colección cuyos valores no están ordenados ni se repiten (p. ej., una selección de k ubicaciones de entre N)."@es ;
                 rdfs:label "Set Shape"@en ,
                            "Forma de conjunto"@es .


###  https://w3id.org/ontologies-ULL/CO-META#SetVariable
CO-META:SetVariable rdf:type owl:Class ;
                    owl:equivalentClass [ owl:intersectionOf ( CO-META:DecisionVariable
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty CO-META:hasShape ;
                                                                 owl:someValuesFrom CO-META:SetShape
                                                               ]
                                                             ) ;
                                          rdf:type owl:Class
                                        ] ;
                    rdfs:subClassOf CO-META:DecisionVariable ;
                    rdfs:comment "Decision variable made up of an unordered selection of values without repetitions (e.g. the k locations where facilities are opened). It is inferred from the shape, so it does not need to be asserted."@en ,
                                 "Variable de decisión formada por una selección no ordenada de valores sin repeticiones (p. ej., las k ubicaciones en las que se abren instalaciones). Se deduce de la forma, por lo que no es necesario declararla."@es ;
                    rdfs:label "Set Variable"@en ,
                               "Variable de conjunto"@es .


###  https://w3id.org/ontologies-ULL/CO-META#SimplePairSelectionComponent
CO-META:SimplePairSelectionComponent rdf:type owl:Class ;
                                     rdfs:subClassOf CO-META:SelectionComponent ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty CO-META:hasOutputSize ;
                                                       owl:hasValue 2
                                                     ] ;
                                     rdfs:comment "Componente de selección que selecciona individuos por parejas en orden."@es ,
                                                  "Selection component that selects pairs of individuals in order."@en ;
                                     rdfs:label "Componente de selección simple por parejas"@es ,
                                                "Simple Pair Selection Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#SingleSolutionConstructionComponent
CO-META:SingleSolutionConstructionComponent rdf:type owl:Class ;
                                            owl:equivalentClass [ owl:intersectionOf ( CO-META:ConstructionComponent
                                                                                       [ rdf:type owl:Restriction ;
                                                                                         owl:onProperty CO-META:hasParameter ;
                                                                                         owl:someValuesFrom [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                                                                                     owl:onProperty CO-META:hasType ;
                                                                                                                                     owl:hasValue CO-META:PopulationSize
                                                                                                                                   ]
                                                                                                                                   [ rdf:type owl:Restriction ;
                                                                                                                                     owl:onProperty CO-META:hasValue ;
                                                                                                                                     owl:hasValue 1
                                                                                                                                   ]
                                                                                                                                 ) ;
                                                                                                              rdf:type owl:Class
                                                                                                            ]
                                                                                       ]
                                                                                     ) ;
                                                                  rdf:type owl:Class
                                                                ] ;
                                            rdfs:subClassOf CO-META:ConstructionComponent ;
                                            rdfs:comment "Componente de construcción que construye una única solución (tamaño de población igual a 1)."@es ,
                                                         "Construction component that builds a single solution (population size equal to 1)."@en ;
                                            rdfs:label "Componente de construcción de solución única"@es ,
                                                       "Single Solution Construction Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#SingleSolutionGenerationComponent
CO-META:SingleSolutionGenerationComponent rdf:type owl:Class ;
                                          owl:equivalentClass [ owl:intersectionOf ( CO-META:GenerationComponent
                                                                                     [ rdf:type owl:Restriction ;
                                                                                       owl:onProperty CO-META:hasParameter ;
                                                                                       owl:someValuesFrom [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                                                                                   owl:onProperty CO-META:hasType ;
                                                                                                                                   owl:hasValue CO-META:PopulationSize
                                                                                                                                 ]
                                                                                                                                 [ rdf:type owl:Restriction ;
                                                                                                                                   owl:onProperty CO-META:hasValue ;
                                                                                                                                   owl:hasValue 1
                                                                                                                                 ]
                                                                                                                               ) ;
                                                                                                            rdf:type owl:Class
                                                                                                          ]
                                                                                     ]
                                                                                   ) ;
                                                                rdf:type owl:Class
                                                              ] ;
                                          rdfs:subClassOf CO-META:GenerationComponent ;
                                          rdfs:comment "Componente de generación que genera una única solución inicial (tamaño de población igual a 1)."@es ,
                                                       "Generation component that generates a single initial solution (population size equal to 1)."@en ;
                                          rdfs:label "Componente de generación de solución única"@es ,
                                                     "Single Solution Generation Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#SingleSolutionMetaheuristic
CO-META:SingleSolutionMetaheuristic rdf:type owl:Class ;
                                    owl:equivalentClass [ owl:intersectionOf ( CO-META:Metaheuristic
                                                                               [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty CO-META:isConnectedTo ;
                                                                                 owl:someValuesFrom [ rdf:type owl:Class ;
                                                                                                      owl:unionOf ( CO-META:SingleSolutionConstructionComponent
                                                                                                                    CO-META:SingleSolutionGenerationComponent
                                                                                                                  )
                                                                                                    ]
                                                                               ]
                                                                             ) ;
                                                          rdf:type owl:Class
                                                        ] ;
                                    rdfs:comment "Metaheuristic that works with a single solution at a time."@en ,
                                                 "Metaheurística que trabaja con una única solución a la vez."@es ;
                                    rdfs:label "Metaheurística basada en solución única"@es ,
                                               "Single Solution Based Metaheuristic"@en .


###  https://w3id.org/ontologies-ULL/CO-META#SolutionSizeReference
CO-META:SolutionSizeReference rdf:type owl:Class ;
                              rdfs:subClassOf CO-META:ValueSpecification ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty CO-META:hasDimensionIndex ;
                                                owl:cardinality "1"^^xsd:nonNegativeInteger
                                              ] ;
                              rdfs:comment "Value specification given by the size of one dimension of the solution handled by the algorithm. It allows algorithm data structures to be sized independently of any specific problem (e.g. an n × n pheromone matrix)."@en ,
                                           "Especificación de valor dada por el tamaño de una dimensión de la solución que maneja el algoritmo. Permite dimensionar las estructuras de datos del algoritmo sin depender de un problema concreto (p. ej., una matriz de feromonas de n × n)."@es ;
                              rdfs:label "Solution Size Reference"@en ,
                                         "Referencia al tamaño de la solución"@es .


###  https://w3id.org/ontologies-ULL/CO-META#StoppingCriterionComponent
CO-META:StoppingCriterionComponent rdf:type owl:Class ;
                                   rdfs:subClassOf CO-META:LoopComponent ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty CO-META:hasParameter ;
                                                     owl:someValuesFrom [ rdf:type owl:Restriction ;
                                                                          owl:onProperty CO-META:hasType ;
                                                                          owl:hasValue CO-META:Iterations
                                                                        ]
                                                   ] ;
                                   rdfs:comment "Componente de bucle que crea el bucle principal del algoritmo y determina cuándo detenerlo. Tiene un parámetro de número de iteraciones."@es ,
                                                "Loop component that creates the main loop of the algorithm and determines when to stop it. It has an iterations parameter."@en ;
                                   rdfs:label "Componente de criterio de parada"@es ,
                                              "Stopping Criterion Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#StrengthFitnessComponent
CO-META:StrengthFitnessComponent rdf:type owl:Class ;
                                 rdfs:subClassOf CO-META:FitnessAssignmentComponent ;
                                 rdfs:comment "Componente de asignación de aptitud que da a cada individuo la suma de las fuerzas (número de individuos dominados) de los que lo dominan (aptitud bruta de SPEA2)."@es ,
                                              "Fitness assignment component that gives each individual the sum of the strengths (number of dominated individuals) of those that dominate it (SPEA2 raw fitness)."@en ;
                                 rdfs:label "Componente de aptitud por fuerza"@es ,
                                            "Strength Fitness Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#SubtractionComponent
CO-META:SubtractionComponent rdf:type owl:Class ;
                             rdfs:subClassOf CO-META:PopulationOperatorComponent ;
                             rdfs:comment "Operador de población que elimina de su entrada las soluciones almacenadas en las estructuras de datos que lee (p. ej. una lista tabú)."@es ,
                                          "Population operator that removes from its input the solutions stored in the data structures it reads (e.g. a tabu list)."@en ;
                             rdfs:label "Componente de sustracción"@es ,
                                        "Subtraction Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#SwapMutationComponent
CO-META:SwapMutationComponent rdf:type owl:Class ;
                              rdfs:subClassOf CO-META:VariationComponent ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty CO-META:supportsShape ;
                                                owl:allValuesFrom CO-META:DistinctSequenceShape
                                              ] ;
                              rdfs:comment "Componente de variación que intercambia los valores de dos posiciones aleatorias de una permutación."@es ,
                                           "Variation component that exchanges the values of two random positions of a permutation."@en ;
                              rdfs:label "Componente de mutación por intercambio"@es ,
                                         "Swap Mutation Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#SwapNeighbourhoodComponent
CO-META:SwapNeighbourhoodComponent rdf:type owl:Class ;
                                   rdfs:subClassOf CO-META:NeighbourhoodComponent ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty CO-META:supportsShape ;
                                                     owl:allValuesFrom CO-META:DistinctSequenceShape
                                                   ] ;
                                   rdfs:comment "Vecindario de las permutaciones obtenidas intercambiando los valores de dos posiciones."@es ,
                                                "Neighbourhood of the permutations obtained by exchanging the values of two positions."@en ;
                                   rdfs:label "Componente de vecindario de intercambio"@es ,
                                              "Swap Neighbourhood Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#TableData
CO-META:TableData rdf:type owl:Class ;
                  owl:equivalentClass [ owl:intersectionOf ( CO-META:ProblemData
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty CO-META:hasShape ;
                                                               owl:someValuesFrom CO-META:TableShape
                                                             ]
                                                           ) ;
                                        rdf:type owl:Class
                                      ] ;
                  rdfs:subClassOf CO-META:ProblemData ;
                  rdfs:comment "Problem data organized as a table of records, each of which describes an entity of the problem by means of its attributes (e.g. the coordinates of each city). It is inferred from the shape, so it does not need to be asserted."@en ,
                               "Datos del problema organizados como una tabla de registros, cada uno de los cuales describe una entidad del problema mediante sus atributos (p. ej., las coordenadas de cada ciudad). Se deduce de la forma, por lo que no es necesario declararla."@es ;
                  rdfs:label "Table Data"@en ,
                             "Datos en tabla"@es .


###  https://w3id.org/ontologies-ULL/CO-META#TableShape
CO-META:TableShape rdf:type owl:Class ;
                   rdfs:subClassOf CO-META:DataShape ,
                                   qudt:Table ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty CO-META:hasRowCount ;
                                     owl:cardinality "1"^^xsd:nonNegativeInteger
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty CO-META:hasColumn ;
                                     owl:someValuesFrom CO-META:Column
                                   ] ;
                   rdfs:comment "Shape of a quantity made up of homogeneous records (rows), each of which describes an entity of the problem by means of named attributes (columns) (e.g. the coordinates of each city)."@en ,
                                "Forma de una magnitud formada por registros homogéneos (filas), cada uno de los cuales describe una entidad del problema mediante atributos con nombre (columnas) (p. ej., las coordenadas de cada ciudad)."@es ;
                   rdfs:label "Table Shape"@en ,
                              "Forma de tabla"@es .


###  https://w3id.org/ontologies-ULL/CO-META#TabuListUpdateComponent
CO-META:TabuListUpdateComponent rdf:type owl:Class ;
                                rdfs:subClassOf CO-META:DataHandlerComponent ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty CO-META:hasParameter ;
                                                  owl:someValuesFrom [ rdf:type owl:Restriction ;
                                                                       owl:onProperty CO-META:hasType ;
                                                                       owl:hasValue CO-META:StorageSize
                                                                     ]
                                                ] ;
                                rdfs:comment "Manejador de datos que almacena las soluciones que recibe en la lista que escribe, descartando las más antiguas por encima del tamaño de almacenamiento, y las deja pasar."@es ,
                                             "Data handler that stores the solutions it receives in the list it writes, discarding the oldest beyond the storage size, and passes them on."@en ;
                                rdfs:label "Componente de actualización de la lista tabú"@es ,
                                           "Tabu List Update Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#TournamentSelectionComponent
CO-META:TournamentSelectionComponent rdf:type owl:Class ;
                                     rdfs:subClassOf CO-META:SelectionComponent ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty CO-META:hasParameter ;
                                                       owl:someValuesFrom [ rdf:type owl:Restriction ;
                                                                            owl:onProperty CO-META:hasType ;
                                                                            owl:hasValue CO-META:TournamentSize
                                                                          ]
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty CO-META:hasOutputSize ;
                                                       owl:hasValue 2
                                                     ] ;
                                     rdfs:comment "Componente de selección que selecciona cada individuo como el mejor de un grupo elegido aleatoriamente (torneo). Tiene un parámetro de tamaño de torneo."@es ,
                                                  "Selection component that selects each individual as the best one of a randomly chosen group (tournament). It has a tournament size parameter."@en ;
                                     rdfs:label "Componente de selección por torneo"@es ,
                                                "Tournament Selection Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#TruncationComponent
CO-META:TruncationComponent rdf:type owl:Class ;
                            rdfs:subClassOf CO-META:PopulationOperatorComponent ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty CO-META:hasParameter ;
                                              owl:someValuesFrom [ rdf:type owl:Restriction ;
                                                                   owl:onProperty CO-META:hasType ;
                                                                   owl:hasValue CO-META:PopulationSize
                                                                 ]
                                            ] ;
                            rdfs:comment "Operador de población que conserva los mejores individuos hasta el tamaño de población, según la aptitud asignada por los componentes previos (rango y diversidad) o, si no la hay, según los objetivos."@es ,
                                         "Population operator that keeps the best individuals up to the population size, according to the fitness assigned by the previous components (rank and diversity) or, without it, to the objectives."@en ;
                            rdfs:label "Componente de truncamiento"@es ,
                                       "Truncation Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#TwoOptNeighbourhoodComponent
CO-META:TwoOptNeighbourhoodComponent rdf:type owl:Class ;
                                     rdfs:subClassOf CO-META:NeighbourhoodComponent ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty CO-META:supportsShape ;
                                                       owl:allValuesFrom CO-META:DistinctSequenceShape
                                                     ] ;
                                     rdfs:comment "Vecindario de las permutaciones obtenidas invirtiendo un segmento (movimiento 2-opt)."@es ,
                                                  "Neighbourhood of the permutations obtained by reversing a segment (2-opt move)."@en ;
                                     rdfs:label "Componente de vecindario 2-opt"@es ,
                                                "2-opt Neighbourhood Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#UnionComponent
CO-META:UnionComponent rdf:type owl:Class ;
                       rdfs:subClassOf CO-META:PopulationOperatorComponent ;
                       rdfs:comment "Operador de población que une, sin repeticiones, las poblaciones que recibe y las soluciones de las estructuras de datos que lee."@es ,
                                    "Population operator that joins, without repetitions, the populations it receives and the solutions of the data structures it reads."@en ;
                       rdfs:label "Componente de unión"@es ,
                                  "Union Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#UpdateBestComponent
CO-META:UpdateBestComponent rdf:type owl:Class ;
                            rdfs:subClassOf CO-META:MetaheuristicComponent ;
                            rdfs:comment "Component that updates the best solution or solutions found so far by the algorithm."@en ,
                                         "Componente que actualiza la mejor solución o soluciones encontradas hasta el momento por el algoritmo."@es ;
                            rdfs:label "Componente de actualización del mejor"@es ,
                                       "Update Best Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#ValueDomain
CO-META:ValueDomain rdf:type owl:Class ;
                    rdfs:subClassOf [ rdf:type owl:Restriction ;
                                      owl:onProperty CO-META:hasBaseType ;
                                      owl:cardinality "1"^^xsd:nonNegativeInteger
                                    ] ;
                    rdfs:comment "Set of values that a quantity or parameter can take, defined by a base number set and optional lower and upper bounds (e.g. the integers between 0 and 1)."@en ,
                                 "Conjunto de valores que puede tomar una magnitud o un parámetro, definido por un conjunto numérico base y cotas inferior y superior opcionales (p. ej., los enteros entre 0 y 1)."@es ;
                    rdfs:label "Value Domain"@en ,
                               "Dominio de valores"@es .


###  https://w3id.org/ontologies-ULL/CO-META#ValueSpecification
CO-META:ValueSpecification rdf:type owl:Class ;
                           rdfs:comment "Number used as a size or as a bound, given explicitly or by reference to a parameter or to the size of the solution. This class should not be instantiated directly; its subclasses should be used instead."@en ,
                                        "Número usado como tamaño o como cota, indicado explícitamente o mediante una referencia a un parámetro o al tamaño de la solución. Esta clase no debe instanciarse directamente; deben usarse sus subclases."@es ;
                           rdfs:label "Value Specification"@en ,
                                      "Especificación de valor"@es .


###  https://w3id.org/ontologies-ULL/CO-META#VariationComponent
CO-META:VariationComponent rdf:type owl:Class ;
                           rdfs:subClassOf CO-META:ModificationComponent ;
                           rdfs:comment "Componente de modificación que introduce pequeños cambios aleatorios en una solución (mutación)."@es ,
                                        "Modification component that introduces small random changes to a solution (mutation)."@en ;
                           rdfs:label "Componente de variación"@es ,
                                      "Variation Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#VelocityApplicationComponent
CO-META:VelocityApplicationComponent rdf:type owl:Class ;
                                     rdfs:subClassOf CO-META:ModificationComponent ;
                                     rdfs:comment "Componente de modificación que desplaza cada partícula que recibe según su velocidad: sumada a los valores reales, o mediante una sigmoide como probabilidad de un 1 en valores binarios."@es ,
                                                  "Modification component that moves each particle it receives by its velocity: added to real values, or through a sigmoid as the probability of a 1 for binary values."@en ;
                                     rdfs:label "Componente de aplicación de la velocidad"@es ,
                                                "Velocity Application Component"@en .


###  https://w3id.org/ontologies-ULL/CO-META#VelocityUpdateComponent
CO-META:VelocityUpdateComponent rdf:type owl:Class ;
                                rdfs:subClassOf CO-META:DataHandlerComponent ;
                                rdfs:comment "Manejador de datos que actualiza la velocidad de cada partícula que recibe a partir de su inercia y la atracción hacia su mejor posición personal y la mejor global."@es ,
                                             "Data handler that updates the velocity of each particle it receives from its inertia and the attraction towards its personal best and the global best."@en ;
                                rdfs:label "Componente de actualización de la velocidad"@es ,
                                           "Velocity Update Component"@en .


