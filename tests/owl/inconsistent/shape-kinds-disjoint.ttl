# Expected: inconsistent.
# A matrix (anonymous columns of the same kind) and a table (named attributes) are disjoint shapes.
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix CO-META: <https://w3id.org/ontologies-ULL/CO-META#> .
@prefix t: <http://example.org/co-meta-test#> .

<http://example.org/co-meta-test/shape-kinds-disjoint> a owl:Ontology ;
    owl:imports <https://w3id.org/ontologies-ULL/CO-META> .

t:shape a owl:NamedIndividual , CO-META:MatrixShape , CO-META:TableShape .
