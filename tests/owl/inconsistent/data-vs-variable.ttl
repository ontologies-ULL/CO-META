# Expected: inconsistent.
# Problem data (known in advance) and decision variables (sought) are disjoint.
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix CO-META: <https://w3id.org/ontologies-ULL/CO-META#> .
@prefix t: <http://example.org/co-meta-test#> .

<http://example.org/co-meta-test/data-vs-variable> a owl:Ontology ;
    owl:imports <https://w3id.org/ontologies-ULL/CO-META> .

t:quantity a owl:NamedIndividual , CO-META:Column , CO-META:DecisionVariable .
