# Expected: inconsistent.
# An objective cannot be both maximized and minimized.
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix CO-META: <https://w3id.org/ontologies-ULL/CO-META#> .
@prefix t: <http://example.org/co-meta-test#> .

<http://example.org/co-meta-test/objective-sense> a owl:Ontology ;
    owl:imports <https://w3id.org/ontologies-ULL/CO-META> .

t:objective a owl:NamedIndividual , CO-META:MaximizationObjective , CO-META:MinimizationObjective .
