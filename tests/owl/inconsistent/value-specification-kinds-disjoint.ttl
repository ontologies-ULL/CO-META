# Expected: inconsistent.
# A value specification is either a literal, a parameter reference or a solution size reference.
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix CO-META: <https://w3id.org/ontologies-ULL/CO-META#> .
@prefix t: <http://example.org/co-meta-test#> .

<http://example.org/co-meta-test/value-specification-kinds-disjoint> a owl:Ontology ;
    owl:imports <https://w3id.org/ontologies-ULL/CO-META> .

t:bound a owl:NamedIndividual , CO-META:LiteralValue , CO-META:ParameterReference .
