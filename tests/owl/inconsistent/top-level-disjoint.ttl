# Expected: inconsistent.
# Problem elements and metaheuristics are disjoint top-level classes.
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix CO-META: <https://w3id.org/ontologies-ULL/CO-META#> .
@prefix t: <http://example.org/co-meta-test#> .

<http://example.org/co-meta-test/top-level-disjoint> a owl:Ontology ;
    owl:imports <https://w3id.org/ontologies-ULL/CO-META> .

t:thing a owl:NamedIndividual , CO-META:Constraint , CO-META:Metaheuristic .
