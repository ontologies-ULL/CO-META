# Expected: inconsistent.
# The seed of an execution is a non-negative integer.
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix CO-META: <https://w3id.org/ontologies-ULL/CO-META#> .
@prefix t: <http://example.org/co-meta-test#> .

<http://example.org/co-meta-test/seed-non-negative> a owl:Ontology ;
    owl:imports <https://w3id.org/ontologies-ULL/CO-META> .

t:execution a owl:NamedIndividual , CO-META:Execution ;
    CO-META:hasSeed "-1"^^xsd:integer .
