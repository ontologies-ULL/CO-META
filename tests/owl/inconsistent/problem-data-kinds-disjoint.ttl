# Expected: inconsistent.
# An input parameter (a scalar datum) cannot be a column of a table.
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix CO-META: <https://w3id.org/ontologies-ULL/CO-META#> .
@prefix t: <http://example.org/co-meta-test#> .

<http://example.org/co-meta-test/problem-data-kinds-disjoint> a owl:Ontology ;
    owl:imports <https://w3id.org/ontologies-ULL/CO-META> .

t:data a owl:NamedIndividual , CO-META:InputParameter , CO-META:Column .
