# Expected: inconsistent.
# A value domain has at most one lower bound, inclusive or exclusive.
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix CO-META: <https://w3id.org/ontologies-ULL/CO-META#> .
@prefix t: <http://example.org/co-meta-test#> .

<http://example.org/co-meta-test/single-lower-bound> a owl:Ontology ;
    owl:imports <https://w3id.org/ontologies-ULL/CO-META> .

t:domain a owl:NamedIndividual , CO-META:ValueDomain ;
    CO-META:hasBaseType CO-META:Reals ;
    CO-META:hasLowerBound CO-META:Zero ;
    CO-META:hasExclusiveLowerBound CO-META:Zero .
