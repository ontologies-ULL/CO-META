# Expected: consistent.
# Unbounded domains can use -INF and INF as xsd:double literal bounds.
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix CO-META: <https://w3id.org/ontologies-ULL/CO-META#> .
@prefix t: <http://example.org/co-meta-test#> .

<http://example.org/co-meta-test/infinite-bounds> a owl:Ontology ;
    owl:imports <https://w3id.org/ontologies-ULL/CO-META> .

t:x a owl:NamedIndividual , CO-META:DecisionVariable ;
    CO-META:hasShape CO-META:Scalar ;
    CO-META:hasValueDomain [ a CO-META:ValueDomain ;
                             CO-META:hasBaseType CO-META:Reals ;
                             CO-META:hasLowerBound [ a CO-META:LiteralValue ;
                                                     CO-META:hasLiteralValue "-INF"^^xsd:double ] ;
                             CO-META:hasUpperBound [ a CO-META:LiteralValue ;
                                                     CO-META:hasLiteralValue "INF"^^xsd:double ] ] .
