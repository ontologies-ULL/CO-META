# Expected: consistent.
# A soft constraint with a penalty weight, a constraint implied by the shape of
# the variables, heuristic information and normalization values of an
# objective.
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix CO-META: <https://w3id.org/ontologies-ULL/CO-META#> .
@prefix t: <http://example.org/co-meta-test#> .

<http://example.org/co-meta-test/problem-formulation> a owl:Ontology ;
    owl:imports <https://w3id.org/ontologies-ULL/CO-META> .

t:problem a owl:NamedIndividual , CO-META:Problem ;
    CO-META:hasProblemElement t:n , t:d , t:x ;
    CO-META:hasObjective t:length ;
    CO-META:hasConstraint t:visit_once , t:short_legs .

t:n a owl:NamedIndividual , CO-META:InputParameter ;
    CO-META:hasLatexSymbol "N" ;
    CO-META:hasShape CO-META:Scalar ;
    CO-META:hasValueDomain [ a CO-META:ValueDomain ; CO-META:hasBaseType CO-META:Integers ] .
t:d a owl:NamedIndividual , CO-META:ProblemData ;
    CO-META:hasLatexSymbol "d" ;
    CO-META:hasShape [ a CO-META:MatrixShape ;
                       CO-META:hasRowCount [ a CO-META:ParameterReference ; CO-META:refersTo t:n ] ;
                       CO-META:hasColumnCount [ a CO-META:ParameterReference ; CO-META:refersTo t:n ] ] .
t:x a owl:NamedIndividual , CO-META:DecisionVariable ;
    CO-META:hasLatexSymbol "x" ;
    CO-META:hasShape [ a CO-META:CollectionShape ;
                       CO-META:isOrdered true ;
                       CO-META:isDistinct true ;
                       CO-META:hasLength [ a CO-META:ParameterReference ; CO-META:refersTo t:n ] ] ;
    CO-META:hasValueDomain [ a CO-META:ValueDomain ;
                             CO-META:hasBaseType CO-META:Integers ;
                             CO-META:hasLowerBound [ a CO-META:LiteralValue ; CO-META:hasLiteralValue 1 ] ;
                             CO-META:hasUpperBound [ a CO-META:ParameterReference ; CO-META:refersTo t:n ] ] ;
    CO-META:hasHeuristic [ a CO-META:TransitionHeuristic ;
                           CO-META:hasLatexExpression "\\frac{1}{d_{ij}}" ;
                           CO-META:hasFromIndexSymbol "i" ;
                           CO-META:hasToIndexSymbol "j" ] .

t:length a owl:NamedIndividual , CO-META:MinimizationObjective ;
    CO-META:hasLatexExpression "\\sum_{i=1}^{N} d_{x_i, x_{(i \\bmod N) + 1}}" ;
    CO-META:hasIdealValue "0.0"^^xsd:double ;
    CO-META:hasNadirValue "1000.0"^^xsd:double .

t:visit_once a owl:NamedIndividual , CO-META:Constraint ;
    CO-META:hasLatexExpression "\\left|\\{ i \\in \\{1, \\ldots, N\\} : x_i = j \\}\\right| = 1 \\quad \\forall j \\in \\{1, \\ldots, N\\}" ;
    CO-META:isImpliedByShape true .
t:short_legs a owl:NamedIndividual , CO-META:Constraint ;
    CO-META:hasLatexExpression "d_{x_i, x_{i + 1}} \\leq 100 \\quad \\forall i \\in \\{1, \\ldots, N - 1\\}" ;
    CO-META:isHard false ;
    CO-META:hasPenaltyWeight "2.5"^^xsd:double .
