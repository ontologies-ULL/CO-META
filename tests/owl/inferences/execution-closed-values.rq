PREFIX cm: <https://w3id.org/ontologies-ULL/CO-META#>
PREFIX t: <http://example.org/co-meta-test#>

ASK {
    t:metaheuristic a cm:Metaheuristic .
    t:binding a cm:DataBinding .
    t:execution a cm:Execution .
    t:run a cm:Run .
    cm:PenaltyHandling a cm:ConstraintHandling .
    cm:JsonFormat a cm:DataFormat .
    cm:ComponentTrace a cm:TraceLevel .
}
