# Expected: SHACL violation (ParameterAssignmentShape).
# A parameter assignment must give the assigned value.
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix CO-META: <https://w3id.org/ontologies-ULL/CO-META#> .
@prefix t: <http://example.org/co-meta-test#> .

<http://example.org/co-meta-test/assignment-without-value> a owl:Ontology ;
    owl:imports <https://w3id.org/ontologies-ULL/CO-META> .

t:population_size a owl:NamedIndividual , CO-META:ParameterValue ;
    CO-META:hasType CO-META:PopulationSize ; CO-META:hasValue 10 .
t:assignment a owl:NamedIndividual , CO-META:ParameterAssignment ;
    CO-META:assignsParameterValue t:population_size .
