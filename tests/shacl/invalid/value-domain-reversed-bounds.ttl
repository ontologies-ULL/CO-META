# Expected: SHACL violation (ValueDomainShape).
# The lower bound of a value domain cannot exceed its upper bound.
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix CO-META: <https://w3id.org/ontologies-ULL/CO-META#> .
@prefix t: <http://example.org/co-meta-test#> .

<http://example.org/co-meta-test/value-domain-reversed-bounds> a owl:Ontology ;
    owl:imports <https://w3id.org/ontologies-ULL/CO-META> .

t:x a owl:NamedIndividual , CO-META:DecisionVariable ;
    CO-META:hasShape CO-META:Scalar ;
    CO-META:hasValueDomain [ a CO-META:ValueDomain ;
                             CO-META:hasBaseType CO-META:Integers ;
                             CO-META:hasLowerBound [ a CO-META:LiteralValue ; CO-META:hasLiteralValue 5 ] ;
                             CO-META:hasUpperBound [ a CO-META:LiteralValue ; CO-META:hasLiteralValue 1 ] ] .
