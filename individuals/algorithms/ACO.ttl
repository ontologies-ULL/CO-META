                                  CO-META:hasDataStructure CO-META:ACO_pheromones ;
                                  CO-META:hasStart CO-META:ACO_stop .


###  https://w3id.org/ontologies-ULL/CO-META#ACO_construction_pheromones
CO-META:ACO_construction_pheromones rdf:type owl:NamedIndividual ,
                                             CO-META:PopulationConstructionComponent ;
                                    CO-META:hasOutput CO-META:ACO_evaporate_pheromones ;
                                    CO-META:hasParameter CO-META:ACO_parameter_heuristic_influence ,
                                                         CO-META:ACO_parameter_pheromone_influence ,
                                                         CO-META:ACO_parameter_populationsize ;
                                    CO-META:readsData CO-META:ACO_pheromones .


###  https://w3id.org/ontologies-ULL/CO-META#ACO_evaporate_pheromones
CO-META:ACO_evaporate_pheromones rdf:type owl:NamedIndividual ,
                                          CO-META:DataHandlerComponent ;
                                 CO-META:hasOutputStart CO-META:ACO_iterate_population ;
                                 CO-META:hasParameter CO-META:ACO_parameter_pheromone_evaporation ;
                                 CO-META:writesData CO-META:ACO_pheromones .


###  https://w3id.org/ontologies-ULL/CO-META#ACO_iterate_population
CO-META:ACO_iterate_population rdf:type owl:NamedIndividual ,
                                        CO-META:PopulationModifierComponent ;
                               CO-META:hasOutput CO-META:ACO_iterative_selector ;
                               CO-META:hasOutputEnd CO-META:ACO_stop .


###  https://w3id.org/ontologies-ULL/CO-META#ACO_iterative_selector
CO-META:ACO_iterative_selector rdf:type owl:NamedIndividual ,
                                        CO-META:IterativeSelectionComponent ;
                               CO-META:hasOutput CO-META:ACO_place_pheromones .


###  https://w3id.org/ontologies-ULL/CO-META#ACO_parameter_heuristic_influence
CO-META:ACO_parameter_heuristic_influence rdf:type owl:NamedIndividual ,
                                                   CO-META:ParameterValue ;
                                          CO-META:hasType CO-META:HeuristicInfluence .


###  https://w3id.org/ontologies-ULL/CO-META#ACO_parameter_pheromone_addition
CO-META:ACO_parameter_pheromone_addition rdf:type owl:NamedIndividual ,
