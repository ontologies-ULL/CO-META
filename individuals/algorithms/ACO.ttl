###  https://w3id.org/ontologies-ULL/CO-META#ACO_place_pheromones
CO-META:ACO_place_pheromones rdf:type owl:NamedIndividual ,
                                      CO-META:DataHandlerComponent ;
                             CO-META:hasOutput CO-META:ACO_iterate_population ;
                             CO-META:hasParameter CO-META:ACO_parameter_pheromone_addition ;
                             CO-META:writesData CO-META:ACO_pheromones ;
