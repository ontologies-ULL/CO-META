@prefix : <https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/TS#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix CO-META: <https://w3id.org/ontologies-ULL/CO-META#> .
@base <https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/TS> .

<https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/TS> rdf:type owl:Ontology ;
                                                                     owl:imports <https://w3id.org/ontologies-ULL/CO-META> ;
                                                                     rdfs:label "CO-META individuals for Tabu Search"@en .

#################################################################
#    Individuals
#################################################################

###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/TS#TabuSearch
:TabuSearch rdf:type owl:NamedIndividual ,
                     CO-META:Metaheuristic ;
            CO-META:hasConstraintHandling CO-META:FeasibilityFirstHandling ;
            CO-META:hasDataStructure :tabu_list ;
            CO-META:hasStart :generate ;
            rdfs:label "Búsqueda tabú"@es ,
                       "Tabu Search"@en .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/TS#generate
:generate rdf:type owl:NamedIndividual ,
                   CO-META:RandomGenerationComponent ;
          CO-META:hasOutputStart :stop ;
          CO-META:hasParameter :parameter_populationsize .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/TS#neighbourhood
:neighbourhood rdf:type owl:NamedIndividual ,
                        CO-META:NeighbourhoodComponent ;
               CO-META:hasOutput :substraction .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/TS#parameter_iterations
:parameter_iterations rdf:type owl:NamedIndividual ,
                               CO-META:ParameterValue ;
                      CO-META:hasType CO-META:Iterations .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/TS#parameter_populationsize
:parameter_populationsize rdf:type owl:NamedIndividual ,
                                   CO-META:ParameterValue ;
                          CO-META:hasType CO-META:PopulationSize ;
                          CO-META:hasValue 1 .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/TS#parameter_storagesize
:parameter_storagesize rdf:type owl:NamedIndividual ,
                                CO-META:ParameterValue ;
                       CO-META:hasType CO-META:StorageSize ;
                       CO-META:hasValue 50 .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/TS#parameter_storagesize_reference
:parameter_storagesize_reference rdf:type owl:NamedIndividual ,
                                          CO-META:ParameterReference ;
                                 CO-META:refersTo :parameter_storagesize .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/TS#select_best
:select_best rdf:type owl:NamedIndividual ,
                      CO-META:BestCandidateAcceptanceComponent ;
             CO-META:hasOutput :stop .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/TS#stop
:stop rdf:type owl:NamedIndividual ,
               CO-META:StoppingCriterionComponent ;
      CO-META:hasOutput :store_visited ;
      CO-META:hasParameter :parameter_iterations .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/TS#store_visited
:store_visited rdf:type owl:NamedIndividual ,
                        CO-META:TabuListUpdateComponent ;
               CO-META:hasOutput :neighbourhood ;
               CO-META:hasParameter :parameter_storagesize ;
               CO-META:writesData :tabu_list .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/TS#substraction
:substraction rdf:type owl:NamedIndividual ,
                       CO-META:SubtractionComponent ;
              CO-META:hasCandidateOutput :select_best ;
              CO-META:readsData :tabu_list .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/TS#tabu_list
:tabu_list rdf:type owl:NamedIndividual ,
                    CO-META:DataStructure ;
           CO-META:hasShape :tabu_list_shape ;
           CO-META:hasValueDomain CO-META:AnySolution .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/TS#tabu_list_shape
:tabu_list_shape rdf:type owl:NamedIndividual ,
                          CO-META:CollectionShape ;
                 CO-META:hasLength :parameter_storagesize_reference ;
                 CO-META:isDistinct "true"^^xsd:boolean ;
                 CO-META:isOrdered "true"^^xsd:boolean .


