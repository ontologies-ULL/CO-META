@base <https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/NSGA-II> .

<https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/NSGA-II> rdf:type owl:Ontology ;
                                                                          owl:imports <https://w3id.org/ontologies-ULL/CO-META> ;
                                                                          rdfs:label "CO-META individuals for NSGA-II"@en .

#################################################################
#    Individuals
#################################################################

###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/NSGA-II#NSGA-II
:NSGA-II rdf:type owl:NamedIndividual ,
                  CO-META:Metaheuristic ;
         CO-META:hasConstraintHandling CO-META:FeasibilityFirstHandling ;
         CO-META:hasStart :generate_population ;
         rdfs:label "Algoritmo genético de ordenación no dominada II"@es ,
                    "Non-dominated Sorting Genetic Algorithm II"@en .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/NSGA-II#binary_tournament_selection
:binary_tournament_selection rdf:type owl:NamedIndividual ,
                                      CO-META:TournamentSelectionComponent ;
                             CO-META:hasOutput :crossover ;
                             CO-META:hasParameter :parameter_elitism ,
                                                  :parameter_tournamentsize .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/NSGA-II#crossover
:crossover rdf:type owl:NamedIndividual ,
                    CO-META:CrossoverComponent ;
           CO-META:hasOutput :mutation ;
           CO-META:hasParameter :parameter_crossover .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/NSGA-II#diversity_preservation_crowding_distance
:diversity_preservation_crowding_distance rdf:type owl:NamedIndividual ,
                                                   CO-META:CrowdingDistanceComponent ;
                                          CO-META:hasOutput :truncation .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/NSGA-II#fitness_assignment_non_dominance
:fitness_assignment_non_dominance rdf:type owl:NamedIndividual ,
                                           CO-META:NonDominatedSortingComponent ;
                                  CO-META:hasOutput :diversity_preservation_crowding_distance .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/NSGA-II#generate_population
:generate_population rdf:type owl:NamedIndividual ,
                              CO-META:PopulationGenerationComponent ,
                              CO-META:RandomGenerationComponent ;
                     CO-META:hasOutput :initial_fitness_assignment_non_dominance ;
                     CO-META:hasParameter :parameter_populationsize .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/NSGA-II#initial_diversity_preservation_crowding_distance
:initial_diversity_preservation_crowding_distance rdf:type owl:NamedIndividual ,
                                                           CO-META:CrowdingDistanceComponent ;
                                                  CO-META:hasOutputStart :stop .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/NSGA-II#initial_fitness_assignment_non_dominance
:initial_fitness_assignment_non_dominance rdf:type owl:NamedIndividual ,
                                                   CO-META:NonDominatedSortingComponent ;
                                          CO-META:hasOutput :initial_diversity_preservation_crowding_distance .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/NSGA-II#mutation
:mutation rdf:type owl:NamedIndividual ,
                   CO-META:VariationComponent ;
          CO-META:hasOutput :next_generation ;
          CO-META:hasParameter :parameter_mutation .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/NSGA-II#next_generation
:next_generation rdf:type owl:NamedIndividual ,
                          CO-META:PopulationModifierComponent ;
                 CO-META:hasCandidateOutput :union ;
                 CO-META:hasOutput :binary_tournament_selection ;
                 CO-META:hasOutputEnd :union ;
                 CO-META:hasParameter :parameter_populationsize .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/NSGA-II#parameter_crossover
:parameter_crossover rdf:type owl:NamedIndividual ,
                              CO-META:ParameterValue ;
                     CO-META:hasType CO-META:CrossoverProbability .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/NSGA-II#parameter_elitism
:parameter_elitism rdf:type owl:NamedIndividual ,
                            CO-META:ParameterValue ;
                   CO-META:hasType CO-META:Elitism ;
                   CO-META:hasValue 0 .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/NSGA-II#parameter_iterations
:parameter_iterations rdf:type owl:NamedIndividual ,
                               CO-META:ParameterValue ;
                      CO-META:hasType CO-META:Iterations ;
                      CO-META:hasValue 100 .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/NSGA-II#parameter_mutation
:parameter_mutation rdf:type owl:NamedIndividual ,
                             CO-META:ParameterValue ;
                    CO-META:hasType CO-META:MutationProbability .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/NSGA-II#parameter_populationsize
:parameter_populationsize rdf:type owl:NamedIndividual ,
                                   CO-META:ParameterValue ;
                          CO-META:hasType CO-META:PopulationSize .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/NSGA-II#parameter_tournamentsize
:parameter_tournamentsize rdf:type owl:NamedIndividual ,
                                   CO-META:ParameterValue ;
                          CO-META:hasType CO-META:TournamentSize ;
                          CO-META:hasValue 2 .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/NSGA-II#stop
:stop rdf:type owl:NamedIndividual ,
               CO-META:StoppingCriterionComponent ;
      CO-META:hasCurrentOutput :union ;
      CO-META:hasOutputStart :next_generation ;
      CO-META:hasParameter :parameter_iterations .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/NSGA-II#truncation
:truncation rdf:type owl:NamedIndividual ,
                     CO-META:TruncationComponent ;
            CO-META:hasOutput :stop ;
            CO-META:hasParameter :parameter_populationsize .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/NSGA-II#union
:union rdf:type owl:NamedIndividual ,
                CO-META:UnionComponent ;
       CO-META:hasOutput :fitness_assignment_non_dominance .


