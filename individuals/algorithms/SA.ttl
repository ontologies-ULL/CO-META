@prefix : <https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/SA#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix CO-META: <https://w3id.org/ontologies-ULL/CO-META#> .
@base <https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/SA> .

<https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/SA> rdf:type owl:Ontology ;
                                                                     owl:imports <https://w3id.org/ontologies-ULL/CO-META> ;
                                                                     rdfs:label "CO-META individuals for Simulated Annealing"@en .

#################################################################
#    Individuals
#################################################################

###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/SA#SimulatedAnnealing
:SimulatedAnnealing rdf:type owl:NamedIndividual ,
                             CO-META:Metaheuristic ;
                    CO-META:hasConstraintHandling CO-META:FeasibilityFirstHandling ;
                    CO-META:hasDataStructure :temperature ;
                    CO-META:hasStart :generate ;
                    rdfs:label "Recocido simulado"@es ,
                               "Simulated Annealing"@en .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/SA#acceptance
:acceptance rdf:type owl:NamedIndividual ,
                     CO-META:MetropolisAcceptanceComponent ;
            CO-META:hasOutput :cooling_schedule ;
            CO-META:readsData :temperature .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/SA#cooling_schedule
:cooling_schedule rdf:type owl:NamedIndividual ,
                           CO-META:GeometricCoolingComponent ;
                  CO-META:hasOutput :stop ;
                  CO-META:hasParameter :parameter_max_temperature ,
                                       :parameter_min_temperature ;
                  CO-META:writesData :temperature .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/SA#generate
:generate rdf:type owl:NamedIndividual ,
                   CO-META:RandomGenerationComponent ;
          CO-META:hasOutputStart :stop ;
          CO-META:hasParameter :parameter_populationsize .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/SA#neighbourhood
:neighbourhood rdf:type owl:NamedIndividual ,
                        CO-META:NeighbourhoodComponent .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/SA#parameter_iterations
:parameter_iterations rdf:type owl:NamedIndividual ,
                               CO-META:ParameterValue ;
                      CO-META:hasType CO-META:Iterations .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/SA#parameter_max_temperature
:parameter_max_temperature rdf:type owl:NamedIndividual ,
                                    CO-META:ParameterValue ;
                           CO-META:hasType CO-META:MaxTemperature .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/SA#parameter_max_temperature_reference
:parameter_max_temperature_reference rdf:type owl:NamedIndividual ,
                                              CO-META:ParameterReference ;
                                     CO-META:refersTo :parameter_max_temperature .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/SA#parameter_min_temperature
:parameter_min_temperature rdf:type owl:NamedIndividual ,
                                    CO-META:ParameterValue ;
                           CO-META:hasType CO-META:MinTemperature .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/SA#parameter_min_temperature_reference
:parameter_min_temperature_reference rdf:type owl:NamedIndividual ,
                                              CO-META:ParameterReference ;
                                     CO-META:refersTo :parameter_min_temperature .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/SA#parameter_populationsize
:parameter_populationsize rdf:type owl:NamedIndividual ,
                                   CO-META:ParameterValue ;
                          CO-META:hasType CO-META:PopulationSize ;
                          CO-META:hasValue 1 .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/SA#perturbation
:perturbation rdf:type owl:NamedIndividual ,
                       CO-META:VariationComponent ;
              CO-META:hasCandidateOutput :acceptance ;
              CO-META:usesComponent :neighbourhood .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/SA#stop
:stop rdf:type owl:NamedIndividual ,
               CO-META:StoppingCriterionComponent ;
      CO-META:hasCurrentOutput :acceptance ;
      CO-META:hasOutput :perturbation ;
      CO-META:hasParameter :parameter_iterations .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/SA#temperature
:temperature rdf:type owl:NamedIndividual ,
                      CO-META:DataStructure ;
             CO-META:hasInitialValue :parameter_max_temperature_reference ;
             CO-META:hasShape CO-META:Scalar ;
             CO-META:hasValueDomain :temperature_domain .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/algorithms/SA#temperature_domain
:temperature_domain rdf:type owl:NamedIndividual ,
                             CO-META:ValueDomain ;
                    CO-META:hasBaseType CO-META:Reals ;
                    CO-META:hasLowerBound :parameter_min_temperature_reference ;
                    CO-META:hasUpperBound :parameter_max_temperature_reference .


