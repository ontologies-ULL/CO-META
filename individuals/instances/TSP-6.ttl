<https://w3id.org/ontologies-ULL/CO-META/individuals/instances/TSP-6> rdf:type owl:Ontology ;
                                                                       owl:imports <https://w3id.org/ontologies-ULL/CO-META/individuals/problems/TSP> ;
                                                                       rdfs:label "Instance of the Travelling Salesman Problem with 6 cities"@en .

#################################################################
#    Individuals
#################################################################

###  https://w3id.org/ontologies-ULL/CO-META/individuals/instances/TSP-6#cities
:cities rdf:type owl:NamedIndividual ,
                 CO-META:DataBinding ;
        CO-META:bindsQuantity TSP:Cities ;
        CO-META:hasSourceFormat CO-META:InlineFormat ;
        CO-META:hasInlineValue "{\"X\": [0, 4, 6, 4, 0, -2], \"Y\": [0, 0, 3, 6, 6, 3]}" .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/instances/TSP-6#instance
:instance rdf:type owl:NamedIndividual ,
                   CO-META:ProblemInstance ;
          CO-META:hasDataBinding :cities ,
                                 :n ;
          CO-META:hasKnownSolution :optimum ;
          CO-META:isInstanceOf TSP:TSP ;
          rdfs:comment "Seis ciudades en un hexágono. El recorrido óptimo las visita en orden y mide unos 22,42."@es ,
                       "Six cities on a hexagon. The optimum tour visits them in order and is about 22.42 long."@en ;
          rdfs:label "TSP con 6 ciudades"@es ,
                     "TSP with 6 cities"@en .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/instances/TSP-6#n
:n rdf:type owl:NamedIndividual ,
            CO-META:DataBinding ;
   CO-META:bindsQuantity TSP:N ;
   CO-META:hasSourceFormat CO-META:InlineFormat ;
   CO-META:hasInlineValue "6" .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/instances/TSP-6#optimum
:optimum rdf:type owl:NamedIndividual ,
                  CO-META:SolutionRecord ;
         CO-META:hasObjectiveValue :optimum_minimum_distance ;
         CO-META:hasVariableValues "{\"x\": [1, 2, 3, 4, 5, 6]}" ;
         CO-META:isFeasible "true"^^xsd:boolean ;
         CO-META:isOptimal "true"^^xsd:boolean .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/instances/TSP-6#optimum_minimum_distance
:optimum_minimum_distance rdf:type owl:NamedIndividual ,
                                   CO-META:ObjectiveValue ;
                          CO-META:hasType TSP:minimum_distance ;
                          CO-META:hasValue "22.42220510185596"^^xsd:double .


