###  https://w3id.org/ontologies-ULL/CO-META/individuals/instances/KNAPSACK-P01#capacity
:capacity rdf:type owl:NamedIndividual ,
                   CO-META:DataBinding ;
          CO-META:bindsQuantity KNAPSACK:W ;
          CO-META:hasSourceFormat CO-META:InlineFormat ;
          CO-META:hasInlineValue "165" .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/instances/KNAPSACK-P01#instance
:instance rdf:type owl:NamedIndividual ,
                   CO-META:ProblemInstance ;
          CO-META:hasDataBinding :capacity ,
                                 :items ;
          CO-META:hasKnownSolution :optimum ;
          CO-META:isInstanceOf KNAPSACK:KNAPSACK ;
          rdfs:comment "Instance P01 of Kreher and Stinson, with 10 items. Its optimum value is 309."@en ,
                       "Instancia P01 de Kreher y Stinson, con 10 objetos. Su valor óptimo es 309."@es ;
          rdfs:label "Knapsack P01"@en ,
                     "Mochila P01"@es .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/instances/KNAPSACK-P01#items
:items rdf:type owl:NamedIndividual ,
                CO-META:DataBinding ;
       CO-META:bindsQuantity KNAPSACK:Items ;
       CO-META:hasSourceFormat CO-META:InlineFormat ;
       CO-META:hasInlineValue "{\"Value\": [92, 57, 49, 68, 60, 43, 67, 84, 87, 72], \"Weight\": [23, 31, 29, 44, 53, 38, 63, 85, 89, 82]}" .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/instances/KNAPSACK-P01#optimum
:optimum rdf:type owl:NamedIndividual ,
                  CO-META:SolutionRecord ;
         CO-META:hasObjectiveValue :optimum_maximum_value ;
         CO-META:hasVariableValues "{\"x\": [1, 1, 1, 1, 0, 1, 0, 0, 0, 0]}" ;
         CO-META:isFeasible "true"^^xsd:boolean ;
         CO-META:isOptimal "true"^^xsd:boolean .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/instances/KNAPSACK-P01#optimum_maximum_value
:optimum_maximum_value rdf:type owl:NamedIndividual ,
                                CO-META:ObjectiveValue ;
                       CO-META:hasType KNAPSACK:maximum_value ;
                       CO-META:hasValue "309.0"^^xsd:double .


