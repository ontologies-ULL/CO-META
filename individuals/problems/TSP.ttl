@prefix : <https://w3id.org/ontologies-ULL/CO-META/individuals/problems/TSP#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix CO-META: <https://w3id.org/ontologies-ULL/CO-META#> .
@base <https://w3id.org/ontologies-ULL/CO-META/individuals/problems/TSP> .

<https://w3id.org/ontologies-ULL/CO-META/individuals/problems/TSP> rdf:type owl:Ontology ;
                                                                    owl:imports <https://w3id.org/ontologies-ULL/CO-META> ;
                                                                    rdfs:label "CO-META individuals for the Traveling Salesman Problem"@en .

#################################################################
#    Individuals
#################################################################

###  https://w3id.org/ontologies-ULL/CO-META/individuals/problems/TSP#Cities
:Cities rdf:type owl:NamedIndividual ,
                 CO-META:ProblemData ;
        CO-META:hasShape :Cities_shape ;
        CO-META:hasIdentifier "Cities" ;
        CO-META:hasLatexSymbol "C" .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/problems/TSP#Cities_X
:Cities_X rdf:type owl:NamedIndividual ,
                   CO-META:Column ;
          CO-META:hasValueDomain CO-META:AnyReal ;
          CO-META:hasIdentifier "X" ;
          CO-META:hasLatexSymbol "X" ;
          CO-META:hasPosition 1 .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/problems/TSP#Cities_Y
:Cities_Y rdf:type owl:NamedIndividual ,
                   CO-META:Column ;
          CO-META:hasValueDomain CO-META:AnyReal ;
          CO-META:hasIdentifier "Y" ;
          CO-META:hasLatexSymbol "Y" ;
          CO-META:hasPosition 2 .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/problems/TSP#Cities_shape
:Cities_shape rdf:type owl:NamedIndividual ,
                       CO-META:TableShape ;
              CO-META:hasColumn :Cities_X ,
                                :Cities_Y ;
              CO-META:hasRowCount :N_reference .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/problems/TSP#N
:N rdf:type owl:NamedIndividual ,
            CO-META:InputParameter ;
   CO-META:hasValueDomain CO-META:PositiveIntegers ;
   CO-META:hasIdentifier "N" ;
   CO-META:hasLatexSymbol "N" ;
   CO-META:isImplicit "false"^^xsd:boolean .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/problems/TSP#N_reference
:N_reference rdf:type owl:NamedIndividual ,
                      CO-META:ParameterReference ;
             CO-META:refersTo :N .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/problems/TSP#TSP
:TSP rdf:type owl:NamedIndividual ,
              CO-META:Problem ;
     CO-META:hasConstraint :visit_each_city_once ;
     CO-META:hasObjective :minimum_distance ;
     CO-META:hasProblemElement :Cities ,
                               :N ,
                               :x ;
     rdfs:label "Problema del viajante"@es ,
                "Traveling Salesman Problem"@en .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/problems/TSP#inverse_distance
:inverse_distance rdf:type owl:NamedIndividual ,
                           CO-META:TransitionHeuristic ;
                  CO-META:hasFromIndexSymbol "i" ;
                  CO-META:hasLatexExpression "\\frac{1}{\\sqrt{(X_i - X_j)^2 + (Y_i - Y_j)^2}}" ;
                  CO-META:hasToIndexSymbol "j" ;
                  rdfs:label "Inversa de la distancia"@es ,
                             "Inverse distance"@en .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/problems/TSP#minimum_distance
:minimum_distance rdf:type owl:NamedIndividual ,
                           CO-META:MinimizationObjective ;
                  CO-META:hasLatexExpression "\\sum_{i=1}^{N} \\sqrt{\\left(X_{x_{(i \\bmod N) + 1}} - X_{x_i}\\right)^2 + \\left(Y_{x_{(i \\bmod N) + 1}} - Y_{x_i}\\right)^2}" ;
                  CO-META:hasWeight "1.0"^^xsd:double ;
                  rdfs:label "Distancia total mínima"@es ,
                             "Minimum total distance"@en .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/problems/TSP#visit_each_city_once
:visit_each_city_once rdf:type owl:NamedIndividual ,
                               CO-META:Constraint ;
                      CO-META:hasLatexExpression "\\left|\\{ i \\in \\{1, \\ldots, N\\} : x_i = j \\}\\right| = 1 \\quad \\forall j \\in \\{1, \\ldots, N\\}" ;
                      CO-META:isHard "true"^^xsd:boolean ;
                      CO-META:isImpliedByShape "true"^^xsd:boolean ;
                      rdfs:label "Cada ciudad se visita exactamente una vez"@es ,
                                 "Each city is visited exactly once"@en .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/problems/TSP#x
:x rdf:type owl:NamedIndividual ,
            CO-META:DecisionVariable ;
   CO-META:hasHeuristic :inverse_distance ;
   CO-META:hasShape :x_shape ;
   CO-META:hasValueDomain :x_domain ;
   CO-META:hasIdentifier "x" ;
   CO-META:hasLatexSymbol "x" .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/problems/TSP#x_domain
:x_domain rdf:type owl:NamedIndividual ,
                   CO-META:ValueDomain ;
          CO-META:hasBaseType CO-META:Integers ;
          CO-META:hasLowerBound CO-META:One ;
          CO-META:hasUpperBound :N_reference .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/problems/TSP#x_shape
:x_shape rdf:type owl:NamedIndividual ,
                  CO-META:CollectionShape ;
         CO-META:hasLength :N_reference ;
         CO-META:isDistinct "true"^^xsd:boolean ;
         CO-META:isOrdered "true"^^xsd:boolean .


