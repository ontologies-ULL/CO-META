###  https://w3id.org/ontologies-ULL/CO-META/individuals/problems/KNAPSACK#KNAPSACK
:KNAPSACK rdf:type owl:NamedIndividual ,
                   CO-META:Problem ;
          CO-META:hasConstraint :capacity ;
          CO-META:hasObjective :maximum_value ;
          CO-META:hasProblemElement :Items ,
                                    :N ,
                                    :W ,
                                    :x ;
          rdfs:label "Knapsack Problem"@en ,
                     "Problema de la mochila"@es .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/problems/KNAPSACK#N
:N rdf:type owl:NamedIndividual ,
            CO-META:InputParameter ;
   CO-META:hasValueDomain CO-META:PositiveIntegers ;
   CO-META:hasIdentifier "N" ;
   CO-META:hasLatexSymbol "N" ;
   CO-META:isImplicit "true"^^xsd:boolean .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/problems/KNAPSACK#N_reference
:N_reference rdf:type owl:NamedIndividual ,
                      CO-META:ParameterReference ;
             CO-META:refersTo :N .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/problems/KNAPSACK#W
:W rdf:type owl:NamedIndividual ,
            CO-META:InputParameter ;
   CO-META:hasValueDomain CO-META:NonNegativeReals ;
   CO-META:hasIdentifier "W" ;
   CO-META:hasLatexSymbol "W" ;
   CO-META:isImplicit "false"^^xsd:boolean .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/problems/KNAPSACK#capacity
:capacity rdf:type owl:NamedIndividual ,
                   CO-META:Constraint ;
          CO-META:hasLatexExpression "\\sum_{i=1}^{N} w_i x_i \\leq W" ;
          CO-META:isHard "true"^^xsd:boolean ;
          rdfs:label "Capacidad de la mochila"@es ,
                     "Knapsack capacity"@en .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/problems/KNAPSACK#instance_P01
:instance_P01 rdf:type owl:NamedIndividual ,
                       CO-META:ProblemInstance ;
              CO-META:hasDataBinding :instance_P01_capacity ,
                                     :instance_P01_items ;
              CO-META:isInstanceOf :KNAPSACK ;
              rdfs:comment "Instance P01 of Kreher and Stinson, with 10 items. Its optimum value is 309."@en ,
                           "Instancia P01 de Kreher y Stinson, con 10 objetos. Su valor óptimo es 309."@es ;
              rdfs:label "Knapsack P01"@en ,
                         "Mochila P01"@es .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/problems/KNAPSACK#instance_P01_capacity
:instance_P01_capacity rdf:type owl:NamedIndividual ,
                                CO-META:DataBinding ;
                       CO-META:bindsQuantity :W ;
                       CO-META:hasSourceFormat CO-META:InlineFormat ;
                       CO-META:hasInlineValue "165" .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/problems/KNAPSACK#instance_P01_items
:instance_P01_items rdf:type owl:NamedIndividual ,
                             CO-META:DataBinding ;
                    CO-META:bindsQuantity :Items ;
                    CO-META:hasSourceFormat CO-META:InlineFormat ;
                    CO-META:hasInlineValue "{\"Value\": [92, 57, 49, 68, 60, 43, 67, 84, 87, 72], \"Weight\": [23, 31, 29, 44, 53, 38, 63, 85, 89, 82]}" .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/problems/KNAPSACK#maximum_value
:maximum_value rdf:type owl:NamedIndividual ,
                        CO-META:MaximizationObjective ;
               CO-META:hasLatexExpression "\\sum_{i=1}^{N} v_i x_i" ;
               CO-META:hasWeight "1.0"^^xsd:double ;
               rdfs:label "Maximum total value"@en ,
                          "Valor total máximo"@es .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/problems/KNAPSACK#value_per_weight
:value_per_weight rdf:type owl:NamedIndividual ,
                           CO-META:ValueHeuristic ;
                  CO-META:hasLatexExpression "\\frac{v_j}{w_j}" ;
                  CO-META:hasValueIndexSymbol "j" ;
                  rdfs:label "Valor por unidad de peso"@es ,
                             "Value per unit of weight"@en .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/problems/KNAPSACK#x
:x rdf:type owl:NamedIndividual ,
            CO-META:DecisionVariable ;
   CO-META:hasHeuristic :value_per_weight ;
   CO-META:hasShape :x_shape ;
   CO-META:hasValueDomain CO-META:BinaryIntegers ;
   CO-META:hasIdentifier "x" ;
   CO-META:hasLatexSymbol "x" .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/problems/KNAPSACK#x_shape
:x_shape rdf:type owl:NamedIndividual ,
                  CO-META:CollectionShape ;
         CO-META:hasLength :N_reference ;
         CO-META:isDistinct "false"^^xsd:boolean ;
         CO-META:isOrdered "true"^^xsd:boolean .


