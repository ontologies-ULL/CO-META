###  https://w3id.org/ontologies-ULL/CO-META/individuals/problems/BIKNAPSACK#N
:N rdf:type owl:NamedIndividual ,
            CO-META:InputParameter ;
   CO-META:hasValueDomain CO-META:PositiveIntegers ;
   CO-META:hasIdentifier "N" ;
   CO-META:hasLatexSymbol "N" ;
   CO-META:isImplicit "true"^^xsd:boolean .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/problems/BIKNAPSACK#N_reference
:N_reference rdf:type owl:NamedIndividual ,
                      CO-META:ParameterReference ;
             CO-META:refersTo :N .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/problems/BIKNAPSACK#W
:W rdf:type owl:NamedIndividual ,
            CO-META:InputParameter ;
   CO-META:hasValueDomain CO-META:NonNegativeReals ;
   CO-META:hasIdentifier "W" ;
   CO-META:hasLatexSymbol "W" ;
   CO-META:isImplicit "false"^^xsd:boolean .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/problems/BIKNAPSACK#capacity
:capacity rdf:type owl:NamedIndividual ,
                   CO-META:Constraint ;
          CO-META:hasLatexExpression "\\sum_{i=1}^{N} w_i x_i \\leq W" ;
          CO-META:isHard "true"^^xsd:boolean ;
          rdfs:label "Capacidad de la mochila"@es ,
                     "Knapsack capacity"@en .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/problems/BIKNAPSACK#maximum_first_value
:maximum_first_value rdf:type owl:NamedIndividual ,
                              CO-META:MaximizationObjective ;
                     CO-META:hasLatexExpression "\\sum_{i=1}^{N} u_i x_i" ;
                     CO-META:hasWeight "1.0"^^xsd:double ;
                     rdfs:label "Maximum total first value"@en ,
                                "Primer valor total máximo"@es .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/problems/BIKNAPSACK#maximum_second_value
:maximum_second_value rdf:type owl:NamedIndividual ,
                               CO-META:MaximizationObjective ;
                      CO-META:hasLatexExpression "\\sum_{i=1}^{N} v_i x_i" ;
                      CO-META:hasWeight "1.0"^^xsd:double ;
                      rdfs:label "Maximum total second value"@en ,
                                 "Segundo valor total máximo"@es .


###  https://w3id.org/ontologies-ULL/CO-META/individuals/problems/BIKNAPSACK#x
:x rdf:type owl:NamedIndividual ,
            CO-META:DecisionVariable ;
   CO-META:hasShape :x_shape ;
   CO-META:hasValueDomain CO-META:BinaryIntegers ;
   CO-META:hasIdentifier "x" ;
   CO-META:hasLatexSymbol "x" .


