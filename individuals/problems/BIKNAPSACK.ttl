###  https://w3id.org/ontologies-ULL/CO-META#BIKNAPSACK_capacity
CO-META:BIKNAPSACK_capacity rdf:type owl:NamedIndividual ,
                                     CO-META:Constraint ;
                            CO-META:hasLatexExpression "\\sum_{i=1}^{N} w_i x_i \\leq W" ;
                            CO-META:isHard "true"^^xsd:boolean ;
                            rdfs:label "Capacidad de la mochila"@es ,
                                       "Knapsack capacity"@en .


###  https://w3id.org/ontologies-ULL/CO-META#BIKNAPSACK_maximum_first_value
CO-META:BIKNAPSACK_maximum_first_value rdf:type owl:NamedIndividual ,
                                                CO-META:MaximizationObjective ;
                                       CO-META:hasLatexExpression "\\sum_{i=1}^{N} u_i x_i" ;
                                       CO-META:hasWeight "1.0"^^xsd:double ;
                                       rdfs:label "Maximum total first value"@en ,
                                                  "Primer valor total máximo"@es .


###  https://w3id.org/ontologies-ULL/CO-META#BIKNAPSACK_maximum_second_value
CO-META:BIKNAPSACK_maximum_second_value rdf:type owl:NamedIndividual ,
